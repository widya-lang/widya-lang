impor "widya_ai_local/modul_evolusi/evaluasi_proyek_widya.wya";
impor "widya_ai_local/modul_evolusi/remediasi_kode_otonom.wya";
impor "modul/pipeline_cicd.wya";
impor "widya_ai_local/modul_evolusi/orkestrasi_fleet.wya";
impor "modul/event_broker.wya";
impor "widya_ai_local/modul_evolusi/pemrosesan_aliran_reaktif.wya";
impor "widya_ai_local/modul_evolusi/federated_learning_edge.wya";
impor "widya_ai_local/modul_evolusi/koloni_swarm_bft.wya";
impor "widya_ai_local/modul_evolusi/mesin_zk_berdaulat.wya";
