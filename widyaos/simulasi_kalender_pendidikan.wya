// =================================================================
// SIMULASI SUITE: KALENDER PENDIDIKAN, LIBUR LOKAL & PJJ DARURAT BENCANA
// Pengujian Otomatisasi Hari Libur, Kebijakan Daerah, & Mitigasi Karhutla
// =================================================================

impor "widyaos/modul/kalender_pendidikan_darurat.wya";

cetak("==================================================================");
cetak(" UJI KALENDER PENDIDIKAN, LIBUR NASIONAL/LOKAL & PROTOKOL BENCANA ");
cetak("==================================================================");

// [TEST 1] Inisialisasi Kalender Pendidikan 2 Sekolah di Berbagai Wilayah
// Sekolah A: SMA Negeri 1 Pekanbaru, Riau (Kode Provinsi: 14)
// Sekolah B: SMA Negeri 1 Denpasar, Bali (Kode Provinsi: 51)
cetak("\n[1] Inisialisasi Kalender Pendidikan Satuan Pendidikan");
misal kalender_riau = inisialisasi_kalender_pendidikan("10401234", "2026/2027", 1, "14");
misal kalender_bali = inisialisasi_kalender_pendidikan("50105678", "2026/2027", 1, "51");

cetak("🏫 Sekolah Riau        : NPSN", kalender_riau.npsn, "| Provinsi: Riau (Kode 14)");
cetak("🏫 Sekolah Bali        : NPSN", kalender_bali.npsn, "| Provinsi: Bali (Kode 51)");
cetak("📅 Tahun Pelajaran     :", kalender_riau.tahun_ajaran, "Semester", kalender_riau.semester_aktif);

jika kalender_riau.kode_provinsi_sekolah == "14" dan kalender_bali.kode_provinsi_sekolah == "51" {
    cetak("✅ [TEST 1] Inisialisasi Kalender Pendidikan Satuan Pendidikan: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Inisialisasi Kalender Pendidikan Satuan Pendidikan: GAGAL");
}

// [TEST 2] Pendaftaran & Evaluasi Hari Libur Nasional (SKB 3 Menteri)
cetak("\n[2] Pendaftaran Hari Libur Nasional (SKB 3 Menteri)");
tambah_libur_nasional(kalender_riau, "2026-08-17", "Hari Kemerdekaan RI Ke-81", "SKB Menag, Menaker, MenPAN-RB No. 854/2025");
tambah_libur_nasional(kalender_bali, "2026-08-17", "Hari Kemerdekaan RI Ke-81", "SKB Menag, Menaker, MenPAN-RB No. 854/2025");

// Evaluasi tanggal 17 Agustus 2026 di Riau dan Bali
misal st_nas_riau = evaluasi_status_hari_kalender(kalender_riau, "2026-08-17");
misal st_nas_bali = evaluasi_status_hari_kalender(kalender_bali, "2026-08-17");

cetak("🇮🇩 Status 17 Agustus (Riau):", st_nas_riau.status, "->", st_nas_riau.keterangan);
cetak("🇮🇩 Status 17 Agustus (Bali):", st_nas_bali.status, "->", st_nas_bali.keterangan);
cetak("📌 Kebijakan Presensi      :", st_nas_riau.kebijakan_presensi);

jika st_nas_riau.status == "LIBUR_NASIONAL" dan st_nas_bali.status == "LIBUR_NASIONAL" {
    cetak("✅ [TEST 2] Sinkronisasi Hari Libur Nasional SKB 3 Menteri Se-Indonesia: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Sinkronisasi Hari Libur Nasional SKB 3 Menteri Se-Indonesia: GAGAL");
}

// [TEST 3] Pendaftaran & Evaluasi Libur Lokal/Fakultatif Daerah
// Libur Hari Raya Galungan di Bali (Hanya berlaku di Provinsi Bali [Kode 51])
cetak("\n[3] Evaluasi Libur Lokal/Fakultatif Daerah (Hari Raya Galungan di Bali)");
tambah_libur_lokal(kalender_bali, "2026-09-23", "Hari Raya Suci Galungan", "51", "Pergub Bali No. 12/2026 tentang Hari Libur Lokal");
tambah_libur_lokal(kalender_riau, "2026-09-23", "Hari Raya Suci Galungan", "51", "Pergub Bali No. 12/2026");

// Evaluasi pada tanggal 23 September 2026
misal st_lokal_bali = evaluasi_status_hari_kalender(kalender_bali, "2026-09-23");
misal st_lokal_riau = evaluasi_status_hari_kalender(kalender_riau, "2026-09-23");

cetak("🌺 Status di Bali (Kode 51):", st_lokal_bali.status, "->", st_lokal_bali.keterangan);
cetak("🌿 Status di Riau (Kode 14):", st_lokal_riau.status, "->", st_lokal_riau.keterangan);

jika st_lokal_bali.status == "LIBUR_LOKAL" dan st_lokal_riau.status == "TATAP_MUKA_REGULER" {
    cetak("✅ [TEST 3] Isolasi Kebijakan Libur Lokal/Fakultatif Berbasis Provinsi: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Isolasi Kebijakan Libur Lokal/Fakultatif Berbasis Provinsi: GAGAL");
}

// [TEST 4] Skenario PJJ Mendadak Kedaruratan Bencana (Karhutla Asap di Riau)
cetak("\n[4] Protokol PJJ Darurat Bencana: Karhutla & Asap Pekat di Riau (ISPU > 300)");
misal pjj_karhutla = aktifkan_pjj_darurat_bencana(
    kalender_riau,
    "EMG-KARHUTLA-RIAU-2026-01",
    "KARHUTLA_ASAP_PEKAT",
    "SE-DISDIK-RIAU/420/IX/2026",
    "BERBAHAYA",
    "2026-09-18",
    "2026-09-25"
);

misal eval_darurat = evaluasi_status_hari_kalender(kalender_riau, "2026-09-18");

cetak("🚨 Status Operasional :", eval_darurat.status);
cetak("📄 Keterangan Bencana :", eval_darurat.keterangan);
cetak("📍 Kebijakan Presensi :", eval_darurat.kebijakan_presensi);
cetak("🍱 Adaptasi Gizi MBG  :", eval_darurat.adaptasi_mbg);
cetak("🛡️ Hak Tukin ASN & TPG:", eval_darurat.tukin_tpg, "(Terlindungi Force Majeure)");

jika eval_darurat.status == "PJJ_DARURAT_BENCANA" dan eval_darurat.kebijakan_presensi == "DARING_BYPASS_GEOFENCE_DARI_RUMAH" {
    cetak("✅ [TEST 4] Protokol Kedaruratan Bencana Karhutla & Presensi Daring: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Protokol Kedaruratan Bencana Karhutla & Presensi Daring: GAGAL");
}

// [TEST 5] Pemulihan Pasca-Bencana (Kembali ke KBM Normal)
cetak("\n[5] Pemulihan Kualitas Udara & Normalisasi KBM Tatap Muka");
akhiri_pjj_darurat_bencana(kalender_riau);
misal eval_normal = evaluasi_status_hari_kalender(kalender_riau, "2026-09-28");

cetak("🟢 Status Pasca-Bencana:", eval_normal.status);
cetak("📋 Kebijakan Operasi  :", eval_normal.keterangan);
cetak("🏫 Mode Presensi      :", eval_normal.kebijakan_presensi);

jika eval_normal.status == "TATAP_MUKA_REGULER" {
    cetak("✅ [TEST 5] Pemulihan Sistem Pasca-Bencana ke KBM Normal: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Pemulihan Sistem Pasca-Bencana ke KBM Normal: GAGAL");
}

// [TEST 6] Kalkulasi Hari Efektif Bersih (MEB) Semester
cetak("\n[6] Kalkulasi Hari & Minggu Efektif Belajar Bersih (MEB)");
misal kalkulasi_meb = kalkulasi_hari_efektif_semester(kalender_bali, 180, 2);

cetak("📊 Total Hari Kalender :", kalkulasi_meb.total_hari_semester, "hari");
cetak("🏖️ Potongan Libur Nas  :", kalkulasi_meb.potongan_libur_nasional, "hari");
cetak("🌺 Potongan Libur Daerah:", kalkulasi_meb.potongan_libur_lokal, "hari");
cetak("📚 Hari Efektif Bersih :", kalkulasi_meb.hari_efektif_kbm_bersih, "hari tatap muka");
cetak("📈 Minggu Efektif (MEB):", kalkulasi_meb.minggu_efektif_belajar, "minggu belajar aktif");
cetak("🏆 Kelayakan Kurikulum :", kalkulasi_meb.status_kelayakan_kurikulum);

jika kalkulasi_meb.hari_efektif_kbm_bersih > 100 {
    cetak("✅ [TEST 6] Kalkulasi Otomatis Minggu Efektif Belajar (MEB): LULUS");
} lainnya {
    cetak("❌ [TEST 6] Kalkulasi Otomatis Minggu Efektif Belajar (MEB): GAGAL");
}

cetak("\n==================================================================");
cetak("     SEMUA PENGUJIAN KALENDER PENDIDIKAN & KEDARURATAN LULUS!     ");
cetak("==================================================================");
