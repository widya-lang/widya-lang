// ==========================================================
// Modul Manajemen Kejuaraan, Kontingen, & Atlet Pencak Silat
// ArenaSilat.id - Platform Digital Pencak Silat Berdaulat
// ==========================================================

struktur AtletSilat {
    id_atlet,
    nama,
    perguruan,
    kontingen,
    kelas_berat,
    rekor_tanding,

    fungsi biodata() {
        kembalikan "Pesilat #" + ke_teks(ini.id_atlet) + " " + ini.nama + " [" + ini.perguruan + " - " + ini.kontingen + "] - " + ini.kelas_berat;
    }
}

struktur ManajemenKejuaraan {
    nama_event,
    lokasi,
    tahun,
    daftar_gelanggang,
    daftar_partai,

    fungsi tambah_partai(partai) {
        tambah(ini.daftar_partai, partai);
        cetak("➕ Partai baru berhasil ditambahkan: " + partai.id_partai + " di " + partai.gelanggang);
    }

    fungsi info_kejuaraan() {
        cetak("🇮🇩 Kejuaraan: " + ini.nama_event);
        cetak("📍 Lokasi: " + ini.lokasi + " (" + ke_teks(ini.tahun) + ")");
        cetak("🏟️ Gelanggang Tersedia: " + ke_teks(panjang(ini.daftar_gelanggang)));
        cetak("⚔️ Total Partai Terjadwal: " + ke_teks(panjang(ini.daftar_partai)));
    }
}
