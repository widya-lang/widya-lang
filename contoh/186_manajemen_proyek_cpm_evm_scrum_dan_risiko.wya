// ============================================================================
// CONTOH WIDYA-LANG 186: SISTEM MANAJEMEN PROYEK TERPADU (PMBOK & AGILE)
// WBS, Critical Path (CPM), Earned Value (EVM), Scrum Sprints & Risk Register
// ============================================================================

fungsi utama() {
    cetak("============================================================================");
    cetak("   EKOSISTEM MANAJEMEN PROYEK: WBS, CPM, EVM, AGILE SCRUM & RISIKO ISO     ");
    cetak("    Standar PMI PMBOK 7th, ISO 21500, ISO 21508 (EVM) & ISO 31000 (Risiko)  ");
    cetak("============================================================================");

    // ------------------------------------------------------------------------
    // [1] WBS & ANALISIS JALUR KRITIS (CRITICAL PATH METHOD / CPM)
    // ------------------------------------------------------------------------
    cetak("\n[1] PENJADWALAN & ANALISIS JALUR KRITIS (CRITICAL PATH METHOD):");
    misal nama_proyek = "Transformasi Infrastruktur Digital & Smart Learning Satdik";
    misal durasi_tugas_a = 5.0;  // Analisis & Desain
    misal durasi_tugas_b = 3.0;  // Pengadaan Server (Float/Slack: 3 Hari)
    misal durasi_tugas_c = 6.0;  // Pemrograman Software (Jalur Kritis)
    misal durasi_tugas_d = 4.0;  // UAT & Go-Live (Jalur Kritis)
    misal total_durasi_cpm = durasi_tugas_a + durasi_tugas_c + durasi_tugas_d; // 15 Hari

    cetak("    - Nama Proyek          : " + nama_proyek);
    cetak("    - Aktivitas A          : Analisis & Desain (Durasi: " + teks(durasi_tugas_a) + " Hari) [Jalur Kritis]");
    cetak("    - Aktivitas B          : Pengadaan Server Hardware (Durasi: " + teks(durasi_tugas_b) + " Hari | Float: 3.0 Hari)");
    cetak("    - Aktivitas C          : Pemrograman Software (Durasi: " + teks(durasi_tugas_c) + " Hari) [Jalur Kritis]");
    cetak("    - Aktivitas D          : Integrasi & Go-Live (Durasi: " + teks(durasi_tugas_d) + " Hari) [Jalur Kritis]");
    cetak("    - Total Durasi Proyek  : " + teks(total_durasi_cpm) + " Hari Kerja");
    cetak("    - Rantai Jalur Kritis  : A -> C -> D (Aktivitas tanpa toleransi keterlambatan)");

    // ------------------------------------------------------------------------
    // [2] ANALISIS NILAI HASIL (EARNED VALUE MANAGEMENT / EVM)
    // ------------------------------------------------------------------------
    cetak("\n[2] EVALUASI KINERJA BIAYA & JADWAL (EARNED VALUE MANAGEMENT - EVM):");
    misal bac_anggaran = 200000000.0; // Rp 200.000.000 (Budget at Completion)
    misal pv_rencana = 100000000.0;   // Rp 100.000.000 (Planned Value)
    misal ev_hasil = 110000000.0;     // Rp 110.000.000 (Earned Value)
    misal ac_aktual = 100000000.0;    // Rp 100.000.000 (Actual Cost)

    misal cv_cost_var = ev_hasil - ac_aktual;      // +10 Juta
    misal sv_sched_var = ev_hasil - pv_rencana;    // +10 Juta
    misal cpi = ev_hasil / ac_aktual;              // 1.10
    misal spi = ev_hasil / pv_rencana;             // 1.10
    misal eac_estimasi_akhir = bac_anggaran / cpi; // Rp 181.818.181

    cetak("    - Pagu Total (BAC)     : Rp " + teks(bac_anggaran));
    cetak("    - Planned Value (PV)   : Rp " + teks(pv_rencana));
    cetak("    - Earned Value (EV)    : Rp " + teks(ev_hasil));
    cetak("    - Actual Cost (AC)     : Rp " + teks(ac_aktual));
    cetak("    ---------------------------------------------------------");
    cetak("    - Cost Variance (CV)   : +Rp " + teks(cv_cost_var) + " [EFISIEN / HEMAT BIAYA]");
    cetak("    - Schedule Var (SV)    : +Rp " + teks(sv_sched_var) + " [LEBIH CEPAT DARI RENCANA]");
    cetak("    - Indeks Biaya (CPI)   : " + teks(cpi) + " (CPI > 1.0)");
    cetak("    - Indeks Jadwal (SPI)  : " + teks(spi) + " (SPI > 1.0)");
    cetak("    - Proyeksi Akhir (EAC) : Rp " + teks(eac_estimasi_akhir) + " (Hemat Rp " + teks(bac_anggaran - eac_estimasi_akhir) + ")");
    cetak("    - Status Kesehatan     : SANGAT BAIK (Under Budget & Ahead of Schedule)");

    // ------------------------------------------------------------------------
    // [3] AGILE SCRUM SPRINTS & BURNDOWN POINTS
    // ------------------------------------------------------------------------
    cetak("\n[3] AGILE SCRUM SPRINT & PELACAKAN BURNDOWN STORY POINTS:");
    misal nama_sprint = "Sprint 01: Modul Autentikasi SSO & Integrasi SIPLah";
    misal point_us1 = 5;  // User Story 1 (SSO OAuth2)
    misal point_us2 = 8;  // User Story 2 (RBAC Role Access)
    misal total_story_points = point_us1 + point_us2; // 13 Points
    misal points_done = 5; // US-1 Selesai
    misal sisa_burndown = total_story_points - points_done; // 8 Points

    cetak("    - Sprint Aktif         : " + nama_sprint);
    cetak("    - Komitmen Points      : " + teks(total_story_points) + " Story Points (Skala Fibonacci)");
    cetak("    - Story 1 (SSO OAuth2) : " + teks(point_us1) + " Points [SELESAI / DONE]");
    cetak("    - Story 2 (RBAC Role)  : " + teks(point_us2) + " Points [IN PROGRESS]");
    cetak("    - Sisa Burndown Points : " + teks(sisa_burndown) + " Points (Sesuai Tren Velocity)");

    // ------------------------------------------------------------------------
    // [4] MATRIKS MANAJEMEN RISIKO (ISO 31000 RISK REGISTER)
    // ------------------------------------------------------------------------
    cetak("\n[4] MANAJEMEN RISIKO PROYEK (MATRIKS 5X5 & DANA KONTINJENSI):");
    misal risiko_1 = "Keterlambatan Pasokan Server Impor";
    misal prob_1 = 4; // Tinggi
    misal imp_1 = 4;  // Tinggi
    misal skor_r1 = prob_1 * imp_1; // 16 (Ekstrem/Merah)
    misal cadangan_kontinjensi_1 = 15000000.0;

    misal risiko_2 = "Fluktuasi Sinyal Jaringan Seluler 5G";
    misal prob_2 = 2; // Rendah
    misal imp_2 = 3;  // Sedang
    misal skor_r2 = prob_2 * imp_2; // 6 (Sedang/Kuning)
    misal cadangan_kontinjensi_2 = 5000000.0;

    misal total_kontinjensi = cadangan_kontinjensi_1 + cadangan_kontinjensi_2;

    cetak("    1. Risiko ID: RSK-01   : " + risiko_1);
    cetak("       • Matriks (P x D)   : " + teks(prob_1) + " x " + teks(imp_1) + " = Skor " + teks(skor_r1) + " [LEVEL: EKSTREM]");
    cetak("       • Respon Strategi   : MITIGASI (Dual-Vendor & Pre-Order)");
    cetak("       • Cadangan Biaya    : Rp " + teks(cadangan_kontinjensi_1));
    cetak("    2. Risiko ID: RSK-02   : " + risiko_2);
    cetak("       • Matriks (P x D)   : " + teks(prob_2) + " x " + teks(imp_2) + " = Skor " + teks(skor_r2) + " [LEVEL: SEDANG]");
    cetak("       • Respon Strategi   : MITIGASI (Dual-WAN Failover)");
    cetak("       • Cadangan Biaya    : Rp " + teks(cadangan_kontinjensi_2));
    cetak("    ---------------------------------------------------------");
    cetak("    • Total Contingency Res: Rp " + teks(total_kontinjensi) + " (Alokasi Manajemen Risiko Terkendali)");

    cetak("\n============================================================================");
    cetak("     SELURUH PILAR MANAJEMEN PROYEK TERPADU BERHASIL DIIMPLEMENTASIKAN!     ");
    cetak("============================================================================");
}

utama();
