                    "epoch_id": { "type": "number" }
                },
                "required": ["tipe_pemulihan", "simpul_sumber"]
            }
        });

        kembalikan ke_json({
            "jsonrpc": "2.0",
            "id": id_req,
            "result": { "tools": tools_list }
        });
    }

    // 3. Method: tools/call
    jika (method == "tools/call") {
        misal tool_name = params["name"];
        misal args = params["arguments"];
        misal hasil_konten = "";

        jika (tool_name == "penelusuran_web") {
            misal res = eksekusi_skill_dinamis(manajer_skill, "skill_pencari_web", { "kueri": args["kueri"] });
            hasil_konten = res["tampilan"];
        } lainnya {
            jika (tool_name == "hitung_jarak_haversine") {
                misal res = eksekusi_skill_haversine(args["lat1"], args["lon1"], args["lat2"], args["lon2"]);
                hasil_konten = res["tampilan"];
            } lainnya {
                jika (tool_name == "hitung_kurs_valas") {
                    misal res = eksekusi_skill_kurs_finansial(args["jumlah"], args["dari_valas"], args["ke_valas"]);
                    hasil_konten = res["tampilan"];
                } lainnya {
                    jika (tool_name == "kueri_semantik_desa") {
                        misal top = 2;
                        jika (ada_kunci(args, "top_k")) { top = args["top_k"]; }
                        misal res = ai_kueri_semantik_vektor(indeks_vektor, args["kueri_teks"], top);
                        misal txt = "Hasil Kueri Semantik Vektor RAG:\n";
                        untuk d di res.daftar_dokumen {
                            txt = txt + "  * " + d["judul"] + " (Skor: " + ke_teks(d["skor_kemiripan"]) + ")\n    " + d["isi"] + "\n";
                        }
                        hasil_konten = txt;
                    } lainnya {
                        jika (tool_name == "kueri_hnsw_desa") {
                            misal k_val = 2;
                            jika (ada_kunci(args, "k")) { k_val = args["k"]; }
                            misal g_hnsw = bangun_graf_hnsw_desa();
                            misal res_hnsw = kueri_hnsw_semantik(g_hnsw, args["kueri"], 16, k_val);
                            misal txt_h = "Hasil Penelusuran HNSW Multi-Layer O(log N):\n";
                            untuk d in res_hnsw.daftar_hasil {
                                txt_h = txt_h + "  * " + d["nama_desa"] + " - Skor: " + ke_teks(d["skor_kemiripan"]) + "\n";
                            }
                            hasil_konten = txt_h;
                        } lainnya {
                            jika (tool_name == "jalankan_swarm_konsensus") {
                                misal g_h = bangun_graf_hnsw_desa();
                                misal res_sw = ai_jalankan_swarm_orkestrasi(args["instruksi"], g_h);
                                hasil_konten = "[Swarm Consensus]: Konsensus 4/4 tercapai (" + res_sw.status_eksekusi + ").\n" +
                                               "Kode disintesis bebas taint & teruji sandbox 100% PASS.";
                            } lainnya {
                                jika (tool_name == "inferensi_slm_npu") {
                                    misal tok = inisialisasi_tokenizer_bpe();
                                    misal prof = bangun_profil_hardware_npu();
                                    misal n_tok = 16;
                                    jika (ada_kunci(args, "maks_token")) { n_tok = args["maks_token"]; }
                                    misal res_npu = ai_inferensi_slm_npu(args["prompt"], tok, prof, n_tok);
                                    hasil_konten = "[NPU 16 TOPS Inference]:\n" + res_npu.teks_dihasilkan + "\n(Latensi: " + ke_teks(res_npu.latensi_per_token_ms) + " ms, Throughput: " + ke_teks(res_npu.throughput_tps) + " tok/s)";
                                } lainnya {
                                    jika (tool_name == "verifikasi_ed25519_vc") {
                                        misal p_hex = args["public_key_hex"];
                                        misal s_hex = args["signature_hex"];
                                        misal sah = ai_verifikasi_tanda_tangan_ed25519("did:widya:ai:sovereign:widya_sovereign_rsi_01", s_hex, p_hex);
                                        jika (sah) {
                                            hasil_konten = "[Ed25519 RFC 8032]: Tanda tangan digital TERVERIFIKASI SAH. W3C DID Credential valid.";
                                        } lainnya {
                                            hasil_konten = "[Ed25519 RFC 8032]: Tanda tangan digital TIDAK VALID!";
                                        }
                                    } lainnya {
                                        jika (tool_name == "cek_ketahanan_sistem") {
                                            misal komp = "semua";
                                            jika (ada_kunci(args, "komponen")) { komp = args["komponen"]; }
                                            misal cb = inisialisasi_pemutus_arus("rag_vektor_desa", 3, 5, "Fallback lokal.");
                                            misal sup = inisialisasi_penyelia("penyelia_core_widya", "SATU_UNTUK_SATU", 5);
                                            penyelia_daftarkan_pekerja(sup, "pekerja_slm_npu", "SLM NPU Engine");
                                            misal prs = inisialisasi_perisai_dos("perisai_gateway", 20, 5);
                                            misal stat_sup = penyelia_cek_kesehatan_semua(sup);
                                            misal stat_prs = perisai_dapatkan_statistik(prs);

                                            hasil_konten = "[Ketahanan Sistem Widya]:\n" +
                                                           "  - Circuit Breaker: " + cb.status + " (Ambang: " + ke_teks(cb.ambang_kegagalan) + ")\n" +
                                                           "  - Supervisor Tree: " + ke_teks(stat_sup.pekerja_aktif) + "/" + ke_teks(stat_sup.total_pekerja) + " pekerja aktif\n" +
                                                           "  - Perisai DoS: " + prs.nama_perisai + " (Kapasitas: " + ke_teks(prs.kapasitas_default) + " rps)";
                                        } lainnya {
                                            jika (tool_name == "sinkronisasi_mesh_desa") {
                                                misal target = "node-kedungbanteng-01";
                                                misal j_muatan = "SKILL_BARU";
                                                jika (ada_kunci(args, "target_desa")) { target = args["target_desa"]; }
                                                jika (ada_kunci(args, "jenis_muatan")) { j_muatan = args["jenis_muatan"]; }
                                                misal kp = bangun_pasangan_kunci_ed25519("BENIH_IKN_MESH", "did:widya:ai:node:ikn01");
                                                misal s_lokal = SimpulMesh("node-ikn-01", "IKN Sepaku", "127.0.0.1", 8088, "did:widya:ai:node:ikn01", kp.kunci_publik_hex, "TERHUBUNG", waktu(), "v1.1.0", "merkle_ikn");
                                                misal m_desa = inisialisasi_mesh_kedaulatan("mesh-nusantara", s_lokal);
                                                misal s_target = SimpulMesh(target, "Desa Target", "192.168.1.102", 8088, "did:widya:ai:node:" + target, sha256("PUB_" + target), "TERHUBUNG", waktu(), "v1.1.0", "merkle_" + target);
                                                mesh_tambah_rekan(m_desa, s_target);
                                                misal msg_sync = mesh_buat_pesan_sinkronisasi(m_desa, j_muatan, { "topik": "kedaulatan_pangan_desa", "status": "VALID" }, kp);
                                                misal res_sync = mesh_terima_pesan_sinkronisasi(m_desa, msg_sync, manajer_skill, indeks_vektor);

                                                hasil_konten = "[P2P Sovereign Mesh]: Sinkronisasi ke " + target + " (" + j_muatan + "):\n" +
                                                               "Status: " + res_sync["status"] + " (ID: " + res_sync["id_pesan"] + ")\n" +
                                                               "Verifikasi Ed25519: SAH (Zero Cloud Dependency)";
                                            } lainnya {
                                                jika (tool_name == "analisis_citra_desa") {
                                                    misal id_c = "citra-mcp-01";
                                                    misal jenis = "PERTANIAN_PADI";
                                                    jika (ada_kunci(args, "id_citra")) { id_c = args["id_citra"]; }
                                                    jika (ada_kunci(args, "jenis_analisis")) { jenis = args["jenis_analisis"]; }
                                                    misal raw = [180.0, 220.0, 240.0, 210.0, 195.0, 180.0, 160.0, 150.0];
                                                    misal res_c = ai_analisis_citra_desa(id_c, "MCP Visual Camera", raw, jenis);
                                                    hasil_konten = "[Radeon 780M Vision]: " + res_c.label_deteksi + " (Keyakinan: " + ke_teks(res_c.skor_keyakinan) + ")\n" +
                                                                   "Rekomendasi: " + res_c.rekomendasi_tindakan;
                                                } lainnya {
                                                    jika (tool_name == "eksekusi_tujuan_otonom") {
                                                        misal target_tujuan = "Optimasi ketahanan pangan desa";
                                                        jika (ada_kunci(args, "tujuan")) { target_tujuan = args["tujuan"]; }
                                                        misal g_hnsw = bangun_graf_hnsw_desa();
                                                        misal rencana = ai_dekomposisi_tujuan_strategis(target_tujuan);
                                                        ai_eksekusi_siklus_tujuan(rencana, manajer_skill, indeks_vektor, g_hnsw);
                                                        misal ev = ai_evaluasi_kemajuan_tujuan(rencana);
                                                        hasil_konten = "[Autonomous Goal Engine]: Status " + ev.status + " (" + ke_teks(ev.persentase_selesai) + "% Selesai)\n" +
                                                                       "Total Subtujuan: " + ke_teks(ev.subtujuan_selesai) + "/" + ke_teks(ev.total_subtujuan) + " selesai dalam DAG.";
                                                    } lainnya {
                                                        jika (tool_name == "inspeksi_widya_lang") {
                                                            misal p_proyek = "c:/widya-lang";
                                                            jika (ada_kunci(args, "path_proyek")) { p_proyek = args["path_proyek"]; }
                                                            misal rep = ai_inspeksi_bahasa_widya(p_proyek);
                                                            hasil_konten = "[Meta-Kompiler Widya-Lang]:\n" +
                                                                           "  - Status Kompiler : " + rep.status_kompiler + "\n" +
                                                                           "  - Kata Kunci Resmi: " + ke_teks(rep.total_kata_kunci) + " kata kunci\n" +
                                                                           "  - Modul Stdlib    : " + ke_teks(rep.total_modul_stdlib) + " modul (modul/*.wya)\n" +
                                                                           "  - Self-Hosted AST : Fungsional (compiler_self_hosted/)\n" +
                                                                           "  - Peluang Evolusi : " + ke_teks(panjang(rep.peluang_pengembangan)) + " peluang teridentifikasi";
                                                        } lainnya {
                                                            jika (tool_name == "kembangkan_widya_lang") {
                                                                misal n_mod = "kripto_post_quantum_kyber";
                                                                misal spes = "Kyber-768 ML-KEM PQC";
                                                                jika (ada_kunci(args, "nama_modul")) { n_mod = args["nama_modul"]; }
                                                                jika (ada_kunci(args, "spesifikasi")) { spes = args["spesifikasi"]; }
                                                                misal sin = ai_kembangkan_modul_widya(n_mod, spes);
                                                                hasil_konten = "[Sintesis Modul Widya]:\n" +
                                                                               "  - Modul    : " + sin.nama_modul + ".wya (" + sin.versi + ")\n" +
                                                                               "  - Kategori : " + sin.kategori + "\n" +
                                                                               "  - Uji      : " + sin.status_uji + "\n" +
                                                                               "  - Kompilasi: " + sin.hasil_kompilasi;
                                                            } lainnya {
                                                                jika (tool_name == "eksekusi_tensor_analitika") {
                                                                    misal t_a = tensor_buat([1.0, 2.0, 3.0, 4.0], [2, 2]);
                                                                    misal t_b = tensor_buat([5.0, 6.0, 7.0, 8.0], [2, 2]);
                                                                    misal t_res = tensor_matmul(t_a, t_b);
                                                                    hasil_konten = "[Widya-NumPy & Pandas Engine]:\n" +
                                                                                   "  - Matmul Result: " + tensor_ke_teks(t_res) + "\n" +
                                                                                   "  - Reduksi Mean : " + ke_teks(tensor_mean(t_res)) + "\n" +
                                                                                   "  - Reduksi Std  : " + ke_teks(tensor_std(t_res)) + "\n" +
                                                                                   "  - Status       : SUKSES (NumPy/Pandas Level)";
                                                                } lainnya {
                                                                    jika (tool_name == "manajer_paket_wpm") {
                                                                        misal repo_mcp = wpm_inisialisasi_repositori();
                                                                        misal cmd = "audit";
                                                                        jika (ada_kunci(args, "perintah")) { cmd = args["perintah"]; }
                                                                        jika (cmd == "audit") {
                                                                            misal aud = wpm_audit_keamanan(repo_mcp);
                                                                            hasil_konten = "[WPM Package Manager]: Status " + aud["status_audit"] + " (Skor: " + ke_teks(aud["skor_keamanan"]) + "/100)\n" +
                                                                                           "Total Paket Terverifikasi: " + ke_teks(aud["total_valid"]) + "/" + ke_teks(aud["total_paket"]);
                                                                        } lainnya {
                                                                            misal p_name = "widya-numpy";
                                                                            jika (ada_kunci(args, "nama_paket")) { p_name = args["nama_paket"]; }
                                                                            misal pas = wpm_pasang_paket(repo_mcp, p_name, "1.0.0");
                                                                            hasil_konten = "[WPM Install]: " + pas["pesan"] + " (Dipasang: " + ke_teks(pas["total_dipasang"]) + " paket)";
                                                                        }
                                                                    } lainnya {
                                                                        jika (tool_name == "evaluasi_proyek_widya") {
                                                                            misal p_nama = "proyek_utama";
                                                                            jika (ada_kunci(args, "nama_proyek")) { p_nama = args["nama_proyek"]; }
                                                                            misal p_kode = "// Titik masuk utama\nfungsi utama() { kembalikan benar; }\n";
                                                                            jika (ada_kunci(args, "kode_sumber")) { p_kode = args["kode_sumber"]; }

                                                                            misal lap = evaluasi_proyek_analisis_kode(p_nama, { "utama.wya": p_kode });
                                                                            hasil_konten = "[Evaluasi Proyek Widya-Lang]: Status " + lap.status_kelayakan + " (Skor: " + ke_teks(lap.skor_kesehatan) + "/100)\n" +
                                                                                           "  - Kepatuhan UU PDP: " + ke_teks(lap.skor_kepatuhan_pdp) + "/100\n" +
                                                                                           "  - Keandalan Kode  : " + ke_teks(lap.skor_keandalan) + "/100\n" +
                                                                                           "  - Total Baris (LOC): " + ke_teks(lap.metrik_kode.total_baris_kode) + "\n" +
                                                                                           "  - Status Telemetri : " + ke_teks(lap.status_telemetri);
                                                                        } lainnya {
                                                                            jika (tool_name == "telemetri_proyek_widya") {
                                                                                misal act = "status";
                                                                                jika (ada_kunci(args, "aksi")) { act = args["aksi"]; }
                                                                                misal prj = "fintech_desa";
                                                                                jika (ada_kunci(args, "id_proyek")) { prj = args["id_proyek"]; }

                                                                                misal kl = telemetri_buat_klien(prj, "1.0.0", "");
                                                                                telemetri_catat_metrik(kl, "detak_jantung", 1.0, "status", "heartbeat");
                                                                                misal res_k = telemetri_kirim_paket(kl, "");

                                                                                hasil_konten = "[Telemetri Berdaulat UU PDP]: " + res_k["status"] + "\n" +
                                                                                               "  - Proyek       : " + prj + "\n" +
                                                                                               "  - Checksum     : " + res_k["checksum_sha256"] + "\n" +
                                                                                               "  - Kepatuhan    : UU PDP No. 27/2022 Terpenuhi (Zero Leakage)";
                                                                            } lainnya {
                                                                                jika (tool_name == "remediasi_kode_otonom") {
                                                                                    misal p_nm = "proyek_target";
                                                                                    jika (ada_kunci(args, "nama_proyek")) { p_nm = args["nama_proyek"]; }
                                                                                    misal p_kd = "fungsi tes() {\n    misal a = 1;\n";
                                                                                    jika (ada_kunci(args, "kode_sumber")) { p_kd = args["kode_sumber"]; }

                                                                                    misal res_rem = remediasi_otomatis_kode_proyek(p_nm, p_kd);
                                                                                    hasil_konten = "[Auto-Fix Agent Remediasi Mandiri]:\n" +
                                                                                                   "  - Proyek           : " + p_nm + "\n" +
                                                                                                   "  - Status           : " + res_rem.status_remediasi + "\n" +
                                                                                                   "  - Skor Kesehatan   : " + ke_teks(res_rem.skor_sebelum) + " -> " + ke_teks(res_rem.skor_sesudah) + "/100\n" +
                                                                                                   "  - Total Perbaikan  : " + ke_teks(res_rem.total_perbaikan) + " tindakan";
                                                                                } lainnya {
                                                                                    jika (tool_name == "orkestrasi_fleet_desa") {
                                                                                        misal arm = fleet_inisialisasi_armada();
                                                                                        misal cmd_f = "status_fleet";
                                                                                        jika (ada_kunci(args, "perintah")) { cmd_f = args["perintah"]; }

                                                                                        jika (cmd_f == "pemilihan_pemimpin") {
                                                                                            misal c_id = "simpul_kedungbanteng";
                                                                                            jika (ada_kunci(args, "kandidat_id")) { c_id = args["kandidat_id"]; }
                                                                                            misal res_l = fleet_pemilihan_pemimpin(arm, c_id);
                                                                                            hasil_konten = "[Raft-Style Consensus]: Pemimpin armada beralih ke " + res_l["pemimpin_baru"] + " (" + res_l["kuorum"] + ")";
                                                                                        } lainnya {
                                                                                            jika (cmd_f == "rolling_deploy") {
                                                                                                misal v_t = "v2.1.0";
                                                                                                jika (ada_kunci(args, "versi_target")) { v_t = args["versi_target"]; }
                                                                                                misal res_d = fleet_rolling_deploy(arm, v_t, "hash-release-01");
                                                                                                hasil_konten = "[Rolling Deployment]: " + res_d.status + " (" + ke_teks(res_d.simpul_berhasil) + "/" + ke_teks(res_d.total_simpul) + " simpul terperbarui tanpa downtime)";
                                                                                            } lainnya {
                                                                                                misal res_h = fleet_cek_kesehatan(arm);
                                                                                                hasil_konten = "[Orkestrasi Armada Edge Desa]:\n" +
                                                                                                               "  - ID Armada        : " + res_h["id_armada"] + "\n" +
                                                                                                               "  - Pemimpin Aktif   : " + res_h["pemimpin_aktif"] + "\n" +
                                                                                                               "  - Status Simpul    : " + ke_teks(res_h["total_sehat"]) + "/" + ke_teks(res_h["total_simpul"]) + " Sehat (100%)\n" +
                                                                                                               "  - Status Konsensus : " + res_h["status_konsensus"];
                                                                                            }
                                                                                        }
                                                                                    } lainnya {
                                                                                        jika (tool_name == "event_broker_widya") {
                                                                                            misal act_b = "status_metrik";
                                                                                            jika (ada_kunci(args, "aksi")) { act_b = args["aksi"]; }
                                                                                            misal tpk_b = "desa.pertanian.sensor";
                                                                                            jika (ada_kunci(args, "topik")) { tpk_b = args["topik"]; }

                                                                                            misal top_obj = broker_buat_topik(tpk_b, 4);
                                                                                            misal cg_obj = broker_buat_consumer_group("cg_mcp_client", tpk_b);

                                                                                            jika (act_b == "publish") {
                                                                                                misal k_p = "kunci_mcp_01";
                                                                                                jika (ada_kunci(args, "kunci")) { k_p = args["kunci"]; }
                                                                                                misal py_b = { "asal": "mcp_tool", "status": "aktif" };
                                                                                                jika (ada_kunci(args, "payload")) { py_b = args["payload"]; }
                                                                                                misal res_pb = broker_publish(top_obj, k_p, py_b, "kunci_mcp_secret");
                                                                                                hasil_konten = "[Widya-Broker Publish]: Pesan berhasil dikomit ke " + tpk_b + " (Partisi: " + ke_teks(res_pb.partisi) + ", Offset: " + ke_teks(res_pb.offset) + ", HMAC: " + res_pb.tanda_tangan + ")";
                                                                                            } lainnya jika (act_b == "consume") {
                                                                                                broker_publish(top_obj, "kunci_awal", { "init": benar }, "secret");
                                                                                                misal msgs_b = broker_poll(cg_obj, top_obj, 5);
                                                                                                hasil_konten = "[Widya-Broker Consume]: " + ke_teks(panjang(msgs_b)) + " pesan berhasil diambil dari " + tpk_b;
                                                                                            } lainnya {
                                                                                                broker_publish(top_obj, "k1", { "val": 1 }, "secret");
                                                                                                misal st_b = broker_status_metrik(top_obj, cg_obj);
                                                                                                hasil_konten = "[Widya-Broker Metrik]:\n" +
                                                                                                               "  - Topik           : " + st_b["topik"] + "\n" +
                                                                                                               "  - Total Pesan     : " + ke_teks(st_b["total_pesan"]) + "\n" +
                                                                                                               "  - Consumer Group  : " + st_b["group_id"] + "\n" +
                                                                                                               "  - Lag Total       : " + ke_teks(st_b["lag_total"]) + "\n" +
                                                                                                               "  - Status          : " + st_b["status_kesehatan"];
                                                                                            }
                                                                                        } lainnya jika (tool_name == "pemrosesan_aliran_reaktif") {
                                                                                            misal act_s = "status_cep";
                                                                                            jika (ada_kunci(args, "aksi")) { act_s = args["aksi"]; }
                                                                                            misal m_cep = cep_buat_mesin();
                                                                                            cep_tambah_aturan(m_cep, {
                                                                                                "id_aturan": "RULE_MCP_01",
                                                                                                "nama_aturan": "Deteksi Lonjakan Aliran MCP",
                                                                                                "topik_target": "desa.pertanian.sensor",
                                                                                                "kondisi_kunci": "suhu_c",
                                                                                                "operator": ">",
                                                                                                "nilai_ambang": 35.0,
                                                                                                "tindakan_otonom": "NOTIFIKASI_OPERATOR",
                                                                                                "tingkat_kritis": "PERINGATAN"
                                                                                            });

                                                                                            jika (act_s == "evaluasi_stream") {
                                                                                                misal mock_events = [
                                                                                                    { "topik": "desa.pertanian.sensor", "payload": { "suhu_c": 38.5 }, "kunci": "k1", "offset": 0 },
                                                                                                    { "topik": "desa.pertanian.sensor", "payload": { "suhu_c": 26.0 }, "kunci": "k2", "offset": 1 }
                                                                                                ];
                                                                                                jika (ada_kunci(args, "daftar_event")) { mock_events = args["daftar_event"]; }
                                                                                                misal res_cep = cep_proses_stream(m_cep, mock_events);
                                                                                                hasil_konten = "[Mesin CEP Reaktif]: " + ke_teks(res_cep["event_diproses"]) + " event diproses, " + ke_teks(res_cep["peringatan_dihasilkan"]) + " anomali terdeteksi.";
                                                                                            } lainnya {
