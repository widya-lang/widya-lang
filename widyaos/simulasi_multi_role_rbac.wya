// ============================================================================
// SIMULASI SUITE: TATA KELOLA SATU AKUN BANYAK PERAN (MULTI-ROLE RBAC)
// Menguji 4 Skenario Nyata di Satuan Pendidikan:
// 1. Akun Guru Tunggal yang Memiliki 3 Peran (Guru Matematika, Bendahara BOS, Wali Murid)
// 2. Fast Context Switch 1-Klik dari Konteks Guru ke Bendahara BOS
// 3. Penegakan Pemisahan Hak Akses (Segregation of Duties) Mencegah Bocor Otoritas
// 4. Beralih ke Konteks Wali Murid untuk Memantau Rapor & Membayar SPP Anak Kandung
// ============================================================================

impor "widyaos/modul/multi_role_sso_rbac.wya";

cetak("====================================================================");
cetak("👤  SIMULASI: TATA KELOLA SATU AKUN BANYAK PERAN (MULTI-ROLE SSO)    ");
cetak("====================================================================");

// [1] Inisialisasi Akun Tunggal dengan Peran Awal (Guru Matematika)
cetak("\n[1] Uji Pembuatan Akun Tunggal (Single Identity) Ibu Anita:");
misal peran_guru = PeranOtoritas(
    "ROL-01",
    "GURU_MAPEL",
    "Guru Matematika Kelas 8 & 9",
    "20512345",
    "SMP Negeri 1 Surabaya",
    "AKSES_KBM_LMS"
);

misal akun_anita = buat_akun_multi_peran(
    "did:sewidya:guru:198805122019032014",
    "anita.kusuma@sewidya.id",
    "Anita Kusuma, S.Pd.",
    "3578015205880003",
    "1234567890123456",
    peran_guru
);

// Menambahkan Peran Ke-2: Bendahara BOS Sekolah
misal peran_bendahara = PeranOtoritas(
    "ROL-02",
    "BENDAHARA_BOS",
    "Bendahara Pengeluaran BOSP",
    "20512345",
    "SMP Negeri 1 Surabaya",
    "AKSES_BKU_ARKAS"
);
tambah_peran_ke_akun(akun_anita, peran_bendahara);

// Menambahkan Peran Ke-3: Wali Murid (Anaknya bersekolah di sekolah yang sama)
misal peran_ortu = PeranOtoritas(
    "ROL-03",
    "WALI_MURID",
    "Orang Tua Siswa (Dimas Kelas 7B)",
    "20512345",
    "SMP Negeri 1 Surabaya",
    "AKSES_TAGIHAN_ANAK"
);
tambah_peran_ke_akun(akun_anita, peran_ortu);

cetak("  • Nama Pemilik Akun  :", akun_anita.nama_lengkap);
cetak("  • Email SSO Tunggal  :", akun_anita.email_sso);
cetak("  • Total Peran Terdaftar:", panjang(akun_anita.daftar_peran), "Peran Sekaligus");
cetak("  • Peran Aktif Awal   :", akun_anita.peran_aktif_saat_ini);

jika panjang(akun_anita.daftar_peran) == 3 dan akun_anita.peran_aktif_saat_ini == "GURU_MAPEL" {
    cetak("  ✅ PASS: Satu Akun Berhasil Memayungi 3 Peran Berbeda Tanpa Duplikasi Email/Password!");
} lainnya {
    cetak("  ❌ FAIL: Inisialisasi multi-peran gagal!");
}

// [2] Uji Validasi Hak Akses Saat Masih di Konteks Guru (Segregation of Duties)
cetak("\n[2] Uji Pencegahan Kebocoran Otoritas Saat Berada di Konteks GURU_MAPEL:");
// Mencoba approve SPJ BKU ARKAS saat peran aktif masih GURU_MAPEL
misal cek_izin_bku = validasi_otoritas_tindakan(akun_anita, "APPROVE_SPJ_BKU");
cetak("  • Permintaan Aksi    : APPROVE_SPJ_BKU");
cetak("  • Status Izin        :", cek_izin_bku.status_izin);
cetak("  • Respon Sistem      :", cek_izin_bku.pesan_keamanan);

jika cek_izin_bku.status_izin == "DITOLAK_HAK_AKSES_TIDAK_SESUAI" {
    cetak("  ✅ PASS: Otoritas BKU Terkunci! Menolak Tindakan Keuangan Jika Konteks Peran Masih Guru.");
} lainnya {
    cetak("  ❌ FAIL: Proteksi wewenang gagal!");
}

// [3] Fast Context Switching ke Konteks BENDAHARA_BOS (1-Klik Tanpa Logout)
cetak("\n[3] Uji Beralih Konteks ke Peran BENDAHARA_BOS (Fast Role Switcher):");
misal switch_bku = beralih_konteks_peran(
    akun_anita,
    "BENDAHARA_BOS",
    "20512345"
);

cetak("  • Peran Sebelumnya   :", switch_bku.peran_lama);
cetak("  • Peran Aktif Baru   :", switch_bku.peran_baru);
cetak("  • Hak Akses Terbuka  :", switch_bku.hak_akses_sekarang);
cetak("  • Status Keamanan    :", switch_bku.catatan_audit_keamanan);

// Cek ulang izin approve BKU setelah switch peran
misal cek_izin_bku_lagi = validasi_otoritas_tindakan(akun_anita, "APPROVE_SPJ_BKU");
cetak("  • Izin BKU Pasca-Switch:", cek_izin_bku_lagi.status_izin, "(", cek_izin_bku_lagi.pesan_keamanan, ")");

jika switch_bku.peran_baru == "BENDAHARA_BOS" dan cek_izin_bku_lagi.status_izin == "DIIZINKAN_SESUAI_PERAN_AKTIF" {
    cetak("  ✅ PASS: Beralih Konteks Berhasil Seketika! Dashboard ARKAS Terbuka Tanpa Logout.");
} lainnya {
    cetak("  ❌ FAIL: Switch role bendahara gagal!");
}

// [4] Beralih Konteks ke Peran WALI_MURID (Melihat Tagihan & Pembayaran SPP Anak)
cetak("\n[4] Uji Beralih Konteks ke Peran WALI_MURID (Akses Data Anak Kandung):");
misal switch_ortu = beralih_konteks_peran(
    akun_anita,
    "WALI_MURID",
    "20512345"
);

misal cek_spp = validasi_otoritas_tindakan(akun_anita, "BAYAR_SPP_ANAK");
cetak("  • Peran Aktif Baru   :", switch_ortu.peran_baru);
cetak("  • Akses Tagihan Anak :", cek_spp.status_izin, "(", cek_spp.pesan_keamanan, ")");

jika switch_ortu.peran_baru == "WALI_MURID" dan cek_spp.status_izin == "DIIZINKAN_SESUAI_PERAN_AKTIF" {
    cetak("  ✅ PASS: Ibu Anita Dapat Memantau Rapor & Membayar SPP Anaknya Sendiri dengan Aman!");
} lainnya {
    cetak("  ❌ FAIL: Switch role wali murid gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 4/4 KASUS SATU AKUN MULTI-ROLE LULUS (100%)      ");
cetak("====================================================================");
