        jika (ada_kunci(b, "subjek_did")) { subjek = b["subjek_did"]; }
        jika (ada_kunci(b, "atribut_diungkap")) { atribut_diungkap = b["atribut_diungkap"]; }
        jika (ada_kunci(b, "nonce")) { nonce = b["nonce"]; }

        misal vc = id_terbitkan_kredensial(id_kred, "KTP_DIGITAL_DESA", "did:widya:desa:sepaku_resmi", subjek, { "status_warga": "TETAP", "zona_desa": "Sepaku_Hilir", "nik_rahasia": "6401019901010001" }, 31536000);
        misal vp = id_buat_presentasi_selektif_zk(vc, atribut_diungkap, nonce, salt);
        misal verif = id_verifikasi_presentasi_zk(vp, vc, "pubkey_subjek_mock");

        kembalikan {
