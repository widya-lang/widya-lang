// ============================================================================
// SKILL: PENCARI WEB & PENELUSURAN FAKTA (skill_pencari_web.wya)
// Kemampuan Menelusuri Informasi Terkini di Internet Secara Aman
// ============================================================================

impor "widya_ai_local/modul_evolusi/akses_internet.wya";

fungsi info_skill_pencari_web() {
    kembalikan {
        "id_skill": "skill_pencari_web",
        "nama": "Penelusuran Web & Fakta Online",
        "deskripsi": "Mencari informasi, artikel, dan fakta dari web menggunakan open search API.",
        "versi": "v1.0.0",
        "pemicu": ["cari di web", "cari web", "browsing", "internet", "google", "telusuri web", "berita tentang", "fakta tentang"],
        "status": "AKTIF",
        "sumber": "BAWAAN_LOKAL"
    };
}

fungsi eksekusi_skill_pencari_web(kueri) {
    misal hasil_pencarian = ai_cari_web(kueri, 3);
    misal ringkasan_teks = "";

    ringkasan_teks = ringkasan_teks + "Hasil Penelusuran Web untuk: '" + kueri + "' (Sumber: " + hasil_pencarian.sumber + "):\n";
    misal idx = 1;
    untuk h di hasil_pencarian.daftar_hasil {
        ringkasan_teks = ringkasan_teks + "  " + ke_teks(idx) + ". " + h["judul"] + "\n";
        jika (h["ringkasan"] != "" dan h["ringkasan"] != kosong) {
            ringkasan_teks = ringkasan_teks + "     " + h["ringkasan"] + "\n";
        }
        ringkasan_teks = ringkasan_teks + "     Tautan: " + h["tautan"] + "\n";
        idx = idx + 1;
    }

    kembalikan {
        "sukses": benar,
        "kueri": kueri,
        "total_hasil": hasil_pencarian.total_hasil,
        "tampilan": ringkasan_teks
    };
}
