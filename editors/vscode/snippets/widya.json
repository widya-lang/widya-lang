{
  "Function Definition": {
    "prefix": "fungsi",
    "body": [
      "fungsi ${1:nama_fungsi}(${2:parameter}) {",
      "\t${0:// logika}",
      "\tkembalikan ${3:hasil};",
      "}"
    ],
    "description": "Mendefinisikan fungsi baru dalam bahasa Widya"
  },
  "English Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:function_name}(${2:params}) {",
      "\t${0:// logic}",
      "\treturn ${3:result};",
      "}"
    ],
    "description": "Define a new function (ANSI / English)"
  },
  "Variable Let / Misal": {
    "prefix": "misal",
    "body": [
      "misal ${1:nama_variabel} = ${2:nilai};"
    ],
    "description": "Deklarasi variabel baru (misal)"
  },
  "Variable Mutabel": {
    "prefix": "mutabel",
    "body": [
      "misal mutabel ${1:nama_variabel} = ${2:nilai};"
    ],
    "description": "Deklarasi variabel yang dapat dimutasi (mutabel)"
  },
  "If Condition": {
    "prefix": "jika",
    "body": [
      "jika (${1:kondisi}) {",
      "\t${0}",
      "}"
    ],
    "description": "Pernyataan kondisional jika"
  },
  "If Else Condition": {
    "prefix": "jikala",
    "body": [
      "jika (${1:kondisi}) {",
      "\t${2}",
      "} lainnya {",
      "\t${0}",
      "}"
    ],
    "description": "Pernyataan kondisional jika...lainnya"
  },
  "For Loop": {
    "prefix": "untuk",
    "body": [
      "untuk (${1:item} dalam ${2:koleksi}) {",
      "\t${0:cetak(item);}",
      "}"
    ],
    "description": "Perulangan untuk...dalam"
  },
  "While Loop": {
    "prefix": "selama",
    "body": [
      "selama (${1:kondisi}) {",
      "\t${0}",
      "}"
    ],
    "description": "Perulangan selama (while)"
  },
  "Print Output": {
    "prefix": "cetak",
    "body": [
      "cetak(${1:\"Teks output\"});"
    ],
    "description": "Mencetak keluaran ke konsol terminal"
  },
  "WPM Gunakan Paket": {
    "prefix": "gunakan",
    "body": [
      "gunakan \"${1:nama_paket}\";",
      "${0}"
    ],
    "description": "Impor paket dependensi ekosistem WPM"
  },
  "WPM Import": {
    "prefix": "impor",
    "body": [
      "impor \"${1:./modul.wya}\";",
      "${0}"
    ],
    "description": "Impor berkas sumber Widya lokal"
  },
  "Modul Ekspor": {
    "prefix": "modul",
    "body": [
      "modul ${1:NamaModul} {",
      "\tekspor fungsi ${2:operasi}() {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Deklarasi namespace modul dengan fungsi ekspor"
  },
  "Struktur Data": {
    "prefix": "struktur",
    "body": [
      "struktur ${1:NamaStruktur} {",
      "\t${2:bidang}: ${3:Teks},",
      "\t${0}",
      "}"
    ],
    "description": "Definisi tipe data struktur baru"
  },
  "Pilihan Enum": {
    "prefix": "pilihan",
    "body": [
      "pilihan ${1:Status} {",
      "\t${2:Aktif},",
      "\t${3:Nonaktif},",
      "\t${0}",
      "}"
    ],
    "description": "Definisi tipe data enum / pilihan"
  },
  "Pencocokan Pola (Match)": {
    "prefix": "cocokkan",
    "body": [
      "cocokkan (${1:nilai}) {",
      "\t${2:kasus_1} => ${3:hasil_1},",
      "\tlainnya => ${0:default_hasil},",
      "}"
    ],
    "description": "Ekspresi pencocokan pola (pattern matching)"
  },
  "Coba Tangkap Galat": {
    "prefix": "coba",
    "body": [
      "coba {",
      "\t${1:// operasi berisiko}",
      "} tangkap (${2:galat}) {",
      "\tcetak(\"Terjadi kesalahan: \" + ${2:galat});",
      "\t${0}",
      "}"
    ],
    "description": "Blok penanganan eksepsi coba...tangkap (try...catch)"
  },
  "Fungsi Asinkron": {
    "prefix": "asinkron",
    "body": [
      "asinkron fungsi ${1:ambil_data}(${2:url}) {",
      "\tmisal respon = tunggu_hasil ${3:klien.ambil(url)};",
      "\tkembalikan respon;",
      "}"
    ],
    "description": "Fungsi asinkron dengan kata kunci tunggu_hasil (async/await)"
  },
  "WidyaBase Query Database": {
    "prefix": "widyabase",
    "body": [
      "misal db = buka_basis_data(\"${1:widya_app.db}\");",
      "db.eksekusi_kueri(\"CREATE TABLE IF NOT EXISTS ${2:pengguna} (id INT, nama TEKS, email TEKS);\");",
      "db.eksekusi_kueri(\"INSERT INTO ${2:pengguna} VALUES (1, 'Budi Santoso', 'budi@widya.id');\");",
      "misal hasil = db.kueri(\"SELECT * FROM ${2:pengguna};\");",
      "cetak(hasil);",
      "${0}"
    ],
    "description": "Template koneksi dan kueri basis data WidyaBase"
  },
  "Unit Test Bertanda Uji": {
    "prefix": "uji",
    "body": [
      "#[uji]",
      "fungsi uji_${1:fitur}() {",
      "\tmisal hasil = ${2:operasi()};",
      "\tpastikan(hasil == ${3:ekspektasi}, \"${4:Gagal memvalidasi fitur}\");",
      "}"
    ],
    "description": "Scaffold unit test dengan anotasi #[uji]"
  },
  "WidyaDesktop App": {
    "prefix": "desktopapp",
    "body": [
      "impor \"./modul/desktop.wya\";",
      "",
      "fungsi utama() {",
      "\tmisal app = BuatAplikasiDesktop(\"${1:Aplikasi Saya}\", ${2:1100}, ${3:720});",
      "\tapp.pusatkan();",
      "\tapp.tambah_menu(\"${4:Menu Baru}\", \"${5:Ctrl+M}\");",
      "\t",
      "\tapp.daftarkan_rpc(\"${6:ambil_data}\", fungsi(payload) {",
      "\t\tkembalikan { \"sukses\": benar, \"data\": \"Halo dari Backend!\" };",
      "\t});",
      "\t",
      "\t${0}",
      "}",
      "",
      "utama();"
    ],
    "description": "Template inisialisasi aplikasi desktop WidyaDesktop"
  },
  "Tensor NumPy Import": {
    "prefix": "numpy",
    "body": [
      "impor \"@widya/tensor\" sebagai np;",
      "misal t = np.tensor_buat([${1:1.0, 2.0, 3.0}], [${2:1, 3}]);",
      "${0}"
    ],
    "description": "Impor pustaka tensor linier aljabar setara NumPy"
  },
  "DataFrame Pandas Import": {
    "prefix": "pandas",
    "body": [
      "impor \"@widya/dataframe\" sebagai pd;",
      "misal df = pd.df_buat([\"${1:id}\", \"${2:nama}\"], [",
      "\t{ \"${1:id}\": 1, \"${2:nama}\": \"${3:Contoh}\" }",
      "]);",
      "${0}"
    ],
    "description": "Impor pustaka data tabular setara Pandas"
  },
  "Web REST Router": {
    "prefix": "express",
    "body": [
      "impor \"@widya/web\" sebagai web;",
      "misal router = web.buat_router();",
      "web.rute_get(router, \"/${1:api}\", fungsi(req) {",
      "\tkembalikan web.respons_json(200, { \"status\": \"sukses\" });",
      "});",
      "${0}"
    ],
    "description": "Impor pustaka REST router setara Express/FastAPI"
  },
  "AI Autograd PyTorch": {
    "prefix": "torch",
    "body": [
      "impor \"@widya/ai\" sebagai torch;",
      "misal layer = torch.lapisan_linear(${1:1.0}, ${2:0.0});",
      "misal x = torch.variabel(${3:2.0}, false);",
      "misal y = torch.linear_maju(layer, x);",
      "${0}"
    ],
    "description": "Impor pustaka autograd AI & neural network setara PyTorch"
  },
  "Test Runner Suite": {
    "prefix": "testsuite",
    "body": [
      "impor \"@widya/test\" sebagai test;",
      "misal pelari = test.uji_buat_pelari();",
      "fungsi uji_${1:fitur}(t) {",
      "\ttest.tegaskan_sama(t, ${2:1 + 1}, ${3:2}, \"${4:Penjumlahan harus benar}\");",
      "}",
      "test.uji_tambah(pelari, \"${5:Uji Fitur}\", uji_${1:fitur});",
      "test.uji_jalankan(pelari);",
      "${0}"
    ],
    "description": "Scaffold unit test suite setara Jest/Pytest"
  }
}
