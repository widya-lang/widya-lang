    // RUTE 19: Komputasi Tensor Widya-NumPy (/v1/tensor/compute)
    tambah_rute(server, "POST", "/v1/tensor/compute", fungsi(req) {
        misal op = "matmul";
        misal d1 = [1.0, 2.0, 3.0, 4.0];
        misal b1 = [2, 2];
        misal d2 = [5.0, 6.0, 7.0, 8.0];
        misal b2 = [2, 2];

        jika (req["badan"] != "" dan req["badan"] != kosong) {
            misal p = dari_json(req["badan"]);
            jika (ada_kunci(p, "operasi")) { op = p["operasi"]; }
            jika (ada_kunci(p, "data1")) { d1 = p["data1"]; }
            jika (ada_kunci(p, "bentuk1")) { b1 = p["bentuk1"]; }
            jika (ada_kunci(p, "data2")) { d2 = p["data2"]; }
            jika (ada_kunci(p, "bentuk2")) { b2 = p["bentuk2"]; }
        }

        misal t1 = tensor_buat(d1, b1);
        jika (op == "matmul") {
            misal t2 = tensor_buat(d2, b2);
            misal res = tensor_matmul(t1, t2);
            kembalikan {
                "operasi": "matmul",
                "bentuk": res.bentuk,
                "data": res.data,
                "mean": tensor_mean(res),
                "std": tensor_std(res)
            };
        } lainnya {
            kembalikan {
                "operasi": "stats",
                "bentuk": t1.bentuk,
                "sum": tensor_sum(t1),
                "mean": tensor_mean(t1),
                "min": tensor_min(t1),
                "max": tensor_max(t1),
                "std": tensor_std(t1)
            };
        }
    });

    // RUTE 20: Analitika Tabular Widya-Pandas (/v1/dataframe/analyze)
    tambah_rute(server, "POST", "/v1/dataframe/analyze", fungsi(req) {
