// ==============================================================================
// WIDYAOS: MODUL MANAJEMEN KURIKULUM, MASA BERLAKU & TRANSISI BERJENJANG
// Berdasarkan Prinsip Hukum Pendidikan: "Grandfathering Clause & Multi-Curriculum"
// Menjamin kepastian belajar: yang sudah berjalan tetap melanjutkan sampai lulus.
// ==============================================================================

struktur Kurikulum {
    kode,
    nama,
    dasar_hukum,
    tahun_mulai,
    tahun_selesai,
    masa_transisi_tahun,
    status, // RESMI_AKTIF, FASE_TRANSISI, DEPRECATED_SUNSET
    alokasi_p5_persen
}

struktur RombelKurikulum {
    nama_rombel,
    tingkat_kelas, // 7, 8, 9 (SMP) atau 10, 11, 12 (SMA)
    tahun_masuk_angkatan,
    kode_kurikulum,
    status_pelaksanaan, // KURIKULUM_BARU_MANDAT, TINGGAL_LANJUT_SAMPAI_LULUS
    keterangan_transisi
}

struktur EkuivalensiMatpel {
    matpel_asal,
    kurikulum_asal,
    matpel_tujuan,
    kurikulum_tujuan,
    bobot_konversi,
    status_penyesuaian
}

// Inisialisasi Kurikulum Nasional
fungsi buat_kurikulum(
    kode,
    nama,
    dasar_hukum,
    tahun_mulai,
    tahun_selesai,
    masa_transisi,
    status,
    p5_persen
) {
    kembalikan Kurikulum(
        kode,
        nama,
        dasar_hukum,
        tahun_mulai,
        tahun_selesai,
        masa_transisi,
        status,
        p5_persen
    );
}

// Logika Evaluasi Kurikulum Rombel dengan Prinsip "Tinggal Lanjut" (Grandfathering)
// Aturan Kemendikdasmen:
// 1. Siswa angkatan baru (tingkat awal) menggunakan kurikulum aktif terbaru.
// 2. Siswa tingkat lanjutan yang sudah memulai kurikulum sebelumnya TETAP MELANJUTKAN sampai lulus.
fungsi tetapkan_kurikulum_rombel(
    nama_rombel,
    tingkat_kelas,
    tingkat_awal_jenjang, // 7 untuk SMP, 10 untuk SMA, 1 untuk SD
    tahun_ajaran_berjalan,
    tahun_masuk_angkatan,
    kurikulum_lama,
    kurikulum_baru
) {
    // Cek apakah rombel ini adalah angkatan baru di tingkat awal jenjang
    jika tingkat_kelas == tingkat_awal_jenjang {
        // Angkatan baru otomatis mengadopsi kurikulum baru yang resmi berlaku
        kembalikan RombelKurikulum(
            nama_rombel,
            tingkat_kelas,
            tahun_masuk_angkatan,
            kurikulum_baru.kode,
            "KURIKULUM_BARU_MANDAT",
            "Angkatan baru wajib mengadopsi " + kurikulum_baru.nama
        );
    } lainnya {
        // Tingkat lanjutan (misal Kelas 8 & 9 SMP atau Kelas 11 & 12 SMA):
        // Menerapkan prinsip Grandfathering: Yang sudah gunakan tinggal lanjut sampai tamat
        kembalikan RombelKurikulum(
            nama_rombel,
            tingkat_kelas,
            tahun_masuk_angkatan,
            kurikulum_lama.kode,
            "TINGGAL_LANJUT_SAMPAI_LULUS",
            "Melanjutkan " + kurikulum_lama.nama + " hingga tamat jenjang (Grandfathering)"
        );
    }
}

// Menghitung Sisa Masa Berlaku Kurikulum
fungsi hitung_sisa_masa_berlaku(kurikulum, tahun_sekarang) {
    jika tahun_sekarang > kurikulum.tahun_selesai {
        kembalikan "KADALUWARSA / SUNSET (" + ke_teks(kurikulum.tahun_selesai) + ")";
    } kalau tahun_sekarang >= (kurikulum.tahun_selesai - kurikulum.masa_transisi_tahun) {
        misal sisa_tahun = kurikulum.tahun_selesai - tahun_sekarang;
        kembalikan "FASE TRANSISI (" + ke_teks(sisa_tahun) + " tahun tersisa hingga " + ke_teks(kurikulum.tahun_selesai) + ")";
    } lainnya {
        misal sisa_resmi = kurikulum.tahun_selesai - tahun_sekarang;
        kembalikan "RESMI AKTIF (" + ke_teks(sisa_resmi) + " tahun tersisa)";
    }
}

// Konversi Nilai Matpel saat Mutasi Siswa Antar-Kurikulum
fungsi konversi_matpel_mutasi(
    nilai_asal,
    matpel_asal,
    kur_asal,
    matpel_tujuan,
    kur_tujuan
) {
    // Ekuivalensi cerdas: IPAS di K-Merdeka ekuivalen IPA/IPS di K-13 / Kurikulum Baru
    misal bobot = 1.0;
    misal status = "EKUIVALEN_LANGSUNG";

    jika matpel_asal == "IPAS" dan matpel_tujuan == "IPA" {
        bobot = 1.0;
        status = "EKUIVALEN_SPLIT_SAINS";
    } kalau matpel_asal == "Informatika" dan matpel_tujuan == "TIK" {
        bobot = 1.0;
        status = "EKUIVALEN_KOMPUTASI";
    }

    kembalikan EkuivalensiMatpel(
        matpel_asal,
        kur_asal,
        matpel_tujuan,
        kur_tujuan,
        bobot,
        status
    );
}

// -------------------------------------------------------------
// [MODEL PENYELENGGARAAN BELAJAR: SISTEM PAKET VS SKS]
// Regulasi: Penyelenggaraan SKS WAJIB memiliki SK Izin Resmi Kementerian Pusat (Kemendikdasmen RI).
// -------------------------------------------------------------

struktur SKIzinSKSKementerian {
    nomor_sk,
    tanggal_terbit,
    instansi_penerbit, // "Direktorat Jenderal PAUD, Dikdas, dan Dikmen Kemendikdasmen RI"
    status_verifikasi_pusat, // benar / salah
    masa_berlaku_tahun
}

struktur PenyelenggaraanBelajarSekolah {
    npsn,
    nama_sekolah,
    model_terpilih, // "SISTEM_PAKET" atau "SISTEM_KREDIT_SEMESTER"
    status_izin_kementerian, // "DEFAULT_PAKET_NASIONAL", "RESMI_BERIZIN_KEMENTERIAN_PUSAT", "DITOLAK_TIDAK_ADA_IZIN_PUSAT"
    nomor_sk_izin,
    keterangan_operasional
}

struktur BebanBelajarSiswa {
    nisn,
    nama_siswa,
    ip_semester_lalu,
    beban_sks_diambil,
    pola_kecepatan, // "AKSELERASI_4_SEMESTER", "REGULER_6_SEMESTER", "PENDAMPINGAN_REMEDIAL"
    status_validasi
}

// Inisialisasi SK Izin Kementerian untuk SKS
fungsi buat_sk_izin_sks_kementerian(
    nomor_sk,
    tanggal,
    instansi,
    verifikasi_pusat,
    masa_berlaku
) {
    kembalikan SKIzinSKSKementerian(
        nomor_sk,
        tanggal,
        instansi,
        verifikasi_pusat,
        masa_berlaku
    );
}

// Tetapkan Model Penyelenggaraan Belajar: Sistem Paket vs SKS dengan Guardrail Verifikasi Pusat
fungsi tetapkan_model_penyelenggaraan(
    npsn,
    nama_sekolah,
    model_diminta,
    sk_izin_kementerian // Bisa berupa SKIzinSKSKementerian atau nihil
) {
    // 1. Sistem Paket: Mode default sekolah nasional tanpa syarat khusus
    jika model_diminta == "SISTEM_PAKET" {
        kembalikan PenyelenggaraanBelajarSekolah(
            npsn,
            nama_sekolah,
            "SISTEM_PAKET",
            "DEFAULT_PAKET_NASIONAL",
            "TIDAK_DIPERLUKAN",
            "Menyelenggarakan pembelajaran dengan sistem paket rombel reguler standar nasional"
        );
    }
    
    // 2. Sistem Kredit Semester (SKS): WAJIB memiliki SK Izin Resmi dari Kementerian Pusat
    jika model_diminta == "SISTEM_KREDIT_SEMESTER" {
        jika sk_izin_kementerian != nihil dan sk_izin_kementerian.status_verifikasi_pusat == true {
            kembalikan PenyelenggaraanBelajarSekolah(
                npsn,
                nama_sekolah,
                "SISTEM_KREDIT_SEMESTER",
                "RESMI_BERIZIN_KEMENTERIAN_PUSAT",
                sk_izin_kementerian.nomor_sk,
                "Sah menyelenggarakan SKS sesuai SK Kemendikdasmen RI (" + sk_izin_kementerian.nomor_sk + ")"
            );
        } lainnya {
            // Pengamanan Regulasi: Tolak dan paksa kembali ke Sistem Paket
            kembalikan PenyelenggaraanBelajarSekolah(
                npsn,
                nama_sekolah,
                "SISTEM_PAKET", // Otomatis rollback ke Paket
                "DITOLAK_TIDAK_ADA_IZIN_PUSAT",
                "NIHIL",
                "PERINGATAN: Pengajuan SKS ditolak karena belum ada SK Izin Resmi Kemendikdasmen Pusat. Dialihkan otomatis ke Sistem Paket."
            );
        }
    }

    // Default fallback
    kembalikan PenyelenggaraanBelajarSekolah(
        npsn,
        nama_sekolah,
        "SISTEM_PAKET",
        "DEFAULT_PAKET_NASIONAL",
        "TIDAK_DIPERLUKAN",
        "Default ke sistem paket standar"
    );
}

// Penentuan Beban Belajar Siswa (Paket vs SKS UKBM)
fungsi tentukan_beban_belajar_siswa(
    nisn,
    nama_siswa,
    ip_semester_lalu,
    penyelenggaraan_sekolah
) {
    // Jika sekolah masih sistem paket: Beban seragam 38 jam / semester
    jika penyelenggaraan_sekolah.model_terpilih == "SISTEM_PAKET" {
        kembalikan BebanBelajarSiswa(
            nisn,
            nama_siswa,
            ip_semester_lalu,
            38,
            "REGULER_6_SEMESTER",
            "Beban paket seragam rombongan belajar (38 JP)"
        );
    }

    // Jika sekolah berizin resmi SKS: Pengambilan SKS dinamis berdasarkan IP semester sebelumnya
    misal beban = 40;
    misal pola = "REGULER_6_SEMESTER";
    misal status = "SKS Reguler 6 Semester";

    jika ip_semester_lalu >= 3.85 {
        beban = 48;
        pola = "AKSELERASI_4_SEMESTER";
        status = "Memenuhi syarat akselerasi cepat (Lulus 2 Tahun / 4 Semester) dengan UKBM mandiri";
    } kalau ip_semester_lalu >= 3.00 {
        beban = 40;
        pola = "REGULER_6_SEMESTER";
        status = "Beban standar SKS reguler (Lulus 3 Tahun / 6 Semester)";
    } lainnya {
        beban = 34;
        pola = "PENDAMPINGAN_REMEDIAL";
        status = "Beban penyesuaian dengan pendampingan belajar guru BK";
    }

    kembalikan BebanBelajarSiswa(
        nisn,
        nama_siswa,
        ip_semester_lalu,
        beban,
        pola,
        status
    );
}

