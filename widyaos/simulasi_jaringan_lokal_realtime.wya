// =================================================================
// SIMULASI SUITE: JARINGAN INTERNAL SEKOLAH REALTIME (WIDYAOS INTRANET)
// Menghubungkan Perangkat Kelas, IFP, Gerbang, Lab, dan UKS via LAN
// =================================================================

impor "widyaos/modul/jaringan_lokal_realtime.wya";

cetak("==================================================================");
cetak("       UJI SISTEM JARINGAN INTERNAL SEKOLAH REALTIME (WIDYAOS)    ");
cetak("==================================================================");

// [TEST 1] Inisialisasi Master Node & Service Discovery (mDNS Zero-Config)
cetak("\n[1] Inisialisasi Master Edge Node & Registrasi mDNS");
misal net = inisialisasi_jaringan_lokal("20101234", "192.168.10.1");

misal dev_gate = registrasi_perangkat_mdns(net, "DEV-GATE-01", "Tablet RFID Gerbang Utama", "GATE_PRESENSI", "192.168.10.50", "00:1A:2B:3C:4D:01");
misal dev_guru = registrasi_perangkat_mdns(net, "DEV-GURU-10A", "Laptop Guru Kelas 10-A (Bpk. Joko)", "GAWAI_GURU", "192.168.10.101", "00:1A:2B:3C:4D:02");
misal dev_ifp = registrasi_perangkat_mdns(net, "DEV-IFP-10A", "Interactive Flat Panel 86 Inch 10-A", "IFP_KELAS", "192.168.10.20", "00:1A:2B:3C:4D:03");
misal dev_cbt_proctor = registrasi_perangkat_mdns(net, "DEV-PROCTOR-LAB", "PC Pengawas Lab Komputer", "CLIENT_CBT", "192.168.10.80", "00:1A:2B:3C:4D:04");
misal dev_uks = registrasi_perangkat_mdns(net, "DEV-TAB-UKS", "Tablet Petugas UKS", "TABLET_UKS", "192.168.10.60", "00:1A:2B:3C:4D:05");

cetak("📡 Hostname mDNS       :", net.hostname_mdns);
cetak("🌐 IP Master Node     :", net.ip_master_node);
cetak("🔌 Port WebSocket     :", net.port_websocket);
cetak("📱 Perangkat Terdaftar:", panjang(net.daftar_perangkat), "unit perangkat LAN");

jika net.hostname_mdns == "widyaos-20101234.local" dan dev_ifp.status_koneksi == "ONLINE" {
    cetak("✅ [TEST 1] Inisialisasi Master Edge Node & mDNS Discovery: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Inisialisasi Master Edge Node & mDNS Discovery: GAGAL");
}

// [TEST 2] Skenario Presensi Gerbang -> Ruang Kelas Realtime
cetak("\n[2] Uji Siaran Presensi Gerbang Sekolah ke Laptop Guru Kelas");
// Guru kelas 10-A berlangganan topik rombelnya
langganan_topik_realtime(net, "DEV-GURU-10A", "sekolah/presensi/rombel/ROMBEL-10-A");

// Siswa melakukan tap kartu di gerbang
misal evt_tap = siarkan_presensi_gerbang(net, "0081234567", "Ahmad Fauzi", "ROMBEL-10-A", "06:45:12 WIB");
cetak("📢 ID Event Presensi  :", evt_tap.id_event);
cetak("🎯 Topik Saluran      :", evt_tap.topik);
cetak("👥 Penerima Aktif LAN :", evt_tap.penerima_aktif, "perangkat (Langsung terdistribusi ke Guru Kelas)");
cetak("⚡ Status Pengiriman  :", evt_tap.status_pengiriman);

jika evt_tap.penerima_aktif > 0 dan evt_tap.status_pengiriman == "TERKIRIM_BROADCAST_LAN" {
    cetak("✅ [TEST 2] Notifikasi Realtime Presensi Gerbang ke Guru Kelas: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Notifikasi Realtime Presensi Gerbang ke Guru Kelas: GAGAL");
}

// [TEST 3] Skenario Mirroring Coretan IFP Smartboard ke Gawai Murid (Low Latency)
cetak("\n[3] Uji Streaming Coretan IFP Smartboard ke Tablet Murid di Kelas");
// 3 Murid berlangganan stream coretan guru di kelas 10-A
langganan_topik_realtime(net, "DEV-MURID-01", "sekolah/kelas/ROMBEL-10-A/ifp_stream");
langganan_topik_realtime(net, "DEV-MURID-02", "sekolah/kelas/ROMBEL-10-A/ifp_stream");
langganan_topik_realtime(net, "DEV-MURID-03", "sekolah/kelas/ROMBEL-10-A/ifp_stream");

misal stroke_vektor = "PATH_DATA:M120,450_C150,420_200,480_Z(Fisika_Newton_G)";
misal evt_ifp = siarkan_coretan_ifp_live(net, "ROMBEL-10-A", "DEV-IFP-10A", stroke_vektor);

cetak("🎨 Sumber IFP         :", evt_ifp.pengirim_id);
cetak("📶 Penerima Streaming :", evt_ifp.penerima_aktif, "tablet murid (Latency ~3.5 ms LAN)");
cetak("✨ Format Payload     : 60 FPS INK Vector Stream");

jika evt_ifp.penerima_aktif == 3 {
    cetak("✅ [TEST 3] Mirroring Coretan IFP Smartboard ke Tablet Murid: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Mirroring Coretan IFP Smartboard ke Tablet Murid: GAGAL");
}

// [TEST 4] Skenario Live Proctoring CBT Lab & Deteksi Kecurangan
cetak("\n[4] Uji Monitoring Ujian CBT Lab Komputer ke Layar Pengawas");
langganan_topik_realtime(net, "DEV-PROCTOR-LAB", "sekolah/lab/LAB-KOMP-01/cbt_monitor");

// Siswa di lab mencoba ganti tab browser saat ujian
misal evt_cbt_alert = siarkan_status_cbt_siswa(net, "LAB-KOMP-01", "0081234567", 18, "PERINGATAN_PINDAH_TAB");
cetak("⚠️ Pengirim Alert     :", evt_cbt_alert.pengirim_id);
cetak("🖥️ Monitor Pengawas   :", evt_cbt_alert.topik);
cetak("🚨 Indikasi Pelanggaran: PERINGATAN_PINDAH_TAB terkirim instan ke proctor");

jika evt_cbt_alert.penerima_aktif == 1 {
    cetak("✅ [TEST 4] Live Proctoring CBT Lab & Telemetri Integritas: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Live Proctoring CBT Lab & Telemetri Integritas: GAGAL");
}

// [TEST 5] Skenario Offline Resilience & Rekonsiliasi CRDT saat Wi-Fi Glitch
cetak("\n[5] Uji Ketahanan Gangguan Wi-Fi & Auto-Reconcile CRDT");
// Perangkat presensi di lapangan basket sempat terputus Wi-Fi dan mencatat 2 presensi offline
simpan_buffer_offline_crdt(net, "DEV-TAB-OLAHRAGA", "PRESENSI", "0081234991", "ABSEN_HADIR");
simpan_buffer_offline_crdt(net, "DEV-TAB-OLAHRAGA", "PRESENSI", "0081234992", "ABSEN_HADIR");

cetak("📦 Buffer Offline Tersimpan:", panjang(net.buffer_offline_crdt), "rekaman lokal");
misal hasil_rekon = rekonsiliasi_buffer_crdt(net);
cetak("🔄 Hasil Rekonsiliasi      :", hasil_rekon.status);
cetak("📊 Rekaman Berhasil Merge  :", hasil_rekon.total_item);
cetak("🛡️ Konflik Data            :", hasil_rekon.konflik_data, "(Zero Conflict)");

jika hasil_rekon.total_item == 2 dan hasil_rekon.konflik_data == 0 {
    cetak("✅ [TEST 5] Offline Resilience & Auto-Reconcile CRDT Jaringan Lokal: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Offline Resilience & Auto-Reconcile CRDT Jaringan Lokal: GAGAL");
}

cetak("\n==================================================================");
cetak("  SEMUA PENGUJIAN JARINGAN INTERNAL SEKOLAH REALTIME LULUS 100%!  ");
cetak("==================================================================");
