// Mode: SESI=pagi | SESI=malam | SESI=siklus_penuh | SESI=multi_proyek
// ==============================================================================

impor "./config.wya";
impor "./agen/daftar_agen.wya";
impor "./integrasi/obsidian_bridge.wya";
impor "./integrasi/telegram_bridge.wya";
impor "./integrasi/lifecycle_engine.wya";
impor "./rapat/rapat_pagi.wya";
impor "./rapat/rapat_malam.wya";
impor "./integrasi/widyabase_bridge.wya";
impor "./integrasi/analitika_bridge.wya";
impor "./integrasi/message_bus.wya";
impor "./integrasi/sandbox_isolasi.wya";
impor "./integrasi/iam_multitenant.wya";
impor "./integrasi/llm_gateway.wya";
impor "./integrasi/generator_dokumen_industri.wya";
impor "./integrasi/observability_audit.wya";
impor "./integrasi/auto_healing.wya";

// Helper menentukan tanggal hari ini (YYYY-MM-DD)
fungsi dapatkan_tanggal_hari_ini() {
    // 1. Coba via Linux date
    coba {
        misal res_l = eksekusi("date +%Y-%m-%d 2>/dev/null");
        jika (res_l != nil dan res_l["stdout"] != nil dan res_l["stdout"] != "") {
            misal tl = res_l["stdout"];
            misal tl_bersih = "";
            misal k = 0;
            selama (k < panjang(tl)) {
                jika (tl[k] != "\r" dan tl[k] != "\n" dan tl[k] != " ") {
                    tl_bersih = tl_bersih + tl[k];
                }
                k = k + 1;
            }
            jika (panjang(tl_bersih) == 10 dan tl_bersih[4] == "-" dan tl_bersih[7] == "-") {
                kembalikan tl_bersih;
            }
        }
    } tangkap (el) {}

    // 2. Coba via PowerShell Get-Date
    coba {
        misal res = eksekusi("powershell -NoProfile -Command Get-Date -Format yyyy-MM-dd");
        jika (res != nil dan res["stdout"] != nil dan res["stdout"] != "") {

            misal t = res["stdout"];
            misal t_bersih = "";
            misal i = 0;
            selama (i < panjang(t)) {
                jika (t[i] != "\r" dan t[i] != "\n" dan t[i] != " ") {
                    t_bersih = t_bersih + t[i];
                }
                i = i + 1;
            }
            // Validasi: hasil harus 10 karakter format YYYY-MM-DD
            jika (panjang(t_bersih) == 10 dan t_bersih[4] == "-" dan t_bersih[7] == "-") {
                kembalikan t_bersih;
            }
        }
    } tangkap (e) {}

    // Fallback 2: coba via cmd date /t
    coba {
        misal res2 = eksekusi("powershell -NoProfile -Command \"Get-Date -Format yyyy-MM-dd\"");
        jika (res2 != nil dan res2["stdout"] != nil) {
            misal t2 = res2["stdout"];
            misal t2_bersih = "";
            misal j = 0;
            selama (j < panjang(t2)) {
                jika (t2[j] != "\r" dan t2[j] != "\n" dan t2[j] != " ") {
                    t2_bersih = t2_bersih + t2[j];
                }
                j = j + 1;
            }
            jika (panjang(t2_bersih) == 10) {
                kembalikan t2_bersih;
            }
        }
    } tangkap (e2) {}

    // Fallback akhir: gunakan tanggal sistem Widya-Lang jika tersedia
    coba {
        misal tgl_sistem = format_tanggal(sekarang(), "YYYY-MM-DD");
        jika (tgl_sistem != nil dan panjang(tgl_sistem) == 10) {
            kembalikan tgl_sistem;
        }
    } tangkap (e3) {}

    // Terakhir: kembalikan string yang jelas menandakan error
    cetak("⚠️ [PERINGATAN] Gagal mendapatkan tanggal sistem. Menggunakan tanggal placeholder.");
    kembalikan "2026-01-01-DATE-ERROR";
}

fungsi utama() {
    cetak("==================================================================");
    cetak("🤖 EKOSISTEM KANTOR DIGITAL BERDAULAT: 10 AI AGENT WIDYA (ENTERPRISE)");
    cetak("Terintegrasi dengan: 7 Pilar Skala Industri, Obsidian & Telegram");
    cetak("==================================================================");

    misal cfg = dapatkan_konfigurasi();
    misal tim_agen = inisialisasi_agen_kantor();
    misal tanggal = dapatkan_tanggal_hari_ini();

    // 0. Inisialisasi 7 Subsistem Enterprise Industrial Grade
    bus_inisialisasi();
    llm_gateway_inisialisasi(cfg);
    otel_inisialisasi();
    ha_inisialisasi_supervisor(tim_agen);
    iam_inisialisasi_tenant(cfg["enterprise"]["iam_multitenant"]["default_tenant"], cfg["enterprise"]["iam_multitenant"]["nama_instansi"]);

    // 0b. Inisialisasi Tabel Lifecycle & Reset Semua Agen ke IDLE (beban = 0%)
    lifecycle_inisialisasi_tabel(cfg);
    lifecycle_inisialisasi_semua_agen(cfg, tim_agen, tanggal);

    // 1. Inisialisasi Vault Obsidian dan salin seluruh SOP
    inisialisasi_obsidian_vault(cfg);
    obsidian_salin_sop_ke_vault(cfg);

    // 2. Baca mode sesi dari variabel lingkungan (Environment Variable)
    misal mode_sesi = baca_env("SESI");
    jika (mode_sesi == nil atau mode_sesi == "") {
        mode_sesi = "siklus_penuh"; // Default jalankan demo siklus penuh (Pagi + Malam)
    }

    cetak("\n📅 Tanggal Operasi: " + tanggal);
    cetak("⚙️ Mode Eksekusi : " + mode_sesi);
    cetak("📦 Versi Sistem   : v1.2.0-GA (10 AI Agent | 5 Proyek/Hari)");

    misal kode_prj = cfg["widyabase"]["proyek_aktif"];

    jika (mode_sesi == "pagi") {
        eksekusi_rapat_pagi(cfg, tim_agen, tanggal);
        widyabase_catat_rapat(cfg, kode_prj, "PAGI", tanggal, "agen_orkestrator", "Otentikasi Argon2id", "Skema DB Inventaris", "Pengujian Beban SSE", "Penyesuaian buffer pool", "88.5%", "DailyNotes/" + tanggal + "-Pagi.md");
    } kalau (mode_sesi == "malam") {
        eksekusi_rapat_malam(cfg, tim_agen, tanggal);
        widyabase_catat_rapat(cfg, kode_prj, "MALAM", tanggal, "agen_orkestrator", "Review Uji QA", "Verifikasi Backup", "Perencanaan Rilis", "Buffer pool memory", "91.2%", "DailyNotes/" + tanggal + "-Malam.md");
    } kalau (mode_sesi == "multi_proyek") {
        // === MODE MULTI-PROYEK: 5 Proyek Industri Sekaligus ===
        cetak("\n>>> MENJALANKAN MODE ORKESTRASI 5 PROYEK INDUSTRI HARIAN <<<");
        cetak("   Model Kerja: Shared-Pool Queue | Isolasi Konteks per Project-ID");
        cetak("   SLA: Seluruh proyek harus selesai sebelum rapat malam (20:00 WIB)\n");

        misal daftar_proyek = cfg["proyek"];
        misal total_prj = panjang(daftar_proyek);
        misal prj_idx = 0;

        selama (prj_idx < total_prj) {
            misal prj = daftar_proyek[prj_idx];
            cetak("------------------------------------------------------------------");
            cetak("🚀 [" + ke_teks(prj_idx + 1) + "/" + ke_teks(total_prj) + "] SPRINT: " + prj["kode"] + " — " + prj["nama"]);
            cetak("🏷️  Kategori: " + prj["kategori"] + " | Lead: " + prj["pic_lead"] + " | Deadline: " + prj["target_deadline"]);
            cetak("------------------------------------------------------------------");

            misal span_prj = otel_mulai_span("EXECUTE_SPRINT", "agen_orkestrator", "");
            misal waktu_prj = tanggal + "-PRJ" + ke_teks(prj_idx + 1);
            misal id_p1 = "TSK-" + prj["kode"] + "-01";
            misal id_p2 = "TSK-" + prj["kode"] + "-02";

            aktifkan_tugas(cfg, prj["pic_lead"], "Lead Developer", [{ "id_tugas": id_p1, "prioritas": "P1" }], waktu_prj);
            aktifkan_tugas(cfg, "agen_qa", "QA Automation Tester", [{ "id_tugas": id_p2, "prioritas": "P2" }], waktu_prj);
            aktifkan_tugas(cfg, "agen_keamanan", "Auditor Siber", [{ "id_tugas": id_p1, "prioritas": "P1" }], waktu_prj);

            cetak("  ⚡ [Dev] " + prj["p1"]);
            cetak("  ⚡ [Arsitek] " + prj["p2"]);
            cetak("  🔍 [QA] " + prj["p3"]);
            cetak("  🛡️  [Security] Audit kepatuhan UU PDP No. 27/2022...");

            widyabase_catat_rapat(cfg, prj["kode"], "SPRINT-HARIAN", tanggal, "agen_orkestrator", prj["p1"], prj["p2"], prj["p3"], "Nol blocker kritis", "94.8%", "DailyNotes/" + tanggal + "-" + prj["kode"] + ".md");
            widyabase_catat_audit(cfg, prj["kode"], waktu_prj, "agen_keamanan", "PDP_AND_CRYPTO_VERIFICATION", "SESUAI_UU_PDP", "Audit lolos — " + prj["nama"], "HMAC-SHA256:PRJ" + ke_teks(prj_idx + 1) + "OK");
            otel_catat_audit_worm("agen_keamanan", "PDP_AND_CRYPTO_VERIFICATION", "Audit lolos — " + prj["nama"]);

            selesaikan_dan_rilis_agen(cfg, prj["pic_lead"], "Lead Developer", id_p1, "agen_qa", "Unit & integrasi test lolos", waktu_prj);
            selesaikan_dan_rilis_agen(cfg, "agen_qa", "QA Automation Tester", id_p2, "agen_orkestrator", "Stress-test passed 100%", waktu_prj);
            selesaikan_dan_rilis_agen(cfg, "agen_keamanan", "Auditor Siber", id_p1, "agen_orkestrator", "Sertifikasi Level A UU PDP", waktu_prj);

            widyabase_susun_dokumen_proyek(cfg, prj["kode"]);

            // 📄 Terbitkan Laporan Progres Resmi Dual-Format (PDF ISO 32000-1 & PPTX OpenXML Deck)
            doc_terbitkan_paket_laporan_ganda(prj, "./proyek/" + prj["kode"]);
            bus_publish("PROJECT_RELEASED", { "kode": prj["kode"], "status": "APPROVED" }, "agen_orkestrator");
            otel_tutup_span(span_prj, "SUCCESS");

            prj_idx = prj_idx + 1;
        }

        // Susun laporan konsolidasi 5 proyek di Obsidian
        misal md_ringkas = "# 🏢 Konsolidasi Portofolio " + ke_teks(total_prj) + " Proyek — " + tanggal + "\n\n";
        md_ringkas = md_ringkas + "> Orchestrator: `agen_orkestrator` | Mode: Shared-Pool Queue | SLA: 100%\n\n";
        md_ringkas = md_ringkas + "| No | Kode | Nama Proyek | Kategori | Laporan PDF | Slide PPTX | Status |\n";
        md_ringkas = md_ringkas + "| :---: | :--- | :--- | :--- | :---: | :---: | :---: |\n";
        misal k = 0;
        selama (k < total_prj) {
            misal p = daftar_proyek[k];
            md_ringkas = md_ringkas + "| " + ke_teks(k + 1) + " | `" + p["kode"] + "` | " + p["nama"] + " | " + p["kategori"] + " | `[[LAPORAN_PROGRES.pdf]]` | `[[PRESENTASI_PROGRES.pptx]]` | ✅ VERIFIED |\n";
            k = k + 1;
        }
        obsidian_tulis_catatan_harian(cfg, tanggal, "Multi-Proyek-Summary", "Konsolidasi Multi-Proyek", md_ringkas, {});
        widyabase_catat_rapat(cfg, kode_prj, "KONSOLIDASI-5PRJ", tanggal, "agen_orkestrator", "5 Proyek Tuntas", "Audit PDP Level A", "Dokumentasi Obsidian Terbit", "Nol blocker", "94.8%", "DailyNotes/" + tanggal + "-Multi-Proyek-Summary.md");

    } lainnya {
        // Mode Siklus Penuh: Jalankan Rapat Pagi, lalu Rapat Malam
        cetak("\n>>> MENJALANKAN SIMULASI SIKLUS HARIAN PENUH (PAGI & MALAM) <<<");
        eksekusi_rapat_pagi(cfg, tim_agen, tanggal);
        widyabase_catat_rapat(cfg, kode_prj, "PAGI", tanggal, "agen_orkestrator", "Otentikasi Argon2id", "Skema DB Inventaris", "Pengujian Beban SSE", "Penyesuaian buffer pool", "88.5%", "DailyNotes/" + tanggal + "-Pagi.md");

        cetak("\n⏳ [Simulasi Berjalan] Jam kerja kantor digital aktif (08:30 - 17:00)...");
        cetak("   Lead Coder mengeksekusi kode, Arsitek memantau DB, QA menguji...");

        eksekusi_rapat_malam(cfg, tim_agen, tanggal);
        widyabase_catat_rapat(cfg, kode_prj, "MALAM", tanggal, "agen_orkestrator", "Review Uji QA", "Verifikasi Backup", "Perencanaan Rilis", "Buffer pool memory", "91.2%", "DailyNotes/" + tanggal + "-Malam.md");

        // Terbitkan Dokumen Laporan Progres Resmi Ganda untuk Proyek Aktif
        misal p_aktif = cfg["proyek"][0];
        doc_terbitkan_paket_laporan_ganda(p_aktif, "./proyek/" + p_aktif["kode"]);
        otel_catat_audit_worm("agen_notulis", "REPORT_GENERATED", "Penerbitan LAPORAN_PROGRES.pdf & PRESENTASI_PROGRES.pptx untuk " + p_aktif["kode"]);
    }

    // 3. Susun Dokumentasi Proyek Otomatis dari Data WidyaBase
    jika (mode_sesi != "multi_proyek") {
        widyabase_susun_dokumen_proyek(cfg, kode_prj);
    }

    cetak("\n==================================================================");
    cetak("🎉 SEMUA PROSES BERHASIL DISELESAIKAN:");
    cetak("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    cetak("1. DailyNotes terbit di Obsidian Vault   : " + cfg["obsidian"]["jalur_vault"] + "/DailyNotes/");
    cetak("2. Papan Kanban diperbarui                : " + cfg["obsidian"]["jalur_vault"] + "/Tasks/Kanban_Prioritas.md");
    cetak("3. Notifikasi Telegram Gateway            : ./telegram_terakhir.txt");
    cetak("4. Basis Data WidyaBase (.wdb & .wal)     : " + cfg["widyabase"]["jalur_db"]);
    cetak("5. Dokumentasi Proyek terbit              : " + cfg["obsidian"]["jalur_vault"] + "/Dokumentasi_Proyek/");
    cetak("6. Dashboard KPI Analitika                : " + cfg["obsidian"]["jalur_vault"] + "/DailyNotes/*-Analitika.md");
    cetak("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    cetak("💡 Panduan Mode Eksekusi:");
    cetak("   $env:SESI='pagi'          → Rapat Pagi saja");
    cetak("   $env:SESI='malam'         → Rapat Malam saja");
    cetak("   $env:SESI='siklus_penuh'  → Siklus harian (Pagi + Malam)");
    cetak("   $env:SESI='multi_proyek'  → 5 Proyek Industri Sekaligus 🏭");
    cetak("==================================================================");
}

utama();
