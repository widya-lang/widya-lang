// ============================================================================
// SIMULASI SUITE: KEPEGAWAIAN, KINERJA SKP, JABATAN FUNGSIONAL & PAK KONVERSI
// Menguji 4 Skenario Administrasi Kepegawaian ASN Guru:
// 1. Evaluasi SKP Periodik Triwulanan & Semesteran Berbasis Hasil Kerja & Perilaku
// 2. Konversi Predikat Kinerja ke Angka Kredit Tahunan (PermenPAN-RB 1/2023)
// 3. Uji Kelayakan Kenaikan Pangkat Fungsional Guru pada 6 Periode BKN via SIASN
// 4. Pengingat Otomatis Kenaikan Gaji Berkala (KGB) Tiap 2 Tahun Tanpa Terlupa
// ============================================================================

impor "widyaos/modul/kepegawaian_kinerja_skp_pak.wya";

cetak("====================================================================");
cetak("👔  SIMULASI: TATA KELOLA KEPEGAWAIAN, SKP & ANGKA KREDIT KONVERSI   ");
cetak("====================================================================");

// [1] Evaluasi SKP Periodik Triwulan & Semesteran
cetak("\n[1] Uji Evaluasi Kinerja SKP Periodik (Triwulan III BerAKHLAK):");
misal skp_triwulan = evaluasi_skp_periodik(
    "SKP-2026-TW3-001",
    "198803122015021002",
    "Agus Setiawan, S.Pd., M.Pd.",
    "TRIWULAN_3",
    2026,
    "DI_ATAS_EKSPEKTASI", // Hasil Belajar Siswa & Modul Ajar Unggul
    "DI_ATAS_EKSPEKTASI"  // Teladan Perilaku BerAKHLAK
);

cetak("  • Nama Pegawai       :", skp_triwulan.nama_pegawai);
cetak("  • Periode Siklus     :", skp_triwulan.periode_siklus, "Tahun", skp_triwulan.tahun_penilaian);
cetak("  • Capaian Kinerja    :", skp_triwulan.hasil_kerja_rhk);
cetak("  • Perilaku Kerja     :", skp_triwulan.perilaku_berakhlak);
cetak("  • Predikat Akhir     :", skp_triwulan.predikat_kinerja);
cetak("  • Status Pengesahan  :", skp_triwulan.status_persetujuan_kepsek);

jika skp_triwulan.predikat_kinerja == "SANGAT_BAIK" dan skp_triwulan.status_persetujuan_kepsek == "DISETUJUI_PEJABAT_PENILAI_KINERJA" {
    cetak("  ✅ PASS: Evaluasi SKP Triwulan Tervalidasi Otomatis dengan Predikat SANGAT BAIK!");
} lainnya {
    cetak("  ❌ FAIL: Evaluasi SKP gagal!");
}

// [2] Konversi Predikat Kinerja Menjadi Angka Kredit (PAK Konversi PermenPAN-RB 1/2023)
cetak("\n[2] Uji Penetapan Angka Kredit Konversi (Guru Ahli Muda, Predikat Sangat Baik):");
// Guru Ahli Muda (Koefisien = 25.0), Predikat Sangat Baik (150% = 37.5 AK/tahun)
// AK Lama = 70.0 -> Total Baru = 107.5
misal pak_konversi = hitung_pak_konversi_tahunan(
    "PAK-KONV-2026-088",
    "198803122015021002",
    "Agus Setiawan, S.Pd., M.Pd.",
    "AHLI_MUDA",
    2026,
    "SANGAT_BAIK",
    70.0
);

cetak("  • Jenjang Jabatan    :", pak_konversi.jenjang_jf);
cetak("  • Koefisien Tahunan  :", pak_konversi.koefisien_tahunan_jf);
cetak("  • Pengali Kinerja    :", pak_konversi.persentase_pengali, "%");
cetak("  • AK Diperoleh Tahun :", pak_konversi.angka_kredit_tahunan_diperoleh);
cetak("  • Total AK Baru      :", pak_konversi.total_ak_kumulatif_baru);
cetak("  • Status SIASN BKN   :", pak_konversi.status_siasn_bkn);

jika pak_konversi.angka_kredit_tahunan_diperoleh == 37.5 dan pak_konversi.total_ak_kumulatif_baru == 107.5 {
    cetak("  ✅ PASS: Paradigma Baru PermenPAN-RB 1/2023 Berhasil! Bebas DUPAK Kertas, Otomatis Masuk SIASN.");
} lainnya {
    cetak("  ❌ FAIL: Perhitungan PAK Konversi gagal!");
}

// [3] Audit Kelayakan Kenaikan Pangkat Jabatan Fungsional Guru (6 Periode BKN)
cetak("\n[3] Uji Kelayakan Kenaikan Pangkat (Golongan III/c ke III/d Periode BKN):");
// Syarat naik pangkat III/c ke III/d butuh AK Kumulatif minimal 100.0
misal cek_kp = audit_kelayakan_kenaikan_pangkat(
    "198803122015021002",
    "Agus Setiawan, S.Pd., M.Pd.",
    "III/c",
    "III/d",
    pak_konversi.total_ak_kumulatif_baru, // 107.5
    100.0,
    "OKTOBER"
);

cetak("  • Pangkat Saat Ini   :", cek_kp.pangkat_sekarang, "-> Target Usulan:", cek_kp.pangkat_tujuan);
cetak("  • AK Saat Ini / Syarat:", cek_kp.ak_kumulatif, "/", cek_kp.ak_syarat_minimal);
cetak("  • Periode Usulan BKN :", cek_kp.periode_usulan_bkn);
cetak("  • Status Kelayakan   :", cek_kp.status_kelayakan_kp);

jika cek_kp.status_kelayakan_kp == "MEMENUHI_SYARAT_KP_6_PERIODE" {
    cetak("  ✅ PASS: Guru Memenuhi Syarat Kenaikan Pangkat! Siap Diusulkan pada Periode BKN Mendatang.");
} lainnya {
    cetak("  ❌ FAIL: Audit kenaikan pangkat gagal!");
}

// [4] Monitoring Otomatis Kenaikan Gaji Berkala (KGB Tiap 2 Tahun)
cetak("\n[4] Uji Pengingat Otomatis Kenaikan Gaji Berkala (KGB):");
misal kgb = pantau_kenaikan_gaji_berkala(
    "198803122015021002",
    "Agus Setiawan, S.Pd., M.Pd.",
    "01 Maret 2027",
    12, // Masa kerja 12 tahun
    4120000 // Gaji pokok baru
);

cetak("  • TMT Jatuh Tempo KGB:", kgb.tmt_kgb_jatuh_tempo);
cetak("  • Masa Kerja Golongan:", kgb.masa_kerja_tahun, "tahun");
cetak("  • Estimasi Gaji Baru : Rp", kgb.gaji_pokok_baru_rp);
cetak("  • Status Administrasi:", kgb.status_sk_kgb);

jika kgb.status_sk_kgb == "SIAP_TERBIT_SPKGB_DINAS" {
    cetak("  ✅ PASS: Peringatan Dini KGB Aktif! Hak Finansial Gaji Guru Terlindungi Tanpa Terlupa.");
} lainnya {
    cetak("  ❌ FAIL: Pengingat KGB gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 4/4 KASUS KEPEGAWAIAN ASN GURU LULUS (100%)      ");
cetak("====================================================================");
