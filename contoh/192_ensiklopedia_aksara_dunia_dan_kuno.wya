// ============================================================================
// CONTOH 192: ENSIKLOPEDIA & TRANSLITERASI AKSARA DUNIA & PERADABAN KUNO
// Bahasa Pemrograman Widya (Widya-lang)
// Mendukung Transliterasi 40+ Aksara Nusantara, Dunia, Peradaban Kuno & Notasi:
// - Asia Tenggara: Khmer, Myanmar/Burma, Tibet, Thai, Baybayin Filipina
// - Asia Selatan: Devanagari, Bengali/Bangla, Tamil, Telugu, Kannada, Malayalam
// - Eropa & Timur Tengah: Yunani, Sirilik, Arab, Ibrani, Fenisia Kuno, Ogham Keltik, Rune
// - Afrika & Amazigh: Ge'ez Amharik, Tifinagh Berber
// - Aksara Notasi Universal: Braille Internasional (Tunanetra), Kode Morse
// ============================================================================

cetak("==================================================================");
cetak("📜 ENSIKLOPEDIA LENGKAP AKSARA DUNIA & PERADABAN KUNO DI WIDYA-LANG");
cetak("==================================================================");

// 1. ASIA TENGGARA & INDOSINA
cetak("\n--- 1. Aksara Asia Tenggara (Southeast Asian Scripts) ---");
cetak("• Khmer (Kamboja) : " + latin_ke_aksara_khmer("sombok sok sabay widya"));
cetak("• Myanmar (Burma) : " + latin_ke_aksara_myanmar("mingalaba widya burma"));
cetak("• Tibet (Himalaya): " + latin_ke_aksara_tibet("tashi delek widya lhasa"));
cetak("• Baybayin (Filipina): " + latin_ke_aksara_baybayin("mabuhay widya"));

// 2. ASIA SELATAN (BRAHMIC SUB-CONTINENT)
cetak("\n--- 2. Aksara Asia Selatan (Sub-Benua India & Brahmic) ---");
cetak("• Devanagari (Hindi)  : " + latin_ke_devanagari("namaste vidya shanti"));
cetak("• Bengali (Bangla)    : " + latin_ke_aksara_bengali("dhonnobad widya"));
cetak("• Tamil (India Selatan): " + latin_ke_aksara_tamil("vanakkam widya"));

// 3. AKSARA KUNO & INDUK ALFABET SEJARAH (ANCIENT SCRIPTS)
cetak("\n--- 3. Aksara Kuno & Induk Peradaban Sejarah ---");
cetak("• Fenisia (Induk Alfabet Dunia ~1200 SM): " + latin_ke_fenisia("widya alfabet phoinike"));
cetak("• Ogham (Keltik/Irlandia Kuno Abad 4 M)  : " + latin_ke_ogham("widya ogham"));
cetak("• Rune (Elder Futhark Skandinavia)       : " + latin_ke_aksara_rune("viking odin thor widya"));
cetak("• Tifinagh (Berber / Amazigh Afrika Utara): " + latin_ke_tifinagh("azul amazigh widya"));

// 4. AKSESIBILITAS & NOTASI TELEKOMUNIKASI UNIVERSAL
cetak("\n--- 4. Notasi Aksara Universal: Braille & Morse ---");
var teks_braille = "widya lang 2026";
var hasil_braille = latin_ke_braille(teks_braille);
cetak("• Teks Asli       : " + teks_braille);
cetak("• Braille (Tunanetra): " + hasil_braille);
cetak("• Braille ke Latin: " + braille_ke_latin(hasil_braille));

var teks_morse = "SOS WIDYA";
var hasil_morse = latin_ke_morse(teks_morse);
cetak("\n• Teks Asli     : " + teks_morse);
cetak("• Kode Morse    : " + hasil_morse);
cetak("• Morse ke Latin: " + morse_ke_latin(hasil_morse));

// 5. MASTER REGISTRY 39 AKSARA DUNIA TERDAFTAR
cetak("\n--- 5. Ringkasan Master Data 39 Aksara Dunia ---");
var master = daftar_aksara_dunia();
cetak("Total Sistem Penulisan Dunia Terdaftar: " + ke_teks(panjang(master)) + " aksara");

var i = 1;
untuk item dalam master {
    cetak(" [" + ke_teks(i) + "] " + item["nama"] + " (" + item["arah_penulisan"] + ") | " + item["rumpun_aksara"]);
    i = i + 1;
}

cetak("\n==================================================================");
cetak("✨ 100% CAKUPAN AKSARA DUNIA, NUSANTARA, KUNO & NOTASI BERHASIL!");
cetak("==================================================================");
