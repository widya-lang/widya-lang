// ============================================================================
// SIMULASI SUITE: KESEJAHTERAAN & PERLINDUNGAN HAK SISWA (STUDENT PROTECTION)
// Menguji Penanganan 5 Kasus Kritis & Sensitif Peserta Didik di Lapangan:
// 1. Siswa Tanpa NIK/Akta Lahir (Afirmasi Hak Sekolah, BOS & Rujukan Dukcapil)
// 2. Deteksi Dini Kesehatan Mental, Depresi & Bahaya Judi Online
// 3. Mitigasi Risiko Putus Sekolah (Pemicu Kunjungan Rumah Otomatis Saat 5 Hari Alpha)
// 4. Pengamanan Sengketa Hak Asuh Anak & Verifikasi Penjemput Pintu Gerbang
// 5. Layanan Belajar Rawat Inap (Hospital Schooling Tanpa Drop-Out)
// ============================================================================

impor "widyaos/modul/kesejahteraan_dan_perlindungan_siswa.wya";

cetak("====================================================================");
cetak("💖  SIMULASI: PERLINDUNGAN HAK & KESEJAHTERAAN SISWA TERPADU         ");
cetak("====================================================================");

// [1] Siswa Tanpa NIK / Akta Kelahiran
cetak("\n[1] Uji Afirmasi Siswa Tanpa NIK / Akta Kelahiran (Hak Pendidikan):");
misal anak_afirmasi = daftarkan_siswa_afirmasi_tanpa_nik(
    "REG-AFIR-2026-001",
    "Budi Santoso",
    "Mojokerto, 12 Mei 2012",
    "Siti Aminah (Nikah Siri, Belum Masuk KK)"
);

cetak("  • Nama Calon Siswa   :", anak_afirmasi.nama_siswa);
cetak("  • Status Dokumen     :", anak_afirmasi.status_dokumen_kependudukan);
cetak("  • NIK Sementara      :", anak_afirmasi.nik_afirmasi_sementara);
cetak("  • NISN Terbit        :", anak_afirmasi.nisn_terbit);
cetak("  • Rujukan Dukcapil   :", anak_afirmasi.status_rekomendasi_dukcapil);

jika anak_afirmasi.status_dokumen_kependudukan == "BELUM_MEMILIKI_AKTA_DAN_NIK" dan anak_afirmasi.nisn_terbit == "0099112233" {
    cetak("  ✅ PASS: Hak Belajar Anak Tetap Dijamin! NISN Terbit & Sistem Mengadvokasi ke Dukcapil.");
} lainnya {
    cetak("  ❌ FAIL: Pendaftaran siswa tanpa NIK gagal!");
}

// [2] Deteksi Dini Kesehatan Mental, Depresi & Risiko Judi Online
cetak("\n[2] Uji Deteksi Dini Kesehatan Mental & Anomali Perilaku Pelajar:");
// Siswa absen 8 hari dalam sebulan, nilai ulangan anjlok 35%
misal skrining_mental = evaluasi_kesehatan_mental_siswa(
    "0081234567",
    "Andi Pratama",
    8,
    35.0,
    benar
);

cetak("  • Nama Siswa         :", skrining_mental.nama_siswa);
cetak("  • Skor Wellness      :", skrining_mental.skor_wellness_persen, "%");
cetak("  • Indikator Anomali  :", skrining_mental.indikator_anomali);
cetak("  • Faktor Risiko      :", skrining_mental.faktor_risiko);
cetak("  • Urgensi Konseling  :", skrining_mental.tingkat_urgensi_konseling);
cetak("  • Tindakan BK        :", skrining_mental.status_penanganan_bk);

jika skrining_mental.tingkat_urgensi_konseling == "BUTUH_PENANGANAN_SEGERA_BK" {
    cetak("  ✅ PASS: Sistem Cerdas Menangkap Sinyal Depresi / Judol Sebelum Terjadi Hal Fatal!");
} lainnya {
    cetak("  ❌ FAIL: Deteksi dini kesehatan mental gagal!");
}

// [3] Mitigasi Anak Putus Sekolah (Alpha 5 Hari Pemicu Home Visit Otomatis)
cetak("\n[3] Uji Mitigasi Anak Tidak Sekolah (ATS) & Pemicu Home Visit Otomatis:");
// Siswa menghilang 6 hari berturut-turut saat musim panen padi
misal kasus_ats = evaluasi_risiko_anak_putus_sekolah(
    "ATS-2026-03-014",
    "0089988776",
    "Dewi Lestari",
    6,
    "BEKERJA_MUSIMAN_BURUH_TANI_DAN_RENTAN_PERKAWINAN_ANAK"
);

cetak("  • Siswa Terdeteksi   :", kasus_ats.nama_siswa, "(Alpha:", kasus_ats.total_alpha_berturut_turut, "Hari Berturut-turut)");
cetak("  • Latar Belakang     :", kasus_ats.faktor_penyebab);
cetak("  • Respon Sistem      :", kasus_ats.tindakan_sekolah);
cetak("  • Status Intervensi  :", kasus_ats.status_intervensi);

jika kasus_ats.tindakan_sekolah == "SURAT_TUGAS_HOME_VISIT_WALI_KELAS_DAN_BK" {
    cetak("  ✅ PASS: Surat Tugas Kunjungan Rumah Otomatis Terbit Menyelamatkan Anak dari Putus Sekolah!");
} lainnya {
    cetak("  ❌ FAIL: Mitigasi anak putus sekolah gagal!");
}

// [4] Pengamanan Hak Asuh & Otorisasi Penjemput Siswa di Gerbang Sekolah
cetak("\n[4] Uji Verifikasi Penjemput Siswa Saat Terjadi Sengketa Hak Asuh:");
// Skenario A: Ibu kandung sah pemegang hak asuh datang menjemput
misal cek_ibu = verifikasi_izin_penjemput_gerbang(
    "PJM-001",
    "0087766554",
    "Citra Kirana",
    "Ibu Nurul Aini",
    "3516015509820001",
    "Ibu Nurul Aini",
    "3516015509820001"
);

// Skenario B: Pihak lain / pihak luar tanpa izin pengadilan mencoba membawa anak
misal cek_orang_lain = verifikasi_izin_penjemput_gerbang(
    "PJM-002",
    "0087766554",
    "Citra Kirana",
    "Orang Asing / Tanpa Surat Kuasa",
    "3516011101800005",
    "Ibu Nurul Aini",
    "3516015509820001"
);

cetak("  • Penjemput Sah (Ibu)    :", cek_ibu.status_izin_penjemputan);
cetak("  • Penjemput Tanpa Izin   :", cek_orang_lain.status_izin_penjemputan);

jika cek_ibu.status_izin_penjemputan == "DIIZINKAN_SATFAM" dan cek_orang_lain.status_izin_penjemputan == "DITOLAK_BUKAN_PENJEMPUT_SAH" {
    cetak("  ✅ PASS: Satpam Sekolah Terlindungi Prosedur Resmi, Menangkal Penculikan / Konflik Asuh!");
} lainnya {
    cetak("  ❌ FAIL: Verifikasi penjemput gagal!");
}

// [5] Layanan Hospital Schooling untuk Siswa Sakit Kronis / Rawat Inap
cetak("\n[5] Uji Hospital Schooling & Pembelajaran Adaptif Siswa Sakit Kronis:");
misal siswa_rawat = fasilitasi_siswa_sakit_kronis(
    "HOSP-2026-001",
    "0083322114",
    "Farhan Alamsyah",
    "LEUKEMIA_AKUT_KEMOTERAPI",
    "RSUD dr. Soetomo Surabaya",
    90 // Izin 3 bulan
);

cetak("  • Nama Siswa         :", siswa_rawat.nama_siswa);
cetak("  • Diagnosa Medis     :", siswa_rawat.diagnosa_medis, "di", siswa_rawat.nama_rumah_sakit);
cetak("  • Durasi Perawatan   :", siswa_rawat.durasi_perkiraan_izin, "hari");
cetak("  • Mode Pembelajaran  :", siswa_rawat.mode_kbm_adaptif);
cetak("  • Hak Kenaikan Kelas :", siswa_rawat.status_kenaikan_kelas);

jika siswa_rawat.status_kenaikan_kelas == "TERJAMIN_DENGAN_PENILAIAN_ADAPTIF" {
    cetak("  ✅ PASS: Siswa Rawat Inap Rumah Sakit Tetap Terfasilitasi Belajar & Berhak Naik Kelas!");
} lainnya {
    cetak("  ❌ FAIL: Layanan hospital schooling gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 5/5 KASUS KESEJAHTERAAN SISWA LULUS (100%)        ");
cetak("====================================================================");
