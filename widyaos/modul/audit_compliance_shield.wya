// =================================================================
// Modul Audit Compliance Shield & Anti-Temuan BPK / Inspektorat
// (Deteksi Dini 7 Temuan Klasik Pengelolaan BOSP, SIPLah, Aset & Pajak)
// =================================================================

struktur BeritaAcaraKasOpname {
    nomor_ba,
    npsn,
    tanggal_opname,
    saldo_buku_kas_tunai,
    saldo_fisik_brankas,
    selisih_fisik_vs_buku,
    status_kesesuaian, // SESUAI, LEBIH_FISIK, KURANG_FISIK
    peringatan_limit_tunai // AMAN atau MELEBIHI_BATAS_10_JUTA
}

struktur RekonsiliasiAsetBelanjaModal {
    id_belanja_arkas,
    kode_rekening_arkas,
    nama_barang,
    nominal_belanja,
    kode_register_kib,
    status_kapitalisasi // TERKAPITALISASI_KIB atau TEMUAN_ASET_SILUMAN
}

struktur RekonsiliasiPajakMengendap {
    id_transaksi,
    jenis_pajak, // PPN_PUSAT, PPH_PUSAT, PBJT_DAERAH
    nominal_pajak,
    nomor_ntpn_ntpd,
    umur_hari_sejak_pungut,
    status_setoran // TERCATAT_SETOR atau MENGENDAP_LEBIH_7_HARI
}

struktur HasilAuditKepatuhanSekolah {
    npsn_sekolah,
    skor_kepatuhan_persen, // 0 - 100%
    predikat_audit, // WAJAR_TANPA_PENGECUALIAN_WTP, WAJAR_DENGAN_PENGECUALIAN_WDP, TIDAK_WAJAR
    total_indikasi_temuan,
    daftar_catatan_temuan,
    status_bku_siap_tutup // BOLEH_TUTUP_BKU atau DILOCK_WAJIB_PERBAIKAN
}

// -------------------------------------------------------------
// [1] Pemeriksaan Kas Opname Fisik & Batas Brankas Tunai (Maks 10 Juta)
// -------------------------------------------------------------
fungsi audit_pemeriksaan_kas_opname(no_ba, npsn, saldo_buku, saldo_fisik) {
    misal selisih = saldo_fisik - saldo_buku;
    misal status_sesuai = "SESUAI";
    
    jika selisih > 0.0 {
        status_sesuai = "LEBIH_FISIK_KAS_TIDAK_TERCATAT";
    } kalau selisih < 0.0 {
        status_sesuai = "KURANG_FISIK_TEKOR_KAS";
    }
    
    // Batas toleransi kas tunai di brankas sekolah: Maksimal Rp 10.000.000
    misal status_limit = "AMAN";
    jika saldo_fisik > 10000000.0 {
        status_limit = "PERINGATAN_KAS_TUNAI_MELEBIHI_10_JUTA";
    }
    
    kembalikan BeritaAcaraKasOpname(
        no_ba,
        npsn,
        waktu(),
        saldo_buku,
        saldo_fisik,
        selisih,
        status_sesuai,
        status_limit
    );
}

// -------------------------------------------------------------
// [2] Audit Belanja Modal vs Registrasi KIB (Anti-Aset Siluman)
// -------------------------------------------------------------
fungsi audit_validasi_belanja_modal_kib(id_trx, rekening, nama_alat, nominal, register_kib) {
    misal status_kap = "TEMUAN_ASET_SILUMAN";
    
    // Jika ada nomor register KIB (KIB B Peralatan / KIB E Buku), maka sah
    jika register_kib != nihil dan register_kib != "" {
        status_kap = "TERKAPITALISASI_KIB_SAH";
    }
    
    kembalikan RekonsiliasiAsetBelanjaModal(
        id_trx,
        rekening,
        nama_alat,
        nominal,
        register_kib,
        status_kap
    );
}

// -------------------------------------------------------------
// [3] Audit Pajak Mengendap & Validasi NTPN / NTPD
// -------------------------------------------------------------
fungsi audit_validasi_setor_pajak(id_trx, jenis, nominal, ntpn_ntpd, umur_hari) {
    misal status_setor = "MENGENDAP_LEBIH_7_HARI_TEMUAN";
    
    // Jika sudah memiliki NTPN/NTPD resmi, setoran dinyatakan sah
    jika ntpn_ntpd != nihil dan ntpn_ntpd != "" {
        status_setor = "TERCATAT_SETOR_MPN_KASDA";
    } kalau umur_hari <= 7 {
        status_setor = "MASIH_DALAM_TOLERANSI_7_HARI";
    }
    
    kembalikan RekonsiliasiPajakMengendap(
        id_trx,
        jenis,
        nominal,
        ntpn_ntpd,
        umur_hari,
        status_setor
    );
}

// -------------------------------------------------------------
// [4] Evaluasi Menyeluruh Indeks Kesiapan Audit BPK (Audit Readiness)
// -------------------------------------------------------------
fungsi audit_evaluasi_kesiapan_sekolah(npsn, kas_opname, daftar_modal, daftar_pajak) {
    misal total_temuan = 0;
    misal catatan = [];
    
    // Cek 1: Kas Opname
    jika kas_opname.status_kesesuaian != "SESUAI" {
        total_temuan = total_temuan + 1;
        tambah(catatan, "Selisih fisik kas tunai di brankas sebesar Rp " + ke_teks(kas_opname.selisih_fisik_vs_buku));
    }
    jika kas_opname.peringatan_limit_tunai != "AMAN" {
        total_temuan = total_temuan + 1;
        tambah(catatan, "Kas tunai brankas Rp " + ke_teks(kas_opname.saldo_fisik_brankas) + " melebihi batas regulasi Rp 10.000.000");
    }
    
    // Cek 2: Belanja Modal Aset
    untuk m dalam daftar_modal {
        jika m.status_kapitalisasi != "TERKAPITALISASI_KIB_SAH" {
            total_temuan = total_temuan + 1;
            tambah(catatan, "Belanja Modal " + m.nama_barang + " (Rp " + ke_teks(m.nominal_belanja) + ") belum dicatat di KIB BMD");
        }
    }
    
    // Cek 3: Pajak Mengendap
    untuk p dalam daftar_pajak {
        jika p.status_setoran == "MENGENDAP_LEBIH_7_HARI_TEMUAN" {
            total_temuan = total_temuan + 1;
            tambah(catatan, "Pajak " + p.jenis_pajak + " (Rp " + ke_teks(p.nominal_pajak) + ") mengendap belum disetor > 7 hari");
        }
    }
    
    // Hitung Skor Kepatuhan
    misal skor = 100.0 - (total_temuan * 20.0);
    jika skor < 0.0 {
        skor = 0.0;
    }
    
    misal predikat = "TIDAK_WAJAR_DISCLAIMER";
    misal status_bku = "DILOCK_WAJIB_PERBAIKAN";
    
    jika total_temuan == 0 {
        predikat = "WAJAR_TANPA_PENGECUALIAN_WTP";
        status_bku = "BOLEH_TUTUP_BKU";
    } kalau total_temuan <= 2 {
        predikat = "WAJAR_DENGAN_PENGECUALIAN_WDP";
        status_bku = "BOLEH_TUTUP_DENGAN_CATATAN";
    }
    
    kembalikan HasilAuditKepatuhanSekolah(
        npsn,
        skor,
        predikat,
        total_temuan,
        catatan,
        status_bku
    );
}
