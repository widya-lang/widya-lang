// =================================================================
// Modul Tipologi Sekolah Khusus & Tata Kelola Kelembagaan Nasional
// 1. Sekolah Nasional Terintegrasi (1 Kepala Sekolah Multi-Jenjang)
// 2. Sekolah Rakyat (Sekolah Afirmasi Gratis Berasrama Dhuafa/3T)
// 3. Sekolah Garuda (Sekolah Kedinasan / Unggulan Nasional K/L Pusat)
// =================================================================

// -------------------------------------------------------------
// [MODEL 1] SEKOLAH NASIONAL TERINTEGRASI (SATU ATAP / KOMPLEKS)
// -------------------------------------------------------------
struktur KompleksTerintegrasi {
    id_kompleks,
    nama_kompleks,
    nama_kepala_sekolah,
    did_kepala_sekolah,
    daftar_jenjang_npsn, // Array NPSN: [SD, SMP, SMA/SMK]
    fasilitas_bersama
}

struktur BebanGuruLintasJenjang {
    nuptk,
    nama_guru,
    mapel,
    jam_unit_1,
    npsn_unit_1,
    jam_unit_2,
    npsn_unit_2,
    total_jjm_teragregasi,
    status_sertifikasi_tpg
}

struktur AlokasiBiayaBersama {
    id_alokasi,
    uraian_sarpras,
    total_biaya_rp,
    beban_sd_rp,
    beban_smp_rp,
    beban_sma_rp,
    metode_pembagian
}

// -------------------------------------------------------------
// [MODEL 2] SEKOLAH RAKYAT (AFIRMASI GRATIS BERASRAMA 100%)
// -------------------------------------------------------------
struktur ProfilSekolahRakyat {
    npsn,
    nama_sekolah,
    sk_pendirian_afirmasi,
    total_siswa_dhuafa,
    anggaran_apbn_bansos,
    standar_makan_harian, // 3x Sehari + Snack Gizi (Sinkron BGN)
    asrama_gratis_penuh,
    status_komersial // DILARANG_PUNGUTAN_SPP
}

struktur CalonSiswaSekolahRakyat {
    nik,
    nama,
    desil_kemiskinan_dtks, // Desil 1 (Sangat Miskin) atau Desil 2 (Miskin)
    status_kelayakan_afirmasi,
    fasilitas_diterima // Asrama, Seragam, Sepatu, Gawai Belajar
}

// -------------------------------------------------------------
// [MODEL 3] SEKOLAH GARUDA (SEKOLAH KEDINASAN / UNGGULAN K/L PUSAT)
// -------------------------------------------------------------
struktur ProfilSekolahGaruda {
    kode_kl,
    kementerian_induk, // Kemenhan, Kemenag, Kemendikdasmen, Kemenperin, KLHK, KKP
    nama_kampus_garuda,
    nomor_dipa_apbn,
    pagu_anggaran_dipa,
    sisa_anggaran_dipa,
    kuota_siswa_nasional,
    sebaran_provinsi_terpenuhi,
    kurikulum_kekhususan, // Bela Negara, Kedirgantaraan, Ketahanan Siber, Kemaritiman
    status_beasiswa_penuh
}

// -------------------------------------------------------------
// FUNGSI MODEL 1: SEKOLAH TERINTEGRASI
// -------------------------------------------------------------
fungsi terintegrasi_agregasi_jjm_guru(nuptk, nama, mapel, jam1, npsn1, jam2, npsn2) {
    misal total = jam1 + jam2;
    misal status_tpg = "BELUM_MEMENUHI";
    
    // Standar Nasional: 24 Jam Pelajaran / minggu
    jika total >= 24 {
        status_tpg = "MEMENUHI_SYARAT_TPG_24_JAM";
    }
    
    kembalikan BebanGuruLintasJenjang(
        nuptk,
        nama,
        mapel,
        jam1,
        npsn1,
        jam2,
        npsn2,
        total,
        status_tpg
    );
}

fungsi terintegrasi_alokasi_biaya_sarpras(id_trx, uraian, total_biaya, rasio_sd, rasio_smp, rasio_sma) {
    // Rasio pembagian berdasarkan persentase jumlah murid (misal 30%, 30%, 40%)
    misal beban_sd = (total_biaya * rasio_sd) / 100.0;
    misal beban_smp = (total_biaya * rasio_smp) / 100.0;
    misal beban_sma = (total_biaya * rasio_sma) / 100.0;
    
    kembalikan AlokasiBiayaBersama(
        id_trx,
        uraian,
        total_biaya,
        beban_sd,
        beban_smp,
        beban_sma,
        "PROPORSIONAL_JUMLAH_SISWA"
    );
}

// -------------------------------------------------------------
// FUNGSI MODEL 2: SEKOLAH RAKYAT
// -------------------------------------------------------------
fungsi sekolah_rakyat_verifikasi_siswa(nik, nama, desil_dtks) {
    misal status = "DITOLAK_TIDAK_MEMENUHI_KRITERIA_MISKIN";
    misal fasilitas = "NIHIL";
    
    // Hanya Desil 1 (Kemiskinan Ekstrem) dan Desil 2 yang berhak
    jika desil_dtks <= 2 {
        status = "DITERIMA_BEASISWA_PENUH_ASRAMA";
        fasilitas = "Asrama Penuh + Seragam Sepatu Gratis + Makan 3x Gizi BGN + Uang Saku";
    }
    
    kembalikan CalonSiswaSekolahRakyat(
        nik,
        nama,
        desil_dtks,
        status,
        fasilitas
    );
}

// -------------------------------------------------------------
// FUNGSI MODEL 3: SEKOLAH GARUDA PUSAT
// -------------------------------------------------------------
fungsi sekolah_garuda_realisasi_dipa(garuda, kode_mak, nominal, keterangan) {
    jika nominal > garuda.sisa_anggaran_dipa {
        kembalikan {
            "sukses": salah,
            "pesan": "Realisasi ditolak! Anggaran DIPA tidak mencukupi (Sisa: Rp " + ke_teks(garuda.sisa_anggaran_dipa) + ")"
        };
    }
    
    garuda.sisa_anggaran_dipa = garuda.sisa_anggaran_dipa - nominal;
    
    kembalikan {
        "sukses": benar,
        "kementerian": garuda.kementerian_induk,
        "nomor_dipa": garuda.nomor_dipa_apbn,
        "kode_mak": kode_mak,
        "uraian": keterangan,
        "nominal_cair": nominal,
        "sisa_dipa": garuda.sisa_anggaran_dipa
    };
}
