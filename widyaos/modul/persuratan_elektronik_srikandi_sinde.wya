// ============================================================================
// MODUL: PERSURATAN ELEKTRONIK SATUAN PENDIDIKAN (SINDE & SRIKANDI COMPLIANT)
// Sistem Tata Naskah Dinas & Kearsipan Dinamis Terintegrasi Nasional
// 
// Mendukung Standar:
// 1. SINDE Kemendikdasmen (Sistem Informasi Naskah Dinas Elektronik Pusat)
// 2. SRIKANDI Nasional (ANRI, KemenPAN-RB, BSSN, Kominfo - SPBE)
// 3. WidyaOS Sovereign Mesh (P2P Persuratan Antar-Sekolah Bebas Kuota)
// 
// Fitur Pokok:
// • Kotak Masuk Surat Elektronik Terverifikasi (Surat Edaran, Undangan, SK)
// • Agenda Surat Masuk Otomatis Berbasis Klasifikasi Kearsipan ANRI
// • Lembar Disposisi Digital Kepala Sekolah (Instruksi, Penerima, Due-Date)
// • Surat Keluar Elektronik dengan Alur Berjenjang (Konseptor -> Verifikator -> KS)
// • TTE Digital BSrE / DID & Tanda Terima Elektronik Otomatis (Read-Receipt)
// ============================================================================

struktur KotakPersuratanSekolah {
    npsn_sekolah,
    nama_sekolah,
    daftar_surat_masuk,
    daftar_disposisi_aktif,
    daftar_surat_keluar,
    total_agenda_masuk,
    total_agenda_keluar
}

struktur SuratMasukElektronik {
    id_surat_masuk,
    nomor_agenda_masuk,
    nomor_surat_pengirim,
    tanggal_surat,
    tanggal_diterima,
    instansi_pengirim,
    sumber_gateway,           // 'SINDE_KEMENDIKDASMEN', 'SRIKANDI_NASIONAL', 'WIDYAOS_P2P_MESH'
    perihal,
    kategori_surat,           // 'SURAT_EDARAN', 'SURAT_UNDANGAN', 'SURAT_PEMBERITAHUAN', 'SURAT_KEPUTUSAN'
    derajat_surat,            // 'KILAT', 'SANGAT_SEGERA', 'BIASA', 'RAHASIA'
    kode_klasifikasi_arsip,   // Standar ANRI, misal: '400.3' (Pendidikan & Kurikulum)
    hash_berkas_pdf,
    status_tte_pengirim,      // 'TERVERIFIKASI_BSRE_BSSN', 'TERVERIFIKASI_W3C_DID'
    is_sudah_dibaca,
    status_disposisi          // 'BELUM_DIDISPOSISI', 'SUDAH_DIDISPOSISI', 'TUNTAS_DITINDAKLANJUTI'
}

struktur LembarDisposisiDigital {
    id_disposisi,
    id_surat_masuk,
    nomor_surat,
    perihal,
    tanggal_disposisi,
    did_kepala_sekolah,
    daftar_penerima_tugas,    // Misal: ['WAKASEK_KURIKULUM', 'BENDAHARA_BOSP']
    instruksi_utama,          // 'TINDAKLANJUTI_SEGERA', 'HADIR_MEWAKILI', 'SIAPKAN_BAHAN', 'ARSIPKAN'
    catatan_kepsek,
    batas_waktu_tuntas,
    status_pelaksanaan,       // 'MENUNGGU_RESPON', 'SEDANG_DILAKSANAKAN', 'SELESAI_TERLAPORKAN'
    laporan_hasil_tindak_lanjut
}

struktur SuratKeluarElektronik {
    id_surat_keluar,
    nomor_agenda_keluar,
    nomor_surat_resmi,
    tanggal_surat,
    tujuan_instansi,
    perihal,
    kode_klasifikasi_arsip,
    did_konseptor,
    did_verifikator,
    did_penandatangan_ks,
    status_persetujuan,       // 'DRAFT', 'DISETUJUI_VERIFIKATOR', 'DITANDATANGANI_DIGITAL_KS'
    status_pengiriman_gateway // 'TERKIRIM_KE_SINDE_SRIKANDI', 'TERKIRIM_ANTAR_SEKOLAH'
}

struktur TandaTerimaElektronik {
    id_tanda_terima,
    id_surat,
    waktu_diterima,
    npsn_penerima,
    nama_petugas_penerima,
    status_pengakuan          // 'TERKIRIM_KEMBALI_KE_PENGIRIM_SINDE_SRIKANDI'
}

// ============================================================================
// LOGIKA BISNIS PERSURATAN ELEKTRONIK
// ============================================================================

// [1] Inisialisasi Kotak Persuratan Sekolah
fungsi inisialisasi_kotak_persuratan(npsn, nama_sekolah) {
    kembalikan KotakPersuratanSekolah(
        npsn,
        nama_sekolah,
        [],
        [],
        [],
        0,
        0
    );
}

// [2] Menerima Surat Elektronik dari Gateway SINDE / SRIKANDI / WidyaOS Mesh
fungsi terima_surat_elektronik(
    kotak,
    nomor_surat_pengirim,
    tanggal_surat,
    instansi_pengirim,
    gateway,
    perihal,
    kategori,
    derajat,
    kode_arsip,
    hash_pdf,
    status_tte
) {
    kotak.total_agenda_masuk = kotak.total_agenda_masuk + 1;
    misal no_agenda = "AGD-M/" + ke_teks(kotak.total_agenda_masuk);
    misal id_surat = "SRT-IN-" + ke_teks(kotak.total_agenda_masuk);

    misal surat_baru = SuratMasukElektronik(
        id_surat,
        no_agenda,
        nomor_surat_pengirim,
        tanggal_surat,
        "2026-03-18T10:00:00",
        instansi_pengirim,
        gateway,
        perihal,
        kategori,
        derajat,
        kode_arsip,
        hash_pdf,
        status_tte,
        benar,
        "BELUM_DIDISPOSISI"
    );

    tambah(kotak.daftar_surat_masuk, surat_baru);
    kembalikan surat_baru;
}

// [3] Penerbitan Tanda Terima Elektronik Otomatis (Receipt of Delivery)
fungsi terbitkan_tanda_terima_baca(surat, npsn, nama_petugas) {
    kembalikan TandaTerimaElektronik(
        "TTR-" + surat.id_surat_masuk,
        surat.id_surat_masuk,
        "2026-03-18T10:01:00",
        npsn,
        nama_petugas,
        "TERKIRIM_KEMBALI_KE_PENGIRIM_SINDE_SRIKANDI"
    );
}

// [4] Disposisi Digital Kepala Sekolah
fungsi buat_disposisi_kepsek(
    kotak,
    surat,
    did_ks,
    daftar_tujuan,
    instruksi,
    catatan,
    due_date
) {
    jika panjang(daftar_tujuan) == 0 {
        kembalikan "GAGAL: Penerima disposisi wajib ditentukan minimal 1 pihak!";
    }

    misal id_disp = "DSP-" + surat.id_surat_masuk;
    misal disposisi = LembarDisposisiDigital(
        id_disp,
        surat.id_surat_masuk,
        surat.nomor_surat_pengirim,
        surat.perihal,
        "2026-03-18T11:00:00",
        did_ks,
        daftar_tujuan,
        instruksi,
        catatan,
        due_date,
        "SEDANG_DILAKSANAKAN",
        ""
    );

    surat.status_disposisi = "SUDAH_DIDISPOSISI";
    tambah(kotak.daftar_disposisi_aktif, disposisi);
    kembalikan disposisi;
}

// [5] Pelaporan Tindak Lanjut Disposisi oleh Staf/Guru Penerima
fungsi selesaikan_tindak_lanjut_disposisi(
    disposisi,
    surat,
    laporan_hasil
) {
    jika laporan_hasil == "" atau laporan_hasil == nihil {
        kembalikan "GAGAL: Laporan tindak lanjut tidak boleh kosong!";
    }

    disposisi.status_pelaksanaan = "SELESAI_TERLAPORKAN";
    disposisi.laporan_hasil_tindak_lanjut = laporan_hasil;
    surat.status_disposisi = "TUNTAS_DITINDAKLANJUTI";

    kembalikan "SUKSES_DISPOSISI_TUNTAS_TERLAPOR_KE_KEPALA_SEKOLAH";
}

// [6] Alur Surat Keluar Resmi Sekolah (Drafting -> Verifikasi -> TTE KS)
fungsi buat_konsep_surat_keluar(
    kotak,
    tujuan,
    perihal,
    kode_arsip,
    did_konseptor
) {
    kotak.total_agenda_keluar = kotak.total_agenda_keluar + 1;
    misal id_keluar = "SRT-OUT-" + ke_teks(kotak.total_agenda_keluar);
    misal no_agenda = "AGD-K/" + ke_teks(kotak.total_agenda_keluar);

    misal surat_keluar = SuratKeluarElektronik(
        id_keluar,
        no_agenda,
        "DRAFT_BELUM_NOMOR",
        "2026-03-18",
        tujuan,
        perihal,
        kode_arsip,
        did_konseptor,
        "",
        "",
        "DRAFT",
        "BELUM_DIKIRIM"
    );

    tambah(kotak.daftar_surat_keluar, surat_keluar);
    kembalikan surat_keluar;
}

// [7] Verifikasi & TTE Digital Surat Keluar (Siap Kirim ke SINDE/SRIKANDI)
fungsi sahkan_surat_keluar_tte(
    surat_keluar,
    did_verifikator,
    did_ks,
    format_nomor_resmi
) {
    surat_keluar.did_verifikator = did_verifikator;
    surat_keluar.did_penandatangan_ks = did_ks;
    surat_keluar.nomor_surat_resmi = format_nomor_resmi;
    surat_keluar.status_persetujuan = "DITANDATANGANI_DIGITAL_KS";
    surat_keluar.status_pengiriman_gateway = "TERKIRIM_KE_SINDE_SRIKANDI";

    kembalikan "SUKSES_SURAT_KELUAR_SAH_BER_TTE_TERKIRIM_KE_SINDE_SRIKANDI";
}
