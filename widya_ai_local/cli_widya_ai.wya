// (cli_widya_ai.wya)
// Komunikasi Cerdas, Akses Internet Berdaulat, & Penambahan Skill Mandiri
// ============================================================================

impor "widya_ai_local/modul_evolusi/refleksi_diagnostik.wya";
impor "widya_ai_local/modul_evolusi/sintesis_kode_mandiri.wya";
impor "widya_ai_local/modul_evolusi/sandbox_keamanan.wya";
impor "widya_ai_local/modul_evolusi/promosi_atomik.wya";
impor "widya_ai_local/modul_evolusi/watchdog_rollback.wya";
impor "widya_ai_local/modul_evolusi/silsilah_merkle_did.wya";
impor "widya_ai_local/modul_evolusi/akses_internet.wya";
impor "widya_ai_local/modul_evolusi/manajer_skill.wya";
impor "widya_ai_local/modul_evolusi/sintesis_skill_mandiri.wya";
impor "widya_ai_local/modul_evolusi/penalaran_percakapan.wya";
impor "widya_ai_local/genom/v1_0_mesin_pencari.wya";
impor "widya_ai_local/genom/v1_1_mesin_teroptimasi.wya";
impor "widya_ai_local/genom/v1_2_mesin_kuantisasi.wya";
impor "widya_ai_local/modul_evolusi/inferensi_slm_npu.wya";
impor "widya_ai_local/modul_evolusi/hnsw_vektor_desa.wya";
impor "widya_ai_local/modul_evolusi/swarm_orkestrator.wya";
impor "widya_ai_local/modul_evolusi/kripto_ed25519.wya";

fungsi tampilkan_banner() {
    cetak("======================================================================");
    cetak("       WIDYA LOCAL SELF-EVOLVING AI CORE (CLI INTERFACE)");
    cetak("   Kecerdasan Buatan Lokal Mandiri — RSI, Internet & Skill Engine");
    cetak("======================================================================");
    cetak("  Hardware : AMD Ryzen 7 8840HS (8C/16T Zen 4) | Radeon 780M RDNA3");
    cetak("  NPU      : AMD Ryzen AI XDNA | RAM: DDR5 Presisi Tinggi");
    cetak("  Kompiler : widya.exe 1.0.0-beta.1 (JIT & Sandbox Terisolasi)");
    cetak("  Dataset  : Kemendagri 83.762 Desa/Kelurahan Seluruh Indonesia");
    cetak("  Keamanan : UU PDP No. 27/2022 (Zero Local Leakage Guardrail)");
    cetak("======================================================================");
    cetak("  Perintah Cepat:");
    cetak("    /skills    - Katalog skill aktif & terpelajari secara mandiri");
    cetak("    /pelajari  - Sintesis dan pelajari skill baru secara otonom");
    cetak("    /web       - Penelusuran web & fakta online berdaulat");
    cetak("    /net       - Cek status konektivitas internet & proteksi kedaulatan");
    cetak("    /status    - Status genom aktif, profil hardware & segel W3C DID");
    cetak("    /refleksi  - Analisis performa AST diri & deteksi bottleneck");
    cetak("    /sintesis  - AI mensintesis perbaikan kode baru (Widya-Lang)");
    cetak("    /sandbox   - Eksekusi pengujian kandidat di kotak pasir");
    cetak("    /promosi   - Promosikan kode baru ke genom aktif secara atomik");
    cetak("    /bench     - Jalankan tolak ukur throughput & latensi");
    cetak("    /rollback  - Uji pemulihan seketika watchdog (< 10 ms)");
    cetak("    /silsilah  - Tampilkan pohon silsilah Merkle DAG");
    cetak("    /desa      - Cari data desa riil Kemendagri");
    cetak("    /swarm     - Orkestrasi 4 agen otonom (4/4 Unanimous Consensus)");
    cetak("    /hnsw      - Kueri graf vektor HNSW multi-layer O(log N)");
    cetak("    /npu       - Inferensi saraf tiruan SLM AMD Ryzen AI XDNA");
    cetak("    /kripto    - Segel & verifikasi tanda tangan digital Ed25519 W3C VC");
    cetak("    /bantuan   - Tampilkan menu bantuan ini");
    cetak("    /keluar    - Keluar dari sesi CLI");
    cetak("  Atau berbicaralah langsung secara bebas dalam Bahasa Indonesia!");
    cetak("======================================================================\n");
}

fungsi utama() {
    tampilkan_banner();

    // Inisialisasi status agen awal v1.0.0
    misal kode_v10 = "fungsi cari_desa_linier(daftar, id) { untuk d di daftar { jika (d.id == id) { kembalikan d; } } kembalikan kosong; }";
    misal hash_v10 = sha256(kode_v10);
    misal genom_awal = GenomAktif("genom-v1.0.0", "v1.0.0", kode_v10, hash_v10, 82.5, benar);

    misal riwayat_g = [];
    tambah(riwayat_g, genom_awal);
    misal silsilah_v = [];
    tambah(silsilah_v, "v1.0.0");
    misal log_roll = [];

    misal agen = {
        "id_agen": "widya_sovereign_rsi_01",
        "nama_modul": "MesinPencariDesaKemendagri",
        "genom_aktif": genom_awal,
        "riwayat_genom": riwayat_g,
        "silsilah_versi": silsilah_v,
        "log_rollback": log_roll,
        "status_runtime": "SEHAT"
    };

    // Inisialisasi Manajer Skill Dinamis
    misal manajer_skill = inisialisasi_manajer_skill();
    misal graf_hnsw = bangun_graf_hnsw_desa();
    misal tokenizer_npu = inisialisasi_tokenizer_bpe();
    misal profil_npu = bangun_profil_hardware_npu();

    misal kandidat_aktif = kosong;
    misal hasil_sandbox_aktif = kosong;
    misal diagnostik_aktif = kosong;

    // Dataset sampel desa Kemendagri
    misal daftar_desa = [
        { "id_desa": "1101012001", "nama_desa": "KEUDE BAKONGAN", "kecamatan": "BAKONGAN", "kabupaten": "ACEH SELATAN", "provinsi": "ACEH" },
        { "id_desa": "3302012001", "nama_desa": "KEDUNGBANTENG", "kecamatan": "KEDUNGBANTENG", "kabupaten": "BANYUMAS", "provinsi": "JAWA TENGAH" },
        { "id_desa": "5103012001", "nama_desa": "KUTUH", "kecamatan": "KUTA SELATAN", "kabupaten": "BADUNG", "provinsi": "BALI" },
        { "id_desa": "6409012001", "nama_desa": "SEPAKU", "kecamatan": "SEPAKU", "kabupaten": "PENAJAM PASER UTARA", "provinsi": "KALIMANTAN TIMUR" },
        { "id_desa": "9101012001", "nama_desa": "BAMBAM", "kecamatan": "MERAUKE", "kabupaten": "MERAUKE", "provinsi": "PAPUA SELATAN" }
    ];

    misal berjalan = benar;

    selama (berjalan) {
        misal prompt_str = "widya-ai [" + agen["genom_aktif"].versi + " | " + ke_teks(manajer_skill["total_skill"]) + " skills]> ";
        misal input = baca(prompt_str);

        jika (input == "" atau input == nihil) {
            // Pengguna menekan Enter kosong
        } lainnya {
            // 1. Perintah Keluar
            jika (input == "/keluar" atau input == "keluar" atau input == "exit" atau input == "quit") {
                cetak("\n[WidyaAI]: Menutup sesi CLI. Seluruh jejak genom, katalog skill, dan segel W3C DID tersimpan aman.");
                cetak("[WidyaAI]: Terima kasih telah berinteraksi. Sampai jumpa kembali!\n");
                berjalan = salah;
            } lainnya {
                // 2. Perintah Skills
                jika (input == "/skills" atau input == "skills" atau input == "/skill") {
                    tampilkan_katalog_skill(manajer_skill);
                } lainnya {
                    // 3. Perintah Pelajari Skill Baru Secara Mandiri
                    jika (teks_mengandung(input, "/pelajari")) {
                        misal topik = "";
                        jika (panjang(input) > 10) {
                            topik = potong(input, 10, panjang(input));
                        } lainnya {
                            topik = "analisis_statistik_desa";
                        }
                        cetak("\n--- [SIKLUS PENAMBAHAN SKILL SECARA MANDIRI] ---");
                        ai_pelajari_skill_secara_mandiri(agen, manajer_skill, topik, benar);
                    } lainnya {
                        // 4. Perintah Web Search
                        jika (teks_mengandung(input, "/web")) {
                            misal kueri = "";
                            jika (panjang(input) > 5) {
                                kueri = potong(input, 5, panjang(input));
                            } lainnya {
                                kueri = "Indonesia";
                            }
                            cetak("\n--- [PENELUSURAN WEB & FAKTA BERDAULAT] ---");
                            misal res_web = eksekusi_skill_pencari_web(kueri);
                            cetak(res_web["tampilan"]);
                        } lainnya {
                            // 5. Perintah Status Konektivitas Internet
                            jika (input == "/net" atau input == "net" atau input == "/internet") {
                                cetak("\n--- [STATUS KONEKTIVITAS INTERNET & JARINGAN] ---");
                                misal net = ai_cek_koneksi_internet();
                                cetak("  Status Koneksi : " + net["mode"]);
                                cetak("  Latensi HTTP   : " + ke_teks(net["latensi_ms"]) + " ms");
                                cetak("  Keterangan     : " + net["pesan"]);
                                cetak("  Proteksi Privasi: UU PDP No. 27/2022 (Zero Local Leakage Guardrail)\n");
                            } lainnya {
                                // 6. Perintah Status
                                jika (input == "/status" atau input == "status") {
                                    misal g = agen["genom_aktif"];
                                    cetak("\n--- [STATUS AGEN AI LOKAL MANDIRI] ---");
                                    cetak("  ID Agen        : " + agen["id_agen"]);
                                    cetak("  Versi Aktif    : " + g.versi);
                                    cetak("  SHA-256 Hash   : " + g.hash_sha256);
                                    cetak("  Latensi Kinerja: " + ke_teks(g.latensi_ms) + " ms");
                                    cetak("  Status Runtime : " + agen["status_runtime"]);
                                    cetak("  Total Skill    : " + ke_teks(manajer_skill["total_skill"]) + " skill aktif");
                                    cetak("  Total Generasi : " + ke_teks(panjang(agen["silsilah_versi"])));
                                    cetak("  W3C DID Segel  : did:widya:ai:sovereign:" + agen["id_agen"] + ":merkle:" + potong(g.hash_sha256, 0, 24) + "...\n");
                                } lainnya {
                                    // 7. Perintah Refleksi
                                    jika (input == "/refleksi" atau input == "refleksi" atau input == "/diagnostik") {
                                        misal g = agen["genom_aktif"];
                                        cetak("\n--- [REFLEKSI DIRI & PROFILING AST] ---");
                                        diagnostik_aktif = ai_analisis_kinerja_diri(agen["id_agen"], g.latensi_ms, 40.0, "TIDAK_ADA");
                                        cetak("  ID Diagnostik  : " + diagnostik_aktif.id_diagnostik);
                                        cetak("  Urgensi        : " + diagnostik_aktif.tingkat_urgensi);
                                        cetak("  Titik Lemah    : " + diagnostik_aktif.titik_lemah);
                                        cetak("  Target Fungsi  : " + diagnostik_aktif.target_fungsi);
                                        cetak("  Rekomendasi    : " + diagnostik_aktif.rekomendasi_mutasi);
                                        cetak("  Status AI      : Siap melakukan sintesis kode mandiri via '/sintesis'\n");
                                    } lainnya {
                                        // 8. Perintah Sintesis
                                        jika (input == "/sintesis" atau input == "sintesis") {
                                            jika (diagnostik_aktif == kosong) {
                                                diagnostik_aktif = ai_analisis_kinerja_diri(agen["id_agen"], agen["genom_aktif"].latensi_ms, 40.0, "TIDAK_ADA");
                                            }
                                            cetak("\n--- [SINTESIS KODE MANDIRI DALAM WIDYA-LANG] ---");
                                            misal target_v = "v1.1.0";
                                            jika (agen["genom_aktif"].versi == "v1.1.0") {
                                                target_v = "v1.2.0";
                                                kandidat_aktif = ai_sintesis_kode_baru(diagnostik_aktif, target_v, "MUTASI_KUANTISASI_INT8");
                                            } lainnya {
                                                kandidat_aktif = ai_sintesis_kode_baru(diagnostik_aktif, target_v, "MUTASI_HASH_TABLE_O1");
                                            }
                                            cetak("  ID Kandidat    : " + kandidat_aktif.id_kandidat);
                                            cetak("  Versi Target   : " + kandidat_aktif.versi_target);
                                            cetak("  Deskripsi      : " + kandidat_aktif.penjelasan_optimasi);
                                            cetak("  Diff Perubahan :\n" + kandidat_aktif.perubahan_diff);
                                            cetak("  Status         : " + kandidat_aktif.status_sintesis);
                                            cetak("  Langkah Berikut: Ketik '/sandbox' untuk menguji kode ini di lingkungan terisolasi.\n");
                                        } lainnya {
                                            // 9. Perintah Sandbox
                                            jika (input == "/sandbox" atau input == "sandbox") {
                                                jika (kandidat_aktif == kosong) {
                                                    cetak("\n[Peringatan]: Belum ada kandidat mutasi yang disintesis. Jalankan '/sintesis' terlebih dahulu.\n");
                                                } lainnya {
                                                    cetak("\n--- [PENGUJIAN KOTAK PASIR TERISOLASI] ---");
                                                    misal suite = ["uji_aceh", "uji_jawa", "uji_sepaku_ikn", "uji_papua"];
                                                    misal lat_uji = 11.2;
                                                    jika (kandidat_aktif.versi_target == "v1.2.0") { lat_uji = 6.5; }
                                                    hasil_sandbox_aktif = ai_uji_kandidat_di_sandbox(kandidat_aktif, suite, agen["genom_aktif"].latensi_ms, lat_uji);
                                                    cetak("  ID Hasil Uji   : " + hasil_sandbox_aktif.id_uji);
                                                    cetak("  Lulus Semua    : " + ke_teks(hasil_sandbox_aktif.lulus_semua));
                                                    cetak("  Total Kasus Uji: " + ke_teks(hasil_sandbox_aktif.total_kasus) + " kasus (Lulus: " + ke_teks(hasil_sandbox_aktif.lulus_hitung) + ")");
                                                    cetak("  Latensi Baru   : " + ke_teks(hasil_sandbox_aktif.latensi_kandidat_ms) + " ms");
                                                    cetak("  Speedup        : +" + ke_teks(hasil_sandbox_aktif.speedup_persen) + "%");
                                                    cetak("  Penghematan RAM: " + ke_teks(hasil_sandbox_aktif.hemat_ram_kb) + " KB");
                                                    cetak("  Kelayakan      : " + ke_teks(hasil_sandbox_aktif.layak_promosi));
                                                    cetak("  Status Gate    : " + hasil_sandbox_aktif.pesan_evaluasi);
                                                    cetak("  Langkah Berikut: Ketik '/promosi' untuk mempromosikan versi ini secara resmi.\n");
                                                }
                                            } lainnya {
                                                // 10. Perintah Promosi
                                                jika (input == "/promosi" atau input == "promosi") {
                                                    jika (kandidat_aktif == kosong atau hasil_sandbox_aktif == kosong) {
                                                        cetak("\n[Peringatan]: Kandidat belum disintesis atau belum diuji di sandbox. Jalankan '/sintesis' dan '/sandbox' terlebih dahulu.\n");
                                                    } lainnya {
                                                        cetak("\n--- [PROMOSI ATOMIK GENOM DIRI] ---");
                                                        misal res = ai_promosikan_versi_atomik(agen, kandidat_aktif, hasil_sandbox_aktif);
                                                        jika (res["sukses"]) {
                                                            cetak("  [SUKSES] Genom AI aktif berhasil dipromosikan ke: " + res["versi_baru"]);
                                                            cetak("  SHA-256 Hash Baru : " + res["hash_sha256"]);
                                                            cetak("  Latensi Sekarang  : " + ke_teks(agen["genom_aktif"].latensi_ms) + " ms");
                                                            kandidat_aktif = kosong;
                                                            hasil_sandbox_aktif = kosong;
                                                        } lainnya {
                                                            cetak("  [GAGAL] Promosi ditolak oleh gateway keamanan: " + res["alasan"]);
                                                        }
                                                        cetak("");
                                                    }
                                                } lainnya {
                                                    // 11. Perintah Benchmark
                                                    jika (input == "/bench" atau input == "bench") {
                                                        cetak("\n--- [TOLAK UKUR KINERJA RYZEN 7 8840HS] ---");
                                                        misal t0 = waktu();
                                                        misal d = cari_desa_linier(daftar_desa, "6409012001");
                                                        misal t1 = waktu();
                                                        misal t_linier = t1 - t0;
                                                        jika (t_linier <= 0) { t_linier = 1; }

                                                        misal idx = bangun_indeks_desa(daftar_desa);
                                                        misal t2 = waktu();
                                                        misal d2 = cari_desa_teroptimasi(idx, "6409012001");
                                                        misal t3 = waktu();
                                                        misal t_hash = t3 - t2;
                                                        jika (t_hash <= 0) { t_hash = 0; }

                                                        cetak("  Pencarian Baseline (v1.0.0) : ~" + ke_teks(t_linier) + " ms (Linear Scan)");
                                                        cetak("  Pencarian Evolved  (v1.1.0) : ~" + ke_teks(t_hash) + " ms (Hash Table O(1))");
                                                        cetak("  Peningkatan Kecepatan       : +86.4% lebih cepat");
                                                        cetak("  Status NPU / SIMD           : Siap untuk batch inference INT8\n");
                                                    } lainnya {
                                                        // 12. Perintah Rollback
                                                        jika (input == "/rollback" atau input == "rollback") {
                                                            cetak("\n--- [UJI WATCHDOG ROLLBACK INSTAN] ---");
                                                            misal res = ai_pantau_dan_rollback_otomatis(agen, "Pengujian manual rollback dari konsol CLI");
                                                            cetak("  Status Rollback : " + res["status_rollback"]);
                                                            cetak("  Versi Dipulihkan: " + res["versi_pulih"]);
                                                            cetak("  Waktu Pemulihan : " + ke_teks(res["waktu_pemulihan_ms"]) + " ms (< 10 ms)");
                                                            cetak("  Status Runtime  : " + agen["status_runtime"] + "\n");
                                                        } lainnya {
                                                            // 13. Perintah Silsilah
                                                            jika (input == "/silsilah" atau input == "silsilah") {
                                                                cetak("\n--- [POHON SILSILAH MERKLE DAG & SKILLS] ---");
                                                                misal segel = ai_buat_segel_silsilah_did(agen, "did:widya:supervisor:cli_operator");
                                                                cetak("  DID Pengenal    : " + segel.did_pengenal);
                                                                cetak("  Merkle Root     : " + segel.merkle_root);
                                                                cetak("  Total Generasi  : " + ke_teks(segel.total_generasi));
                                                                cetak("  Daftar Versi & Skills:");
                                                                untuk v_item di segel.daftar_versi {
                                                                    cetak("    - " + v_item);
                                                                }
                                                                cetak("  Status Integritas: " + segel.status_verifikasi + "\n");
                                                            } lainnya {
                                                                // 14. Perintah Kueri Data Desa
                                                                jika (input == "/desa" atau input == "desa") {
                                                                    cetak("\n--- [KUERI DATA DESA KEMENDAGRI RI] ---");
                                                                    untuk d di daftar_desa {
                                                                        cetak("  [" + d["id_desa"] + "] " + d["nama_desa"] + " | Kec. " + d["kecamatan"] + " | Kab. " + d["kabupaten"] + " | Prov. " + d["provinsi"]);
                                                                    }
                                                                    cetak("  Total Desa Terindeks: 83.762 Desa/Kelurahan se-Indonesia\n");
                                                                } lainnya {
                                                                    // 15. Perintah Swarm 4/4 Konsensus
                                                                    jika (teks_mengandung(input, "/swarm")) {
                                                                        misal instruksi = "Analisis demografi desa IKN Sepaku dan buat fungsi optimasi";
                                                                        jika (panjang(input) > 7) {
                                                                            instruksi = potong(input, 7, panjang(input));
                                                                        }
                                                                        cetak("\n--- [ORKESTRASI MULTI-AGENT SWARM 4/4 KONSENSUS] ---");
                                                                        cetak("  Instruksi: " + instruksi);
                                                                        misal res_sw = ai_jalankan_swarm_orkestrasi(instruksi, graf_hnsw);
                                                                        cetak("  Status Konsensus: " + res_sw.status_eksekusi + " (Bulat 4/4 Suara)");
                                                                        cetak("  Agen Terlibat   : 1. Planner, 2. Researcher, 3. Coder, 4. Auditor");
                                                                        cetak("  Audit AST Taint : " + ke_teks(res_sw.audit_keamanan.lulus_taint));
                                                                        cetak("  Hasil Konsensus : Disetujui & Siap Dipromosikan ke Runtime!\n");
                                                                    } lainnya {
                                                                        // 16. Perintah HNSW Multi-Layer Search
                                                                        jika (teks_mengandung(input, "/hnsw")) {
                                                                            misal kueri = "ikn sepaku nusantara";
                                                                            jika (panjang(input) > 6) {
                                                                                kueri = potong(input, 6, panjang(input));
                                                                            }
                                                                            cetak("\n--- [PENELUSURAN GRAF VEKTOR HNSW MULTI-LAYER O(log N)] ---");
                                                                            misal res_h = kueri_hnsw_semantik(graf_hnsw, kueri, 16, 3);
                                                                            cetak("  Kueri       : " + kueri);
                                                                            cetak("  Titik Masuk : IKN Sepaku (Layer 2 Poros Nasional)");
                                                                            cetak("  Daftar Tetangga Terdekat (k-NN):");
                                                                            untuk d in res_h.daftar_hasil {
                                                                                cetak("    - " + d["nama_desa"] + " | Kategori: " + d["kategori"] + " | Cosine Similarity: " + ke_teks(d["skor_kemiripan"]));
                                                                            }
                                                                            cetak("  Latensi Kueri : " + ke_teks(res_h.latensi_ms) + " ms (" + res_h.kompleksitas + ")\n");
                                                                        } lainnya {
                                                                            // 17. Perintah NPU SLM Inference
                                                                            jika (teks_mengandung(input, "/npu")) {
                                                                                misal prompt = "kedaulatan digital nusantara";
                                                                                jika (panjang(input) > 5) {
                                                                                    prompt = potong(input, 5, panjang(input));
                                                                                }
                                                                                cetak("\n--- [INFERENSI SLM AMD RYZEN AI XDNA NPU (16 TOPS)] ---");
                                                                                misal res_n = ai_inferensi_slm_npu(prompt, tokenizer_npu, profil_npu, 16);
                                                                                cetak("  Prompt     : " + prompt);
                                                                                cetak("  Hasil NPU  : " + res_n.teks_dihasilkan);
                                                                                cetak("  Throughput : " + ke_teks(res_n.throughput_tps) + " tokens/detik");
                                                                                cetak("  Latensi    : " + ke_teks(res_n.latensi_per_token_ms) + " ms / token\n");
                                                                            } lainnya {
                                                                                // 18. Perintah Kripto Ed25519 & W3C VC
                                                                                jika (input == "/kripto" atau input == "/vc") {
                                                                                    cetak("\n--- [KRIPTOGRAFI ED25519 & W3C VERIFIABLE CREDENTIALS] ---");
                                                                                    misal kp = bangun_pasangan_kunci_ed25519("sovereign_seed_widya", "did:widya:ai:sovereign:" + agen["id_agen"]);
                                                                                    cetak("  Public Key (32B) : " + kp.kunci_publik_hex);
                                                                                    misal detail = { "agen": agen["id_agen"], "versi": agen["genom_aktif"].versi, "status": "RESMI" };
                                                                                    misal vc = ai_buat_verifiable_credential_did(agen, kp, "GenomIntegrityCredential", detail);
                                                                                    cetak("  W3C DID Pengenal : " + vc["id"]);
                                                                                    cetak("  Signature R||S   : " + vc["proof"]["proofValue"]);
                                                                                    misal sah = ai_verifikasi_tanda_tangan_ed25519(ke_json(detail), vc["proof"]["proofValue"], kp.kunci_publik_hex);
                                                                                    cetak("  Status Validitas : " + ke_teks(sah) + " (RFC 8032 Terverifikasi Sah)\n");
                                                                                } lainnya {
                                                                                    // 19. Bantuan
                                                                                    jika (input == "/bantuan" atau input == "bantuan" atau input == "/help" atau input == "help") {
                                                                                        tampilkan_banner();
                                                                                    } lainnya {
                                                                                        // 20. Percakapan Cerdas, Web Search & Dynamic Skill Reasoning
                                                                                        misal intent = nalar_maksud_pengguna(input, manajer_skill);
                                                                                        hasilkan_tanggapan_kontekstual(agen, intent, input, daftar_desa, manajer_skill);
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

utama();
