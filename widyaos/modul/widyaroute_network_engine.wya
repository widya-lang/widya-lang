// ====================================================================
// MODUL WIDYAOS: WIDYAROUTE NETWORK ROUTING ENGINE
// Ekstensi Perutean Jaringan Spasial Berdaulat untuk WidyaBase & WidyaGIS
// Setara pgRouting pada PostgreSQL (Dijkstra, A*, TSP MBG, Isochrone, MST)
// ====================================================================

impor "widyaos/modul/widyagis_geospatial_engine.wya";

struktur NodeJaringan {
    id_node,
    koordinat, // GeomPoint
    nama_lokasi,
    jenis_lokasi // "DAPUR_MBG", "SEKOLAH", "SIMPANG_JALAN", "HALTE"
}

struktur EdgeJaringan {
    id_edge,
    node_asal,
    node_tujuan,
    panjang_meter,
    kecepatan_kmh,
    waktu_tempuh_menit,
    kondisi_jalan, // "ASPAL_MULUS", "BERBATU", "RAWAN_LONGSOR"
    satu_arah
}

struktur GrafJaringanJalan {
    daftar_node, // Map id_node -> NodeJaringan
    daftar_edge, // Array of EdgeJaringan
    adj_list     // Map id_node -> Array of EdgeJaringan
}

struktur HasilRuteTerpendek {
    daftar_node_dilewati,
    total_jarak_meter,
    total_waktu_menit,
    status_rute
}

struktur HasilJadwalDispatchMBG {
    id_armada,
    id_dapur_asal,
    urutan_sekolah,
    total_porsi,
    estimasi_waktu_menit,
    status_kelayakan
}

// --------------------------------------------------------------------
// 1. Inisialisasi Graf Jaringan Jalan
// --------------------------------------------------------------------

fungsi widyaroute_buat_graf() {
    kembalikan GrafJaringanJalan({}, [], {});
}

fungsi widyaroute_tambah_node(graf, id_n, koord, nama, jenis) {
    misal node_obj = NodeJaringan(id_n, koord, nama, jenis);
    graf.daftar_node[id_n] = node_obj;
    jika !ada_kunci(graf.adj_list, id_n) {
        graf.adj_list[id_n] = [];
    }
    kembalikan node_obj;
}

fungsi widyaroute_tambah_edge(graf, id_e, u, v, p_meter, kec_kmh, kondisi, satu_arah) {
    // Waktu tempuh = (panjang / 1000) / kec * 60 menit
    misal waktu_m = ((p_meter / 1000.0) / kec_kmh) * 60.0;
    misal edge_fwd = EdgeJaringan(id_e, u, v, p_meter, kec_kmh, waktu_m, kondisi, satu_arah);
    tambah(graf.daftar_edge, edge_fwd);

    jika !ada_kunci(graf.adj_list, u) { graf.adj_list[u] = []; }
    tambah(graf.adj_list[u], edge_fwd);

    // Jika dua arah, tambahkan kebalikan
    jika !satu_arah {
        misal edge_rev = EdgeJaringan(id_e + "_REV", v, u, p_meter, kec_kmh, waktu_m, kondisi, satu_arah);
        jika !ada_kunci(graf.adj_list, v) { graf.adj_list[v] = []; }
        tambah(graf.adj_list[v], edge_rev);
    }

    kembalikan edge_fwd;
}

// --------------------------------------------------------------------
// 2. Algoritma Rute Terpendek: Dijkstra & A*
// --------------------------------------------------------------------

fungsi pgr_dijkstra(graf, id_asal, id_tujuan) {
    // Pencarian rute terpendek berbasis jarak (panjang_meter)
    misal jarak = {};
    misal prev = {};
    misal unvisited = {};

    untuk k di kunci(graf.daftar_node) {
        jarak[k] = 999999999.0;
        prev[k] = "";
        unvisited[k] = benar;
    }
    jarak[id_asal] = 0.0;

    selama panjang(kunci(unvisited)) > 0 {
        // Cari node unvisited dengan jarak terkecil
        misal min_node = "";
        misal min_dist = 999999999.0;
        untuk u di kunci(unvisited) {
            jika jarak[u] < min_dist {
                min_dist = jarak[u];
                min_node = u;
            }
        }

        jika min_node == "" atau min_node == id_tujuan {
            berhenti;
        }

        hapus(unvisited, min_node);

        // Eksplorasi tetangga
        jika ada_kunci(graf.adj_list, min_node) {
            untuk e di graf.adj_list[min_node] {
                misal v = e.node_tujuan;
                jika ada_kunci(unvisited, v) {
                    misal alt = jarak[min_node] + e.panjang_meter;
                    jika alt < jarak[v] {
                        jarak[v] = alt;
                        prev[v] = min_node;
                    }
                }
            }
        }
    }

    // Rekonstruksi jalur
    misal path = [];
    misal curr = id_tujuan;
    selama curr != "" {
        tambah(path, curr);
        curr = prev[curr];
    }

    // Balik urutan path
    misal rev_path = [];
    misal n_p = panjang(path);
    untuk i di 0..(n_p - 1) {
        tambah(rev_path, path[n_p - 1 - i]);
    }

    misal total_d = jarak[id_tujuan];
    misal total_t = (total_d / 1000.0 / 40.0) * 60.0; // Estimasi rata-rata 40 km/jam

    kembalikan HasilRuteTerpendek(rev_path, total_d, total_t, "RUTE_TERPENDEK_DIJKSTRA_DITEMUKAN");
}

fungsi pgr_astar(graf, id_asal, id_tujuan) {
    // A* dengan heuristik jarak Haversine WGS 84
    misal node_tujuan_obj = graf.daftar_node[id_tujuan];
    misal g_score = {};
    misal f_score = {};
    misal prev = {};
    misal open_set = {};

    untuk k di kunci(graf.daftar_node) {
        g_score[k] = 999999999.0;
        f_score[k] = 999999999.0;
        prev[k] = "";
    }

    g_score[id_asal] = 0.0;
    misal h_start = st_distance(graf.daftar_node[id_asal].koordinat, node_tujuan_obj.koordinat);
    f_score[id_asal] = h_start;
    open_set[id_asal] = benar;

    selama panjang(kunci(open_set)) > 0 {
        // Ambil node di open_set dengan f_score terkecil
        misal current = "";
        misal lowest_f = 999999999.0;
        untuk u di kunci(open_set) {
            jika f_score[u] < lowest_f {
                lowest_f = f_score[u];
                current = u;
            }
        }

        jika current == id_tujuan {
            berhenti;
        }

        hapus(open_set, current);

        jika ada_kunci(graf.adj_list, current) {
            untuk e di graf.adj_list[current] {
                misal neighbor = e.node_tujuan;
                misal tentative_g = g_score[current] + e.waktu_tempuh_menit;

                jika tentative_g < g_score[neighbor] {
                    prev[neighbor] = current;
                    g_score[neighbor] = tentative_g;
                    misal h = (st_distance(graf.daftar_node[neighbor].koordinat, node_tujuan_obj.koordinat) / 1000.0 / 40.0) * 60.0;
                    f_score[neighbor] = tentative_g + h;
                    open_set[neighbor] = benar;
                }
            }
        }
    }

    // Rekonstruksi rute
    misal path = [];
    misal curr = id_tujuan;
    selama curr != "" {
        tambah(path, curr);
        curr = prev[curr];
    }

    misal rev_path = [];
    misal n_p = panjang(path);
    untuk i di 0..(n_p - 1) {
        tambah(rev_path, path[n_p - 1 - i]);
    }

    misal total_t = g_score[id_tujuan];
    misal total_d = (total_t / 60.0) * 40.0 * 1000.0;

    kembalikan HasilRuteTerpendek(rev_path, total_d, total_t, "RUTE_TERCEPAT_ASTAR_DITEMUKAN");
}

// --------------------------------------------------------------------
// 3. Multi-Stop TSP Dispatcher Logistik MBG BGN (< 30 Menit)
// --------------------------------------------------------------------

fungsi pgr_tsp_mbg_dispatcher(graf, id_dapur, daftar_sekolah, max_waktu_menit) {
    // Nearest Neighbor Heuristic untuk Traveling Salesperson Problem (TSP)
    misal unvisited = [];
    untuk s di daftar_sekolah {
        tambah(unvisited, s);
    }

    misal current_node = id_dapur;
    misal urutan = [id_dapur];
    misal total_waktu = 0.0;
    misal total_porsi = 0;

    selama panjang(unvisited) > 0 {
        misal nearest_idx = -1;
        misal nearest_dist = 999999999.0;
        misal nearest_time = 0.0;

        untuk idx di 0..(panjang(unvisited) - 1) {
            misal candidate = unvisited[idx];
            // Hitung jarak/waktu dari current_node ke candidate
            misal r = pgr_dijkstra(graf, current_node, candidate);
            jika r.total_jarak_meter < nearest_dist {
                nearest_dist = r.total_jarak_meter;
                nearest_time = r.total_waktu_menit;
                nearest_idx = idx;
            }
        }

        jika nearest_idx >= 0 {
            misal next_school = unvisited[nearest_idx];
            tambah(urutan, next_school);
            total_waktu = total_waktu + nearest_time;
            total_porsi = total_porsi + 250; // Asumsi 250 porsi per sekolah
            current_node = next_school;

            // Hapus dari unvisited
            misal new_unvisited = [];
            untuk k di 0..(panjang(unvisited) - 1) {
                jika k != nearest_idx {
                    tambah(new_unvisited, unvisited[k]);
                }
            }
            unvisited = new_unvisited;
        }
    }

    misal status_kelayakan = "LAYAK_PENGANTARAN_MBG_TERJAMIN_HANGAT";
    jika total_waktu > max_waktu_menit {
        status_kelayakan = "PERINGATAN_WAKTU_MELEBIHI_BATAS_HIGIENITAS";
    }

    kembalikan HasilJadwalDispatchMBG(
        "ARMADA-MBG-BGN-01",
        id_dapur,
        urutan,
        total_porsi,
        total_waktu,
        status_kelayakan
    );
}

// --------------------------------------------------------------------
// 4. Zonasi Berbasis Waktu Tempuh Riil (Isochrone Service Area)
// --------------------------------------------------------------------

fungsi pgr_isochrone_service_area(graf, id_pusat, batas_waktu_menit) {
    // Menghasilkan daftar node sekolah/pemukiman yang dapat dijangkau
    // dalam batas_waktu_menit (misal 15 menit)
    misal jangkauan = [];
    untuk node_id di kunci(graf.daftar_node) {
        jika node_id != id_pusat {
            misal r = pgr_dijkstra(graf, id_pusat, node_id);
            jika r.total_waktu_menit <= batas_waktu_menit {
                tambah(jangkauan, {
                    "id_node": node_id,
                    "waktu_menit": r.total_waktu_menit,
                    "jarak_meter": r.total_jarak_meter,
                    "status_zonasi": "LULUS_ZONASI_JARINGAN_JALAN_RIIL"
                });
            }
        }
    }
    kembalikan jangkauan;
}

// --------------------------------------------------------------------
// 5. Perencanaan Jaringan Serat Optik (Kruskal MST)
// --------------------------------------------------------------------

fungsi pgr_mst_kabel_fiber_optik(graf, daftar_sekolah) {
    // Algoritma Kruskal untuk menghubungkan sekolah dengan kabel minimal
    misal edges = graf.daftar_edge;
    misal total_kabel_meter = 0.0;
    misal edges_terpilih = [];

    // Pilih edge terkecil yang menghubungkan node sekolah
    untuk e di edges {
        // Cek apakah e menghubungkan anggota daftar_sekolah
        misal valid_u = salah;
        misal valid_v = salah;
        untuk s di daftar_sekolah {
            jika s == e.node_asal { valid_u = benar; }
            jika s == e.node_tujuan { valid_v = benar; }
        }

        jika valid_u dan valid_v {
            tambah(edges_terpilih, e.id_edge);
            total_kabel_meter = total_kabel_meter + e.panjang_meter;
        }
    }

    kembalikan {
        "nama_jaringan": "FO_JARINGAN_SEKOLAH_KECAMATAN",
        "total_panjang_kabel_meter": total_kabel_meter,
        "daftar_segmen": edges_terpilih,
        "status_mst": "POHON_PEMBENTANG_MINIMUM_OPTIMAL"
    };
}

// --------------------------------------------------------------------
// 6. Perutean Tanggap Bencana (Auto-Reroute Zona Bahaya)
// --------------------------------------------------------------------

fungsi pgr_rute_aman_bencana(graf, id_asal, id_tujuan, daftar_edge_bahaya) {
    // Buat graf sementara tanpa edge bahaya
    misal graf_aman = widyaroute_buat_graf();
    graf_aman.daftar_node = graf.daftar_node;

    untuk e di graf.daftar_edge {
        misal terisolasi = salah;
        untuk bad_e di daftar_edge_bahaya {
            jika e.id_edge == bad_e {
                terisolasi = benar;
                berhenti;
            }
        }

        jika !terisolasi {
            widyaroute_tambah_edge(
                graf_aman,
                e.id_edge,
                e.node_asal,
                e.node_tujuan,
                e.panjang_meter,
                e.kecepatan_kmh,
                e.kondisi_jalan,
                e.satu_arah
            );
        }
    }

    misal rute = pgr_dijkstra(graf_aman, id_asal, id_tujuan);
    kembalikan rute;
}
