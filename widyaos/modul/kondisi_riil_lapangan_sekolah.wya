// ============================================================================
// MODUL: KONDISI RIIL LAPANGAN SATUAN PENDIDIKAN (GRITTY FIELD RESILIENCE)
// Mengatasi 9 Masalah Kronis Nyata yang Sering Dihadapi Sekolah di Indonesia:
// 
// 1. Buku Induk Ijazah Abadi & Pengganti Ijazah Hilang (SKPI Permendikbud)
// 2. Food Safety & Sample Checking Kantin / MBG (Sampel Saksi 2x24 Jam Anti-Racun)
// 3. Tanggap Darurat Medis & Kronologi Insiden Siswa (Rujukan Puskesmas & Asuransi)
// 4. Kelaikan Armada Bus / Perahu Sekolah & Study Tour (Uji KIR Dishub)
// 5. Mutasi Masuk/Keluar Siswa 1-Pintu (Guardrail Kuota Rombel Maks 32/36)
// 6. Bank Sampah Adiwiyata & Audit Konsumsi Listrik/Air (Efisiensi Tagihan ARKAS)
// 7. Akuntabilitas Komite & Guardrail Anti-Pungli (Dilarang Tahan Kartu Ujian/Ijazah)
// 8. Profiling Inklusi Siswa Berkebutuhan Khusus (ABK & Program Belajar Individual)
// 9. Patroli Keamanan Malam & Pengawasan Lab Komputer (Guard Patrol Asset Protection)
// ============================================================================

struktur BerkasIjazahBukuInduk {
    nisn,
    nomor_seri_ijazah,
    tahun_lulus,
    nama_lengkap,
    tempat_tanggal_lahir,
    status_serah_terima_fisik, // 'SUDAH_DIAMBIL_ALUMNI', 'TERSUSUN_DI_BRANKAS'
    nama_pengambil_ijazah,
    hash_tanda_terima_fisik
}

struktur SuratPenggantiIjazahSkpi {
    nomor_skpi,
    nisn,
    nama_pemohon,
    tahun_lulus,
    nomor_surat_laporan_polisi,
    alasan_penggantian,        // 'HILANG', 'RUSAK_TERBAKAR', 'HANYUT_BANJIR'
    did_kepala_sekolah,
    status_keabsahan
}

struktur SampelSaksiMakananMbg {
    id_sampel,
    tanggal_saji,
    nama_menu,                 // Misal: 'Nasi, Ayam Semur, Sayur Bayam, Susu'
    waktu_masuk_kulkas_kontrol,
    waktu_kadaluarsa_sampel,   // Wajib disimpan 2 x 24 jam (48 jam)
    status_uji_organoleptik,   // 'LAYAK_KONSUMSI_AROMA_RASA_NORMAL', 'TIDAK_LAYAK'
    nama_petugas_uji
}

struktur InsidenMedisDarurat {
    id_insiden,
    nisn_korban,
    nama_korban,
    lokasi_kejadian,           // Contoh: 'LAPANGAN_BASKET', 'LABORATORIUM_IPA'
    kronologi_kejadian,
    tindakan_pertama_uks,
    faskes_rujukan,            // Contoh: 'PUSKESMAS_DAWARBLANDONG'
    status_notifikasi_wali,
    klaim_asuransi_pelajar
}

struktur VerifikasiArmadaSekolah {
    id_verifikasi,
    jenis_armada,              // 'BUS_STUDY_TOUR', 'PERAHU_SEKOLAH_PULAU'
    nomor_polisi_atau_lambung,
    nomor_uji_kir_dishub,
    tanggal_kadaluarsa_kir,
    nama_sopir,
    nomor_sim_sopir,
    status_kelaikan_jalan      // 'LAIK_JALAN_DIIZINKAN_KEPSEK', 'DITOLAK_KIR_KADALUARSA'
}

struktur MutasiSiswaAntarSekolah {
    id_mutasi,
    nisn_siswa,
    sekolah_asal_npsn,
    sekolah_tujuan_npsn,
    rombel_tujuan,
    kapasitas_maksimal_rombel, // SD: 28, SMP: 32, SMA/SMK: 36
    jumlah_siswa_saat_ini,
    status_kelayakan_mutasi    // 'MUTASI_DITERIMA_KUOTA_TERSEDIA', 'DITOLAK_ROMBEL_PENUH'
}

struktur SumbanganKomiteAntiPungli {
    id_transaksi,
    nama_wali_murid,
    nominal_sumbangan,
    kategori_bantuan,          // 'SUMBANGAN_SUKARELA_PENGEMBANGAN', 'BEBAS_BIAYA_DTKS'
    apakah_kartu_ujian_tertahan // Wajib SALAH (Siswa tidak boleh dicekal ujian!)
}

// ============================================================================
// LOGIKA OPERASIONAL KONDISI RIIL
// ============================================================================

// [1] Penerbitan Surat Keterangan Pengganti Ijazah (SKPI) Resmi Permendikbud
fungsi terbitkan_skpi_ijazah_hilang(
    nomor_skpi,
    nisn,
    nama,
    tahun_lulus,
    no_polisi,
    alasan,
    did_ks
) {
    jika no_polisi == "" atau no_polisi == nihil {
        kembalikan "DITOLAK: Penerbitan SKPI wajib menyertakan Surat Keterangan Kehilangan dari Kepolisian!";
    }

    misal skpi = SuratPenggantiIjazahSkpi(
        nomor_skpi,
        nisn,
        nama,
        tahun_lulus,
        no_polisi,
        alasan,
        did_ks,
        "SKPI_SAH_BERKEKUATAN_HUKUM_PENGGANTI_IJAZAH"
    );
    kembalikan skpi;
}

// [2] Pengendalian Sampel Makanan MBG / Kantin (Penyimpanan Saksi 2 x 24 Jam)
fungsi simpan_sampel_saksi_makanan(
    id_sampel,
    tanggal,
    menu,
    petugas_uji
) {
    // Sampel disimpan selama 48 jam di kulkas kontrol untuk rujukan investigasi jika ada keluhan medis
    misal sampel = SampelSaksiMakananMbg(
        id_sampel,
        tanggal,
        menu,
        "2026-03-18 11:30 WIB",
        "2026-03-20 11:30 WIB (48 Jam Kontrol)",
        "LAYAK_KONSUMSI_AROMA_RASA_NORMAL",
        petugas_uji
    );
    kembalikan sampel;
}

// [3] Protokol Insiden Medis Darurat & Rujukan Cepat
fungsi catat_insiden_darurat_siswa(
    id_insiden,
    nisn,
    nama,
    lokasi,
    kronologi,
    tindakan_awal,
    faskes
) {
    misal insiden = InsidenMedisDarurat(
        id_insiden,
        nisn,
        nama,
        lokasi,
        kronologi,
        tindakan_awal,
        faskes,
        "NOTIFIKASI_TELEPON_DAN_WHATSAPP_TERKIRIM_KE_WALI",
        "KLAIM_ASURANSI_KECELAKAAN_PELAJAR_DIAJUKAN"
    );
    kembalikan insiden;
}

// [4] Verifikasi Uji Kelaikan Armada Bus / Study Tour (Anti-Kecelakaan)
fungsi verifikasi_armada_perjalanan(
    id_verif,
    jenis,
    plat_no,
    no_kir,
    is_kir_aktif,
    sopir,
    sim
) {
    jika is_kir_aktif == salah {
        kembalikan VerifikasiArmadaSekolah(
            id_verif,
            jenis,
            plat_no,
            no_kir,
            "KADALUARSA",
            sopir,
            sim,
            "DITOLAK_KIR_KADALUARSA_BAHAYA_KESELAMATAN"
        );
    }

    kembalikan VerifikasiArmadaSekolah(
        id_verif,
        jenis,
        plat_no,
        no_kir,
        "MASIH_BERLAKU_SAH_DISHUB",
        sopir,
        sim,
        "LAIK_JALAN_DIIZINKAN_KEPSEK"
    );
}

// [5] Guardrail Kuota Maksimal Rombel pada Mutasi Siswa (Standar Permendikbud)
fungsi validasi_kuota_mutasi_masuk(
    id_mutasi,
    nisn,
    sekolah_asal,
    sekolah_tujuan,
    rombel,
    kapasitas_maks,
    siswa_eksisting
) {
    // Jika kelas sudah penuh, tolak mutasi untuk mencegah kelas over-capacity
    jika siswa_eksisting >= kapasitas_maks {
        kembalikan MutasiSiswaAntarSekolah(
            id_mutasi,
            nisn,
            sekolah_asal,
            sekolah_tujuan,
            rombel,
            kapasitas_maks,
            siswa_eksisting,
            "DITOLAK_ROMBEL_PENUH"
        );
    }

    kembalikan MutasiSiswaAntarSekolah(
        id_mutasi,
        nisn,
        sekolah_asal,
        sekolah_tujuan,
        rombel,
        kapasitas_maks,
        siswa_eksisting,
        "MUTASI_DITERIMA_KUOTA_TERSEDIA"
    );
}

// [6] Guardrail Anti-Pungli & Anti-Cekal Ujian Siswa Kurang Mampu
fungsi validasi_sumbangan_komite(
    id_trx,
    nama_wali,
    nominal,
    is_keluarga_kurang_mampu
) {
    // Siswa dari keluarga tidak mampu (DTKS) bebas sumbangan, dan TIDAK BOLEH ditahan kartu ujiannya
    misal kategori = "SUMBANGAN_SUKARELA_PENGEMBANGAN";
    jika is_keluarga_kurang_mampu == benar {
        kategori = "PEMBEBASAN_BIAYA_AFIRMASI_DTKS";
    }

    kembalikan SumbanganKomiteAntiPungli(
        id_trx,
        nama_wali,
        nominal,
        kategori,
        salah // apakah_kartu_ujian_tertahan = SALAH (Kartu Ujian Selalu Terbit 100%)
    );
}
