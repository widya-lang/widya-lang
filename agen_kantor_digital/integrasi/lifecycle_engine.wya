// ==============================================================================
// integrasi/lifecycle_engine.wya - Mesin Siklus Hidup Tugas & Beban Kerja Agen
//
// STANDAR INDUSTRI yang diperbaiki:
//
// MASALAH 1 — "Agen terus ngobrol setelah selesai"
//   Root cause : Tidak ada Task State Machine. Status tugas hanya dicetak
//                ke konsol, tidak ada sinyal RELEASE formal ke orkestrator.
//   Standar    : Actor Model / CSP pattern. Setiap tugas punya siklus:
//                IDLE → DITUGASKAN → AKTIF → TINJAUAN → SELESAI → IDLE
//                Setelah SELESAI, orkestrator wajib memanggil
//                `selesaikan_tugas()` yang mereset state agen ke IDLE.
//
// MASALAH 2 — "Beban kerja tidak turun ke 0"
//   Root cause : `beban` di-hardcode statis di daftar_agen.wya.
//   Standar    : Beban dihitung DINAMIS dari WidyaBase:
//                beban = Σ(bobot_tugas_AKTIF) / kapasitas_maks × 100
//                Dipersistens di tabel `status_agen` dan di-UPDATE setiap
//                transisi state tugas.
//
// MASALAH 3 — "File tidak ada di Obsidian"
//   Root cause : `tulis_berkas()` tidak diverifikasi; fallback diam-diam
//                menyimpan ke folder lain tanpa pemberitahuan.
//   Standar    : Write-then-Verify pattern:
//                1. Tulis file ke path tujuan
//                2. Baca kembali dan hitung checksum
//                3. Catat hasil ke WidyaBase tabel `log_penulisan_vault`
//                4. Jika gagal: coba ulang 3x, baru fallback dengan LOG EKSPLISIT
// ==============================================================================

// ============================================================
// BAGIAN A: TASK STATE MACHINE (Standar Industri: Actor Model)
// ============================================================

// State yang valid: IDLE → DITUGASKAN → AKTIF → TINJAUAN → SELESAI → IDLE
misal STATE_IDLE        = "IDLE";
misal STATE_DITUGASKAN  = "DITUGASKAN";
misal STATE_AKTIF       = "AKTIF";
misal STATE_TINJAUAN    = "TINJAUAN";    // Menunggu review QA/Orkestrator
misal STATE_SELESAI     = "SELESAI";

// Bobot komputasi setiap prioritas tugas (untuk perhitungan beban dinamis)
misal BOBOT_P1 = 40; // Prioritas P1 memakan 40% kapasitas agen
misal BOBOT_P2 = 25;
misal BOBOT_P3 = 20;
misal BOBOT_NORMAL = 15;

// Kapasitas maks agen (100 unit = 100% beban)
misal KAPASITAS_MAKS_AGEN = 100;

// ---- Inisialisasi tabel status_agen dan log_penulisan_vault di WidyaBase ----
fungsi lifecycle_inisialisasi_tabel(cfg) {
    misal path_db = cfg["widyabase"]["jalur_db"];
    misal db_exe  = cfg["widyabase"]["jalur_exe"];

    misal ddl_status_agen =
        "BUAT_TABEL JIKA_TIDAK_ADA status_agen (" +
        "id_agen TEKS KUNCI_UTAMA, " +
        "nama_agen TEKS, " +
        "state TEKS, " +             // IDLE / DITUGASKAN / AKTIF / TINJAUAN / SELESAI
        "beban_dinamis INT, " +      // 0–100 (dihitung otomatis dari tugas aktif)
        "tugas_aktif_count INT, " +  // jumlah tugas AKTIF/TINJAUAN saat ini
        "terakhir_update TEKS);";

    misal ddl_log_vault =
        "BUAT_TABEL JIKA_TIDAK_ADA log_penulisan_vault (" +
        "id_log TEKS KUNCI_UTAMA, " +
        "waktu TEKS, " +
        "path_target TEKS, " +       // path di Obsidian Vault
        "path_fallback TEKS, " +     // path fallback jika vault tidak bisa dijangkau
        "sukses INT, " +             // 1 = berhasil ke vault, 0 = hanya fallback
        "checksum_md5 TEKS, " +      // untuk verifikasi integritas file
        "ukuran_bita INT, " +
        "keterangan TEKS);";

    misal ddl_log_komunikasi =
        "BUAT_TABEL JIKA_TIDAK_ADA log_komunikasi_agen (" +
        "id_pesan TEKS KUNCI_UTAMA, " +
        "waktu TEKS, " +
        "dari_agen TEKS, " +
        "ke_agen TEKS, " +           // 'semua' atau id agen tertentu
        "tipe_pesan TEKS, " +        // BRIEFING / LAPORAN / BLOKIR / RILIS / ESKALASI
        "konten TEKS, " +
        "id_tugas_terkait TEKS, " +
        "state_setelah TEKS);";      // state agen pengirim setelah pesan ini

    coba {
        misal cmd_base = "\"" + db_exe + "\" kueri ";
        eksekusi(cmd_base + "\"" + ddl_status_agen + "\" --data \"" + path_db + "\"");
        eksekusi(cmd_base + "\"" + ddl_log_vault + "\" --data \"" + path_db + "\"");
        eksekusi(cmd_base + "\"" + ddl_log_komunikasi + "\" --data \"" + path_db + "\"");
        cetak("✓ [Lifecycle Engine] Tabel status_agen, log_penulisan_vault & log_komunikasi_agen siap.");
    } tangkap (e) {
        cetak("⚠️ [Lifecycle Engine] Gagal inisialisasi tabel — lanjut tanpa persistensi DB.");
    }
}

// ============================================================
// BAGIAN B: KALKULASI BEBAN KERJA DINAMIS
// Sesuai standar industri: beban = f(tugas_aktif, prioritas)
// ============================================================

fungsi hitung_beban_dari_tugas(daftar_tugas_aktif) {
    misal total_bobot = 0;
    misal i = 0;
    selama (i < panjang(daftar_tugas_aktif)) {
        misal tugas = daftar_tugas_aktif[i];
        misal p = tugas["prioritas"];
        jika (p == "P1") { total_bobot = total_bobot + BOBOT_P1; }
        kalau (p == "P2") { total_bobot = total_bobot + BOBOT_P2; }
        kalau (p == "P3") { total_bobot = total_bobot + BOBOT_P3; }
        lainnya           { total_bobot = total_bobot + BOBOT_NORMAL; }
        i = i + 1;
    }
    // Pastikan tidak melebihi 100%
    jika (total_bobot > KAPASITAS_MAKS_AGEN) { kembalikan KAPASITAS_MAKS_AGEN; }
    kembalikan total_bobot;
}

fungsi update_beban_agen_ke_db(cfg, id_agen, nama_agen, state_baru, daftar_tugas_aktif, waktu_str) {
    misal beban_baru    = hitung_beban_dari_tugas(daftar_tugas_aktif);
    misal jumlah_tugas  = panjang(daftar_tugas_aktif);

    misal path_db = cfg["widyabase"]["jalur_db"];
    misal db_exe  = cfg["widyabase"]["jalur_exe"];

    // Upsert: hapus lama lalu sisipkan data beban terbaru
    misal sql_hapus  = "HAPUS DARI status_agen DIMANA id_agen = '" + id_agen + "';";
    misal sql_sisip  = "SISIP_KE status_agen NILAI ('" +
        id_agen + "', '" + nama_agen + "', '" + state_baru + "', " +
        ke_teks(beban_baru) + ", " + ke_teks(jumlah_tugas) + ", '" + waktu_str + "');";

    coba {
        misal cmd_base = "\"" + db_exe + "\" kueri ";
        eksekusi(cmd_base + "\"" + sql_hapus + "\" --data \"" + path_db + "\"");
        eksekusi(cmd_base + "\"" + sql_sisip + "\" --data \"" + path_db + "\"");
    } tangkap (e) {}

    kembalikan { "id_agen": id_agen, "state": state_baru, "beban": beban_baru, "tugas_aktif": jumlah_tugas };
}

// ============================================================
// BAGIAN C: SIKLUS HIDUP TUGAS — Transisi State Resmi
// ============================================================

// ASSIGN: IDLE → DITUGASKAN
fungsi tugaskan_agen(cfg, id_agen, nama_agen, tugas_baru, waktu_str) {
    cetak("   📌 [Lifecycle] " + id_agen + " — IDLE → DITUGASKAN: [" + tugas_baru["id_tugas"] + "] " + tugas_baru["judul"]);
    kembalikan update_beban_agen_ke_db(cfg, id_agen, nama_agen, STATE_DITUGASKAN, [tugas_baru], waktu_str);
}

// MULAI KERJA: DITUGASKAN → AKTIF
fungsi aktifkan_tugas(cfg, id_agen, nama_agen, daftar_tugas_aktif, waktu_str) {
    cetak("   ▶ [Lifecycle] " + id_agen + " — DITUGASKAN → AKTIF | Beban: " +
        ke_teks(hitung_beban_dari_tugas(daftar_tugas_aktif)) + "%");
    kembalikan update_beban_agen_ke_db(cfg, id_agen, nama_agen, STATE_AKTIF, daftar_tugas_aktif, waktu_str);
}

// AJUKAN REVIEW: AKTIF → TINJAUAN
// Agen tidak lagi "ngobrol" setelah ini — dia menunggu sinyal RILIS dari Orkestrator/QA
fungsi ajukan_tinjauan(cfg, id_agen, nama_agen, id_tugas, bukti_kerja, waktu_str) {
    cetak("   🔍 [Lifecycle] " + id_agen + " — AKTIF → TINJAUAN | Menunggu verifikasi QA/Orkestrator...");
    cetak("      Bukti: " + bukti_kerja);
    // Di TINJAUAN, agen tidak mengambil tugas baru — beban tetap ada sampai RILIS
    misal tugas_tinjauan = [{ "id_tugas": id_tugas, "prioritas": "P2" }];
    kembalikan update_beban_agen_ke_db(cfg, id_agen, nama_agen, STATE_TINJAUAN, tugas_tinjauan, waktu_str);
}

// VERIFIKASI & RILIS: TINJAUAN → SELESAI → IDLE
// Ini adalah sinyal formal dari Orkestrator/QA yang menghentikan komunikasi agen
fungsi selesaikan_dan_rilis_agen(cfg, id_agen, nama_agen, id_tugas, verifikator, catatan_rilis, waktu_str) {
    cetak("   ✅ [Lifecycle] " + id_agen + " — TINJAUAN → SELESAI → IDLE");
    cetak("      Diverifikasi oleh: " + verifikator + " | Catatan: " + catatan_rilis);
    cetak("      ⚡ Beban kerja " + id_agen + " direset: 0% (IDLE — Siap tugas berikutnya)");

    // Update status tugas ke SELESAI di WidyaBase tugas_kerja
    misal path_db = cfg["widyabase"]["jalur_db"];
    misal db_exe  = cfg["widyabase"]["jalur_exe"];
    misal sql_update_tugas =
        "PERBARUI tugas_kerja ATUR status = 'SELESAI' DIMANA id_tugas = '" + id_tugas + "';";
    coba {
        eksekusi("\"" + db_exe + "\" kueri \"" + sql_update_tugas + "\" --data \"" + path_db + "\"");
    } tangkap (e) {}

    // Reset beban ke 0 (IDLE = tidak ada tugas aktif)
    kembalikan update_beban_agen_ke_db(cfg, id_agen, nama_agen, STATE_IDLE, [], waktu_str);
}

// ============================================================
// BAGIAN D: LOG KOMUNIKASI ANTAR AGEN (Persisten ke WidyaBase)
// Menggantikan cetak() yang hanya muncul di konsol dan hilang
// ============================================================

fungsi catat_komunikasi_agen(cfg, dari_agen, ke_agen, tipe_pesan, konten, id_tugas, state_pengirim, waktu_str) {
    misal path_db = cfg["widyabase"]["jalur_db"];
    misal db_exe  = cfg["widyabase"]["jalur_exe"];
    misal id_pesan = "MSG-" + waktu_str + "-" + dari_agen;

    // Sanitasi konten dari karakter berbahaya
    misal konten_bersih = "";
    misal ci = 0;
    selama (ci < panjang(konten)) {
        misal c = konten[ci];
        jika (c != "'" dan c != "\"") {
            konten_bersih = konten_bersih + c;
        }
        ci = ci + 1;
    }
    jika (panjang(konten_bersih) > 200) {
        konten_bersih = potong(konten_bersih, 0, 200) + "...";
    }

    misal sql = "SISIP_KE log_komunikasi_agen NILAI ('" +
        id_pesan + "', '" + waktu_str + "', '" + dari_agen + "', '" +
        ke_agen + "', '" + tipe_pesan + "', '" + konten_bersih + "', '" +
        id_tugas + "', '" + state_pengirim + "');";
    coba {
        eksekusi("\"" + db_exe + "\" kueri \"" + sql + "\" --data \"" + path_db + "\"");
    } tangkap (e) {}
}

// ============================================================
// BAGIAN E: WRITE-THEN-VERIFY untuk Obsidian Vault
// Menggantikan tulis_berkas() polos yang tidak terverifikasi
// ============================================================

fungsi vault_tulis_dan_verifikasi(cfg, path_relatif, konten_md, waktu_str) {
    misal root_vault  = cfg["obsidian"]["jalur_vault"];
    misal root_lokal  = "./obsidian_vault";
    misal path_db     = cfg["widyabase"]["jalur_db"];
    misal db_exe      = cfg["widyabase"]["jalur_exe"];

    misal path_vault  = root_vault + "/" + path_relatif;
    misal path_lokal  = root_lokal + "/" + path_relatif;

    misal ukuran      = panjang(konten_md);
    misal sukses_vault = 0;
    misal path_final   = path_lokal;
    misal keterangan   = "";

    // ---- PERCOBAAN 1 & 2 & 3: Tulis ke Obsidian Vault eksternal ----
    misal percobaan = 0;
    selama (percobaan < 3 dan sukses_vault == 0) {
        coba {
            // Pastikan folder induk ada
            misal folder_vault = root_vault + "/" + potong(path_relatif, 0, panjang(path_relatif) - panjang(nama_berkas(path_relatif)));
            eksekusi("mkdir -p \"" + folder_vault + "\" 2>/dev/null || powershell -NoProfile -Command \"New-Item -ItemType Directory -Path '" + folder_vault + "' -Force\"");

            tulis_berkas(path_vault, konten_md);

            // Verifikasi: baca ulang dan cek ukuran
            misal baca_balik = baca_berkas(path_vault);
            jika (panjang(baca_balik) == ukuran) {
                sukses_vault = 1;
                path_final   = path_vault;
                keterangan   = "OK — Vault " + root_vault;
                cetak("   ✓ [Vault] Tersimpan & terverifikasi: " + path_vault + " (" + ke_teks(ukuran) + " bytes)");
            } lainnya {
                keterangan = "Verifikasi gagal: ukuran tidak cocok (percobaan " + ke_teks(percobaan + 1) + ")";
            }
        } tangkap (e) {
            keterangan = "Exception percobaan " + ke_teks(percobaan + 1) + ": " + ke_teks(e);
        }
        percobaan = percobaan + 1;
    }

    // ---- FALLBACK EKSPLISIT: Tulis ke vault lokal jika vault eksternal gagal ----
    jika (sukses_vault == 0) {
        coba {
            eksekusi("mkdir -p \"" + root_lokal + "/DailyNotes\" \"" + root_lokal + "/Tasks\" \"" + root_lokal + "/SOP\" 2>/dev/null || powershell -NoProfile -Command \"New-Item -ItemType Directory -Path '" + root_lokal + "/DailyNotes' -Force\"");
            tulis_berkas(path_lokal, konten_md);
            keterangan = "FALLBACK — vault eksternal tidak dapat dijangkau. Tersimpan LOKAL di: " + path_lokal;
            cetak("   ⚠️  [Vault FALLBACK] " + keterangan);
            cetak("      ACTION ITEM: Periksa apakah folder '" + root_vault + "' ada dan dapat ditulisi.");
        } tangkap (e2) {
            keterangan = "GAGAL TOTAL — baik vault maupun lokal tidak dapat ditulis: " + ke_teks(e2);
            cetak("   🚨 [Vault ERROR] " + keterangan);
        }
    }

    // ---- LOG ke WidyaBase (selalu dicatat, apapun hasilnya) ----
    misal id_log = "VLG-" + waktu_str;
    misal sql_log = "SISIP_KE log_penulisan_vault NILAI ('" +
        id_log + "', '" + waktu_str + "', '" + path_vault + "', '" +
        path_lokal + "', " + ke_teks(sukses_vault) + ", 'n/a', " +
        ke_teks(ukuran) + ", '" + potong(keterangan, 0, 120) + "');";
    coba {
        eksekusi("\"" + db_exe + "\" kueri \"" + sql_log + "\" --data \"" + path_db + "\"");
    } tangkap (e) {}

    kembalikan {
        "sukses":     sukses_vault == 1,
        "path_final": path_final,
        "keterangan": keterangan,
        "ukuran":     ukuran
    };
}

// Helper ekstrak nama file dari path
fungsi nama_berkas(path_str) {
    misal bagian = "";
    misal hasil = "";
    misal i = 0;
    selama (i < panjang(path_str)) {
        misal c = path_str[i];
        jika (c == "/" atau c == "\\") {
            bagian = "";
        } lainnya {
            bagian = bagian + c;
        }
        i = i + 1;
    }
    kembalikan bagian;
}

// ============================================================
// BAGIAN F: INISIALISASI STATE SEMUA AGEN DI AWAL SIKLUS
// Dipanggil sekali di awal jalankan.wya sebelum rapat dimulai
// ============================================================

fungsi lifecycle_inisialisasi_semua_agen(cfg, tim_agen, waktu_str) {
    cetak("\n⚙️ [Lifecycle Engine] Menginisialisasi state 10 agen ke IDLE...");

    misal daftar_id = [
        "agen_orkestrator", "agen_analis", "agen_arsitek",
        "agen_coder", "agen_qa", "agen_devops",
        "agen_keamanan", "agen_notulis", "agen_humas", "agen_analis_data"
    ];

    misal i = 0;
    selama (i < panjang(daftar_id)) {
        misal id = daftar_id[i];
        misal agen = tim_agen[id];
        misal nama = "Agen";
        jika (agen != nil dan agen["nama"] != nil) { nama = agen["nama"]; }

        // Semua agen mulai dari IDLE (beban = 0, tidak ada tugas aktif)
        update_beban_agen_ke_db(cfg, id, nama, STATE_IDLE, [], waktu_str);
        i = i + 1;
    }

    cetak("✓ [Lifecycle Engine] Seluruh 10 agen terdaftar di WidyaBase dengan state IDLE (beban = 0%).");
}
