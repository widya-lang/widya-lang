    cetak("    - SINTA Score 3-Year   : " + teks(sinta_score_3yr) + " (Kategori Kinerja Sangat Unggul)");

    // ------------------------------------------------------------------------
    // [3] INDEKSASI INTERNASIONAL BEREPUTASI (SCOPUS & WEB OF SCIENCE)
    // ------------------------------------------------------------------------
    cetak("\n[3] METRIK INDEKSASI INTERNASIONAL (SCOPUS & WEB OF SCIENCE):");
    misal kuartil_scopus = "Q1 (Top 25% Quartile - Terindeks Elsevier Scopus)";
    misal citescore = 12.8;
