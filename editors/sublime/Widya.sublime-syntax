%YAML 1.2
---
name: Widya
file_extensions: [wya, widya, wd]
scope: source.widya

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: keywords
    - include: types
    - include: functions

  comments:
    - match: //.*$
      scope: comment.line.double-slash.widya
    - match: /\*
      scope: punctuation.definition.comment.begin.widya
      push:
        - match: \*/
          scope: punctuation.definition.comment.end.widya
          pop: true
        - match: .
          scope: comment.block.widya

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.widya
      push:
        - match: '"'
          scope: punctuation.definition.string.end.widya
          pop: true
        - match: \\.
          scope: constant.character.escape.widya
        - match: .
          scope: string.quoted.double.widya

  numbers:
    - match: '\b0x[0-9a-fA-F]+\b'
      scope: constant.numeric.hex.widya
    - match: '\b\d+\.\d+([eE][+-]?\d+)?\b'
      scope: constant.numeric.float.widya
    - match: '\b\d+\b'
      scope: constant.numeric.integer.widya

  keywords:
    - match: '\b(fn|fungsi|let|tetapkan|misal|var|tetap|mut|const)\b'
      scope: keyword.declaration.widya
    - match: '\b(if|jika|kalau|else|lain|lainnya|match|cocokkan)\b'
      scope: keyword.control.conditional.widya
    - match: '\b(for|untuk|in|dalam|while|selama|ulang|berhenti|break|lanjut|continue)\b'
      scope: keyword.control.loop.widya
    - match: '\b(return|kembalikan|try|coba|catch|tangkap|throw|lempar)\b'
      scope: keyword.control.flow.widya
    - match: '\b(struct|struktur|enum|pilihan|impl|terapkan|trait|sifat|type|tipe)\b'
      scope: keyword.declaration.type.widya
    - match: '\b(impor|import|gunakan|use|modul|module|ekspor|export|pasok|vendor)\b'
      scope: keyword.control.import.widya
    - match: '\b(async|asinkron|await|tunggu_hasil)\b'
      scope: keyword.control.async.widya
    - match: '\b(basis_data|tabel|kueri|sisip|perbarui|hapus|indeks|transaksi|komit|batal)\b'
      scope: keyword.other.database.widya
    - match: '\b(true|false|benar|salah)\b'
      scope: constant.language.boolean.widya
    - match: '\b(null|nil|nihil|kosong)\b'
      scope: constant.language.null.widya
    - match: '\b(dan|atau|bukan)\b'
      scope: keyword.operator.logical.widya

  types:
    - match: '\b(Int|Angka|Float|String|Teks|Bool|Bolean|Array|Larik|Map|Peta|Byte|Waktu|BasisData|Hasil|Opsi|Uuid|Blob|Tabel|Kueri|Option|Result|Any|Void|Objek)\b'
      scope: entity.name.type.widya

  functions:
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\s*\()'
      scope: entity.name.function.widya
