// ============================================================================
// SIMULASI: WIDYASTAT MULTIVARIATE ANALYSIS & DISERTASI DOKTORAL S3
// Verifikasi MANOVA (Wilks' Lambda), PCA / Factor Analysis, Path Analysis SEM (Sobel),
// dan Uji Heteroskedastisitas Breusch-Pagan dengan White Robust Standard Errors
// ============================================================================

impor "widyaos/modul/widyastat_engine.wya";

fungsi utama() {
    tulis("====================================================================");
    tulis("🎓  SIMULASI: WIDYASTAT MULTIVARIATE & PhD-LEVEL RESEARCH SUITE      ");
    tulis("====================================================================");
    tulis("");

    misal total_pengujian = 4;
    misal kasus_lolos = 0;

    // -------------------------------------------------------------------------
    // KASUS 1: MANOVA (Multivariate Analysis of Variance - 2 DVs Simultan)
    // -------------------------------------------------------------------------
    tulis("[1] Uji MANOVA: Pengaruh Metode Pembelajaran terhadap Kognitif & Afektif:");
    // Kelompok 1 (Metode IFP Interaktif): Y1 = Kognitif, Y2 = Afektif
    misal k1_y1 = [85.0, 90.0, 88.0, 92.0];
    misal k1_y2 = [80.0, 85.0, 84.0, 89.0];

    // Kelompok 2 (Metode Konvensional): Y1 = Kognitif, Y2 = Afektif
    misal k2_y1 = [60.0, 65.0, 62.0, 68.0];
    misal k2_y2 = [58.0, 62.0, 60.0, 65.0];

    misal manova = widyastat_manova_2dv(k1_y1, k1_y2, k2_y1, k2_y2);
    tulis("  • Wilks' Lambda (Λ)          : " + manova.wilks_lambda + " (Kekuatan Efek Multivariat)");
    tulis("  • Pillai's Trace             : " + manova.pillai_trace);
    tulis("  • Hotelling's Trace          : " + manova.hotelling_trace);
    tulis("  • Rao's F-Aproksimasi        : " + manova.f_aproksimasi_rao);
    tulis("  • Derajat Kebebasan (df)     : df1=" + manova.df_hipotesis + ", df2=" + manova.df_galat);
    tulis("  • Estimasi p-value           : " + manova.p_value);
    tulis("  • Partial Eta Squared (ηp²)  : " + manova.partial_eta_squared);
    tulis("  • Kesimpulan MANOVA          : " + manova.interpretasi);

    jika manova.wilks_lambda < 0.15 dan manova.f_aproksimasi_rao > 15.0 dan manova.p_value <= 0.01 {
        tulis("  ✅ PASS: MANOVA Membuktikan Efek Multivariat Sangat Signifikan (Wilks' Λ < 0.15, p < 0.01)!");
        kasus_lolos = kasus_lolos + 1;
    } lainnya {
        tulis("  ❌ FAIL: Kalkulasi matriks SSCP E dan H pada MANOVA tidak tepat!");
    }
    tulis("");

    // -------------------------------------------------------------------------
    // KASUS 2: PCA & Exploratory Factor Analysis (KMO & Bartlett's Test)
    // -------------------------------------------------------------------------
    tulis("[2] Uji Reduksi Dimensi: PCA & Exploratory Factor Analysis (EFA):");
    // Korelasi 3 Variabel Indikator Kualitas Sekolah:
    // r12 = Sarpras & Mutu Guru (0.78), r13 = Sarpras & Prestasi (0.72), r23 = Guru & Prestasi (0.81)
    misal pca = widyastat_pca_analisis_faktor_3var(0.78, 0.72, 0.81, 150);

    tulis("  • Nilai KMO Sampling Adequacy: " + pca.kmo_sampling_adequacy + " (Kategori: Sangat Baik >= 0.80)");
    tulis("  • Bartlett's Test Chi-Square : " + pca.bartlett_chi_square);
    tulis("  • Bartlett's p-value         : " + pca.bartlett_p_value);
    tulis("  • Eigenvalue Komponen 1 (λ1) : " + pca.daftar_nilai_eigen[0]);
    tulis("  • Varians Kumulatif %        : " + pca.varians_kumulatif_persen + " %");
    tulis("  • Loading Faktor (PC1)       : [" + pca.matriks_loading[0] + ", " + pca.matriks_loading[1] + ", " + pca.matriks_loading[2] + "]");
    tulis("  • Kesimpulan Konstruk        : " + pca.interpretasi);

    jika pca.kmo_sampling_adequacy >= 0.80 dan pca.bartlett_chi_square > 50.0 dan pca.daftar_nilai_eigen[0] > 1.0 {
        tulis("  ✅ PASS: PCA & EFA Tervalidasi Memenuhi Syarat KMO & Bartlett Sferisitas!");
        kasus_lolos = kasus_lolos + 1;
    } lainnya {
        tulis("  ❌ FAIL: Uji kelayakan KMO atau Bartlett gagal memenuhi ambang batas!");
    }
    tulis("");

    // -------------------------------------------------------------------------
    // KASUS 3: Path Analysis SEM & Pengujian Mediasi (Sobel Test)
    // -------------------------------------------------------------------------
    tulis("[3] Uji Analisis Jalur SEM: Efek Mediasi Efikasi Guru (Sobel Test):");
    // X = Kepemimpinan Instruksional KS, M = Efikasi Diri Guru, Y = Mutu Pembelajaran
    misal x_lead = [3.0, 3.5, 4.0, 4.5, 5.0, 4.2];
    misal m_efik = [3.2, 3.8, 4.1, 4.6, 4.9, 4.4];
    misal y_mutu = [3.1, 3.6, 4.2, 4.7, 5.0, 4.5];

    misal sem = widyastat_analisis_jalur_sem(x_lead, m_efik, y_mutu);
    tulis("  • Pengaruh Langsung (c')     : " + sem.pengaruh_langsung);
    tulis("  • Pengaruh Tidak Langsung(ab): " + sem.pengaruh_tidak_langsung);
    tulis("  • Pengaruh Total (c)         : " + sem.pengaruh_total);
    tulis("  • Nilai Sobel Z-statistic    : " + sem.sobel_z_stat + " (Kritis: Z > 1.96)");
    tulis("  • Sobel p-value              : " + sem.sobel_p_value);
    tulis("  • VAF Rasio Mediasi          : " + sem.vaf_persen + " %");
    tulis("  • Status Mediasi             : " + sem.kategori_mediasi);

    jika sem.sobel_z_stat > 2.0 dan sem.sobel_p_value <= 0.05 {
        tulis("  ✅ PASS: Path Analysis Berhasil Membuktikan Mediasi Signifikan Secara Statistik!");
        kasus_lolos = kasus_lolos + 1;
    } lainnya {
        tulis("  ❌ FAIL: Sobel Test gagal mengonfirmasi efek mediasi!");
    }
    tulis("");

    // -------------------------------------------------------------------------
    // KASUS 4: Uji Heteroskedastisitas Breusch-Pagan & White Robust Standard Errors
    // -------------------------------------------------------------------------
    tulis("[4] Uji Asumsi Ekonometrika: Breusch-Pagan Test & White Robust SE:");
    misal residuals = [0.1, -0.2, 0.15, -0.1, 0.05];
    misal x1_vec = [2.0, 4.0, 1.0, 5.0, 3.0];
    misal x2_vec = [85.0, 70.0, 90.0, 75.0, 95.0];

    misal bp = widyastat_uji_breusch_pagan(residuals, x1_vec, x2_vec);
    tulis("  • Lagrange Multiplier (LM)   : " + bp.lm_statistic);
    tulis("  • Derajat Kebebasan (df)     : " + bp.df);
    tulis("  • p-value Breusch-Pagan      : " + bp.p_value);
    tulis("  • Status Asumsi Klasik       : " + bp.status_asumsi);
    tulis("  • White Robust SE (Beta 1)   : " + bp.white_robust_se_b1);
    tulis("  • White Robust SE (Beta 2)   : " + bp.white_robust_se_b2);

    jika bp.lm_statistic < 5.991 dan bp.p_value >= 0.05 {
        tulis("  ✅ PASS: Asumsi Homoskedastisitas Gauss-Markov Terpenuhi & White Robust SE Tersedia!");
        kasus_lolos = kasus_lolos + 1;
    } lainnya {
        tulis("  ❌ FAIL: Uji heteroskedastisitas mendeteksi pelanggaran yang tidak tertangani!");
    }
    tulis("");

    // -------------------------------------------------------------------------
    // REKAPITULASI
    // -------------------------------------------------------------------------
    tulis("====================================================================");
    tulis("🏆 HASIL SIMULASI:  " + kasus_lolos + " / " + total_pengujian + "  KASUS S3 MULTIVARIAT LULUS ( " + ((kasus_lolos * 100) / total_pengujian) + " %)");
    tulis("====================================================================");
}

utama();
