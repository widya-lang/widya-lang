// ============================================================================
// MODUL: JEMBATAN MUTASI SISWA BERTUNGGAKAN & ADVOKASI PIP KEMENDIKDASMEN RI
// Menjamin Hak Konstitusional Anak: Pembelajaran Siswa Tidak Boleh Terhambat
// 
// Fitur Utama:
// 1. Surat Pernyataan Hutang / Komitmen Finansial Orang Tua Ber-Materai Digital
// 2. Pemisahan Hak Pendidikan Siswa vs Kewajiban Perdata Finansial Orang Tua
// 3. Pelepasan Surat Mutasi & Sinkronisasi Dapodik Instan ke Sekolah Baru
// 4. Rekapitulasi Data Tunggakan Siswa untuk Advokasi Kebijakan Bantuan PIP
// 5. Settlement Otomatis Pelunasan Tunggakan Saat Dana PIP / Bantuan Cair
// ============================================================================

struktur SuratPernyataanHutangSiswa {
    id_surat_pernyataan,
    nomor_surat,
    nisn_siswa,
    nama_siswa,
    sekolah_asal_npsn,
    nama_sekolah_asal,
    sekolah_tujuan_npsn,
    nama_sekolah_tujuan,
    nama_wali_penanggung,
    nik_wali,
    kontak_wali,
    total_tunggakan_rp,
    rincian_komponen_tunggakan,
    skema_penyelesaian,         // 'CICILAN_MANDIRI_BERTAHAP', 'USULAN_AFIRMASI_PIP', 'KOMBINASI'
    did_kepsek_asal,
    status_pelepasan_dapodik,   // 'MUTASI_RESMI_DILEPAS_DAPODIK', 'TERKUNCI'
    status_hak_belajar          // 'HAK_BELAJAR_DIJAMIN_100_PERSEN_LANCAR'
}

struktur UsulanAfirmasiPipSiswa {
    id_usulan_pip,
    nisn_siswa,
    nama_siswa,
    jenjang_pendidikan,         // 'SD', 'SMP', 'SMA', 'SMK'
    status_ekonomi_keluarga,    // 'DTKS_DESIL_1_MISKIN_EKSTREM', 'DTKS_DESIL_2', 'RENTAN_MISKIN'
    total_tunggakan_tercatat,
    nominal_bantuan_pip_tahunan,
    rekomendasi_kebijakan,      // 'PRIORITAS_1_INTERVENSI_PENYALURAN_PIP'
    status_verifikasi_puslapdik // 'TERVERIFIKASI_SIAP_SALUR_KEMENDIKDASMEN'
}

struktur RekapitulasiKebijakanBantuan {
    total_siswa_mutasi_menunggak,
    total_nominal_tunggakan_wilayah,
    jumlah_sekolah_asal_swasta,
    rekomendasi_alokasi_pip_rupiah,
    status_kebijakan
}

// ============================================================================
// LOGIKA OPERASIONAL JEMBATAN MUTASI & ADVOKASI PIP
// ============================================================================

// [1] Penerbitan Surat Pernyataan Hutang & Pemisahan Hak Anak dari Utang Perdata
fungsi terbitkan_surat_pernyataan_hutang_mutasi(
    id_surat,
    nomor_surat,
    nisn,
    nama_siswa,
    npsn_asal,
    nama_asal,
    npsn_tujuan,
    nama_tujuan,
    nama_wali,
    nik_wali,
    kontak_wali,
    total_tunggakan,
    rincian,
    skema,
    did_ks_asal
) {
    jika total_tunggakan <= 0.0 {
        kembalikan "GAGAL: Nominal tunggakan harus lebih besar dari 0!";
    }

    // Menerbitkan Surat Pernyataan Resmi:
    // Kewajiban finansial diakui secara hukum oleh Orang Tua, 
    // namun hak anak mutasi ke sekolah baru dijamin bebas hambatan 100%
    misal surat = SuratPernyataanHutangSiswa(
        id_surat,
        nomor_surat,
        nisn,
        nama_siswa,
        npsn_asal,
        nama_asal,
        npsn_tujuan,
        nama_tujuan,
        nama_wali,
        nik_wali,
        kontak_wali,
        total_tunggakan,
        rincian,
        skema,
        did_ks_asal,
        "MUTASI_RESMI_DILEPAS_DAPODIK",
        "HAK_BELAJAR_DIJAMIN_100_PERSEN_LANCAR"
    );

    kembalikan surat;
}

// [2] Pelepasan Surat Keterangan Pindah Sekolah (Dapodik Mutasi Out)
fungsi eksekusi_pelepasan_mutasi_sekolah_lama(surat_pernyataan) {
    jika surat_pernyataan.status_hak_belajar != "HAK_BELAJAR_DIJAMIN_100_PERSEN_LANCAR" {
        kembalikan "DITOLAK: Hak belajar anak belum dijamin!";
    }

    kembalikan "SUKSES_SISWA_RESMI_DIMUTASIKAN_DAPODIK_SIAP_DITARIK_SEKOLAH_BARU";
}

// [3] Advokasi Usulan Bantuan PIP Berdasarkan Catatan Tunggakan Riil
fungsi ajukan_tunggakan_ke_basis_data_pip(
    id_usulan,
    surat_pernyataan,
    jenjang,
    desil_ekonomi
) {
    misal nominal_pip = 750000.0; // Default SMP (Rp 750.000/tahun)
    jika jenjang == "SD" {
        nominal_pip = 450000.0;
    }
    jika jenjang == "SMA" atau jenjang == "SMK" {
        nominal_pip = 1800000.0;
    }

    misal usulan = UsulanAfirmasiPipSiswa(
        id_usulan,
        surat_pernyataan.nisn_siswa,
        surat_pernyataan.nama_siswa,
        jenjang,
        desil_ekonomi,
        surat_pernyataan.total_tunggakan_rp,
        nominal_pip,
        "PRIORITAS_1_INTERVENSI_PENYALURAN_PIP",
        "TERVERIFIKASI_SIAP_SALUR_KEMENDIKDASMEN"
    );

    kembalikan usulan;
}

// [4] Rekapitulasi Data Tunggakan Seluruh Wilayah untuk Dasar Kebijakan Pemerintah
fungsi rekapitulasi_tunggakan_untuk_dinas(daftar_surat_tunggakan) {
    misal total_nominal = 0.0;
    misal jumlah_siswa = panjang(daftar_surat_tunggakan);

    untuk s in daftar_surat_tunggakan {
        total_nominal = total_nominal + s.total_tunggakan_rp;
    }

    kembalikan RekapitulasiKebijakanBantuan(
        jumlah_siswa,
        total_nominal,
        1, // Sekolah asal swasta terdampak
        total_nominal,
        "REKOMENDASI_ALOKASI_DANA_AFIRMASI_PIP_DAN_BOSDA_PEMDA"
    );
}

// [5] Penyelesaian (Settlement) Tunggakan Saat Dana PIP Cair ke Rekening Siswa
fungsi selesaikan_tunggakan_via_pencairan_pip(
    surat_pernyataan,
    nominal_cair_pip,
    tanggal_cair
) {
    misal sisa_tunggakan = surat_pernyataan.total_tunggakan_rp - nominal_cair_pip;
    jika sisa_tunggakan <= 0.0 {
        sisa_tunggakan = 0.0;
    }

    kembalikan {
        "nisn": surat_pernyataan.nisn_siswa,
        "nominal_disalurkan_ke_sekolah_lama": nominal_cair_pip,
        "sisa_kewajiban_wali": sisa_tunggakan,
        "status_pelunasan": "TERBAYARKAN_SEBAGIAN_ATAU_LUNAS_DARI_PIP",
        "tanggal_penyelesaian": tanggal_cair
    };
}
