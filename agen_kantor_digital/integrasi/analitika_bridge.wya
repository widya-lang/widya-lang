// ---- HELPERS ----

fungsi _format_persen(nilai) {
    misal bulat = ke_angka(nilai);
    jika (bulat == nil) { kembalikan "0.0%"; }
    kembalikan ke_teks(bulat) + "%";
}

fungsi _baris_tabel_md(kolom_list) {
    misal baris = "| ";
    misal i = 0;
    selama (i < panjang(kolom_list)) {
        baris = baris + kolom_list[i] + " | ";
        i = i + 1;
    }
    kembalikan baris + "\n";
}

// ---- SNAPSHOT PORTOFOLIO (dipanggil saat Rapat Pagi) ----

fungsi analitika_snapshot_portofolio(cfg, tim_agen) {
    cetak("\n📊 [agen_analis_data] Menyusun Snapshot Portofolio untuk Briefing Pagi...");

    // Data status tugas saat ini (simulasi kueri WidyaBase)
    misal distribusi_tugas = {
        "VERIFIED":     5,
        "IN_PROGRESS":  2,
        "TERTUNDA":     1,
        "TODO":         3
    };
    misal total_tugas = 11;
    misal persen_selesai = ke_angka(45); // (5/11) * 100

    // Data progres proyek aktif
    misal proyek_aktif = [
        { "kode": "PRJ-WIDYA-KOP-01", "nama": "Koperasi Digital Sovereign",   "progres": 72, "status": "ON_TRACK" },
        { "kode": "PRJ-ARKAS-WEB-01", "nama": "Sistem ARKAS Web Terintegrasi", "progres": 55, "status": "AT_RISK"  },
        { "kode": "PRJ-WIDYA-INV-02", "nama": "Inventaris UMKM Nusantara",     "progres": 88, "status": "ON_TRACK" }
    ];

    // Deteksi proyek berisiko (< 60% atau AT_RISK)
    misal peringatan_proyek = [];
    misal j = 0;
    selama (j < panjang(proyek_aktif)) {
        misal prj = proyek_aktif[j];
        jika (prj["status"] == "AT_RISK" atau prj["progres"] < 60) {
            tambah(peringatan_proyek, "⚠️ [" + prj["kode"] + "] " + prj["nama"] + " hanya " + ke_teks(prj["progres"]) + "% — Perlu eskalasi!");
        }
        j = j + 1;
    }

    cetak("   ▶ Total Tugas Aktif   : " + ke_teks(total_tugas));
    cetak("   ▶ Tugas Terverifikasi : " + ke_teks(distribusi_tugas["VERIFIED"]) + " (" + _format_persen(persen_selesai) + " selesai)");
    cetak("   ▶ Masih Berjalan      : " + ke_teks(distribusi_tugas["IN_PROGRESS"]));
    cetak("   ▶ Tertunda (Blocker)  : " + ke_teks(distribusi_tugas["TERTUNDA"]));

    jika (panjang(peringatan_proyek) > 0) {
        cetak("\n   🚨 PERINGATAN PROYEK AT-RISK:");
        misal k = 0;
        selama (k < panjang(peringatan_proyek)) {
            cetak("   " + peringatan_proyek[k]);
            k = k + 1;
        }
    } lainnya {
        cetak("   ✅ Semua proyek on-track. Tidak ada eskalasi diperlukan.");
    }

    kembalikan {
        "distribusi":      distribusi_tugas,
        "total":           total_tugas,
        "persen_selesai":  persen_selesai,
        "proyek":          proyek_aktif,
        "peringatan":      peringatan_proyek
    };
}

// ---- DASHBOARD ANALITIKA HARIAN (dipanggil saat Rapat Malam) ----

fungsi analitika_susun_dashboard_harian(cfg, tim_agen, tanggal_str, skor_efektivitas_hari_ini) {
    cetak("\n📈 [agen_analis_data] Menyusun Dashboard Analitika Harian: " + tanggal_str + "...");

    // Simulasi data historis skor efektivitas (3 hari terakhir dari WidyaBase)
    misal histori_skor = [
        { "tanggal": "2026-09-27", "skor": 91.2 },
        { "tanggal": "2026-09-28", "skor": 85.7 },
        { "tanggal": "2026-09-29", "skor": skor_efektivitas_hari_ini }
    ];

    // Grafik ASCII tren efektivitas
    misal grafik_ascii = "```\n";
    grafik_ascii = grafik_ascii + "Tren Skor Efektivitas Tim (3 Hari Terakhir)\n";
    grafik_ascii = grafik_ascii + "─────────────────────────────────────────────\n";
    misal hi = 0;
    selama (hi < panjang(histori_skor)) {
        misal entry = histori_skor[hi];
        misal skor_val = entry["skor"];
        misal bar_len = ke_angka(skor_val) / 5; // Skala: 100% = 20 karakter
        misal bar = "";
        misal bi = 0;
        selama (bi < bar_len) {
            bar = bar + "█";
            bi = bi + 1;
        }
        jika (skor_val >= 90) { bar = bar + " 🟢"; }
        kalau (skor_val >= 75) { bar = bar + " 🟡"; }
        lainnya { bar = bar + " 🔴"; }
        grafik_ascii = grafik_ascii + entry["tanggal"] + " | " + bar + " " + ke_teks(skor_val) + "%\n";
        hi = hi + 1;
    }
    grafik_ascii = grafik_ascii + "```\n";

    // Analisis beban kerja per agen
    misal tabel_beban = "";
    tabel_beban = tabel_beban + "| ID Agen | Jabatan | Beban (%) | Status |\n";
    tabel_beban = tabel_beban + "| :--- | :--- | :---: | :--- |\n";
    tabel_beban = tabel_beban + "| `agen_orkestrator` | Mandor Utama | 80% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_analis` | Analis Bisnis | 70% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_arsitek` | Arsitek Sistem | 75% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_coder` | Lead Developer | 90% | 🟡 Tinggi |\n";
    tabel_beban = tabel_beban + "| `agen_qa` | QA Tester | 85% | 🟡 Tinggi |\n";
    tabel_beban = tabel_beban + "| `agen_devops` | DevOps SRE | 65% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_keamanan` | Auditor Siber | 70% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_notulis` | Notulis Obsidian | 60% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_humas` | Humas Telegram | 60% | 🟢 Normal |\n";
    tabel_beban = tabel_beban + "| `agen_analis_data` | Analis Data | 75% | 🟢 Normal |\n";

    // Rekomendasi strategis berdasarkan data
    misal rekomendasi = "";
    jika (skor_efektivitas_hari_ini >= 90) {
        rekomendasi = "✅ **Kinerja Optimal**: Tim berada di zona hijau. Rekomendasikan penambahan fitur kompleks baru pada sprint berikutnya.";
    } kalau (skor_efektivitas_hari_ini >= 75) {
        rekomendasi = "🟡 **Kinerja Baik**: `agen_coder` berada di kapasitas 90%. Rekomendasikan distribusi beban: alihkan 1 tugas koding ke `agen_arsitek` untuk modul scaffolding.";
    } lainnya {
        rekomendasi = "🔴 **PERINGATAN KINERJA**: Skor di bawah 75%! Rekomendasikan sesi debugging darurat jam 09:00 besok. `agen_orkestrator` harap mengadakan sidang kilat.";
    }

    // Susun dokumen Markdown lengkap
    misal md = "# 📊 Dashboard Analitika Harian — " + tanggal_str + "\n\n";
    md = md + "> **Disusun oleh:** `agen_analis_data` (SOP-10) | **Waktu:** 20:00 WIB | **Sumber Data:** WidyaBase v1.0.0\n\n";
    md = md + "---\n\n";

    md = md + "## 📈 Tren Skor Efektivitas (3 Hari)\n\n";
    md = md + grafik_ascii + "\n";

    md = md + "## ⚖️ Matriks Beban Kerja 10 AI Agent\n\n";
    md = md + tabel_beban + "\n";

    md = md + "## 🎯 Distribusi Status Tugas Portofolio\n\n";
    md = md + "| Status | Jumlah | Persentase |\n";
    md = md + "| :--- | :---: | :---: |\n";
    md = md + "| ✅ Terverifikasi (VERIFIED) | 5 | 45.5% |\n";
    md = md + "| 🔄 Sedang Berjalan (IN_PROGRESS) | 2 | 18.2% |\n";
    md = md + "| ⏳ Tertunda/Blocker (TERTUNDA) | 1 | 9.1% |\n";
    md = md + "| 📋 Belum Mulai (TODO) | 3 | 27.3% |\n\n";

    md = md + "## 💡 Rekomendasi Strategis `agen_analis_data`\n\n";
    md = md + rekomendasi + "\n\n";

    md = md + "---\n";
    md = md + "*Laporan ini digenerate otomatis oleh Mesin Analitika Widya-Lang v1.0.0.*\n";

    // Simpan ke Obsidian Vault
    misal vault_dir = "C:/Satriyo/Vault";
    jika (cfg != nil dan cfg["obsidian"] != nil dan cfg["obsidian"]["jalur_vault"] != nil) {
        vault_dir = cfg["obsidian"]["jalur_vault"];
    }
    misal target_file = vault_dir + "/DailyNotes/" + tanggal_str + "-Analitika.md";
    misal local_file = "obsidian_vault/DailyNotes/" + tanggal_str + "-Analitika.md";

    coba {
        tulis_berkas(target_file, md);
        tulis_berkas(local_file, md);
        cetak("   ✓ Dashboard analitika tersimpan: " + target_file);
    } tangkap (e) {
        cetak("   [Analitika] Fallback penyimpanan lokal: " + local_file);
        coba { tulis_berkas(local_file, md); } tangkap (e2) {}
    }

    cetak("   ✓ Rekomendasi strategis: " + rekomendasi);
    kembalikan {
        "skor_hari_ini":    skor_efektivitas_hari_ini,
        "histori_skor":     histori_skor,
        "rekomendasi":      rekomendasi,
        "path_dashboard":   target_file
    };
}

// ---- DETEKSI ANOMALI (dipanggil saat Rapat Malam) ----

fungsi analitika_deteksi_anomali(cfg, skor_hari_ini, skor_kemarin) {
    misal threshold_merah = 75.0;
    misal anomali_terdeteksi = salah;
    misal pesan_anomali = "";

    // Anomali 1: Skor di bawah threshold 2 hari berturut-turut
    jika (skor_hari_ini < threshold_merah dan skor_kemarin < threshold_merah) {
        anomali_terdeteksi = benar;
        pesan_anomali = "🚨 ANOMALI KRITIS: Skor efektivitas tim di bawah " + ke_teks(threshold_merah) + "% selama 2 hari berturut-turut! (" + ke_teks(skor_kemarin) + "% kemarin → " + ke_teks(skor_hari_ini) + "% hari ini)";
        cetak("   " + pesan_anomali);
    }

    // Anomali 2: Penurunan drastis (> 15% dalam 1 hari)
    misal penurunan = skor_kemarin - skor_hari_ini;
    jika (penurunan > 15) {
        anomali_terdeteksi = benar;
        pesan_anomali = "⚡ PERINGATAN PENURUNAN MENDADAK: Skor turun " + ke_teks(penurunan) + " poin dalam 1 hari! Harap investigasi blocker segera.";
        cetak("   " + pesan_anomali);
    }

    jika (bukan anomali_terdeteksi) {
        cetak("   ✅ [Anomali Check] Tidak ada anomali terdeteksi. Tim beroperasi normal.");
    }

    kembalikan {
        "anomali": anomali_terdeteksi,
        "pesan":   pesan_anomali
    };
}
