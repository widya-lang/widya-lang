// ============================================================================
// SUITE SIMULASI: INTEGRASI WARTEK-ID SDS SIPLAH KEMENDIKDASMEN RI
// Menguji Kepatuhan Standar Wartek-ID SDS SIPLah Kemendikdasmen:
// 1. SSO SDS Hak Akses Kepsek vs Bendahara BOS/BOP
// 2. Pemetaan Pembelanjaan SSH & Puskurbuk HET Buku Zona
// 3. Tax Engine PMK 58/2022 (Non-FTZ vs FTZ Batam Tag 101 Bebas PPN)
// 4. State Machine Event Agregasi SIPLah
// 5. Standar Dokumen Pengadaan PDF & Kuota Ukuran
// ============================================================================

impor "widyaos/modul/siplah_sds_wartek.wya";

cetak("====================================================================");
cetak("🚀 SIMULASI PENGUJIAN: INTEGRASI WARTEK-ID SDS SIPLAH KEMENDIKDASMEN");
cetak("====================================================================");

// ------------------------------------------------------------------------
// TEST 1: SSO SDS RBAC (Kepala Sekolah vs Bendahara BOS)
// ------------------------------------------------------------------------
cetak("\n[UJI 1] Verifikasi Role Based Access Control (RBAC) SSO SDS Kemendikdasmen:");
misal izin_kepsek_spk = cek_izin_sso_sds("Kepala Sekolah", "PERIKATAN_SPK");
misal izin_bendahara_cart = cek_izin_sso_sds("Bendahara BOS/BOP", "BELANJA_KERANJANG");
misal izin_bendahara_spk = cek_izin_sso_sds("Bendahara BOS/BOP", "PERIKATAN_SPK");
misal izin_guru_cart = cek_izin_sso_sds("Guru Mata Pelajaran", "BELANJA_KERANJANG");

jika izin_kepsek_spk == benar dan izin_bendahara_cart == benar dan izin_bendahara_spk == salah dan izin_guru_cart == salah {
    cetak("  ✅ PASS: RBAC SSO SDS Sesuai Regulasi (Bendahara dibatasi s/d keranjang/nego, Kepsek berwenang SPK/BAST, Guru ditolak).");
} lainnya {
    cetak("  ❌ FAIL: Pelanggaran otorisasi SSO SDS!");
}

// ------------------------------------------------------------------------
// TEST 2: Pemetaan Pembelanjaan (Validasi SSH & HET Buku Puskurbuk)
// ------------------------------------------------------------------------
cetak("\n[UJI 2] Verifikasi Halaman Pemetaan Pembelanjaan (SSH & HET Puskurbuk):");
// Kasus A: Buku BTP melampaui HET Zona
misal val_buku_mahal = validasi_pemetaan_arkas_ssh(
    120000.0, // Harga penawaran rekanan
    150000.0, // Plafon SSH
    1,        // Tipe Buku
    95000.0,  // HET Resmi Zona Kemendikdasmen
    50000000.0,
    1200000.0
);

// Kasus B: Barang melampaui SSH Daerah
misal val_barang_over_ssh = validasi_pemetaan_arkas_ssh(
    4500000.0, // Harga laptop rekanan
    3000000.0, // Plafon SSH Pemda
    2,         // Tipe Non-Buku
    0.0,
    50000000.0,
    4500000.0
);

// Kasus C: Sesuai SSH & Plafon ARKAS
misal val_lolos = validasi_pemetaan_arkas_ssh(
    250000.0,  // Meja siswa
    300000.0,  // Plafon SSH
    2,
    0.0,
    10000000.0, // Anggaran ARKAS tersedia
    5000000.0   // Total belanja (20 meja)
);

jika val_buku_mahal != "LOLOS_VALIDASI_PEMETAAN" dan val_barang_over_ssh != "LOLOS_VALIDASI_PEMETAAN" dan val_lolos == "LOLOS_VALIDASI_PEMETAAN" {
    cetak("  ✅ PASS: Guardrail Pemetaan Pembelanjaan Berhasil Menolak Markup di Atas HET Buku & SSH Daerah!");
} lainnya {
    cetak("  ❌ FAIL: Guardrail pemetaan pembelanjaan bocor!");
}

// ------------------------------------------------------------------------
// TEST 3: Tax Engine PMK 58/2022 (Non-FTZ Jakarta vs FTZ Batam Tag 101)
// ------------------------------------------------------------------------
cetak("\n[UJI 3] Verifikasi Tax Engine PMK 58/2022 (Sekolah Non-FTZ vs Sekolah FTZ Batam):");
// Transaksi Non-FTZ: Subtotal kena PPN 10.000.000, Ongkir 100.000, Denda 50.000
misal faktur_non_ftz = hitung_pajak_siplah_sds(
    "TRX-JKT-001",
    10000000.0,
    0.0,
    100000.0,
    salah, // Non-FTZ
    50000.0,
    0.11, // PPN 11%
    0.005 // PPh 22 0.5%
);

// Transaksi FTZ Batam (Tag 101): Bebas PPN (DPP PPN = 0, PPN = 0)
misal faktur_ftz = hitung_pajak_siplah_sds(
    "TRX-BTM-001",
    10000000.0,
    0.0,
    100000.0,
    benar, // FTZ Batam
    50000.0,
    0.11,
    0.005
);

cetak("  • Faktur Non-FTZ Grand Total: Rp", faktur_non_ftz.grand_total, "| PPN: Rp", faktur_non_ftz.ppn_nominal);
cetak("  • Faktur FTZ Batam Grand Total: Rp", faktur_ftz.grand_total, "| PPN: Rp", faktur_ftz.ppn_nominal, "(Tag:", faktur_ftz.ppn_tag_school, ")");

jika faktur_non_ftz.ppn_nominal > 0.0 dan faktur_ftz.ppn_nominal == 0.0 dan faktur_ftz.ppn_tag_school == 101 {
    cetak("  ✅ PASS: Skema Perpajakan PMK 58/2022 & Pembebasan PPN Kawasan Perdagangan Bebas (FTZ) 100% Akurat!");
} lainnya {
    cetak("  ❌ FAIL: Kesalahan kalkulasi PPN/FTZ!");
}

// ------------------------------------------------------------------------
// TEST 4: Event State Machine Rekonsiliasi (API Agregasi & Recon)
// ------------------------------------------------------------------------
cetak("\n[UJI 4] Verifikasi State Machine Rekonsiliasi Transaksi (API Agregasi/Recon):");
misal transisi_1 = validasi_transisi_event_siplah("TRANSACTION_CREATED", "ORDER_PROCESSED");
misal transisi_2 = validasi_transisi_event_siplah(transisi_1, "ORDER_SHIPPED");
misal transisi_ilegal = validasi_transisi_event_siplah("TRANSACTION_CREATED", "BAST_GENERATED");

jika transisi_2 == "TRANSACTION_SHIPPED" dan transisi_ilegal != "TRANSACTION_BAST_GENERATED" {
    cetak("  ✅ PASS: State Machine Transaksi SIPLah Melindungi Urutan Event Legal (BAST dilarang sebelum barang tiba)!");
} lainnya {
    cetak("  ❌ FAIL: Anomali pada urutan state transaksi!");
}

// ------------------------------------------------------------------------
// TEST 5: Standar Dokumen Pengadaan PDF & Validasi Kuota Ukuran
// ------------------------------------------------------------------------
cetak("\n[UJI 5] Verifikasi Standar Unggah Dokumen PDF Pengadaan PBJ:");
misal doc_bast_valid = verifikasi_dokumen_unggah_siplah("BAST", "pdf", 2.1);
misal doc_bast_kegedean = verifikasi_dokumen_unggah_siplah("BAST", "pdf", 4.5); // Maks 3 MB
misal doc_bukan_pdf = verifikasi_dokumen_unggah_siplah("BAST", "jpg", 1.2);

jika doc_bast_valid == "DOKUMEN_VALID_SIAP_UNGGAH" dan doc_bast_kegedean != "DOKUMEN_VALID_SIAP_UNGGAH" dan doc_bukan_pdf != "DOKUMEN_VALID_SIAP_UNGGAH" {
    cetak("  ✅ PASS: Format & Ukuran Dokumen PDF Sesuai Spesifikasi Pusat Data Wartek SIPLah!");
} lainnya {
    cetak("  ❌ FAIL: Validasi dokumen PBJ gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 5/5 PENGUJIAN INTEGRASI SIPLAH WARTEK-ID BERHASIL (100%)");
cetak("====================================================================");
