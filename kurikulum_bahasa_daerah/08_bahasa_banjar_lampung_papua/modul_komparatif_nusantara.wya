// ==============================================================================
// MODUL BD-108: KOMPUTASI LINGUISTIK KOMPARATIF MULTIBAHASA DAERAH NUSANTARA
// Implementasi Kurikulum Pembelajaran Bahasa Daerah Berbasis Widya-Lang
// ==============================================================================

cetak("==================================================================");
cetak("📚 MODUL BD-108: LINGUISTIK KOMPARATIF 16 BAHASA DAERAH NUSANTARA");
cetak("==================================================================");

// 1. MATRIKS KOMPARATIF KOSAKATA INTI (SWADESH LIST NUSANTARA)
cetak("\n--- [1] Matriks Perbandingan Kosakata Inti Antar Bahasa Daerah ---");

struktur EntriKomparatif {
    arti_nasional,
    jawa,
    sunda,
    bali,
    minang,
    bugis,
    batak,
    banjar,
    lampung,
    papua
}

misal tabel_komparasi = [
    EntriKomparatif("Makan", "Mangan", "Dahar", "Medaar", "Makan", "Manre", "Mangan", "Makan", "Mengan", "Makan"),
    EntriKomparatif("Tidur", "Turu", "Sare", "Pules", "Lalok", "Matinro", "Modom", "Guring", "Pedom", "Tidur"),
    EntriKomparatif("Rumah", "Omah", "Imah", "Umah", "Rumah", "Bola", "Bagas", "Rumah", "Lamban", "Rumah"),
    EntriKomparatif("Datang", "Teka", "Datang", "Teka", "Tibo", "Pole", "Ro", "Datang", "Rattei", "Datang"),
    EntriKomparatif("Terima Kasih", "Matur Nuwun", "Hatur Nuhun", "Matur Suksma", "Tarimo Kasih", "Kurru Sumange", "Mauliate", "Tarima Kasih", "Nalom Nihan", "Terima Kasih Banyak")
];

untuk e dalam tabel_komparasi {
    cetak("  🌐 Kata Dasar: [" + e.arti_nasional + "]");
    cetak("     • Jawa    : " + e.jawa + "   \t• Sunda   : " + e.sunda);
    cetak("     • Bali    : " + e.bali + "   \t• Minang  : " + e.minang);
    cetak("     • Bugis   : " + e.bugis + "  \t• Batak   : " + e.batak);
    cetak("     • Banjar  : " + e.banjar + " \t• Lampung : " + e.lampung);
    cetak("     • Papua   : " + e.papua);
    cetak("------------------------------------------------------------------");
}

// 2. SISTEM LOKALISASI MULTI-LOCALE I18N WIDYA-LANG
cetak("\n--- [2] Sistem Lokalisasi Antarmuka (i18n) Bawaan Widya-Lang ---");

var daftar_kode = [
    "jv-ID", "su-ID", "ban-ID", "min-ID", "bug-ID", "btk-ID", "ace-ID", "bjn-ID", "ljp-ID", "pap-ID"
];

untuk k in daftar_kode {
    atur_lokal(k);
    var pesan = t("selamat_datang");
    cetak("  • Locale [" + k + "] -> Pesan Salam: " + pesan);
}

// 3. TRANSLITERASI AKSARA HAD LAMPUNG
cetak("\n--- [3] Transliterasi Aksara Had Lampung (KaGaNga) ---");
var aksara_lampung_teks = latin_ke_aksara_lampung("lampung sai bumi ruwa jurai");
cetak("  • Latin   : lampung sai bumi ruwa jurai");
cetak("    Lampung : " + aksara_lampung_teks);

cetak("\n==================================================================");
cetak("✅ Modul BD-108 Linguistik Komparatif Nusantara selesai dipelajari!");
cetak("==================================================================");
