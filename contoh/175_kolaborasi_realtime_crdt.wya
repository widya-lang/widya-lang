// ============================================================================
// CONTOH 175: KOLABORASI DOKUMEN REAL-TIME BEBAS KONFLIK (CRDT ENGINE)
// Widya-Lang Real-Time Collaboration Suite (Fractional Indexing & LWW)
// ============================================================================

cetak("====================================================================")
cetak("  ⚡ SISTEM KOLABORASI REAL-TIME WIDYADOCS CRDT (BEBAS KONFLIK)")
cetak("====================================================================")

// 1. Inisialisasi State Dokumen CRDT Klien 1 (Penulis A)
biar doc_a = crdt_teks_buat("penulis_jakarta")
doc_a = crdt_teks_sisip(doc_a, 0, "Naskah Rancangan Kebijakan Transformasi Digital")

cetak("\n[1] Penulis A membuat naskah:")
cetak("  Isi Dokumen A: " + crdt_teks_baca(doc_a))

// 2. Klien 1 Menyisipkan Teks Tambahan
doc_a = crdt_teks_sisip(doc_a, 47, " Republik Indonesia 2045")
cetak("\n[2] Penulis A menambahkan visi jangka panjang:")
cetak("  Isi Dokumen A: " + crdt_teks_baca(doc_a))

// 3. Klien 1 Menghapus kata awal bila diperlukan
doc_a = crdt_teks_hapus(doc_a, 0, 7) // hapus "Naskah "
cetak("\n[3] Penulis A merapikan judul:")
cetak("  Isi Dokumen A: " + crdt_teks_baca(doc_a))

// 4. Inisialisasi Sesi Kolaborasi Multi-Pengguna
biar sesi = crdt_sesi_buat("ruang-sidang-kabinet", "Transformasi_Digital_2045.docx", "presiden")
biar html_editor = crdt_sesi_render_html(sesi)

cetak("\n[4] Sesi Kolaborasi Web Studio:")
cetak("  Panjang Bundle Editor: " + teks(panjang(html_editor)) + " bytes")
cetak("  Status Protokol      : Strong Eventual Consistency (SEC) Aktif")

cetak("\n✅ Sesi Kolaborasi Multi-Pengguna Berhasil Berjalan Mulus & Terverifikasi!")
