// ==============================================================================
// rapat/rapat_pagi.wya - Mesin Rapat Pagi (08:00 WIB: Jadwal, Prioritas, Deadline)
// ==============================================================================

impor "../integrasi/obsidian_bridge.wya";
impor "../integrasi/telegram_bridge.wya";
impor "../integrasi/llm_bridge.wya";
impor "../integrasi/analitika_bridge.wya";


fungsi eksekusi_rapat_pagi(cfg, tim_agen, tanggal_str) {
    cetak("\n==================================================================");
    cetak("🌅 [SIDANG 08:00 WIB] MEMULAI RAPAT PAGI KANTOR DIGITAL WIDYA");
    cetak("==================================================================");

    // 1. Sidang 10 Agen merumuskan prioritas berdasarkan SOP masing-masing
    cetak("👥 10 Agen hadir lengkap sesuai SOP.");
    cetak("📢 [agen_orkestrator] Membuka rapat dan meminta usulan fokus harian...");

    // 1b. Penalaran Cerdas AI Berdaulat (Qwen 2.5 Coder Engine)
    misal usulan_orkestrator = minta_penalaran_llm(cfg, "agen_orkestrator", "Buka sidang pagi dan tetapkan arahan disiplin P1-P3 hari ini.");
    cetak("💬 [agen_orkestrator] \"" + usulan_orkestrator + "\"");

    misal usulan_arsitek = minta_penalaran_llm(cfg, "agen_arsitek", "Bagaimana strategi validasi skema tabel dan migrasi basis data hari ini?");
    cetak("📐 [agen_arsitek] \"" + usulan_arsitek + "\"");

    misal usulan_keamanan = minta_penalaran_llm(cfg, "agen_keamanan", "Apa fokus audit siber dan kepatuhan UU PDP No. 27/2022 hari ini?");
    cetak("🛡️ [agen_keamanan] \"" + usulan_keamanan + "\"");

    // 1c. agen_analis_data: Snapshot portofolio pembuka sidang
    cetak("\n📊 [agen_analis_data] Mempresentasikan Snapshot Portofolio...");
    misal snapshot = analitika_snapshot_portofolio(cfg, tim_agen);

    // 2. Tiga Prioritas Utama Terpilih
    misal p1 = "Implementasi Otentikasi Argon2id & Session Guard (PIC: Lead Coder & Auditor Keamanan)";
    misal p2 = "Penyusunan Skema Basis Data SQLite & Migrasi Tabel (PIC: Arsitek Sistem)";
    misal p3 = "Pengujian Beban Jalur Real-Time Server-Sent Events (PIC: QA Tester & DevOps)";

    misal daftar_prioritas = [
        "🔐 *P1:* " + p1,
        "🗄️ *P2:* " + p2,
        "⚡ *P3:* " + p3
    ];

    // 3. Jadwal & Hard Deadlines per Agen
    misal daftar_deadline = [
        "11:30 WIB — Finalisasi Migrasi DB (`agen_arsitek`)",
        "14:00 WIB — Selesai Endpoint Login & Argon2id (`agen_coder`)",
        "16:30 WIB — Uji Penetrasi & Audit UU PDP (`agen_qa` & `agen_keamanan`)",
        "17:30 WIB — Backup Snapshot Harian Server (`agen_devops`)"
    ];

    cetak("\n🎯 3 PRIORITAS UTAMA DISETUJUI:");
    cetak("  1. " + p1);
    cetak("  2. " + p2);
    cetak("  3. " + p3);

    // Sisipkan peringatan proyek AT-RISK dari agen_analis_data
    jika (panjang(snapshot["peringatan"]) > 0) {
        cetak("\n  ⚠️  [agen_analis_data] PROYEK AT-RISK MEMERLUKAN PERHATIAN SEGERA:");
        misal ai = 0;
        selama (ai < panjang(snapshot["peringatan"])) {
            cetak("       " + snapshot["peringatan"][ai]);
            ai = ai + 1;
        }
    }

    cetak("\n📋 HARD DEADLINES:");
    cetak("  • 11:30 WIB: Migrasi DB (Arsitek)");
    cetak("  • 14:00 WIB: Endpoint Login (Coder)");
    cetak("  • 16:30 WIB: Audit Penetrasi (QA & Keamanan)");
    cetak("  • 17:30 WIB: Backup Snapshot (DevOps)");

    // 4. Susun Konten Markdown untuk Obsidian DailyNotes
    misal md_konten = "# 🌅 Risalah Rapat Pagi — " + tanggal_str + " (08:00 WIB)\n\n" +
        "> **Moderator:** `agen_orkestrator` | **Notulis:** `agen_notulis` | **Status:** Disetujui\n\n" +
        "## 🎯 3 Prioritas Utama Hari Ini\n" +
        "1. **[P1]** " + p1 + "\n" +
        "2. **[P2]** " + p2 + "\n" +
        "3. **[P3]** " + p3 + "\n\n" +
        "## 📋 Matriks Jadwal, PIC & Hard Deadline\n" +
        "| Waktu | Target Pekerjaan | Penanggung Jawab (PIC) | SOP Acuan | Status |\n" +
        "| :---: | :--- | :---: | :---: | :---: |\n" +
        "| **11:30** | Migrasi Skema Tabel Basis Data | `agen_arsitek` | SOP-03 | [ ] TODO |\n" +
        "| **14:00** | Penulisan Logika Login & Argon2id | `agen_coder` | SOP-04 | [ ] TODO |\n" +
        "| **16:30** | Audit Siber & Penetrasi UU PDP | `agen_qa` & `agen_keamanan` | SOP-05 & 07 | [ ] TODO |\n" +
        "| **17:30** | Snapshot Backup Basis Data | `agen_devops` | SOP-06 | [ ] TODO |\n\n" +
        "## 🛡️ Catatan Keamanan & Kepatuhan UU PDP No. 27/2022\n" +
        "- Tidak diperkenankan menyimpan sandi polos.\n" +
        "- Cookie sesi wajib menggunakan atribut `HttpOnly` dan `SameSite=Strict`.\n" +
        "- Berkas log CCTV wajib disanitasi dari informasi kredensial (*Log Masking*).\n\n" +
        "## 🧠 Arahan Penalaran AI Berdaulat (Qwen 2.5 Coder)\n" +
        "- **Mandor PM (`agen_orkestrator`):** " + usulan_orkestrator + "\n" +
        "- **Arsitek DB (`agen_arsitek`):** " + usulan_arsitek + "\n" +
        "- **Auditor Siber (`agen_keamanan`):** " + usulan_keamanan + "\n";

    // 5. Arsipkan ke Obsidian Vault
    misal path_obsidian = obsidian_tulis_catatan_harian(cfg, tanggal_str, "Pagi", "Risalah Rapat Pagi", md_konten, {});

    // 6. Perbarui Papan Kanban di Obsidian
    misal daftar_todo = [
        "[P1] Coding Rute Login & Argon2id (@agen_coder) - Deadline: 14:00",
        "[P2] Skema Migrasi SQLite Inventaris (@agen_arsitek) - Deadline: 11:30",
        "[P3] Audit UU PDP & Uji QA (@agen_qa & @agen_keamanan) - Deadline: 16:30",
        "Backup Snapshot Harian Basis Data (@agen_devops) - Deadline: 17:30"
    ];
    obsidian_perbarui_kanban(cfg, tanggal_str, daftar_todo, [], []);

    // 7. Format dan Kirim Pesan ke Telegram Bot Gateway
    misal pesan_tg = tg_format_pesan_pagi(tanggal_str, daftar_prioritas, daftar_deadline, tanggal_str + "-Pagi.md");
    tg_kirim_pesan(cfg, pesan_tg);

    cetak("\n✓ [Rapat Pagi] Seluruh prosedur Rapat Pagi telah selesai secara paripurna!");
    kembalikan {
        "status": "SELESAI",
        "sesi": "pagi",
        "tanggal": tanggal_str,
        "path_obsidian": path_obsidian
    };
}
