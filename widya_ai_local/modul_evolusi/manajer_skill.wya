// ============================================================================
// MODUL MANAJER SKILL DINAMIS (manajer_skill.wya)
// Registri & Orkestrasi Skill Mandiri (Built-in & Autonomously Acquired)
// ============================================================================

impor "widya_ai_local/skills/skill_pencari_web.wya";
impor "widya_ai_local/skills/skill_kalkulator_haversine.wya";
impor "widya_ai_local/skills/skill_kurs_finansial.wya";

struktur SkillAgen {
    id_skill,
    nama,
    deskripsi,
    versi,
    pemicu_kata_kunci,
    status,
    sumber,
    waktu_dibuat
}

// Fungsi bantu substring
fungsi skill_teks_ada_sub(teks, sub) {
    misal p_teks = panjang(teks);
    misal p_sub = panjang(sub);
    jika (p_sub > p_teks) { kembalikan salah; }
    jika (p_sub == 0) { kembalikan benar; }
    misal batas = p_teks - p_sub + 1;
    misal i = 0;
    selama (i < batas) {
        jika (potong(teks, i, i + p_sub) == sub) {
            kembalikan benar;
        }
        i = i + 1;
    }
    kembalikan salah;
}

// Inisialisasi Manajer Skill dengan Skill Bawaan
fungsi inisialisasi_manajer_skill() {
    misal daftar = [];

    // 1. Skill Pencari Web
    misal info_web = info_skill_pencari_web();
    tambah(daftar, SkillAgen(
        info_web["id_skill"],
        info_web["nama"],
        info_web["deskripsi"],
        info_web["versi"],
        info_web["pemicu"],
        info_web["status"],
        info_web["sumber"],
        ke_teks(waktu())
    ));

    // 2. Skill Kalkulator Haversine
    misal info_hav = info_skill_haversine();
    tambah(daftar, SkillAgen(
        info_hav["id_skill"],
        info_hav["nama"],
        info_hav["deskripsi"],
        info_hav["versi"],
        info_hav["pemicu"],
        info_hav["status"],
        info_hav["sumber"],
        ke_teks(waktu())
    ));

    // 3. Skill Kurs Finansial
    misal info_kurs = info_skill_kurs_finansial();
    tambah(daftar, SkillAgen(
        info_kurs["id_skill"],
        info_kurs["nama"],
        info_kurs["deskripsi"],
        info_kurs["versi"],
        info_kurs["pemicu"],
        info_kurs["status"],
        info_kurs["sumber"],
        ke_teks(waktu())
    ));

    kembalikan {
        "daftar_skill": daftar,
        "total_skill": panjang(daftar),
        "riwayat_eksekusi": []
    };
}

// Mendaftarkan Skill Baru Secara Hot-Plug ke Runtime
fungsi daftarkan_skill_baru(manajer, skill_baru) {
    misal daftar = manajer["daftar_skill"];
    misal ditemukan = salah;
    misal idx = 0;

    untuk s di daftar {
        jika (s.id_skill == skill_baru.id_skill) {
            // Perbarui skill yang sudah ada
            daftar[idx] = skill_baru;
            ditemukan = benar;
        }
        idx = idx + 1;
    }

    jika (!ditemukan) {
        tambah(daftar, skill_baru);
    }

    manajer["daftar_skill"] = daftar;
    manajer["total_skill"] = panjang(daftar);

    kembalikan {
        "sukses": benar,
        "id_skill": skill_baru.id_skill,
        "nama": skill_baru.nama,
        "total_sekarang": manajer["total_skill"],
        "manajer": manajer
    };
}

// Mencari Skill yang Cocok Berdasarkan Teks Permintaan Pengguna
fungsi cari_skill_sesuai(manajer, pesan) {
    misal p = huruf_kecil(pesan);
    misal daftar = manajer["daftar_skill"];

    untuk s di daftar {
        jika (s.status == "AKTIF") {
            untuk pemicu di s.pemicu_kata_kunci {
                jika (skill_teks_ada_sub(p, huruf_kecil(pemicu))) {
                    kembalikan s;
                }
            }
        }
    }

    kembalikan kosong;
}

// Eksekusi Skill Terpilih Secara Dinamis
fungsi eksekusi_skill_dinamis(manajer, id_skill, argumen) {
    misal hasil = kosong;

    jika (id_skill == "skill_pencari_web") {
        hasil = eksekusi_skill_pencari_web(argumen["kueri"]);
    } lainnya {
        jika (id_skill == "skill_kalkulator_haversine") {
            hasil = eksekusi_skill_haversine(
                argumen["lat1"],
                argumen["lon1"],
                argumen["lat2"],
                argumen["lon2"]
            );
        } lainnya {
            jika (id_skill == "skill_kurs_finansial") {
                hasil = eksekusi_skill_kurs_finansial(
                    argumen["jumlah"],
                    argumen["dari_valas"],
                    argumen["ke_valas"]
                );
            } lainnya {
                // Skill hasil sintesis mandiri dinamis
                hasil = {
                    "sukses": benar,
                    "id_skill": id_skill,
                    "tampilan": "Skill mandiri '" + id_skill + "' berhasil dieksekusi dengan parameter: " + ke_json(argumen)
                };
            }
        }
    }

    // Catat riwayat eksekusi
    misal riwayat = manajer["riwayat_eksekusi"];
    tambah(riwayat, {
        "id_skill": id_skill,
        "waktu": waktu(),
        "sukses": hasil["sukses"]
    });
    manajer["riwayat_eksekusi"] = riwayat;

    kembalikan hasil;
}

// Menampilkan Ringkasan Seluruh Skill Aktif
fungsi tampilkan_katalog_skill(manajer) {
    cetak("\n======================================================================");
    cetak("               KATALOG SKILL WIDYA-AI CORE (AKTIF)");
    cetak("======================================================================");
    cetak("Total Skill Dikuasai: " + ke_teks(manajer["total_skill"]) + " Skill\n");

    misal no = 1;
    untuk s di manajer["daftar_skill"] {
        cetak("  [" + ke_teks(no) + "] " + s.nama + " (" + s.versi + ")");
        cetak("      ID       : " + s.id_skill);
        cetak("      Sumber   : " + s.sumber + " | Status: " + s.status);
        cetak("      Deskripsi: " + s.deskripsi);
        cetak("      Pemicu   : " + gabung(s.pemicu_kata_kunci, ", "));
        cetak("");
        no = no + 1;
    }
    cetak("======================================================================\n");
}
