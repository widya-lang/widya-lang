// ============================================================================
// MODUL: TATA KELOLA SATU AKUN MULTI-ROLE & CONTEXT SWITCHER (RBAC SEWIDYA)
// Mengelola Akun Tunggal Guru/Tendik yang Memiliki Banyak Peran Sekaligus:
// 1. Guru Mapel yang Merangkap Bendahara BOS (Pemisahan Wewenang / Segregation of Duties)
// 2. Guru yang Merangkap Wali Kelas & Pembina OSIS
// 3. Guru/Pegawai yang Sekaligus Menjadi Orang Tua / Wali Murid di Sekolah yang Sama
// 4. Guru Lintas Satuan Pendidikan (Kompleks Terintegrasi Multi-NPSN)
// 5. Fast Role Switcher (1 Klik Beralih Konteks Tanpa Logout) & Audit Trail Terisolasi
// ============================================================================

struktur PeranOtoritas {
    id_peran,
    kode_peran,                 // 'GURU_MAPEL', 'WALI_KELAS', 'BENDAHARA_BOS', 'WALI_MURID', 'OPERATOR_SEKOLAH'
    nama_peran_label,           // "Guru Matematika", "Bendahara BOSP", "Orang Tua Siswa"
    npsn_sekolah,
    nama_satdik,
    hak_akses_fitur             // 'AKSES_KBM_LMS', 'AKSES_BKU_ARKAS', 'AKSES_RAPOR_KELAS', 'AKSES_TAGIHAN_ANAK'
}

struktur AkunPenggunaMultiRole {
    did_pengguna,
    email_sso,
    nama_lengkap,
    nik,
    nuptk,
    daftar_peran,               // Array PeranOtoritas
    peran_aktif_saat_ini,       // Kode peran yang sedang digunakan sesi ini
    npsn_aktif_saat_ini,        // NPSN yang sedang aktif
    token_sesi_aktif
}

struktur HasilBeralihPeran {
    did_pengguna,
    peran_lama,
    peran_baru,
    npsn_baru,
    status_switch,              // 'BERHASIL_BERALIH_KONTEKS'
    hak_akses_sekarang,
    catatan_audit_keamanan      // 'SESI_TERISOLASI_MENCEGAH_BENTURAN_KEPENTINGAN'
}

struktur ValidasiIzinAksi {
    did_pengguna,
    peran_aktif,
    aksi_diminta,               // 'INPUT_NILAI_RAPOR', 'APPROVE_SPJ_BKU', 'BAYAR_SPP_ANAK'
    status_izin,                // 'DIIZINKAN_SESUAI_PERAN_AKTIF', 'DITOLAK_HAK_AKSES_TIDAK_SESUAI'
    pesan_keamanan
}

// ============================================================================
// LOGIKA BISNIS MULTI-ROLE & CONTEXT SWITCHING
// ============================================================================

// [1] Inisialisasi Akun Multi-Peran Tunggal (Single Identity)
fungsi buat_akun_multi_peran(
    did,
    email,
    nama,
    nik,
    nuptk,
    peran_awal
) {
    misal daftar = [peran_awal];
    misal token = "JWT-SECURE-SESSION-" + potong(sha256(did + peran_awal.kode_peran), 0, 16);

    kembalikan AkunPenggunaMultiRole(
        did,
        email,
        nama,
        nik,
        nuptk,
        daftar,
        peran_awal.kode_peran,
        peran_awal.npsn_sekolah,
        token
    );
}

// [2] Penambahan Peran Baru ke Akun yang Sama (Misal: Ditugaskan Jadi Bendahara BOS)
fungsi tambah_peran_ke_akun(
    akun,
    peran_baru
) {
    tambah(akun.daftar_peran, peran_baru);
    kembalikan {
        "did": akun.did_pengguna,
        "total_peran": panjang(akun.daftar_peran),
        "peran_terbaru": peran_baru.nama_peran_label,
        "status": "PERAN_BERHASIL_DITAMBAHKAN"
    };
}

// [3] Beralih Peran (Fast Context Switching 1-Klik Tanpa Perlu Logout)
fungsi beralih_konteks_peran(
    akun,
    kode_peran_tujuan,
    npsn_tujuan
) {
    misal peran_lama = akun.peran_aktif_saat_ini;
    akun.peran_aktif_saat_ini = kode_peran_tujuan;
    akun.npsn_aktif_saat_ini = npsn_tujuan;
    akun.token_sesi_aktif = "JWT-SECURE-SESSION-" + potong(sha256(akun.did_pengguna + kode_peran_tujuan), 0, 16);

    // Menemukan hak akses yang sesuai peran baru
    misal hak = "AKSES_KBM_LMS";
    jika kode_peran_tujuan == "BENDAHARA_BOS" {
        hak = "AKSES_BKU_ARKAS";
    } kalau kode_peran_tujuan == "WALI_MURID" {
        hak = "AKSES_TAGIHAN_ANAK";
    } kalau kode_peran_tujuan == "WALI_KELAS" {
        hak = "AKSES_RAPOR_KELAS";
    }

    kembalikan HasilBeralihPeran(
        akun.did_pengguna,
        peran_lama,
        kode_peran_tujuan,
        npsn_tujuan,
        "BERHASIL_BERALIH_KONTEKS",
        hak,
        "SESI_TERISOLASI_MENCEGAH_BENTURAN_KEPENTINGAN"
    );
}

// [4] Validasi Otoritas Aksi (Segregation of Duties / Anti-Privilege Leakage)
// Mencegah Guru memanipulasi BKU jika saat itu dia sedang berada dalam konteks Peran GURU
fungsi validasi_otoritas_tindakan(
    akun,
    aksi_diminta
) {
    // Jika aksi adalah urusan BKU Keuangan, hanya boleh saat peran aktif = BENDAHARA_BOS
    jika aksi_diminta == "APPROVE_SPJ_BKU" {
        jika akun.peran_aktif_saat_ini == "BENDAHARA_BOS" {
            kembalikan ValidasiIzinAksi(
                akun.did_pengguna,
                akun.peran_aktif_saat_ini,
                aksi_diminta,
                "DIIZINKAN_SESUAI_PERAN_AKTIF",
                "Otoritas Bendahara BOS Terverifikasi Sah"
            );
        } lainnya {
            kembalikan ValidasiIzinAksi(
                akun.did_pengguna,
                akun.peran_aktif_saat_ini,
                aksi_diminta,
                "DITOLAK_HAK_AKSES_TIDAK_SESUAI",
                "Ditolak! Anda sedang dalam konteks Peran Guru. Silakan switch role ke Bendahara BOS."
            );
        }
    }

    // Jika aksi adalah melihat tagihan/rapor anak sendiri, hanya boleh saat peran aktif = WALI_MURID
    jika aksi_diminta == "BAYAR_SPP_ANAK" {
        jika akun.peran_aktif_saat_ini == "WALI_MURID" {
            kembalikan ValidasiIzinAksi(
                akun.did_pengguna,
                akun.peran_aktif_saat_ini,
                aksi_diminta,
                "DIIZINKAN_SESUAI_PERAN_AKTIF",
                "Akses Portal Wali Murid Sah"
            );
        } lainnya {
            kembalikan ValidasiIzinAksi(
                akun.did_pengguna,
                akun.peran_aktif_saat_ini,
                aksi_diminta,
                "DITOLAK_HAK_AKSES_TIDAK_SESUAI",
                "Ditolak! Silakan beralih ke peran Wali Murid untuk melihat data anak."
            );
        }
    }

    // Default akses KBM
    kembalikan ValidasiIzinAksi(
        akun.did_pengguna,
        akun.peran_aktif_saat_ini,
        aksi_diminta,
        "DIIZINKAN_SESUAI_PERAN_AKTIF",
        "Akses Akademik Terbuka"
    );
}
