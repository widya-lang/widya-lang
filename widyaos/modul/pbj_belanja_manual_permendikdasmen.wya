// ============================================================================
// MODUL: PBJ BELANJA MANUAL PERMENDIKDASMEN 15/2026
// Tata Cara Belanja Satuan Pendidikan di Luar SIPLah (Toko Fisik / Manual)
// 
// Menjamin 6 Tahapan Wajib Terekam "By System" & Bebas Temuan BPK:
// 1. Dokumen Rencana Belanja (Justifikasi Manual & SSH Plafon)
// 2. Perbandingan Harga Toko Fisik (Multi-Quotation Comparison Matrix)
// 3. Negosiasi Harga (Digital Negotiation Log & Rekam Penghematan)
// 4. Pelaksanaan Kesepakatan (Surat Pesanan / SPK Ber-QR DID)
// 5. Serah Terima Riil (BAST Digital + Geotag GPS + Hash Foto Fisik Barang)
// 6. Pembayaran & Pelunasan Pajak (Kuitansi + NTPN/NTPD + Ingesti is_beli_di_siplah = 0)
// ============================================================================

struktur DokumenRencanaBelanja {
    id_rencana,
    id_anggaran_arkas,
    uraian_kebutuhan,
    volume,
    satuan,
    harga_satuan_maks_ssh,
    justifikasi_belanja_manual, // Contoh: 'TOKO_LOKAL_BELUM_SIPLAH', 'KEBUTUHAN_MENDESAK_SEKETIKA', 'BAHAN_BASAH_KONSUMSI'
    status_persetujuan_ks      // 'DISETUJUI_KEPALA_SEKOLAH', 'DITOLAK'
}

struktur TokoPenawarPembanding {
    nama_toko,
    alamat_toko,
    kontak_toko,
    npwp_atau_nik,
    harga_satuan_penawaran,
    total_penawaran,
    apakah_terpilih
}

struktur LogNegosiasiHarga {
    harga_penawaran_awal,
    harga_target_sekolah,
    harga_final_kesepakatan,
    nominal_penghematan,
    persen_penghematan,
    catatan_kesepakatan
}

struktur SuratPesananManualSpk {
    nomor_spk,
    tanggal_spk,
    nama_rekanan_toko,
    total_nilai_pesanan,
    batas_waktu_kirim,
    did_pejabat_pengadaan,
    did_kepala_sekolah,
    status_spk
}

struktur BastPemeriksaanFisik {
    nomor_bast,
    tanggal_serah_terima,
    lokasi_geotag_lat,
    lokasi_geotag_lon,
    nama_file_foto_barang,
    hash_foto_kriptografi,
    kesesuaian_spesifikasi,    // 'SESUAI_SPESIFIKASI_100_PERSEN', 'TIDAK_SESUAI'
    did_pemeriksa_barang,
    nama_wakil_toko,
    status_bast
}

struktur KuitansiPelunasanManual {
    nomor_kuitansi,
    nominal_bruto,
    potongan_ppn,
    potongan_pph_22,
    nominal_netto_dibayar,
    metode_bayar,              // 'NON_TUNAI_CMS_BANK', 'TUNAI_BRANKAS_LIMIT_10_JUTA'
    kode_ntpn_pajak,
    tanggal_bayar,
    did_bendahara
}

struktur BerkasDossierPbjManual {
    id_transaksi_pbj,
    id_kas_umum,
    id_kas_nota,
    is_beli_di_siplah,          // Selalu 0 untuk transaksi belanja manual
    rencana,
    daftar_pembanding,
    negosiasi,
    spk,
    bast,
    kuitansi,
    skor_kepatuhan_regulasi,    // 0 - 100%
    status_keabsahan_riil       // 'BELANJA_RIIL_TERBUKTI_VALID_ANTI_FIKTIF', 'CACAT_PROSEDUR'
}

// ============================================================================
// LOGIKA BISNIS 6 TAHAPAN PERMENDIKDASMEN 15/2026
// ============================================================================

// [TAHAP 1] Pembuatan Dokumen Rencana Belanja & Verifikasi Plafon SSH
fungsi buat_rencana_belanja_manual(
    id_rencana,
    id_anggaran,
    uraian,
    volume,
    satuan,
    harga_satuan_ssh,
    alasan_manual,
    is_disetujui_ks
) {
    jika alasan_manual == "" atau alasan_manual == nihil {
        kembalikan "DITOLAK: Alasan belanja manual di luar SIPLah wajib dijelaskan secara tertulis!";
    }
    jika is_disetujui_ks == salah {
        kembalikan "DITOLAK: Rencana belanja belum disetujui Kepala Sekolah!";
    }

    misal rencana = DokumenRencanaBelanja(
        id_rencana,
        id_anggaran,
        uraian,
        volume,
        satuan,
        harga_satuan_ssh,
        alasan_manual,
        "DISETUJUI_KEPALA_SEKOLAH"
    );
    kembalikan rencana;
}

// [TAHAP 2] Evaluasi Matriks Perbandingan Harga Toko Fisik (Minimal 2 Toko)
fungsi evaluasi_perbandingan_harga_manual(daftar_toko) {
    misal jumlah_toko = panjang(daftar_toko);
    jika jumlah_toko < 2 {
        kembalikan "DITOLAK: Permendikdasmen 15/2026 mensyaratkan perbandingan harga minimal 2 toko!";
    }

    // Cari toko dengan penawaran paling ekonomis dan valid
    misal harga_termurah = 999999999999.0;
    misal toko_terpilih = "";

    untuk t in daftar_toko {
        jika t.total_penawaran < harga_termurah {
            harga_termurah = t.total_penawaran;
            toko_terpilih = t.nama_toko;
        }
    }

    kembalikan toko_terpilih;
}

// [TAHAP 3] Rekam Jejak Negosiasi Harga (Digital Negotiation Log)
fungsi catat_hasil_negosiasi_manual(
    harga_awal,
    harga_target,
    harga_sepakat,
    catatan
) {
    misal penghematan = harga_awal - harga_sepakat;
    jika penghematan < 0.0 {
        penghematan = 0.0;
    }

    misal persen = 0.0;
    jika harga_awal > 0.0 {
        persen = (penghematan / harga_awal) * 100.0;
    }

    misal log_negosiasi = LogNegosiasiHarga(
        harga_awal,
        harga_target,
        harga_sepakat,
        penghematan,
        persen,
        catatan
    );
    kembalikan log_negosiasi;
}

// [TAHAP 4] Penerbitan Surat Pesanan (SPK) Ber-DID Digital
fungsi terbitkan_spk_manual(
    nomor_spk,
    nama_toko,
    total_nilai,
    did_pengadaan,
    did_ks
) {
    jika total_nilai <= 0.0 {
        kembalikan "GAGAL: Nilai pesanan tidak sah!";
    }

    misal spk = SuratPesananManualSpk(
        nomor_spk,
        "2026-03-15",
        nama_toko,
        total_nilai,
        "2026-03-18",
        did_pengadaan,
        did_ks,
        "SPK_RESMI_TERBIT_DITANDATANGANI_DIGITAL"
    );
    kembalikan spk;
}

// [TAHAP 5] Verifikasi Serah Terima Riil & Anti-Fiktif (Geotag + Foto Fisik + BAST)
fungsi verifikasi_serah_terima_fisik(
    nomor_bast,
    lat,
    lon,
    nama_foto,
    hash_foto,
    kondisi_sesuai,
    did_pemeriksa,
    nama_toko
) {
    // Memastikan ada bukti geospasial toko riil dan bukti foto fisik barang
    jika lat == 0.0 atau lon == 0.0 {
        kembalikan "DITOLAK: Koordinat geotag toko fisik tidak terdeteksi! Wajib rekam lokasi nyata.";
    }
    jika hash_foto == "" atau hash_foto == nihil {
        kembalikan "DITOLAK: Foto fisik barang bukti serah terima tidak boleh kosong!";
    }
    jika kondisi_sesuai != benar {
        kembalikan "DITOLAK: Barang tidak sesuai spesifikasi pesanan!";
    }

    misal bast = BastPemeriksaanFisik(
        nomor_bast,
        "2026-03-18",
        lat,
        lon,
        nama_foto,
        hash_foto,
        "SESUAI_SPESIFIKASI_100_PERSEN",
        did_pemeriksa,
        nama_toko,
        "BAST_SAH_DIVERIFIKASI_FISIK"
    );
    kembalikan bast;
}

// [TAHAP 6] Pembayaran & Pemungutan Pajak Kas Negara
fungsi proses_pembayaran_manual_bku(
    nomor_kuitansi,
    bruto,
    ppn,
    pph,
    metode,
    ntpn,
    did_bendahara
) {
    // Validasi batas kas tunai brankas (Maks 10 Juta)
    jika metode == "TUNAI_BRANKAS" dan bruto > 10000000.0 {
        kembalikan "DITOLAK: Pembayaran di atas Rp 10.000.000 wajib Non-Tunai / Transfer Bank!";
    }

    misal netto = bruto - ppn - pph;
    misal kuitansi = KuitansiPelunasanManual(
        nomor_kuitansi,
        bruto,
        ppn,
        pph,
        netto,
        metode,
        ntpn,
        "2026-03-18",
        did_bendahara
    );
    kembalikan kuitansi;
}

// [INTEGRASI DOSSIER] Verifikasi 6 Tahap Lengkap By System (Permendikdasmen 15/2026)
fungsi validasi_dossier_pbj_manual_lengkap(
    id_trx,
    id_kas_umum,
    id_kas_nota,
    rencana,
    pembanding,
    negosiasi,
    spk,
    bast,
    kuitansi
) {
    misal skor = 0.0;

    // Tahap 1: Rencana Belanja Valid (+15%)
    jika rencana.status_persetujuan_ks == "DISETUJUI_KEPALA_SEKOLAH" {
        skor = skor + 15.0;
    }

    // Tahap 2: Perbandingan Harga Minimal 2 Toko (+20%)
    jika panjang(pembanding) >= 2 {
        skor = skor + 20.0;
    }

    // Tahap 3: Negosiasi Terekam (+15%)
    jika negosiasi.harga_final_kesepakatan > 0.0 {
        skor = skor + 15.0;
    }

    // Tahap 4: SPK Sah Bertanda Tangan (+15%)
    jika spk.status_spk == "SPK_RESMI_TERBIT_DITANDATANGANI_DIGITAL" {
        skor = skor + 15.0;
    }

    // Tahap 5: BAST Geotag & Foto Barang Riil (+20%)
    jika bast.status_bast == "BAST_SAH_DIVERIFIKASI_FISIK" {
        skor = skor + 20.0;
    }

    // Tahap 6: Pembayaran & Pajak Sesuai (+15%)
    jika kuitansi.nominal_bruto > 0.0 {
        skor = skor + 15.0;
    }

    misal status = "CACAT_PROSEDUR_DITOLAK";
    jika skor >= 100.0 {
        status = "BELANJA_RIIL_TERBUKTI_VALID_ANTI_FIKTIF";
    }

    kembalikan BerkasDossierPbjManual(
        id_trx,
        id_kas_umum,
        id_kas_nota,
        0, // is_beli_di_siplah = 0 (Belanja Manual di Toko Fisik)
        rencana,
        pembanding,
        negosiasi,
        spk,
        bast,
        kuitansi,
        skor,
        status
    );
}
