// ============================================================================
// CONTOH WIDYA-LANG 184: EKOSISTEM PERPUSTAKAAN TERPADU 4 TINGKATAN
// Perpustakaan Sekolah, Daerah, Perguruan Tinggi, dan Jaringan Internasional
// ============================================================================

fungsi utama() {
    cetak("============================================================================");
    cetak("   EKOSISTEM PERPUSTAKAAN TERPADU: SEKOLAH, DAERAH, KAMPUS & INTERNASIONAL  ");
    cetak("  Integrasi Standar MARC21, Dublin Core, OAI-PMH, Z39.50, IIIF & ILL Global ");
    cetak("============================================================================");

    // ------------------------------------------------------------------------
    // [1] PERPUSTAKAAN SEKOLAH (STANDAR NASIONAL SNP & BOSP PENGADAAN BUKU)
    // ------------------------------------------------------------------------
    cetak("\n[TINGKAT 1] PERPUSTAKAAN SEKOLAH DASAR & MENENGAH:");
    misal nama_sekolah = "Perpustakaan Pelita SD Negeri 1 Somagede (NPSN: 20301234)";
    misal buku_sd = "Buku Teks Pelajaran IPAS Kurikulum Nasional Kelas 4";
    misal isbn_sd = "978-602-244-123-4";
    misal klasifikasi_ddc_sd = "372.357 (Pendidikan Dasar Sains & Sosial)";
    misal sumber_dana = "BOSP Reguler 2026 (Pengadaan SIPLah)";
    misal peminjam_nisn = "0123456789 (Ahmad Fauzi - Kelas 4A)";

    cetak("    - Nama Perpustakaan    : " + nama_sekolah);
    cetak("    - Katalog Buku BOSP    : " + buku_sd + " (ISBN: " + isbn_sd + ")");
    cetak("    - Klasifikasi DDC      : " + klasifikasi_ddc_sd);
    cetak("    - Sumber Pengadaan     : " + sumber_dana);
    cetak("    - Transaksi Sirkulasi  : Dipinjam oleh Siswa " + peminjam_nisn);
    cetak("    - Status Buku          : DIPINJAM (Batas Kembali: 24 Januari 2026)");

    // ------------------------------------------------------------------------
    // [2] PERPUSTAKAAN DAERAH (UU 13/2018 KCKR, NASKAH KUNO & MOBIL KELILING)
    // ------------------------------------------------------------------------
    cetak("\n[TINGKAT 2] PERPUSTAKAAN DAERAH (DISPUSSIPDA KAB/KOTA & PROVINSI):");
    misal nama_perpusda = "Dinas Arsip & Perpustakaan Daerah Kabupaten Banyumas";
    misal judul_kckr = "Buku Sejarah & Kebudayaan Kadipaten Banyumas (Penerbit Lokal)";
    misal naskah_kuno = "Manuskrip Asli Babad Pasir Luhur (Media Daluang, Aksara Jawa Kuno)";
    misal scan_dpi = 600;
    misal rute_keliling = "Mobil Layanan Keliling Unit 02 - Rute Desa Somagede & Tambak";

    cetak("    - Lembaga Pengelola    : " + nama_perpusda);
    cetak("    - Wajib Deposit KCKR   : Diterima 2 Eksemplar Resmi (UU No. 13/2018)");
    cetak("    - Judul Karya Deposit  : " + judul_kckr);
    cetak("    - Preservasi Manuskrip : " + naskah_kuno + " (Master Scan: " + teks(scan_dpi) + " DPI)");
    cetak("    - Jangkauan Komunitas  : " + rute_keliling + " (340 Pembaca Terlayani)");

    // ------------------------------------------------------------------------
    // [3] PERPUSTAKAAN PERGURUAN TINGGI (REPOSITORI INSTITUSI, OAI-PMH, DOI)
    // ------------------------------------------------------------------------
    cetak("\n[TINGKAT 3] PERPUSTAKAAN PERGURUAN TINGGI (INSTITUTIONAL REPOSITORY):");
    misal nama_univ = "Universitas Jenderal Soedirman (UNSOED Purwokerto)";
    misal judul_skripsi = "Penerapan Algoritma Kuantum Hibrida untuk Rantai Pasok Pertanian";
    misal penulis_mahasiswa = "Rizky Pratama (NIM: H1D022001 - Informatika)";
    misal doi_crossref = "https://doi.org/10.20884/skripsi.fasilkom.2026.0123";
    misal skor_kemiripan_turnitin = 11.2; // % (Standar max 20%)
    misal endpoint_oai = "https://repository.unsoed.ac.id/oai/request (RAMA / GARUDA)";

    cetak("    - Perguruan Tinggi     : " + nama_univ);
    cetak("    - Karya Ilmiah Mandiri : " + judul_skripsi);
    cetak("    - Penulis Mahasiswa    : " + penulis_mahasiswa);
    cetak("    - DOI Crossref Digital : " + doi_crossref);
    cetak("    - Uji Plagiarisme      : " + teks(skor_kemiripan_turnitin) + "% [LOLOS UJI KEMIRIPAN < 20%]");
    cetak("    - OAI-PMH Harvest      : TERKONEKSI (Sinkron ke Portal RAMA Kemendiktisaintek)");

    // ------------------------------------------------------------------------
    // [4] PERPUSTAKAAN INTERNASIONAL (Z39.50, WORLDCAT, IIIF & INTERLIBRARY LOAN)
    // ------------------------------------------------------------------------
    cetak("\n[TINGKAT 4] JARINGAN PERPUSTAKAAN INTERNASIONAL (GLOBAL INTEROPERABILITY):");
    misal protokol_search = "Z39.50 Federated Query (Library of Congress & OCLC WorldCat)";
    misal standar_metadata = "MARC21 Full Bibliographic & Dublin Core DCMI 15 Elements";
    misal no_ill = "ILL-GLOBAL-2026-0089 (Perpusnas RI Jakarta <-> Leiden University)";
    misal manifes_iiif = "https://digitalcollections.universiteitleiden.nl/iiif/3/manifest/1786.json";

    cetak("    - Protokol Temu Kembali: " + protokol_search);
    cetak("    - Standar Bibliografi  : " + standar_metadata);
    cetak("    - Pinjam Antar-Negara  : " + no_ill);
    cetak("    - Koleksi Yang Diminta : Manuskrip Babad Tanah Jawi (Cod. Or. 1786)");
    cetak("    - Format Layanan       : IIIF High-Resolution Archival Manifest");
    cetak("    - URL IIIF Manifest    : " + manifes_iiif);

    cetak("\n============================================================================");
    cetak("    SELURUH 4 TINGKATAN EKOSISTEM PERPUSTAKAAN BERHASIL TERHUBUNG LENGKAP!  ");
    cetak("============================================================================");
}

utama();
