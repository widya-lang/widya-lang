// ============================================================================
// SIMULASI: WIDYALAB VIRTUAL / STEM INTERACTIVE SIMULATOR
// (simulasi_widyalab_virtual_stem_engine.wya)
// Uji Komprehensif Simulasi Fisika (Parabola & Listrik), Kimia, & Biologi
// ============================================================================

impor "widyaos/modul/widyalab_virtual_stem_engine.wya";

fungsi assert_wlab(kondisi, nama_tes) {
    jika (kondisi) {
        cetak("[PASS] " + nama_tes);
    } lainnya {
        cetak("[FAIL] " + nama_tes);
    }
}

fungsi utama() {
    cetak("======================================================================");
    cetak("MEMULAI SIMULASI WIDYALAB VIRTUAL STEM SIMULATOR (SETARA PhET/LABSTER)");
    cetak("======================================================================");

    // ------------------------------------------------------------------------
    // TES 1: Fisika - Gerak Parabola Sudut 45 Derajat
    // ------------------------------------------------------------------------
    misal p45 = wlab_hitung_gerak_parabola(20.0, 45.0);
    assert_wlab(p45.kecepatan_awal == 20.0, "Tes 1.1: Kecepatan awal 20 m/s terkonfigurasi");
    assert_wlab(p45.waktu_terbang_s > 2.8 && p45.waktu_terbang_s < 3.0, "Tes 1.2: Waktu terbang ~2.88s terhitung presisi");
    assert_wlab(p45.jarak_maksimum_m > 40.0, "Tes 1.3: Jarak jangkauan maksimum mencapai >40 meter");
    assert_wlab(panjang(p45.titik_lintasan) >= 4, "Tes 1.4: Titik sampling lintasan trajektori tergenerasi");

    // ------------------------------------------------------------------------
    // TES 2: Fisika - Gerak Vertikal Ke Atas (Sudut 90 Derajat)
    // ------------------------------------------------------------------------
    misal p90 = wlab_hitung_gerak_parabola(20.0, 90.0);
    assert_wlab(p90.jarak_maksimum_m == 0.0, "Tes 2.1: Sudut 90 derajat menghasilkan jarak horizontal 0 meter");
    assert_wlab(p90.tinggi_maksimum_m > 20.0, "Tes 2.2: Ketinggian vertikal maksimum terhitung benar");

    // ------------------------------------------------------------------------
    // TES 3: Fisika - Rangkaian Listrik Seri (Hukum Ohm)
    // ------------------------------------------------------------------------
    misal seri = wlab_hitung_rangkaian_listrik(12.0, "SERI", [10.0, 20.0]);
    assert_wlab(seri.hambatan_total_ohm == 30.0, "Tes 3.1: Hambatan total seri (10+20) = 30 Ohm");
    assert_wlab(seri.arus_ampere == 0.4, "Tes 3.2: Arus listrik I = 12/30 = 0.4 Ampere");
    assert_wlab(seri.daya_watt > 4.7 && seri.daya_watt < 4.9, "Tes 3.3: Daya listrik P = V*I = 4.8 Watt");

    // ------------------------------------------------------------------------
    // TES 4: Fisika - Rangkaian Listrik Paralel
    // ------------------------------------------------------------------------
    misal par = wlab_hitung_rangkaian_listrik(10.0, "PARALEL", [20.0, 20.0]);
    assert_wlab(par.hambatan_total_ohm == 10.0, "Tes 4.1: Hambatan total paralel (20 // 20) = 10 Ohm");
    assert_wlab(par.arus_ampere == 1.0, "Tes 4.2: Arus listrik paralel I = 10/10 = 1.0 Ampere");

    // ------------------------------------------------------------------------
    // TES 5: Kimia - Titrasi Sebelum Titik Ekivalen (Kondisi Asam)
    // ------------------------------------------------------------------------
    misal titrasi_awal = wlab_simulasi_titrasi_asam_basa(25.0, 0.1, 10.0, 0.1);
    assert_wlab(titrasi_awal.volume_ekivalen_ml == 25.0, "Tes 5.1: Titik ekivalen terhitung tepat 25.0 mL");
    assert_wlab(titrasi_awal.ph_larutan < 7.0, "Tes 5.2: Sebelum titik ekivalen pH larutan asam (< 7)");
    assert_wlab(titrasi_awal.warna_indikator == "BENING", "Tes 5.3: Indikator PP tetap bening di suasana asam");

    // ------------------------------------------------------------------------
    // TES 6: Kimia - Titrasi Tepat pada Titik Ekivalen
    // ------------------------------------------------------------------------
    misal titrasi_eq = wlab_simulasi_titrasi_asam_basa(25.0, 0.1, 25.0, 0.1);
    assert_wlab(titrasi_eq.ph_larutan == 7.0, "Tes 6.1: Tepat pada titik ekivalen pH netral (7.0)");
    assert_wlab(titrasi_eq.warna_indikator == "MERAH_MUDA", "Tes 6.2: Indikator PP berubah merah muda menandakan titik akhir titrasi");

    // ------------------------------------------------------------------------
    // TES 7: Kimia - Titrasi Lewat Titik Ekivalen (Kondisi Basa)
    // ------------------------------------------------------------------------
    misal titrasi_lewat = wlab_simulasi_titrasi_asam_basa(25.0, 0.1, 30.0, 0.1);
    assert_wlab(titrasi_lewat.ph_larutan > 7.0 && titrasi_lewat.warna_indikator == "MERAH_TUA", "Tes 7: Kelebihan basa menghasilkan pH tinggi dan warna merah tua");

    // ------------------------------------------------------------------------
    // TES 8: Biologi - Mikroskop Digital Virtual
    // ------------------------------------------------------------------------
    misal mikroskop = wlab_atur_mikroskop(40, "STOMATA_DAUN");
    assert_wlab(mikroskop.total_perbesaran == 400, "Tes 8.1: Total perbesaran 10x * 40x = 400x");
    assert_wlab(mikroskop.resolusi_mikron == 100.0, "Tes 8.2: Lapangan pandang mikroskop mikron terkalibrasi presisi");
    assert_wlab(mikroskop.preparat_aktif == "STOMATA_DAUN", "Tes 8.3: Preparat stomata daun aktif");

    cetak("======================================================================");
    cetak("SELURUH PENGUJIAN WIDYALAB VIRTUAL STEM SIMULATOR SELESAI (8/8 PASS)");
    cetak("======================================================================");
}

utama();
