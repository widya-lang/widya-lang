// ============================================================================
// MODUL: TATA KELOLA ETIKA, PENEGAKAN DISIPLIN & KASUS MORALITAS GURU
// Menangani Pelanggaran Kode Etik Profesi & Skandal Asmara / Perselingkuhan di Sekolah
// Rujukan Regulasi:
// 1. PP No. 94 Tahun 2021 tentang Disiplin PNS jo. PP No. 45/1990 (Larangan Perselingkuhan)
// 2. Kode Etik Guru Indonesia (Dewan Kehormatan Guru Indonesia / DKGI)
// 3. Permendikbudristek No. 46/2023 (Pencegahan & Penanganan Kekerasan di Satuan Pendidikan)
// 4. UU No. 12 Tahun 2022 tentang Tindak Pidana Kekerasan Seksual (TPKS)
// ============================================================================

struktur BerkasKasusEtikaGuru {
    id_kasus,
    nuptk_terlapor,
    nama_terlapor,
    status_kepegawaian,         // 'PNS', 'PPPK', 'GTT_HONORER', 'GTY_SWASTA'
    pihak_terlibat,             // 'SESAMA_GURU_TENDIK', 'WALI_MURID', 'SISWA_DI_BAWAH_UMUR'
    klasifikasi_pelanggaran,    // 'PELANGGARAN_DISIPLIN_BERAT_ASN', 'PELANGGARAN_KODE_ETIK_PROFESI', 'TINDAK_PIDANA_TPKS_DARURAT'
    tindakan_darurat_kbm,       // 'BEBAS_TUGAS_MENGAJAR_SEMENTARA_DAN_AUTO_INVAL'
    guru_inval_pengganti,       // Menjamin kelas tidak jamkos
    tahap_investigasi,          // 'PEMERIKSAAN_TERTUTUP_BAP', 'SIDANG_KODE_ETIK_DKGI', 'ESKALASI_INSPEKTORAT_BKD'
    rekomendasi_sanksi,         // 'HUKUMAN_DISIPLIN_BERAT_PP94', 'MUTASI_KELUAR_SATUAN_PENDIDIKAN', 'PEMBERHENTIAN_DAN_RUJUKAN_POLISI'
    protokol_kondusivitas       // 'RUANG_MEDIASI_TERTUTUP_DAN_ANTI_VIRAL'
}

// ============================================================================
// LOGIKA PENANGANAN KASUS PERSELINGKUHAN & MORALITAS GURU
// ============================================================================

// [1] Registrasi & Mitigasi Cepat Kasus Perselingkuhan / Hubungan Terlarang
fungsi tangani_skandal_asmara_guru(
    id_kasus,
    nuptk,
    nama,
    status_kerja,
    pihak_terlibat,
    guru_pengganti_kelas
) {
    // KASUS KRITIS A: Jika melibatkan SISWA -> Ini bukan sekadar perselingkuhan,
    // melainkan Tindak Pidana Kekerasan Seksual Anak di Bawah Umur (TPKS).
    // Wajib langsung dinonaktifkan permanen dan diserahkan ke APH (Polisi).
    jika pihak_terlibat == "SISWA_DI_BAWAH_UMUR" {
        kembalikan BerkasKasusEtikaGuru(
            id_kasus,
            nuptk,
            nama,
            status_kerja,
            pihak_terlibat,
            "TINDAK_PIDANA_TPKS_DARURAT",
            "PEMBERHENTIAN_SEKETIKA_DAN_BLOKIR_DAPODIK",
            guru_pengganti_kelas,
            "PELAPORAN_RESMI_KE_UNIT_PPA_POLRES",
            "PEMBERHENTIAN_DENGAN_TIDAK_HORMAT_DAN_PROSES_HUKUM",
            "PENDAMPINGAN_TRAUMA_HEALING_SISWA_OLEH_PSIKOLOG"
        );
    }

    // KASUS B: Perselingkuhan Sesama Guru/Tendik (Dewasa dengan Dewasa)
    // Berlaku PP 94/2021 Disiplin PNS / Kode Etik Kepegawaian
    misal klasifikasi = "PELANGGARAN_DISIPLIN_BERAT_ASN";
    misal sanksi = "HUKUMAN_DISIPLIN_BERAT_PP94_DAN_MUTASI_BEDAH_SEKOLAH";

    jika status_kerja == "GTT_HONORER" atau status_kerja == "GTY_SWASTA" {
        klasifikasi = "PELANGGARAN_KODE_ETIK_BERAT_INTEGRITAS";
        sanksi = "PEMUTUSAN_KONTRAK_KERJA_YAYASAN_ATAU_DINAS";
    }

    kembalikan BerkasKasusEtikaGuru(
        id_kasus,
        nuptk,
        nama,
        status_kerja,
        pihak_terlibat,
        klasifikasi,
        "BEBAS_TUGAS_MENGAJAR_SEMENTARA_DAN_AUTO_INVAL",
        guru_pengganti_kelas,
        "PEMERIKSAAN_TERTUTUP_BAP_OLEH_TIM_DISIPLIN",
        sanksi,
        "RUANG_MEDIASI_TERTUTUP_DAN_ANTI_VIRAL"
    );
}

// [2] Protokol Penyelamatan Citra Sekolah & Pencegahan Keributan Massa di Gerbang
fungsi protokol_keamanan_sekolah_anti_labrak(
    id_kasus,
    status_pasangan_sah_datang
) {
    // Mengarahkan pasangan yang menuntut ke ruang mediasi kepala sekolah,
    // melarang aksi kekerasan/pelabrakan di depan murid
    kembalikan {
        "id_kasus": id_kasus,
        "tindakan_satpam": "ARAHKAN_LANGSUNG_KE_RUANG_TRANSIT_MEDIASI_KEPSEK",
        "zona_kbm": "STERIL_DARI_KERIBUTAN_TERTUTUP_DARI_MURID",
        "dukungan_bhabinkamtibmas": "PANGGILAN_KOORDINASI_POLSEK_JIKA_MEMICU_ANARKIS",
        "mitigasi_medsos": "SIARAN_PERS_RESMI_HUMAS_AGAR_TIDAK_SIMPANG_SIUR"
    };
}
