// ============================================================================
// MODUL: ARKAS BKU IMMUTABLE SHIELD (ANTI-HAPUS RECORD BKU KEMENDIKDASMEN RI)
// Menjamin Kepatuhan Standar Akuntansi Pemerintahan (SAP) & Audit BPK RI:
// 
// ATURAN MUTLAK SISTEM KEUANGAN NEGARA:
// 1. DILARANG KERAS HARD-DELETE (Tidak ada query DELETE yang boleh menghapus baris kas_umum)
// 2. Soft-Delete dengan Audit Trail Lengkap (soft_delete = 1, waktu, DID, alasan)
// 3. Jurnal Pembalik (Storno Entry) via parent_id_kas_umum untuk transaksi buku kas
// 4. Rekam Jejak 100% Abadi untuk Pemeriksaan Inspektorat & BPK RI
// 5. Konsistensi Saldo Buku Kas Tanpa Gap Nomor Urut Kuitansi (Anti-Kwitansi Fiktif)
// ============================================================================

struktur RekamBkuKasUmum {
    id_kas_umum,
    parent_id_kas_umum, // Bertaut ke ID transaksi asal jika ini adalah Jurnal Pembalik (Storno)
    id_kas_nota,
    kode_rekening,
    no_bukti,
    uraian,
    saldo,              // Positif untuk kas masuk, bernilai pengeluaran/pembalik
    tipe_mutasi,        // 'KAS_MASUK' atau 'KAS_KELUAR'
    is_lock,            // 1 jika periode telah ditutup/sah
    soft_delete,        // 0: Aktif Berjalan, 1: Dibatalkan/Dihapus Logis (TIDAK PERNAH HILANG)
    create_date,
    last_update,
    updater_id,         // DID penanggung jawab terakhir
    alasan_pembatalan,  // Wajib diisi jika soft_delete = 1
    status_audit        // 'RECORD_SAH_AKTIF', 'RECORD_BATAL_TERARSIP', 'RECORD_STORNO_PEMBALIK'
}

struktur HasilProteksiBku {
    status_eksekusi,
    pesan,
    apakah_ada_record_terhapus_fisik, // Selalu bernilai SALAH (Zero Physical Deletion)
    jumlah_record_tersimpan
}

struktur RingkasanAuditBkuBpk {
    total_seluruh_record_fisik,
    total_transaksi_aktif,
    total_transaksi_soft_deleted,
    total_transaksi_storno_pembalik,
    saldo_efektif_bku,
    status_integritas_audit // 'AUDIT_TRAIL_SEMPURNA_TANPA_DATA_HILANG'
}

// ============================================================================
// LOGIKA BISNIS PROTEKSI KAS UMUM (IMMUTABLE APPEND-ONLY)
// ============================================================================

// [1] Guardrail Interceptor: Mencegah Eksekusi Perintah SQL DELETE Fisik
fungsi cegah_hard_delete_bku(perintah_sql) {
    // Jika ada upaya menjalankan perintah DELETE pada kas_umum / kas_umum_nota
    jika perintah_sql == "DELETE" atau perintah_sql == "DROP" atau perintah_sql == "TRUNCATE" {
        kembalikan "DITOLAK_KERAS_HARD_DELETE_DILARANG_STANDAR_BPK";
    }
    kembalikan "DIIZINKAN_OPERASI_NON_DESTRUKTIF";
}

// [2] Pembatalan Transaksi BKU Tanpa Menghapus Record (Soft Delete Tombstone)
// Record tetap berada di database dengan flag soft_delete = 1 dan audit provenance
fungsi batalkan_transaksi_bku_soft_delete(
    trx,
    did_penghapus,
    alasan,
    waktu_aksi
) {
    // Validasi 1: Alasan pembatalan tidak boleh kosong (syarat audit BPK)
    jika alasan == "" atau alasan == nihil {
        kembalikan "GAGAL: Alasan pembatalan transaksi BKU wajib diisi untuk jejak audit!";
    }

    // Validasi 2: BKU yang sudah dikunci/tutup buku tidak boleh diedit sembarangan
    jika trx.is_lock == 1 {
        kembalikan "GAGAL: BKU bulan ini telah dikunci! Wajib melalui prosedur pembukaan BKU resmi dinas.";
    }

    // Eksekusi Soft Delete: Data fisik 100% DILESTARIKAN di tabel kas_umum
    misal trx_batal = RekamBkuKasUmum(
        trx.id_kas_umum,
        trx.parent_id_kas_umum,
        trx.id_kas_nota,
        trx.kode_rekening,
        trx.no_bukti,
        trx.uraian,
        trx.saldo,
        trx.tipe_mutasi,
        trx.is_lock,
        1, // soft_delete = 1 (Tanda dibatalkan logis, RECORD TETAP UTUH DI DATABASE)
        trx.create_date,
        waktu_aksi,
        did_penghapus,
        alasan,
        "RECORD_BATAL_TERARSIP"
    );

    kembalikan trx_batal;
}

// [3] Pembatalan Melalui Jurnal Pembalik (Storno Entry) Sesuai Standar Akuntansi Keuangan Negara
// Untuk transaksi yang sudah mempengaruhi buku kas, dibuat jurnal pembalik bertaut parent_id
fungsi batalkan_transaksi_dengan_storno(
    trx,
    id_storno_baru,
    did_bendahara,
    alasan,
    waktu_aksi
) {
    jika alasan == "" {
        kembalikan "GAGAL: Alasan storno wajib diisi!";
    }

    // Transaksi lama ditandai soft_delete = 1 dan diberi alasan
    misal trx_asal_diarsip = RekamBkuKasUmum(
        trx.id_kas_umum,
        trx.parent_id_kas_umum,
        trx.id_kas_nota,
        trx.kode_rekening,
        trx.no_bukti,
        trx.uraian,
        trx.saldo,
        trx.tipe_mutasi,
        trx.is_lock,
        1, // soft_delete = 1
        trx.create_date,
        waktu_aksi,
        did_bendahara,
        alasan,
        "RECORD_BATAL_TERARSIP"
    );

    // Menentukan saldo lawan (pembalik):
    // Jika asal KAS_KELUAR (belanja), maka storno adalah KAS_MASUK (pemulihan saldo)
    misal tipe_lawan = "KAS_MASUK";
    jika trx.tipe_mutasi == "KAS_MASUK" {
        tipe_lawan = "KAS_KELUAR";
    }

    // Record baru bertaut ke parent_id_kas_umum (Persis seperti kolom di arkas.db.sql baris 126!)
    misal uraian_storno = "[STORNO PEMBALIKAN] " + trx.no_bukti + " - " + alasan;
    misal trx_storno = RekamBkuKasUmum(
        id_storno_baru,
        trx.id_kas_umum, // parent_id_kas_umum = ID transaksi asal
        trx.id_kas_nota,
        trx.kode_rekening,
        "STR-" + trx.no_bukti,
        uraian_storno,
        trx.saldo,       // Nominal yang dibalikkan
        tipe_lawan,
        0,               // Belum di-lock
        0,               // soft_delete = 0 (Storno aktif sebagai penyeimbang kas)
        waktu_aksi,
        waktu_aksi,
        did_bendahara,
        "Jurnal Pembalik Otomatis untuk Transaksi " + trx.id_kas_umum,
        "RECORD_STORNO_PEMBALIK"
    );

    misal hasil = [];
    tambah(hasil, trx_asal_diarsip);
    tambah(hasil, trx_storno);
    kembalikan hasil;
}

// [4] Filter Tampilan Operasional Sekolah (Hanya Menampilkan Data Aktif)
fungsi saring_bku_tampilan_operasional(daftar_trx) {
    misal hasil_aktif = [];
    untuk item dalam daftar_trx {
        // Hanya record dengan soft_delete == 0 yang tampil di kuitansi harian sekolah
        jika item.soft_delete == 0 {
            tambah(hasil_aktif, item);
        }
    }
    kembalikan hasil_aktif;
}

// [5] Perhitungan Saldo Berjalan Kas BKU
fungsi hitung_saldo_bku_berjalan(saldo_awal, daftar_trx) {
    misal saldo = saldo_awal;
    untuk item dalam daftar_trx {
        jika item.soft_delete == 0 {
            jika item.tipe_mutasi == "KAS_MASUK" {
                saldo = saldo + item.saldo;
            } lainnya {
                saldo = saldo - item.saldo;
            }
        }
    }
    kembalikan saldo;
}

// [6] Inspeksi Menyeluruh BPK / Inspektorat: Bukti Tidak Ada Data yang Hilang
fungsi audit_bku_transparansi_bpk(saldo_awal, daftar_seluruh_record_database) {
    misal total_fisik = panjang(daftar_seluruh_record_database);
    misal aktif = 0;
    misal soft_deleted = 0;
    misal storno = 0;

    untuk item dalam daftar_seluruh_record_database {
        jika item.soft_delete == 1 {
            soft_deleted = soft_deleted + 1;
        } lainnya {
            aktif = aktif + 1;
            jika item.parent_id_kas_umum != "" dan item.parent_id_kas_umum != nihil {
                storno = storno + 1;
            }
        }
    }

    misal saldo_efektif = hitung_saldo_bku_berjalan(saldo_awal, daftar_seluruh_record_database);

    kembalikan RingkasanAuditBkuBpk(
        total_fisik,
        aktif,
        soft_deleted,
        storno,
        saldo_efektif,
        "AUDIT_TRAIL_SEMPURNA_TANPA_DATA_HILANG"
    );
}
