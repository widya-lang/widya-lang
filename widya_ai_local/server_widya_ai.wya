        };
    });

    // RUTE 94: Verifikasi Presentasi ZK Selektif UU PDP (/v1/id/vc/verify-presentation)
    tambah_rute(server, "POST", "/v1/id/vc/verify-presentation", fungsi(req) {
        misal b = req["badan"];
