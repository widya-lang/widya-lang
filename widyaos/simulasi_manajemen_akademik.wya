// =================================================================
// SIMULASI SUITE: MANAJEMEN AKADEMIK LENGKAP & MUATAN LOKAL WIDYAOS
// Penjadwalan 3D, Mapel Mulok, Penugasan Inval, e-Rapor & Leger F4
// =================================================================

impor "widyaos/modul/manajemen_akademik_lengkap.wya";

cetak("==================================================================");
cetak(" UJI SISTEM MANAJEMEN AKADEMIK LENGKAP & MUATAN LOKAL (WIDYAOS)   ");
cetak("==================================================================");

// [TEST 1] Pendaftaran Mata Pelajaran Muatan Lokal (Mulok) & Pengakuan TPG
cetak("\n[1] Pendaftaran Mapel Muatan Lokal Daerah (Pergub Jabar No. 69/2013)");
misal mulok_sunda = daftarkan_mapel_muatan_lokal(
    "MLK-32-SUNDA",
    "Bahasa dan Sastra Sunda",
    "BAHASA_DAERAH",
    "Pergub Jawa Barat No. 69/2013 tentang Kurikulum Muatan Lokal",
    2, // 2 Jam Pelajaran per minggu
    "32" // Jawa Barat
);

misal mulok_angklung = daftarkan_mapel_muatan_lokal(
    "MLK-32-ANGKLUNG",
    "Seni Budaya Musik Tradisional Angklung",
    "SENI_BUDAYA_LOKAL",
    "SK Disdik Jabar No. 420/2024",
    1,
    "32"
);

cetak("📖 Mapel Mulok 1       :", mulok_sunda.nama_mapel, "(Kategori:", mulok_sunda.kategori_mulok, ")");
cetak("📜 Dasar Hukum         :", mulok_sunda.dasar_hukum_pergub);
cetak("⏰ Alokasi Waktu       :", mulok_sunda.alokasi_jjm_mingguan, "JJM/minggu");
cetak("🎖️ Status Linieritas   :", mulok_sunda.linearitas_tpg);

jika mulok_sunda.alokasi_jjm_mingguan == 2 dan mulok_sunda.linearitas_tpg == "DIAKUI_UNTUK_BEBAN_KERJA_TPG_24_JAM" {
    cetak("✅ [TEST 1] Fasilitasi Mapel Muatan Lokal & Pengakuan JJM Sertifikasi: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Fasilitasi Mapel Muatan Lokal & Pengakuan JJM Sertifikasi: GAGAL");
}

// [TEST 2] Penjadwalan Pelajaran & Audit Bentrok 3D (Termasuk Slot Mulok)
cetak("\n[2] Penjadwalan Pelajaran Mingguan & Audit Anti-Bentrok 3-Dimensi");
misal jadwal = inisialisasi_jadwal_akademik();

// Slot 1: Senin Jam ke-1 - Fisika di Kelas 10-A
tambah_slot_jadwal(jadwal, "SLOT-01", "SENIN", 1, "ROMBEL-10-A", "IPA-FIS-10", "Fisika Dasar", "INTRAKURIKULER_NASIONAL", "19750812001", "Drs. Bambang Irawan", "LAB-FISIKA");
// Slot 2: Senin Jam ke-2 - Bahasa Sunda (Mulok) di Kelas 10-A
tambah_slot_jadwal(jadwal, "SLOT-02", "SENIN", 2, "ROMBEL-10-A", "MLK-32-SUNDA", "Bahasa dan Sastra Sunda", "MUATAN_LOKAL", "19800510002", "Cecep Hidayat, S.Pd", "R-KELAS-10A");
// Slot 3: Senin Jam ke-1 - Matematika di Kelas 10-B (Guru beda, ruang beda)
tambah_slot_jadwal(jadwal, "SLOT-03", "SENIN", 1, "ROMBEL-10-B", "MAT-WAJIB-10", "Matematika", "INTRAKURIKULER_NASIONAL", "19820315003", "Rina Marlina, S.Pd", "R-KELAS-10B");

misal audit_jadwal = audit_bentrok_jadwal_3d(jadwal);
cetak("📅 Total Slot Terjadwal:", audit_jadwal.total_slot_terjadwal, "slot");
cetak("👥 Bentrok Guru        :", audit_jadwal.total_bentrok_guru);
cetak("🚪 Bentrok Ruangan     :", audit_jadwal.total_bentrok_ruang);
cetak("👥 Bentrok Rombel      :", audit_jadwal.total_bentrok_rombel);
cetak("✨ Status Kelayakan    :", audit_jadwal.status_kelayakan_jadwal);

jika audit_jadwal.status_kelayakan_jadwal == "JADWAL_VALID_BEBAS_BENTROK" {
    cetak("✅ [TEST 2] Audit Jadwal Pelajaran 3D Bebas Bentrok: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Audit Jadwal Pelajaran 3D Bebas Bentrok: GAGAL");
}

// [TEST 3] Penugasan Guru Inval / Pengganti
cetak("\n[3] Penugasan Guru Pengganti (Inval / Guru Piket) saat Guru Izin");
// Slot 1: Drs. Bambang izin dinas seminar
misal slot_target = jadwal[0];
misal res_inval = tugaskan_guru_inval(slot_target, "19900101004", "Agus Setiawan, S.Pd (Guru Piket)", "Izin Dinas Luar / Seminar Kemendikdasmen");

cetak("🔄 Status Slot 1       :", slot_target.status_kehadiran_guru);
cetak("👨‍🏫 Guru Pengganti     :", res_inval.guru_inval);
cetak("📋 Alasan Penugasan    :", res_inval.alasan);

jika slot_target.status_kehadiran_guru == "DIGANTIKAN_GURU_INVAL" {
    cetak("✅ [TEST 3] Penugasan Guru Inval / Piket Akademik: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Penugasan Guru Inval / Piket Akademik: GAGAL");
}

// [TEST 4] Pengelolaan Nilai KKTP Mapel Nasional vs Mapel Muatan Lokal
cetak("\n[4] Pengolahan Nilai Formatif, Sumatif & KKTP (Nasional & Mulok)");
// 1. Mapel Nasional (Fisika)
misal nilai_fisika = hitung_nilai_akhir_mapel_lengkap(
    "IPA-FIS-10",
    "Fisika Dasar",
    "KELOMPOK_UMUM_NASIONAL",
    75.0, // KKTP
    85.0, // Formatif
    90.0, // Sumatif Materi
    88.0, // SAS
    "analisis gerak lurus dan hukum Newton",
    "penerapan optik geometris"
);

// 2. Mapel Muatan Lokal (Bahasa Sunda)
misal nilai_sunda = hitung_nilai_akhir_mapel_lengkap(
    "MLK-32-SUNDA",
    "Bahasa dan Sastra Sunda",
    "KELOMPOK_MUATAN_LOKAL",
    75.0,
    90.0,
    95.0,
    92.0,
    "paguneman (percakapan undak-usuk basa) dan aksara Sunda kuno",
    "pembacaan carita carpon panjang"
);

cetak("📚 Mapel Nasional      :", nilai_fisika.nama_mapel, "-> Nilai Akhir:", nilai_fisika.nilai_akhir, "| Predikat:", nilai_fisika.predikat);
cetak("   Capaian Unggul      :", nilai_fisika.deskripsi_capaian_tertinggi);
cetak("🌺 Mapel Muatan Lokal  :", nilai_sunda.nama_mapel, "-> Nilai Akhir:", nilai_sunda.nilai_akhir, "| Predikat:", nilai_sunda.predikat);
cetak("   Capaian Unggul      :", nilai_sunda.deskripsi_capaian_tertinggi);

jika nilai_fisika.nilai_akhir == 87.9 dan nilai_sunda.nilai_akhir == 92.6 {
    cetak("✅ [TEST 4] Perhitungan Nilai KKTP & Narasi Capaian (Nasional & Mulok): LULUS");
} lainnya {
    cetak("❌ [TEST 4] Perhitungan Nilai KKTP & Narasi Capaian (Nasional & Mulok): GAGAL");
}

// [TEST 5] Penerbitan e-Rapor Resmi Siswa (Format Kemendikdasmen)
cetak("\n[5] Penerbitan Lembar e-Rapor Resmi Siswa (Tabel Nasional & Mulok Terpisah)");
misal erapor_fauzi = terbitkan_erapor_lengkap(
    "0081234567",
    "Ahmad Fauzi",
    "ROMBEL-10-A",
    "Fase E (Kelas 10)",
    1,
    "2026/2027",
    [nilai_fisika], // Tabel Mapel Nasional
    [nilai_sunda],  // Tabel Muatan Lokal Daerah
    "Ananda menunjukkan prestasi akademik yang sangat membanggakan dan aktif dalam projek P5.",
    0, // Sakit
    1, // Izin
    0, // Alpa
    "NAIK_KE_KELAS_BERIKUTNYA",
    "did:sewidya:kepsek:20101234",
    "did:sewidya:wali:19800510002"
);

cetak("👦 Peserta Didik       :", erapor_fauzi.nama_siswa, "(NISN:", erapor_fauzi.nisn, ")");
cetak("📊 Mapel Nasional      :", panjang(erapor_fauzi.daftar_nilai_nasional), "mapel");
cetak("🌺 Mapel Muatan Lokal  :", panjang(erapor_fauzi.daftar_nilai_mulok), "mapel daerah");
cetak("📈 Rekap Presensi      : Sakit = 0 | Izin = 1 | Alpa = 0");
cetak("🏆 Status Kenaikan     :", erapor_fauzi.status_kenaikan);
cetak("🔐 Hash TTE Digital    :", erapor_fauzi.qr_verifikasi_hash);

jika panjang(erapor_fauzi.daftar_nilai_mulok) == 1 dan erapor_fauzi.status_kenaikan == "NAIK_KE_KELAS_BERIKUTNYA" {
    cetak("✅ [TEST 5] Penerbitan e-Rapor Lengkap Ber-QR TTE Digital: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Penerbitan e-Rapor Lengkap Ber-QR TTE Digital: GAGAL");
}

// [TEST 6] Penyusunan Leger Nilai Semester Rombel (Format F4 Folio Baku)
cetak("\n[6] Penyusunan Leger Nilai Semester Rombel Siap Cetak F4");
misal leger = susun_leger_nilai_rombel("ROMBEL-10-A", "Kelas X MIPA 1", 1, "2026/2027", [erapor_fauzi]);

cetak("📑 Rombongan Belajar   :", leger.nama_rombel);
cetak("👥 Total Siswa         :", leger.total_siswa, "murid");
cetak("📈 Rata-Rata Rombel    :", leger.rata_rata_rombel, "skala 100");

jika leger.total_siswa == 1 dan leger.rata_rata_rombel > 80.0 {
    cetak("✅ [TEST 6] Penyusunan Leger Nilai Semester Rombel Format F4: LULUS");
} lainnya {
    cetak("❌ [TEST 6] Penyusunan Leger Nilai Semester Rombel Format F4: GAGAL");
}

cetak("\n==================================================================");
cetak("  SEMUA PENGUJIAN MANAJEMEN AKADEMIK & MUATAN LOKAL LULUS 100%!   ");
cetak("==================================================================");
