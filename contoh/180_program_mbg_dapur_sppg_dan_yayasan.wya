// ============================================================================
// CONTOH 180: EKOSISTEM PROGRAM NASIONAL MAKAN BERGIZI GRATIS (MBG)
// Dapur Sentral SPPG, Standar Gizi AKG, Yayasan Bantuan, & Penerima Manfaat
// ============================================================================

fungsi utama() {
    cetak("====================================================================");
    cetak("🍱 PROGRAM NASIONAL MAKAN BERGIZI GRATIS (MBG) & DAPUR SENTRAL SPPG");
    cetak("====================================================================");

    // ------------------------------------------------------------------------
    // 1. STANDAR GIZI & ANGKA KECUKUPAN GIZI (AKG PERMENKES)
    // ------------------------------------------------------------------------
    cetak("\n--- [1. STANDAR GIZI & KOMPOSISI MENU 4 SEHAT 5 SEMPURNA] ---");
    misal menu_hari = "Senin";
    misal makanan_pokok = "Nasi Pulen Desa Merah Putih (150 gram)";
    misal lauk_hewani = "Ayam Ungkep Bumbu Kuning (80 gram) + Telur Rebus";
    misal lauk_nabati = "Tempe Bacem Gurih (50 gram)";
    misal sayuran = "Sayur Bening Bayam Wortel Jagung Manis";
    misal buah = "Pisang Cavendish Segar";
    misal minuman = "Susu Pasteurisasi Sapi Perah Koperasi Merah Putih";

    misal kalori_kkal = 635.0; // Kalori ideal SD Kelas 4-6 (~600 - 700 kkal)
    misal protein_g = 24.5;    // Protein tinggi untuk cegah stunting (Standar min: 20g)
    misal karbohidrat_g = 88.0;
    misal zat_besi_mg = 4.8;

    cetak("  ✓ Menu Makan Siang Bergizi Hari " + menu_hari + ":");
    cetak("    • Karbohidrat : " + makanan_pokok);
    cetak("    • Protein     : " + lauk_hewani + " & " + lauk_nabati);
    cetak("    • Sayur & Buah: " + sayuran + " & " + buah);
    cetak("    • Susu Segar  : " + minuman);
    cetak("  ✓ Analisis Profil Nutrisi Laboratorium:");
    cetak("    • Total Energi : " + kalori_kkal + " kkal (Sesuai Standar AKG)");
    cetak("    • Total Protein: " + protein_g + " gram | Zat Besi: " + zat_besi_mg + " mg");

    // ------------------------------------------------------------------------
    // 2. DAPUR SENTRAL SPPG (SATUAN PELAYANAN PEMENUHAN GIZI)
    // ------------------------------------------------------------------------
    cetak("\n--- [2. DAPUR SENTRAL SPPG KECAMATAN & PENYERAPAN BAHAN LOKAL] ---");
    misal nama_dapur = "Dapur SPPG Sentral Somagede (Kapasitas: 3.000 Porsi/Hari)";
    misal serapan_beras_kg = 450.0;
    misal serapan_ayam_kg = 250.0;
    misal serapan_sayur_kg = 180.0;
    misal suhu_makanan_matang = 74.5; // °C (HACCP >= 65 °C)

    cetak("  ✓ Fasilitas Dapur Sentral: " + nama_dapur);
    cetak("  ✓ Penyerapan Bahan Pangan Petani/Peternak Koperasi Desa Merah Putih:");
    cetak("    • Beras Organik Petani Lokal : " + serapan_beras_kg + " kg");
    cetak("    • Ayam Potong Peternak Lokal : " + serapan_ayam_kg + " kg");
    cetak("    • Sayur Mayur Segar Kelompok Tani: " + serapan_sayur_kg + " kg");
    cetak("  ✓ Kontrol Kualitas Sanitasi & Keamanan Pangan (HACCP):");
    cetak("    • Suhu Makanan Saat Selesai Masak: " + suhu_makanan_matang + " °C (Higienis & Matang Sempurna)");
    cetak("    • Sampel Makanan Disimpan (Retention Box 24 Jam): Terkunci");
    cetak("    • Batas Waktu Konsumsi: Maksimal 4 Jam Setelah Produksi");

    // ------------------------------------------------------------------------
    // 3. YAYASAN & LEMBAGA SEKOLAH PENERIMA BANTUAN DANA APBN
    // ------------------------------------------------------------------------
    cetak("\n--- [3. TATA KELOLA YAYASAN / SEKOLAH & SPJ DIGITAL AKUNTABEL] ---");
    misal nama_sekolah = "SD Negeri 1 Somagede & Yayasan Pendidikan Islam";
    misal npsn = "NPSN: 20301234";
    misal jumlah_siswa = 250;
    misal biaya_per_porsi = 15000;
    misal hari_sekolah_sebulan = 20;
    misal total_anggaran_bulan = jumlah_siswa * biaya_per_porsi * hari_sekolah_sebulan;

    cetak("  ✓ Lembaga Penerima Manfaat: " + nama_sekolah + " (" + npsn + ")");
    cetak("    • Total Sasaran Siswa: " + jumlah_siswa + " Siswa");
    cetak("    • Alokasi Dana Termin APBN (20 Hari): Rp " + total_anggaran_bulan);

    misal no_spj = "SPJ-MBG-2026-0001";
    cetak("  ✓ Pelaporan Pertanggungjawaban (SPJ Digital E-Faktur):");
    cetak("    • No. Dokumen SPJ: " + no_spj + " (Tervalidasi BPKP / Inspektorat)");
    cetak("    • Bukti Nota & E-Faktur: Terlampir Sesuai Realisasi Lapangan");

    // ------------------------------------------------------------------------
    // 4. PENERIMA MANFAAT, PRESENSI QR & PEMANTAUAN TUMBUH KEMBANG
    // ------------------------------------------------------------------------
    cetak("\n--- [4. PENERIMA MANFAAT & MONITORING GIZI ANAK SEKOLAH] ---");
    misal nisn_siswa = "0123456789";
    misal nama_siswa = "Ahmad Fauzi (Kelas 5A)";
    misal tinggi_cm = 135.0;
    misal berat_kg = 32.0;
    misal imt = 17.6; // Normal Ideal

    cetak("  ✓ Data Siswa Penerima: " + nama_siswa + " | NISN: " + nisn_siswa);
    cetak("    • Tinggi Badan: " + tinggi_cm + " cm | Berat Badan: " + berat_kg + " kg");
    cetak("    • Indeks Massa Tubuh (IMT): " + imt + " (Status: Gizi Baik / Normal Ideal)");

    misal log_distribusi = "LOG-MBG-20261001-042";
    cetak("  ✓ Presensi Tapping QR Siswa:");
    cetak("    • No. Transaksi: " + log_distribusi + " (Pukul 11:45 WIB)");
    cetak("    • Status Distribusi: Porsi Makan Siang & Susu Diterima Lengkap");
    cetak("    • Keamanan Sistem: Anti-Double Claim (Porsi Ganda Otomatis Dicegah)");

    cetak("\n====================================================================");
    cetak("🚀 SELURUH RANTAI PASOK PROGRAM MBG & SPPG BERJALAN DENGAN AKUNTABEL!");
    cetak("====================================================================");
}

utama();
