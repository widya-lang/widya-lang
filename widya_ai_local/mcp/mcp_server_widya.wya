        // Tool 54: pemulihan_mandiri_anti_entropi
        tambah(tools_list, {
            "name": "pemulihan_mandiri_anti_entropi",
            "description": "Memicu rekonsiliasi gossip anti-entropi, isolasi simpul Byzantine, atau pemulihan nol-downtime dari snapshot Merkle bencana dengan jaminan RTO sub-10ms.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "tipe_pemulihan": { "type": "string" },
                    "simpul_sumber": { "type": "string" },
