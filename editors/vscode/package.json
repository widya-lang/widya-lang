{
  "name": "widya-lang",
  "displayName": "Widya-Lang Official Support",
  "description": "Dukungan resmi sintaksis, LSP Language Server, DAP Debugger, dan Snippet untuk bahasa pemrograman Widya-Lang",
  "version": "2.5.0",
  "publisher": "widya-lang-foundation",
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:widya"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Bakulcoding/widya-lang"
  },
  "homepage": "https://widya-lang.org",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Snippets"
  ],
  "keywords": [
    "widya",
    "widya-lang",
    "hindley-milner",
    "lsp",
    "dap",
    "wpm",
    "web",
    "desktop"
  ],
  "contributes": {
    "languages": [
      {
        "id": "widya",
        "aliases": ["Widya", "widya", "Widya-Lang"],
        "extensions": [".wya", ".widya", ".wd"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "widya",
        "scopeName": "source.widya",
        "path": "./syntaxes/widya.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "widya",
        "path": "./snippets/widya.json"
      }
    ],
    "breakpoints": [
      {
        "language": "widya"
      }
    ],
    "debuggers": [
      {
        "type": "widya",
        "label": "Widya DAP Debugger",
        "runtime": "widya",
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Lokasi file sumber Widya (.wya)"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Otomatis berhenti saat entry point tercapai"
              }
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "widya.runFile",
        "title": "Widya: Jalankan Berkas",
        "category": "Widya"
      },
      {
        "command": "widya.testFile",
        "title": "Widya: Jalankan Pengujian Unit (Test)",
        "category": "Widya"
      },
      {
        "command": "widya.formatFile",
        "title": "Widya: Format Berkas",
        "category": "Widya"
      },
      {
        "command": "widya.vendorPackages",
        "title": "Widya: Pasok Seluruh Dependensi (WPM Offline Vendor)",
        "category": "Widya"
      },
      {
        "command": "widya.showInfo",
        "title": "Widya: Tampilkan Info Compiler",
        "category": "Widya"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .wya || resourceExtname == .widya",
          "command": "widya.runFile",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .wya || resourceExtname == .widya",
          "command": "widya.runFile",
          "group": "1_run"
        },
        {
          "when": "resourceExtname == .wya || resourceExtname == .widya",
          "command": "widya.testFile",
          "group": "1_run"
        },
        {
          "when": "resourceExtname == .wya || resourceExtname == .widya",
          "command": "widya.vendorPackages",
          "group": "2_package"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Konfigurasi Widya-Lang",
      "properties": {
        "widya.executablePath": {
          "type": "string",
          "default": "widya",
          "description": "Jalur (path) lengkap ke berkas eksekusi biner compiler widya."
        },
        "widya.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Aktifkan integrasi otomatis Language Server Protocol (LSP)."
        }
      }
    }
  }
}
