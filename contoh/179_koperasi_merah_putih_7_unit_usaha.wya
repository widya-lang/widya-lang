// ============================================================================
// CONTOH 179: EKOSISTEM DIGITAL KOPERASI DESA / KELURAHAN MERAH PUTIH
// Integrasi 7 Bidang Usaha Berdaulat: Perkantoran, Simpan Pinjam, Warung Sembako,
// Klinik Desa, Apotek, Pergudangan (SRG), dan Logistik Distribusi Desa.
// ============================================================================

fungsi utama() {
    cetak("====================================================================");
    cetak("🇮🇩 KOPERASI DESA / KELURAHAN MERAH PUTIH (7 UNIT USAHA TERPADU)");
    cetak("====================================================================");

    // ------------------------------------------------------------------------
    // 1. UNIT PERKANTORAN, KEANGGOTAAN, RAT & PEMBAGIAN SHU
    // ------------------------------------------------------------------------
    cetak("\n--- [1. UNIT PERKANTORAN & TATA KELOLA ANGGOTA] ---");
    misal npa = "KMP-3301-0001";
    misal nama_anggota = "Ibu Siti Aminah (Petani Desa Sukamaju)";
    misal simpanan_pokok = 500000;
    misal simpanan_wajib = 600000; // 12 bulan x Rp 50.000
    misal total_belanja_tahun = 12500000;

    cetak("  ✓ Pendaftaran Anggota Koperasi: " + npa + " (" + nama_anggota + ")");
    cetak("    • Simpanan Pokok: Rp " + simpanan_pokok + " | Simpanan Wajib: Rp " + simpanan_wajib);
    cetak("    • Partisipasi Transaksi Tahunan: Rp " + total_belanja_tahun);

    // Simulasi Distribusi SHU
    misal shu_jasa_modal = 245000;
    misal shu_jasa_usaha = 385000;
    misal total_shu = shu_jasa_modal + shu_jasa_usaha;
    cetak("  ✓ Alokasi Sisa Hasil Usaha (SHU) RAT Tahun 2026:");
    cetak("    • Jasa Modal (Simpanan): Rp " + shu_jasa_modal);
    cetak("    • Jasa Usaha (Belanja & Transaksi): Rp " + shu_jasa_usaha);
    cetak("    • Total SHU Diterima Anggota: Rp " + total_shu + " (Ditransfer ke Tabungan)");

    // ------------------------------------------------------------------------
    // 2. UNIT SIMPAN PINJAM (USP SYARIAH / MIKROFINANSIAL DESA)
    // ------------------------------------------------------------------------
    cetak("\n--- [2. UNIT SIMPAN PINJAM (USP) & PEMBIAYAAN MIKRO] ---");
    misal saldo_tabungan = 3500000;
    cetak("  ✓ Rekening Tabungan Anggota: Rp " + saldo_tabungan + " (Bebas Biaya Admin)");

    // Pembiayaan Modal Tani (Murabahah)
    misal pinjaman_pokok = 10000000;
    misal tenor_bulan = 10;
    misal margin_tahunan_pct = 6.0;
    misal angsuran_per_bulan = 1050000;
    cetak("  ✓ Akad Pembiayaan Murabahah Modal Tani Padi Organik:");
    cetak("    • Plafon: Rp " + pinjaman_pokok + " | Tenor: " + tenor_bulan + " Bulan (Margin: " + margin_tahunan_pct + "% p.a.)");
    cetak("    • Cicilan Bulanan: Rp " + angsuran_per_bulan + " / bulan (Jatuh tempo pasca panen)");

    // ------------------------------------------------------------------------
    // 3. UNIT WARUNG SEMBAKO & RITEL KOPERASI (POS SUBSIDI TEPAT SASARAN)
    // ------------------------------------------------------------------------
    cetak("\n--- [3. UNIT WARUNG SEMBAKO & RITEL BAHAN POKOK] ---");
    misal beras_5kg = 68000;  // Harga anggota (Umum: Rp 72.000)
    misal minyakita_1l = 14000;// Subsidi
    misal lpg_3kg = 18000;    // Subsidi NIK
    misal total_struk = (beras_5kg * 2) + (minyakita_1l * 3) + lpg_3kg;

    cetak("  ✓ Transaksi Kasir POS Warung Sembako:");
    cetak("    • 2x Beras Premium 5kg  : Rp " + (beras_5kg * 2));
    cetak("    • 3x Minyakita 1L       : Rp " + (minyakita_1l * 3));
    cetak("    • 1x Gas LPG 3kg        : Rp " + lpg_3kg + " (Terverifikasi NIK KTP)");
    cetak("    • Total Belanja: Rp " + total_struk + " (Pembayaran via QRIS Koperasi / Potong Saldo)");
    cetak("    • Poin Reward Anggota Diperoleh: 19 Poin");

    // ------------------------------------------------------------------------
    // 4. UNIT KLINIK DESA & FASKES PRIMER (SATUSEHAT & ANTI-STUNTING)
    // ------------------------------------------------------------------------
    cetak("\n--- [4. UNIT KLINIK DESA & KESEHATAN MASYARAKAT] ---");
    misal no_rm = "RM-DESA-2026-0042";
    misal tensi = "118/78 mmHg";
    misal status_anak = "Tinggi 88.5 cm pada 24 Bulan (Status: Gizi Baik & Bebas Stunting)";

    cetak("  ✓ Layanan Posyandu & Pemeriksaan Dokter Desa:");
    cetak("    • No. Rekam Medis: " + no_rm + " (Tersinkronisasi SatuSehat Kemenkes)");
    cetak("    • Tekanan Darah: " + tensi + " (Normal)");
    cetak("    • Pemantauan Tumbuh Kembang Balita: " + status_anak);

    // ------------------------------------------------------------------------
    // 5. UNIT APOTEK DESA (DISTRIBUSI OBAT FEFO & FITOFARMAKA)
    // ------------------------------------------------------------------------
    cetak("\n--- [5. UNIT APOTEK DESA & FARMASI ESENSIAL] ---");
    misal obat_resep = "Paracetamol 500mg (Batch: 2027A, Exp: 2027-12-31)";
    misal obat_herbal = "Kapsul Fitofarmaka Temulawak Jahe Merah (Exp: 2028-05-15)";

    cetak("  ✓ Pengeluaran Resep Sistem FEFO (First Expired First Out):");
    cetak("    • Obat Generik: " + obat_resep + " -> Sesuai HET Kemenkes");
    cetak("    • Jamu / OHT  : " + obat_herbal);

    // ------------------------------------------------------------------------
    // 6. UNIT PERGUDANGAN & RESI GUDANG (SRG GABAH & KOMODITAS)
    // ------------------------------------------------------------------------
    cetak("\n--- [6. UNIT PERGUDANGAN & SISTEM RESI GUDANG (SRG)] ---");
    misal no_srg = "SRG-KMP-2026-0081";
    misal tonase_gabah = 3500.0; // 3.5 Ton
    misal kadar_air_gabah = 13.2; // %
    misal taksiran_harga = 23800000;
    misal plafon_kredit_srg = 16660000; // 70% LTV

    cetak("  ✓ Penerbitan Sertifikat Resi Gudang (SRG Bappebti):");
    cetak("    • No. Sertifikat: " + no_srg);
    cetak("    • Komoditas: Gabah Kering Panen (" + tonase_gabah + " kg | Kadar Air: " + kadar_air_gabah + "%)");
    cetak("    • Taksiran Nilai Pasar: Rp " + taksiran_harga);
    cetak("    • Plafon Likuiditas Pembiayaan Bank (70%): Rp " + plafon_kredit_srg);
    cetak("    • Sensor IoT Silo: Suhu 24.5 °C | RH 60% (Kondisi Gabah Terjaga Aman)");

    // ------------------------------------------------------------------------
    // 7. UNIT LOGISTIK, DISTRIBUSI & KURIR DESA
    // ------------------------------------------------------------------------
    cetak("\n--- [7. UNIT LOGISTIK & DISTRIBUSI ARMADA DESA] ---");
    misal no_waybill = "KMP-LOG-2026-0421";
    misal armada = "Mobil Pick-Up L300 (B 9488 KMP)";
    misal rute = "Gudang Koperasi Merah Putih -> Pasar Induk Beras Cipinang";

    cetak("  ✓ Surat Jalan Elektronik (e-Waybill): " + no_waybill);
    cetak("    • Armada Pengangkut: " + armada);
    cetak("    • Rute Pengiriman: " + rute);
    cetak("    • Muatan: 1.200 kg Beras Premium Kemasan Koperasi");
    cetak("    • Status Pelacakan GPS: Terkirim & Tanda Tangan Digital Penerima Sah");

    cetak("\n====================================================================");
    cetak("🚀 SELURUH 7 UNIT USAHA KOPERASI MERAH PUTIH TERPADU BEROPERASI PENUH!");
    cetak("====================================================================");
}

utama();
