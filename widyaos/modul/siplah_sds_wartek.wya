// ============================================================================
// MODUL: SIPLAH SDS WARTEK - KEMENDIKDASMEN RI
// Mengacu Resmi pada Dokumentasi Wartek-ID SDS SIPLah Kemendikdasmen:
// https://wartek-id.gitlab.io/sds/sds/siplah/docs/
//
// Standar Teknis & Regulasi:
// 1. Permendikbudristek No. 18 Tahun 2022 (PBJ Satuan Pendidikan melalui SIPLah)
// 2. PMK No. 58/PMK.03/2022 (PPMSE Wajib Pungut PPN & PPh 22)
// 3. SSO SDS OAuth 2.0 / OIDC (Casdoor standard)
// 4. Halaman Pemetaan Pembelanjaan (AES-128-GCM + zlib, SSH & ARKAS sync)
// 5. 8 Event Collectors & API Agregasi
// 6. API Rekonsiliasi (Recon Items, Merchants, Transactions)
// 7. Puskurbuk HET Buku Zonasi 1 - 5B
// ============================================================================

// 1. SSO SDS Model
struktur SsoSdsUser {
    pengguna_id,
    ptk_id,
    nama,
    nik,
    nip,
    username,
    jabatan, // 'Kepala Sekolah', 'PLT Kepala Sekolah', 'Pelaksana PBJ', 'Bendahara BOS/BOP'
    peran,
    npsn,
    nama_sekolah,
    zona_sekolah, // '1', '2', '3', '4', '5A', '5B'
    is_ftz // benar jika di Batam (101) atau Bintan (102)
}

// 2. Item Belanja SIPLah
struktur ItemSiplah {
    item_id,
    nama_item,
    kategori_id, // 1: Barang, 2: Jasa, 3: Alat Peraga, dst
    tipe_item,     // 1: Buku (BTP/BNTP), 2: Non-Buku, 3: Jasa
    harga_satuan_dpp,
    ppn_tag_item,  // 0: Barang Kena PPN, 2: Non-PPN
    kuantitas,
    puskurbuk_id,
    isbn,
    het_zona     // HET resmi jika buku BTP
}

// 3. Perhitungan Pajak Transaksi (PMK 58/2022)
struktur FakturSiplah {
    transaksi_id,
    total_harga_barang,
    biaya_kirim,
    dpp_ppn,
    tarif_ppn,    // Misal 0.11 (11%)
    ppn_nominal,
    denda_keterlambatan,
    grand_total,
    pph_22_nominal,
    ppn_tag_school  // 0: Non-FTZ, 101: FTZ Batam, 102: FTZ Bintan
}

// 4. State Rekonsiliasi Transaksi
struktur StatusTransaksiSds {
    transaksi_id,
    transaction_state, // 'TRANSACTION_CREATED', 'TRANSACTION_PROCESSED', 'TRANSACTION_SHIPPED', 'TRANSACTION_DELIVERED', 'TRANSACTION_BAST_GENERATED', 'TRANSACTION_CLOSED'
    shipment_state,    // 'SHIPMENT_UNSPECIFIED', 'SHIPMENT_SHIPPING', 'SHIPMENT_DELIVERED'
    payment_state,     // 'PAYMENT_UNSPECIFIED', 'PAYMENT_WAIT', 'PAYMENT_CONFIRMED', 'PAYMENT_SETTLED', 'PAYMENT_COMPLAINED'
    complaint_state    // 'COMPLAINT_UNSPECIFIED', 'COMPLAINT_COMPLAINED', 'COMPLAINT_PROCESSED', 'COMPLAINT_RESOLVED'
}

// ============================================================================
// FUNGSI UTAMA SIPLAH SDS
// ============================================================================

// 1. Otorisasi Akses SSO SDS Berdasarkan Jabatan (RBAC Kemendikdasmen)
fungsi cek_izin_sso_sds(jabatan, aksi) {
    // Aksi: 'BELANJA_KERANJANG', 'NEGOSIASI', 'PERIKATAN_SPK', 'TERBIT_BAST', 'BAYAR'
    jika jabatan == "Kepala Sekolah" atau jabatan == "PLT Kepala Sekolah" atau jabatan == "Pelaksana PBJ" {
        // Berwenang penuh atas seluruh siklus pengadaan
        kembalikan benar;
    }
    jika jabatan == "Bendahara BOS/BOP" {
        // Bendahara BOS/BOP hanya dapat memilih barang, negosiasi, dan perbandingan harga
        jika aksi == "BELANJA_KERANJANG" atau aksi == "NEGOSIASI" atau aksi == "PERBANDINGAN" {
            kembalikan benar;
        } lainnya {
            // Ditolak: Bendahara tidak boleh checkout/terbitkan SPK atau tanda tangan BAST
            kembalikan salah;
        }
    }
    // Jabatan lain (guru mata pelajaran dll) dilarang masuk
    kembalikan salah;
}

// 2. Guardrail Pemetaan Pembelanjaan (ARKAS & Standar Satuan Harga SSH)
fungsi validasi_pemetaan_arkas_ssh(
    harga_satuan,
    ssh_plafon,
    tipe_item,
    het_buku,
    anggaran_arkas_tersedia,
    total_belanja
) {
    // Validasi 1: Cek HET Buku (jika buku teks BTP)
    jika tipe_item == 1 dan het_buku > 0.0 dan harga_satuan > het_buku {
        kembalikan "GAGAL: Harga buku melebihi HET Kemendikdasmen Zona terkait!";
    }

    // Validasi 2: Cek SSH (Standar Satuan Harga Daerah)
    jika harga_satuan > ssh_plafon {
        kembalikan "GAGAL: Harga item melebihi batas Standar Satuan Harga (SSH) Daerah!";
    }

    // Validasi 3: Cek Ketersediaan Anggaran Kertas Kerja ARKAS
    jika total_belanja > anggaran_arkas_tersedia {
        kembalikan "GAGAL: Nilai belanja melebihi sisa plafon pagu Kertas Kerja ARKAS!";
    }

    kembalikan "LOLOS_VALIDASI_PEMETAAN";
}

// 3. Kalkulator Pajak Standar SDS SIPLah (PMK 58/2022 & FTZ Rule)
fungsi hitung_pajak_siplah_sds(
    transaksi_id,
    subtotal_barang_kena_ppn,
    subtotal_barang_non_ppn,
    ongkir,
    is_ftz,
    denda,
    tarif_ppn,
    tarif_pph_22
) {
    misal total_barang = subtotal_barang_kena_ppn + subtotal_barang_non_ppn;
    misal dpp = 0.0;
    misal ppn = 0.0;
    misal tag_sekolah = 0;

    jika is_ftz {
        // Sekolah berada di kawasan Free Trade Zone (Batam tag 101 / Bintan tag 102)
        // Bebas PPN (DPP PPN = 0, PPN = 0)
        dpp = 0.0;
        ppn = 0.0;
        tag_sekolah = 101;
    } lainnya {
        // Sekolah Non-FTZ (Normal PPN): DPP meliputi barang kena PPN + ongkir
        dpp = subtotal_barang_kena_ppn + ongkir;
        ppn = dpp * tarif_ppn;
        tag_sekolah = 0;
    }

    // Grand Total = Total Barang + Ongkir + PPN - Denda Keterlambatan
    misal grand_total = total_barang + ongkir + ppn - denda;

    // PPh 22 dipungut rekanan/PPMSE berdasarkan PMK 58/2022 dari subtotal barang (DPP barang)
    misal pph = subtotal_barang_kena_ppn * tarif_pph_22;

    kembalikan FakturSiplah(
        transaksi_id,
        total_barang,
        ongkir,
        dpp,
        tarif_ppn,
        ppn,
        denda,
        grand_total,
        pph,
        tag_sekolah
    );
}

// 4. Validasi State Mesin Rekonsiliasi Transaksi (API Recon)
fungsi validasi_transisi_event_siplah(
    state_sekarang,
    event_baru
) {
    // Aturan Event Agregasi SIPLah:
    // Created -> Order Processed -> Order Shipped -> Order Delivered -> BAST Generated -> Payment Confirmed -> Payment Settled -> Closed
    jika event_baru == "BAST_GENERATED" {
        jika state_sekarang != "TRANSACTION_DELIVERED" dan state_sekarang != "TRANSACTION_RECEIVED" {
            kembalikan "ERROR: BAST hanya boleh diterbitkan jika barang sudah berstatus DELIVERED/RECEIVED!";
        }
        kembalikan "TRANSACTION_BAST_GENERATED";
    }

    jika event_baru == "ORDER_PROCESSED" {
        jika state_sekarang != "TRANSACTION_CREATED" dan state_sekarang != "TRANSACTION_INFO_UPDATED" {
            kembalikan "ERROR: Transaksi belum dibuat atau telah diproses sebelumnya!";
        }
        kembalikan "TRANSACTION_PROCESSED";
    }

    jika event_baru == "ORDER_SHIPPED" {
        jika state_sekarang != "TRANSACTION_PROCESSED" {
            kembalikan "ERROR: Barang tidak dapat dikirim sebelum status pesanan diproses penyedia!";
        }
        kembalikan "TRANSACTION_SHIPPED";
    }

    kembalikan state_sekarang;
}

// 5. Validasi Dokumen Unggah PBJ Standar (PDF Guardrail)
fungsi verifikasi_dokumen_unggah_siplah(
    tipe_dokumen,
    ekstensi,
    ukuran_mb
) {
    // Harus berformat PDF
    jika ekstensi != "pdf" dan ekstensi != "PDF" {
        kembalikan "GAGAL: Dokumen pengadaan harus berformat PDF!";
    }

    // Limitasi ukuran sesuai panduan Wartek SDS:
    // Comparison: 1 MB, Negotiation: 1 MB, SP: 2 MB, BAST: 3 MB, Payment: 2 MB, Closing: 3 MB
    jika tipe_dokumen == "BAST" dan ukuran_mb > 3.0 {
        kembalikan "GAGAL: Ukuran dokumen BAST melebihi batas maksimum 3 MB!";
    }
    jika tipe_dokumen == "SURAT_PESANAN" dan ukuran_mb > 2.0 {
        kembalikan "GAGAL: Ukuran dokumen Surat Pesanan melebihi batas maksimum 2 MB!";
    }
    jika tipe_dokumen == "NEGOSIASI" dan ukuran_mb > 1.0 {
        kembalikan "GAGAL: Ukuran dokumen Berita Acara Negosiasi melebihi 1 MB!";
    }

    kembalikan "DOKUMEN_VALID_SIAP_UNGGAH";
}
