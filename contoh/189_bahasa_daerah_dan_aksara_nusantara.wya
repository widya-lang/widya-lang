// ============================================================================
// CONTOH 189: PENGATURAN BAHASA DAERAH, AKSARA NUSANTARA & KALENDER ADAT
// Bahasa Pemrograman Widya (Widya-lang)
// Mendukung i18n Bahasa Daerah: Jawa, Sunda, Bali, Minang, Bugis, Batak, Aceh, Madura,
//                                Banjar, Sasak, Makassar, Lampung, Rejang, Toraja, Papua, Melayu
// Mendukung Transliterasi & Rendering Aksara Nusantara (Hanacaraka, Sunda, Bali, Batak, Lontara,
//                                                        Kawi, Makasar Kuno, Had Lampung, KaGaNga Rejang,
//                                                        Surat Incung, Cia-Cia, Arab Pegon/Jawi)
// ============================================================================

cetak("==================================================================");
cetak("🇮🇩 PENGATURAN BAHASA DAERAH & AKSARA NUSANTARA DI WIDYA-LANG");
cetak("==================================================================");

// 1. SISTEM LOKALISASI I18N BAHASA DAERAH BAWAAN
cetak("\n--- 1. Terjemahan Antarmuka Bahasa Daerah Bawaan (16 Bahasa) ---");

var daftar_bahasa = [
    "jv-ID", "su-ID", "ban-ID", "min-ID", "bug-ID", "mak-ID", "btk-ID", "ace-ID",
    "mad-ID", "bjn-ID", "sas-ID", "ljp-ID", "rej-ID", "tor-ID", "pap-ID", "ms-MY"
];

untuk kode dalam daftar_bahasa {
    atur_lokal(kode);
    var pesan_salam = t("selamat_datang");
    var sapa_nama = t("halo", { "nama": "Nusantara" });
    var pesan_sukses = t("sukses");
    var tombol_simpan = t("simpan");
    var tombol_batal = t("batal");

    cetak("Locale [" + kode + "]:");
    cetak("  - Salam   : " + pesan_salam);
    cetak("  - Sapaan  : " + sapa_nama);
    cetak("  - Status  : " + pesan_sukses);
    cetak("  - Tombol  : [" + tombol_simpan + "] / [" + tombol_batal + "]");
}

// 2. FORMAT PENANGGALAN LOKAL NUSANTARA
cetak("\n--- 2. Format Tanggal Kalender Tradisional & Daerah ---");
atur_lokal("id-ID");
cetak("Format Tanggal Nasional (id-ID) : " + format_tanggal("id-ID"));
cetak("Format Tanggal Jawa (jv-ID)     : " + format_tanggal("jv-ID"));
cetak("Format Tanggal Sunda (su-ID)    : " + format_tanggal("su-ID"));
cetak("Format Tanggal Bali (ban-ID)    : " + format_tanggal("ban-ID"));
cetak("Format Tanggal Madura (mad-ID)  : " + format_tanggal("mad-ID"));
cetak("Format Tanggal Banjar (bjn-ID)  : " + format_tanggal("bjn-ID"));
cetak("Format Tanggal Aceh (ace-ID)    : " + format_tanggal("ace-ID"));

// 3. KALENDER ADAT & PERHITUNGAN WETON JAWA
cetak("\n--- 3. Kalender Adat & Perhitungan Weton Jawa (Dina, Pasaran, Neptu, Wuku) ---");
var weton = hitung_weton(2026, 10, 3);
cetak("Tanggal Analisis: 3 Oktober 2026");
cetak("  - Dina (Hari)        : " + weton["dina"] + " (Neptu: " + weton["neptu_dina"] + ")");
cetak("  - Pasaran (Pancawara): " + weton["pasaran"] + " (Neptu: " + weton["neptu_pasaran"] + ")");
cetak("  - Total Neptu        : " + weton["neptu_total"]);
cetak("  - Wuku Siklus 30     : " + weton["wuku"]);
cetak("  - Weton Lengkap      : " + weton["weton_lengkap"]);

// 4. KALENDER BALI, KALA SUNDA & PRANATA MANGSA JAWA
cetak("\n--- 4. Kalender Bali, Kala Sunda & Pranata Mangsa Agraris ---");
var bali = hitung_kalender_bali(2026, 10, 3);
cetak("Kalender Bali:");
cetak("  - Wewaran (Saptawara-Pancawara) : " + bali["wewaran"]);
cetak("  - Sasih                         : " + bali["sasih"]);
cetak("  - Pawukon                       : " + bali["pawukon"]);

var sunda = hitung_kala_sunda(2026, 10, 3);
cetak("Kala Sunda:");
cetak("  - Poe & Pancawara               : " + sunda["weton_sunda"]);

var pm = hitung_pranata_mangsa(10, 3);
cetak("Pranata Mangsa (Kalender Tani Jawa):");
cetak("  - Mangsa                        : " + pm["mangsa"]);
cetak("  - Candra Sesanti                : \"" + pm["candra_sesanti"] + "\"");
cetak("  - Makna Alam & Pertanian        : " + pm["makna_alam"]);
cetak("  - Rentang Waktu                 : " + pm["rentang_waktu"]);

// 5. TRANSLITERASI AKSARA NUSANTARA (UNICODE COMPLIANT)
cetak("\n--- 5. Transliterasi Latin ke Aksara Tradisional Nusantara ---");

var teks_jawa = "sugeng rawuh ing widya lang 2026";
var aksara_jawa = latin_ke_aksara_jawa(teks_jawa);
cetak("Latin Jawa         : " + teks_jawa);
cetak("Aksara Jawa (ꦲ)    : " + aksara_jawa);

var teks_sunda = "wilujeng sumping di widya lang 2026";
var aksara_sunda = latin_ke_aksara_sunda(teks_sunda);
cetak("Latin Sunda        : " + teks_sunda);
cetak("Aksara Sunda (ᮃ)   : " + aksara_sunda);

var teks_bali = "om swastyastu widya lang 2026";
var aksara_bali = latin_ke_aksara_bali(teks_bali);
cetak("Latin Bali         : " + teks_bali);
cetak("Aksara Bali (ᬅ)    : " + aksara_bali);

var teks_batak = "horas widya lang";
var aksara_batak = latin_ke_aksara_batak(teks_batak);
cetak("Latin Batak        : " + teks_batak);
cetak("Aksara Batak (ᯀ)   : " + aksara_batak);

var teks_bugis = "salama widya lang";
var aksara_bugis = latin_ke_aksara_lontara(teks_bugis);
cetak("Latin Bugis        : " + teks_bugis);
cetak("Aksara Lontara (ᨕ) : " + aksara_bugis);

var teks_kawi = "swasti widya lang";
var aksara_kawi = latin_ke_aksara_kawi(teks_kawi);
cetak("Latin Kawi Kuno    : " + teks_kawi);
cetak("Aksara Kawi (𑼑)    : " + aksara_kawi);

var teks_makasar_kuno = "salama widya";
var aksara_makasar = latin_ke_aksara_makasar_kuno(teks_makasar_kuno);
cetak("Latin Makasar Kuno : " + teks_makasar_kuno);
cetak("Jangang-Jangang(𑻠) : " + aksara_makasar);

var teks_lampung = "tabik pun selamat ratong widya";
var aksara_lampung = latin_ke_aksara_lampung(teks_lampung);
cetak("Latin Lampung      : " + teks_lampung);
cetak("Had Lampung (ᰀ)    : " + aksara_lampung);

var teks_rejang = "selamat magheak keme widya";
var aksara_rejang = latin_ke_aksara_rejang(teks_rejang);
cetak("Latin Rejang       : " + teks_rejang);
cetak("KaGaNga Rejang (ꤰ) : " + aksara_rejang);

var teks_incung = "selamat magheak widya";
var aksara_incung = latin_ke_surat_incung(teks_incung);
cetak("Latin Incung Kerinci: " + teks_incung);
cetak("Surat Incung (ꤼ)   : " + aksara_incung);

var teks_cia_cia = "bahasa widya ciacia";
var aksara_cia_cia = latin_ke_aksara_cia_cia(teks_cia_cia);
cetak("Latin Cia-Cia Buton: " + teks_cia_cia);
cetak("Aksara Cia-Cia     : " + aksara_cia_cia);

var teks_melayu = "bahasa widya pegon";
var aksara_pegon = latin_ke_pegon(teks_melayu);
cetak("Latin Pegon/Jawi   : " + teks_melayu);
cetak("Arab Pegon (ڠ/ڤ)   : " + aksara_pegon);

// 6. DAFTAR MASTER BAHASA DAERAH & AKSARA NUSANTARA
cetak("\n--- 6. Master Data Bahasa Daerah & Aksara Nusantara ---");
var master_bahasa = daftar_bahasa_daerah();
cetak("Total Bahasa Daerah Terdaftar: " + ke_teks(panjang(master_bahasa)) + " bahasa");
untuk item dalam master_bahasa {
    cetak("  • [" + item["kode"] + "] " + item["nama"] + " | Wilayah: " + item["wilayah"] + " (" + item["estimasi_penutur"] + ") -> " + item["aksara_tradisional"]);
}

var master_aksara = daftar_aksara_nusantara();
cetak("\nTotal Aksara Nusantara Terdaftar: " + ke_teks(panjang(master_aksara)) + " aksara");
untuk aks in master_aksara {
    cetak("  • " + aks["nama"] + " [" + aks["rentang_unicode"] + "] Contoh: " + aks["contoh_aksara"] + " (" + aks["wilayah_asal"] + ")");
}

cetak("\n==================================================================");
cetak("✨ SEMUA MODUL BAHASA DAERAH & SELURUH AKSARA NUSANTARA BERFUNGSI PARIPURNA!");
cetak("==================================================================");
