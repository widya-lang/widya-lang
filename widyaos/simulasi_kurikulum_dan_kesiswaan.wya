// ==============================================================================
// WIDYAOS: SIMULASI MASTER MANAJEMEN KURIKULUM, P5, UKS & KESISWAAN
// Menguji:
// 1. Masa Berlaku Kurikulum & Multi-Curriculum Coexistence
// 2. Prinsip "Tinggal Lanjut" (Grandfathering Clause) Rombel Berjalan
// 3. Ekuivalensi Mutasi Nilai Siswa Antar-Kurikulum
// 4. Asesmen Kokurikuler P5 & Rapor Projek Profil Pelajar Pancasila
// 5. Skrining Trias UKS & Safety Guard Alergen Menu MBG BGN
// 6. Tata Kelola Asrama Sekolah Rakyat & Presensi Realtime Orang Tua
// ==============================================================================

impor "widyaos/modul/manajemen_kurikulum.wya";
impor "widyaos/modul/p5_kurikulum_merdeka.wya";
impor "widyaos/modul/uks_kesehatan_mbg.wya";
impor "widyaos/modul/manajemen_asrama.wya";
impor "widyaos/modul/portal_wali_siswa.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === SIMULASI KURIKULUM, P5, UKS & KESISWAAN WIDYAOS v1.0 ===   ║");
cetak("║   Kepastian Belajar, Transisi Grandfathering & Safe School       ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

// ==============================================================================
// [TEST 1] SIKLUS HIDUP KURIKULUM & MASA BERLAKU
// ==============================================================================
cetak("================================================================");
cetak("[1] Siklus Hidup Kurikulum & Masa Berlaku Resmi");
cetak("================================================================");

misal kur_merdeka = buat_kurikulum(
    "KUR_MERDEKA_2024",
    "Kurikulum Merdeka",
    "Permendikbudristek No. 12 Tahun 2024",
    2024,
    2029, // Berlaku hingga 2029
    3,    // Masa transisi 3 tahun (2026-2029)
    "FASE_TRANSISI",
    20
);

misal kur_nasional_2026 = buat_kurikulum(
    "KURNAS_2026",
    "Kurikulum Nasional 2026",
    "Kepmendikdasmen No. 01 Tahun 2026",
    2026,
    2032, // Berlaku 2026 - 2032
    3,
    "RESMI_AKTIF",
    25
);

cetak("📜 Kurikulum Eksisting :", kur_merdeka.nama, "(" + kur_merdeka.dasar_hukum + ")");
cetak("   Periode Berlaku     :", kur_merdeka.tahun_mulai, "s/d", kur_merdeka.tahun_selesai);
misal status_merdeka_2026 = hitung_sisa_masa_berlaku(kur_merdeka, 2026);
cetak("   Status di Thn 2026  :", status_merdeka_2026);

cetak("🌟 Kurikulum Baru      :", kur_nasional_2026.nama, "(" + kur_nasional_2026.dasar_hukum + ")");
cetak("   Periode Berlaku     :", kur_nasional_2026.tahun_mulai, "s/d", kur_nasional_2026.tahun_selesai);
misal status_kurnas_2026 = hitung_sisa_masa_berlaku(kur_nasional_2026, 2026);
cetak("   Status di Thn 2026  :", status_kurnas_2026);

TOTAL_TEST = TOTAL_TEST + 1;
jika kur_merdeka.tahun_selesai == 2029 dan kur_nasional_2026.status == "RESMI_AKTIF" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Manajemen Siklus Hidup & Masa Berlaku Kurikulum: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Manajemen Siklus Hidup & Masa Berlaku Kurikulum: GAGAL");
}

// ==============================================================================
// [TEST 2] PRINSIP GRANDFATHERING: YANG SUDAH GUNAKAN TINGGAL LANJUT
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[2] Prinsip Tinggal Lanjut (Grandfathering) pada Rombel Sekolah");
cetak("================================================================");
cetak("Kasus: SMP Negeri 1 Nusantara pada Tahun Ajaran Baru 2026/2027");

// Rombel 7A (Siswa baru masuk 2026 di tingkat awal = 7)
misal rombel_7a = tetapkan_kurikulum_rombel(
    "Kelas 7A",
    7,  // Tingkat 7 (Awal SMP)
    7,  // Ambang awal SMP
    2026,
    2026,
    kur_merdeka,
    kur_nasional_2026
);

// Rombel 8A (Siswa angkatan 2025 yang naik ke kelas 8)
misal rombel_8a = tetapkan_kurikulum_rombel(
    "Kelas 8A",
    8,  // Tingkat 8 (Lanjutan)
    7,  // Ambang awal SMP
    2026,
    2025,
    kur_merdeka,
    kur_nasional_2026
);

// Rombel 9A (Siswa angkatan 2024 yang naik ke kelas 9)
misal rombel_9a = tetapkan_kurikulum_rombel(
    "Kelas 9A",
    9,  // Tingkat 9 (Lanjutan)
    7,  // Ambang awal SMP
    2026,
    2024,
    kur_merdeka,
    kur_nasional_2026
);

cetak("🔹 Rombel 7A (Siswa Baru) :", rombel_7a.kode_kurikulum, "-> Status:", rombel_7a.status_pelaksanaan);
cetak("   Keterangan             :", rombel_7a.keterangan_transisi);
cetak("🔹 Rombel 8A (Tingkat 8)  :", rombel_8a.kode_kurikulum, "-> Status:", rombel_8a.status_pelaksanaan);
cetak("   Keterangan             :", rombel_8a.keterangan_transisi);
cetak("🔹 Rombel 9A (Tingkat 9)  :", rombel_9a.kode_kurikulum, "-> Status:", rombel_9a.status_pelaksanaan);
cetak("   Keterangan             :", rombel_9a.keterangan_transisi);

TOTAL_TEST = TOTAL_TEST + 1;
jika rombel_7a.kode_kurikulum == "KURNAS_2026" dan rombel_8a.kode_kurikulum == "KUR_MERDEKA_2024" dan rombel_9a.kode_kurikulum == "KUR_MERDEKA_2024" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Kebijakan Tinggal Lanjut (Grandfathering Clause): LULUS");
} lainnya {
    cetak("❌ [TEST 2] Kebijakan Tinggal Lanjut (Grandfathering Clause): GAGAL");
}

// ==============================================================================
// [TEST 3] EKUIVALENSI MATPEL MUTASI ANTAR-KURIKULUM
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[3] Konversi Ekuivalensi Matpel Siswa Mutasi");
cetak("================================================================");

misal nilai_mutasi = 87.5;
misal konversi_sains = konversi_matpel_mutasi(
    nilai_mutasi,
    "IPAS",
    "KUR_MERDEKA_2024",
    "IPA",
    "KURNAS_2026"
);

cetak("🔄 Siswa Pindahan Asal  : Kurikulum", konversi_sains.kurikulum_asal);
cetak("   Mata Pelajaran Asal  :", konversi_sains.matpel_asal, "(Nilai:", nilai_mutasi + ")");
cetak("   Dikonversi ke Matpel :", konversi_sains.matpel_tujuan, "pada Kurikulum", konversi_sains.kurikulum_tujuan);
cetak("   Status Penyesuaian   :", konversi_sains.status_penyesuaian, "| Bobot:", konversi_sains.bobot_konversi);

TOTAL_TEST = TOTAL_TEST + 1;
jika konversi_sains.status_penyesuaian == "EKUIVALEN_SPLIT_SAINS" dan konversi_sains.bobot_konversi == 1.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Matriks Ekuivalensi Matpel Mutasi Antar-Kurikulum: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Matriks Ekuivalensi Matpel Mutasi Antar-Kurikulum: GAGAL");
}

// ==============================================================================
// [TEST 4] P5 KURIKULUM MERDEKA & PENERBITAN RAPOR PROJEK
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[4] Projek Penguatan Profil Pelajar Pancasila (P5) & Rapor Projek");
cetak("================================================================");

misal projek_biogas = rancang_projek_p5(
    "PRJ-SMP-01",
    "Pengolahan Sampah Organik Menjadi Biogas Mandiri Sekolah",
    "GAYA_HIDUP_BERKELANJUTAN",
    120,
    "Drs. Joko Susilo, M.Pd",
    "FASE_D"
);

misal nilai_dimensi_1 = nilai_dimensi_siswa(
    "Ahmad Fauzi",
    "GOTONG_ROYONG",
    "BSH",
    "Sangat aktif berkolaborasi memilah limbah kantin sekolah dan merakit tabung digester"
);

misal nilai_dimensi_2 = nilai_dimensi_siswa(
    "Ahmad Fauzi",
    "KREATIF",
    "SAB",
    "Mampu merancang katup pengaman tekanan gas alternatif dari bahan daur ulang"
);

misal rapor_p5_fauzi = terbitkan_rapor_p5(
    "0081234567",
    "Ahmad Fauzi",
    "Kelas 8A",
    projek_biogas,
    "BSH",
    "Menunjukkan karakter profil pelajar Pancasila yang tangguh, peduli lingkungan, dan solutif."
);

cetak("🌱 Judul Projek P5     :", projek_biogas.nama_projek);
cetak("   Tema Utama          :", projek_biogas.tema, "| Alokasi:", projek_biogas.alokasi_jp, "JP");
cetak("   Fasilitator Projek  :", projek_biogas.nama_fasilitator);
cetak("📄 Rapor Projek Terbit :");
cetak("   ID Rapor Resmi      :", rapor_p5_fauzi.id_rapor);
cetak("   Peserta Didik       :", rapor_p5_fauzi.nama_siswa, "(NISN:", rapor_p5_fauzi.nisn + ")");
cetak("   Predikat Dominan    :", deskripsi_predikat_p5(rapor_p5_fauzi.predikat_dominan));
cetak("   Catatan Fasilitator :", rapor_p5_fauzi.catatan_fasilitator);

TOTAL_TEST = TOTAL_TEST + 1;
jika rapor_p5_fauzi.predikat_dominan == "BSH" dan projek_biogas.alokasi_jp == 120 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 4] Perancangan P5 & Pencetakan Rapor Projek Pancasila: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Perancangan P5 & Pencetakan Rapor Projek Pancasila: GAGAL");
}

// ==============================================================================
// [TEST 5] TRIAS UKS & SAFETY GUARD ALERGEN MENU MBG BGN
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[5] Trias UKS, Antropometri & Safety Interlock Alergen MBG BGN");
cetak("================================================================");

// Skrining kesehatan siswi Siti Rahma (TB: 152 cm, BB: 44 kg)
misal kesehatan_siti = skrining_antropometri(
    "0089988771",
    "Siti Rahma",
    152.0,
    44.0,
    "KACANG_TANAH", // Riwayat alergi berat
    "Asma Ringan"
);

cetak("🩺 Profil Kesehatan Siswa:", kesehatan_siti.nama);
cetak("   Antropometri        : TB", kesehatan_siti.tinggi_cm, "cm | BB", kesehatan_siti.berat_kg, "kg");
cetak("   Indeks Massa Tubuh  :", kesehatan_siti.indeks_massa_tubuh, "-> Status:", kesehatan_siti.status_stunting);
cetak("   Riwayat Alergen     :", kesehatan_siti.riwayat_alergi_makanan, "(Risiko Syok Anafilaksis)");

// Menu MBG Sentra Dapur Gizi BGN hari ini: Nasi Uduk Bumbu Kacang
misal menu_mbg_hari_ini = MenuDapurMBG(
    "2026-09-19",
    "Nasi Uduk Gurih Bumbu Kacang, Ayam Suwir & Telur",
    "KACANG_TANAH",
    650,
    22
);

// Uji Safety Guard Interlock
misal safety_check = validasi_alergen_mbg(
    kesehatan_siti,
    menu_mbg_hari_ini,
    "Nasi Uduk Kecap Manis & Ayam Suwir Gurih (Bebas Kacang)"
);

cetak("🍱 Menu Dapur MBG      :", menu_mbg_hari_ini.nama_menu);
cetak("⚠️ Safety Interlock    :", safety_check.status_keamanan);
cetak("🛑 Tindakan Sentra Dapur:", safety_check.instruksi_dapur);
cetak("🍲 Menu Pengganti Aman :", safety_check.menu_pengganti);

TOTAL_TEST = TOTAL_TEST + 1;
jika safety_check.status_keamanan == "BAHAYA_ALERGEN_TERDETEKSI" dan safety_check.instruksi_dapur == "BLOKIR_SAJIKAN_SUBSTITUSI" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 5] Safety Guard Alergen MBG BGN & Perlindungan UKS: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Safety Guard Alergen MBG BGN & Perlindungan UKS: GAGAL");
}

// ==============================================================================
// [TEST 6] MANAJEMEN ASRAMA SEKOLAH RAKYAT & NOTIFIKASI REALTIME WALI
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[6] Tata Kelola Asrama Sekolah Rakyat & Presensi Realtime Orang Tua");
cetak("================================================================");

// 1. Pengajuan Izin Pesiar
misal izin_pesiar_fauzi = ajukan_izin_pesiar(
    "IZN-ASR-901",
    "0081234567",
    "Ahmad Fauzi",
    "Membeli Buku Tulis di Toko Buku Gramedia",
    "14:00",
    "17:30"
);

misal izin_disetujui = setujui_izin_pesiar(
    izin_pesiar_fauzi,
    true,
    "Diizinkan keluar maksimal pukul 17.30 dan wajib kembali sebelum Maghrib"
);

cetak("🏢 Asrama Sekolah Rakyat: Pengajuan Izin Pesiar Siswa");
cetak("   Pemohon             :", izin_disetujui.nama_siswa, "| Tujuan:", izin_disetujui.tujuan);
cetak("   Status Persetujuan  :", izin_disetujui.status_approval, "(Pass:", izin_disetujui.qr_verifikasi + ")");

// 2. Night Roll Call Asrama Kamar 101 (Kapasitas 4 siswa)
misal roll_call_101 = rekam_roll_call_malam(
    "2026-09-18",
    "Kamar 101 Gedung Diponegoro",
    4,
    3, // 3 hadir fisik
    1, // 1 izin pesiar resmi
    0  // 0 sakit
);

cetak("🌙 Night Roll Call     :", roll_call_101.nomor_kamar);
cetak("   Kondisi Siswa       : Total", roll_call_101.total_siswa, "| Hadir:", roll_call_101.jumlah_hadir, "| Izin:", roll_call_101.jumlah_izin);
cetak("   Status Kelengkapan  :", roll_call_101.status_lengkap, "(100% siswa terverifikasi aman)");

// 3. Buku Saku Karakter: Apresiasi Tahfidz
misal poin_prestasi = catat_poin_karakter(
    "0081234567",
    "Ahmad Fauzi",
    "PRESTASI_KEBAIKAN",
    25,
    "Setoran Hafalan Al-Qur'an Juz 30 Lancar dan Tartil",
    100
);
cetak("⭐ Buku Saku Karakter  :", poin_prestasi.uraian, "(+" + ke_teks(poin_prestasi.poin) + " Poin -> Total:", ke_teks(poin_prestasi.total_saldo_poin) + ")");

// 4. Presensi Tap Gerbang Realtime ke Orang Tua
misal tap_pagi = rekam_presensi_gerbang(
    "PRES-20260918-001",
    "0081234567",
    "Ahmad Fauzi",
    "06:42",
    "07:00",
    "GERBANG_MASUK"
);

cetak("📲 Presensi Gerbang Tap : Pukul", tap_pagi.waktu_tap, "-> Status:", tap_pagi.status_kehadiran);
cetak("   WhatsApp/Push Wali   : Terkirim Otomatis =", tap_pagi.notifikasi_wali_terkirim);

TOTAL_TEST = TOTAL_TEST + 1;
jika izin_disetujui.status_approval == "DISETUJUI_PEMBINA" dan roll_call_101.status_lengkap == true dan tap_pagi.status_kehadiran == "TEPAT_WAKTU" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 6] Asrama Sekolah Rakyat, Buku Saku & Presensi Gerbang: LULUS");
} lainnya {
    cetak("❌ [TEST 6] Asrama Sekolah Rakyat, Buku Saku & Presensi Gerbang: GAGAL");
}

// ==============================================================================
// [TEST 7] SISTEM PAKET VS SKS & VERIFIKASI IZIN KEMENTERIAN PUSAT
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[7] Sistem Paket vs SKS & Guardrail Izin Kemendikdasmen Pusat");
cetak("================================================================");

// Kasus A: SMA Negeri 1 Unggulan mengajukan SKS dengan SK Izin Pusat Sah
misal sk_pusat_resmi = buat_sk_izin_sks_kementerian(
    "SK-SKS-042/Ditjen.Dikmen/2026",
    "2026-01-15",
    "Direktorat Jenderal PAUD, Dikdas, dan Dikmen Kemendikdasmen RI",
    benar, // Terverifikasi Pusat
    5
);

misal sekolah_a_sks = tetapkan_model_penyelenggaraan(
    "20104444",
    "SMA Negeri 1 Unggulan Prestasi",
    "SISTEM_KREDIT_SEMESTER",
    sk_pusat_resmi
);

cetak("🏫 Satuan Pendidikan A :", sekolah_a_sks.nama_sekolah);
cetak("   Model Diajukan      : SISTEM_KREDIT_SEMESTER");
cetak("   Hasil Verifikasi    :", sekolah_a_sks.status_izin_kementerian);
cetak("   Status Akhir        :", sekolah_a_sks.model_terpilih);
cetak("   Keterangan          :", sekolah_a_sks.keterangan_operasional);

// Siswa Berbakat Istimewa (IP 3.92) mengambil beban akselerasi di Sekolah A
misal beban_akselerasi = tentukan_beban_belajar_siswa(
    "0071122334",
    "Nadia Syifa (Gifted Student)",
    3.92,
    sekolah_a_sks
);
cetak("   Beban Siswa IP 3.92 :", beban_akselerasi.beban_sks_diambil, "SKS -> Pola:", beban_akselerasi.pola_kecepatan);

// Kasus B: SMA Mandiri Belum Berizin mencoba aktifkan SKS tanpa SK Pusat (nihil)
misal sekolah_b_tanpa_izin = tetapkan_model_penyelenggaraan(
    "20105555",
    "SMA Swasta Belum Berizin",
    "SISTEM_KREDIT_SEMESTER",
    nihil // Tanpa SK Izin Pusat
);

cetak("");
cetak("🏫 Satuan Pendidikan B :", sekolah_b_tanpa_izin.nama_sekolah);
cetak("   Model Diajukan      : SISTEM_KREDIT_SEMESTER (Tanpa SK Kementerian)");
cetak("   Hasil Verifikasi    :", sekolah_b_tanpa_izin.status_izin_kementerian);
cetak("   Status Akhir        :", sekolah_b_tanpa_izin.model_terpilih, "(Otomatis Rollback ke Paket)");
cetak("   Keterangan          :", sekolah_b_tanpa_izin.keterangan_operasional);

// Siswa di Sekolah B otomatis hanya mendapat paket standar seragam
misal beban_sekolah_b = tentukan_beban_belajar_siswa(
    "0079988112",
    "Budi Santoso",
    3.95,
    sekolah_b_tanpa_izin
);
cetak("   Beban Siswa IP 3.95 :", beban_sekolah_b.beban_sks_diambil, "JP (Paket Rombel Seragam) -> Pola:", beban_sekolah_b.pola_kecepatan);

// Kasus C: Sekolah Umum dengan Sistem Paket Reguler
misal sekolah_c_paket = tetapkan_model_penyelenggaraan(
    "20106666",
    "SMP Negeri 2 Standar",
    "SISTEM_PAKET",
    nihil
);
cetak("");
cetak("🏫 Satuan Pendidikan C :", sekolah_c_paket.nama_sekolah, "-> Model:", sekolah_c_paket.model_terpilih, "(" + sekolah_c_paket.status_izin_kementerian + ")");

TOTAL_TEST = TOTAL_TEST + 1;
jika sekolah_a_sks.model_terpilih == "SISTEM_KREDIT_SEMESTER" dan sekolah_b_tanpa_izin.model_terpilih == "SISTEM_PAKET" dan sekolah_b_tanpa_izin.status_izin_kementerian == "DITOLAK_TIDAK_ADA_IZIN_PUSAT" dan beban_akselerasi.beban_sks_diambil == 48 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 7] Sistem Paket vs SKS & Guardrail Izin Kemendikdasmen Pusat: LULUS");
} lainnya {
    cetak("❌ [TEST 7] Sistem Paket vs SKS & Guardrail Izin Kemendikdasmen Pusat: GAGAL");
}

