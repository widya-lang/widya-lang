// ============================================================================
// SIMULASI SUITE: MUTASI SISWA BERTUNGGAKAN & ADVOKASI PIP KEMENDIKDASMEN RI
// Menguji Penyelesaian Holistik Masalah Mutasi & Tunggakan Biaya Sekolah:
// 1. Penerbitan Surat Pernyataan Hutang / Komitmen Finansial Orang Tua
// 2. Garansi Hak Belajar: Siswa Bebas Pindah & Aktif di Dapodik Sekolah Baru
// 3. Transformasi Tunggakan Menjadi Usulan Prioritas PIP (Program Indonesia Pintar)
// 4. Rekapitulasi Dashboard Wilayah untuk Kebijakan Afirmasi Pemda / Pusat
// 5. Settlement Otomatis Pelunasan Tunggakan ke Sekolah Lama Saat Dana PIP Cair
// ============================================================================

impor "widyaos/modul/mutasi_tunggakan_pip_bridge.wya";

cetak("====================================================================");
cetak("🎓  SIMULASI: JEMBATAN MUTASI SISWA BERTUNGGAKAN & ADVOKASI PIP     ");
cetak("    Perlindungan Hak Belajar Anak & Dasar Kebijakan Bantuan Nasional");
cetak("====================================================================");

// [1] Penerbitan Surat Pernyataan Hutang & Pemisahan Hak Anak dari Kewajiban Perdata
cetak("\n[1] Penerbitan Surat Pernyataan Komitmen Finansial Orang Tua:");
misal surat_pernyataan = terbitkan_surat_pernyataan_hutang_mutasi(
    "SPH-2026-089",
    "421.2/SPH-089/SMP-SW/2026",
    "0098765432",
    "Rizky Ramadhan",
    "20509999",
    "SMP Budi Mulia (Sekolah Swasta Asal)",
    "20502621",
    "SMP Negeri 2 Dawarblandong (Sekolah Baru)",
    "Bambang Hermanto (Ayah Kandung)",
    "3516011204780002",
    "081333444555",
    1500000.0, // Tunggakan SPP & Uang Ujian Rp 1.500.000
    "Tunggakan SPP 5 Bulan (Rp 1.000.000) + Buku Lembar Kerja (Rp 500.000)",
    "USULAN_AFIRMASI_PIP_DAN_CICILAN_MANDIRI",
    "did:sewidya:ks:smp_swasta_budi_mulia"
);

cetak("  • Nomor Surat Resmi  :", surat_pernyataan.nomor_surat);
cetak("  • Nama Siswa         :", surat_pernyataan.nama_siswa, "(NISN:", surat_pernyataan.nisn_siswa, ")");
cetak("  • Sekolah Asal       :", surat_pernyataan.nama_sekolah_asal);
cetak("  • Sekolah Tujuan     :", surat_pernyataan.nama_sekolah_tujuan);
cetak("  • Wali Penanggung    :", surat_pernyataan.nama_wali_penanggung);
cetak("  • Total Tunggakan    : Rp", surat_pernyataan.total_tunggakan_rp);
cetak("  • Status Hak Belajar :", surat_pernyataan.status_hak_belajar);

jika surat_pernyataan.status_hak_belajar == "HAK_BELAJAR_DIJAMIN_100_PERSEN_LANCAR" {
    cetak("  ✅ PASS: Surat Pernyataan Sah Diterbitkan! Hak Belajar Siswa Terpisah dari Hutang Orang Tua.");
} lainnya {
    cetak("  ❌ FAIL: Penerbitan surat komitmen gagal!");
}

// [2] Pelepasan Surat Keterangan Pindah Sekolah & Tarik Dapodik di Sekolah Baru
cetak("\n[2] Eksekusi Pelepasan Mutasi Dapodik (Tanpa Hambatan):");
misal status_dapodik = eksekusi_pelepasan_mutasi_sekolah_lama(surat_pernyataan);
cetak("  • Status Integrasi Dapodik:", status_dapodik);

jika status_dapodik == "SUKSES_SISWA_RESMI_DIMUTASIKAN_DAPODIK_SIAP_DITARIK_SEKOLAH_BARU" {
    cetak("  ✅ PASS: Siswa Resmi Dilepas di Dapodik & Langsung Aktif Belajar di Sekolah Baru!");
} lainnya {
    cetak("  ❌ FAIL: Pelepasan mutasi Dapodik tertahan!");
}

// [3] Transformasi Catatan Tunggakan Menjadi Usulan Prioritas Bantuan PIP
cetak("\n[3] Ingesti Data Tunggakan ke Usulan Afirmasi PIP Kemendikdasmen:");
misal usulan_pip = ajukan_tunggakan_ke_basis_data_pip(
    "USULAN-PIP-2026-0042",
    surat_pernyataan,
    "SMP",
    "DTKS_DESIL_1_MISKIN_EKSTREM"
);

cetak("  • ID Usulan PIP      :", usulan_pip.id_usulan_pip);
cetak("  • Jenjang & Desil    :", usulan_pip.jenjang_pendidikan, "|", usulan_pip.status_ekonomi_keluarga);
cetak("  • Plafon Bantuan PIP : Rp", usulan_pip.nominal_bantuan_pip_tahunan);
cetak("  • Rekomendasi Pusat  :", usulan_pip.rekomendasi_kebijakan);
cetak("  • Status Puslapdik   :", usulan_pip.status_verifikasi_puslapdik);

jika usulan_pip.status_verifikasi_puslapdik == "TERVERIFIKASI_SIAP_SALUR_KEMENDIKDASMEN" {
    cetak("  ✅ PASS: Tunggakan Siswa Miskin Menjadi Dasar Valid & Legal Penyaluran Bantuan PIP!");
} lainnya {
    cetak("  ❌ FAIL: Advokasi PIP gagal!");
}

// [4] Rekapitulasi Data Tunggakan Wilayah untuk Pengambilan Kebijakan Pemda / Dinas
cetak("\n[4] Rekapitulasi Wilayah Dasar Alokasi Anggaran Afirmasi:");
misal daftar_surat = [];
tambah(daftar_surat, surat_pernyataan);

misal rekap_dinas = rekapitulasi_tunggakan_untuk_dinas(daftar_surat);
cetak("  • Total Siswa Menunggak :", rekap_dinas.total_siswa_mutasi_menunggak, "siswa");
cetak("  • Akumulasi Tunggakan   : Rp", rekap_dinas.total_nominal_tunggakan_wilayah);
cetak("  • Rekomendasi Kebijakan :", rekap_dinas.status_kebijakan);

jika rekap_dinas.total_nominal_tunggakan_wilayah == 1500000.0 {
    cetak("  ✅ PASS: Dashboard Wilayah Memberikan Angka Riil untuk Intervensi APBD / Bansos!");
} lainnya {
    cetak("  ❌ FAIL: Rekapitulasi dinas gagal!");
}

// [5] Settlement Otomatis Saat Dana PIP Dicairkan ke Rekening SimPel Siswa
cetak("\n[5] Penyelesaian (Settlement) Tunggakan Saat Dana PIP Cair:");
// Dana PIP SMP cair Rp 750.000 langsung disalurkan untuk melunasi tunggakan sekolah lama
misal hasil_settlement = selesaikan_tunggakan_via_pencairan_pip(
    surat_pernyataan,
    750000.0,
    "2026-08-15"
);

cetak("  • Dana PIP Masuk         : Rp", hasil_settlement["nominal_disalurkan_ke_sekolah_lama"]);
cetak("  • Sisa Tunggakan Wali    : Rp", hasil_settlement["sisa_kewajiban_wali"]);
cetak("  • Status Penyelesaian    :", hasil_settlement["status_pelunasan"]);
cetak("  • Tanggal Pelunasan      :", hasil_settlement["tanggal_penyelesaian"]);

jika hasil_settlement["sisa_kewajiban_wali"] == 750000.0 {
    cetak("  ✅ PASS: Pelunasan Transparan Terdistribusi Adil, Sekolah Swasta Terlindungi!");
} lainnya {
    cetak("  ❌ FAIL: Settlement PIP gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 5/5 TAHAPAN ADVOKASI MUTASI & PIP LULUS (100%)    ");
cetak("====================================================================");
