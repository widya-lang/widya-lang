    tambah_rute(server, "POST", "/v1/project/evaluate", fungsi(req) {
        misal p_nama = "proyek_analitika_desa";
        misal p_kode = "// Proyek Widya-Lang Default\nimpor \"modul/telemetri_proyek.wya\";\nfungsi hitung() { kembalikan 42; }\n";

        jika (req["badan"] != "" dan req["badan"] != kosong) {
