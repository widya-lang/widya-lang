// ==============================================================================
// MODUL BD-103: KOMPUTASI BAHASA BALI, AKSARA BALI & KALENDER PAWUKON
// Implementasi Kurikulum Pembelajaran Bahasa Daerah Berbasis Widya-Lang
// ==============================================================================

cetak("==================================================================");
cetak("📚 MODUL BD-103: PEMBELAJARAN BASA BALI & ETNOSAINS KOMPUTASI");
cetak("==================================================================");

// 1. ANGGAH-UNGGUHING BASA BALI
cetak("\n--- [1] Anggah-Ungguhing Basa Bali (Tingkatan Tutur) ---");

struktur EntriKamusBali {
    andap,
    alus_sor,
    alus_singgih,
    arti_indonesia
}

misal kamus_bali = [
    EntriKamusBali("medaar", "neda", "ngrayunin", "makan"),
    EntriKamusBali("pules", "masare", "makolem", "tidur"),
    EntriKamusBali("umah", "kubu", "jeroan / puri", "rumah"),
    EntriKamusBali("teka", "rauh", "rauh", "datang"),
    EntriKamusBali("suba", "sampun", "sampun", "sudah")
];

cetak("Katalog Anggah-Ungguh Kruna Basa Bali:");
untuk item dalam kamus_bali {
    cetak("  • Teges Basa     : " + item.arti_indonesia);
    cetak("    - Basa Andap       : " + item.andap);
    cetak("    - Basa Alus Sor    : " + item.alus_sor);
    cetak("    - Basa Alus Singgih: " + item.alus_singgih);
}

// 2. TRANSLITERASI AKSARA BALI (WIANJANA & PANGANGGE)
cetak("\n--- [2] Transliterasi Latin ka Aksara Bali ---");

var frasa_bali = [
    "om swastiastu",
    "rahajeng semeng",
    "bali santi",
    "widya nusantara"
];

untuk frasa dalam frasa_bali {
    var aksara = latin_ke_aksara_bali(frasa);
    cetak("  • Latin  : " + frasa);
    cetak("    Aksara : " + aksara);
}

// 3. KALENDER PAWUKON & WEWARAN BALI
cetak("\n--- [3] Sistem Kalender Adat Pawukon & Wewaran Bali ---");
var bali = hitung_kalender_bali(2026, 10, 3);
cetak("Analisis Kalender Bali (3 Oktober 2026):");
cetak("  - Wewaran (Saptawara-Pancawara) : " + bali["wewaran"]);
cetak("  - Sasih                         : " + bali["sasih"]);
cetak("  - Pawukon (Wuku)                : " + bali["pawukon"]);

// 4. PARIBASA BALI (SESONGGAN & SESENGGAKAN)
cetak("\n--- [4] Paribasa & Falsafah Luhung Krama Bali ---");
var sesonggan = [
    "Kadi andus matekep (Rahasia atau perbuatan buruk cepat atau lambat pasti akan terungkap)",
    "Buka cicinge ngongkong, tuara ngutgut (Seseorang yang banyak bicaranya namun tidak berbahaya)",
    "Sing ada kasugihan tan palelampahan (Tiada kesuksesan dan kemuliaan tanpa perjuangan gigih)"
];

untuk s dalam sesonggan {
    cetak("  🌟 " + s);
}

cetak("\n==================================================================");
cetak("✅ Modul BD-103 Basa Bali sampun puput kalaksanayang kalawan becik!");
cetak("==================================================================");
