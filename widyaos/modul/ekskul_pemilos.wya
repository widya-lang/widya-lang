// =================================================================
// Modul Ekstrakurikuler, Nilai Rapor Karakter & E-Voting Pemilos Digital
// (Adopsi MOD-14: Portofolio Ekskul, Prestasi Siswa & Pemilos LUBER JURDIL)
// =================================================================

struktur EkstrakurikulerSekolah {
    id_ekskul,
    nama_ekskul,
    kategori, // WAJIB_PRAMUKA, OLAHRAGA, SENI_BUDAYA, SAINS_ROBOTIK
    nama_pembina,
    hari_latihan,
    lokasi_ruang,
    total_anggota
}

struktur NilaiEkskulRapor {
    nisn,
    nama_siswa,
    id_ekskul,
    predikat, // A (SANGAT_BAIK), B (BAIK), C (CUKUP)
    deskripsi_narasi_rapor
}

struktur PaslonPemilos {
    nomor_urut,
    nama_ketua,
    nama_wakil,
    visi_misi,
    total_suara
}

struktur PemilosDigital {
    id_pemilos,
    tahun_ajaran,
    daftar_paslon,
    total_pemilih_dpt,
    total_suara_masuk,
    status_pemilihan // DIBUKA atau DITUTUP_SELESAI
}

// -------------------------------------------------------------
// [1] Pendaftaran & Penilaian Ekstrakurikuler ke e-Rapor
// -------------------------------------------------------------
fungsi ekskul_daftarkan(id, nama, kat, pembina, hari, ruang, kuota) {
    kembalikan EkstrakurikulerSekolah(
        id,
        nama,
        kat,
        pembina,
        hari,
        ruang,
        kuota
    );
}

fungsi ekskul_beri_nilai_rapor(nisn, nama, id_ekskul, predikat, narasi) {
    kembalikan NilaiEkskulRapor(
        nisn,
        nama,
        id_ekskul,
        predikat,
        narasi
    );
}

// -------------------------------------------------------------
// [2] Inisialisasi E-Voting Pemilos Digital (Anti-Kecurangan)
// -------------------------------------------------------------
fungsi pemilos_inisialisasi(id, thn, dpt) {
    kembalikan PemilosDigital(
        id,
        thn,
        [],
        dpt,
        0,
        "DIBUKA"
    );
}

fungsi pemilos_tambah_paslon(pemilos, no_urut, ketua, wakil, visi) {
    misal paslon = PaslonPemilos(no_urut, ketua, wakil, visi, 0);
    tambah(pemilos.daftar_paslon, paslon);
    kembalikan paslon;
}

// -------------------------------------------------------------
// [3] Pemberian Suara Rahasia (1 Siswa = 1 Token Hak Suara SewidyaID)
// -------------------------------------------------------------
fungsi pemilos_coblos_digital(pemilos, nomor_pilihan, token_siswa_hash) {
    jika pemilos.status_pemilihan != "DIBUKA" {
        kembalikan { "sukses": salah, "pesan": "Pemungutan suara telah ditutup!" };
    }
    
    misal suara_sah = salah;
    untuk p dalam pemilos.daftar_paslon {
        jika p.nomor_urut == nomor_pilihan {
            p.total_suara = p.total_suara + 1;
            suara_sah = benar;
        }
    }
    
    jika bukan suara_sah {
        kembalikan { "sukses": salah, "pesan": "Nomor paslon tidak valid!" };
    }
    
    pemilos.total_suara_masuk = pemilos.total_suara_masuk + 1;
    
    kembalikan {
        "sukses": benar,
        "pesan": "Suara sah berhasil dienkripsi ke kotak suara digital",
        "total_masuk": pemilos.total_suara_masuk,
        "partisipasi_persen": (pemilos.total_suara_masuk * 100.0) / pemilos.total_pemilih_dpt
    };
}
