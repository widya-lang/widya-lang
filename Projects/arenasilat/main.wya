    cetak("       🥋  ARENA SILAT SAAS — WIDYA-LANG SOVEREIGN APPLICATION  🥋           ")
    cetak("       100% In-House Sovereign Code: WidyaOS, WidyaBase, WidyaWeb & Mobile   ")
