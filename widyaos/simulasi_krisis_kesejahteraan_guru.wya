// ============================================================================
// SIMULASI SUITE: MITIGASI KRISIS, FINANSIAL & BEBAN KERJA GURU
// Menguji 3 Kasus Kritis Kesejahteraan Guru di Lapangan:
// 1. Deteksi Kerentanan Finansial & Blokir Teror Pinjol Ilegal di Sekolah
// 2. Pembiayaan Guru Pengganti Cuti Melahirkan dari BOS (Anti-Patungan Pribadi)
// 3. Peringatan Overload Guru Merangkap Operator Dapodik & Hak Insentif Tambahan
// ============================================================================

impor "widyaos/modul/kesejahteraan_finansial_dan_krisis_guru.wya";

cetak("====================================================================");
cetak("🛡️   SIMULASI: MITIGASI KRISIS & KESEJAHTERAAN GURU INDONESIA         ");
cetak("====================================================================");

// [1] Skrining Kerentanan Finansial & Teror Pinjol Ilegal
cetak("\n[1] Uji Deteksi Kerentanan Finansial & Perlindungan Teror Pinjol:");
// Gaji Rp 4.000.000 terpotong angsuran bank Rp 3.200.000 (sisa Rp 800.000 = 20%)
// dan terdapat teror pinjol ilegal ke kontak sekolah
misal krisis_finansial = evaluasi_kesehatan_finansial_guru(
    "FIN-2026-003",
    "199002142019021004",
    "Sri Wahyuni, S.Pd.",
    4000000,
    3200000,
    benar // Ada teror debt collector pinjol
);

cetak("  • Nama Guru Terdata   :", krisis_finansial.nama_guru);
cetak("  • Gaji Bruto          : Rp", krisis_finansial.gaji_bruto_rp);
cetak("  • Potongan Kredit Bank: Rp", krisis_finansial.potongan_kredit_bank_rp);
cetak("  • Sisa Take Home Pay  : Rp", krisis_finansial.sisa_take_home_pay_rp, "(Kritis < 30%)");
cetak("  • Status Kerentanan   :", krisis_finansial.status_kerentanan_finansial);
cetak("  • Proteksi Sekolah    :", krisis_finansial.status_teror_debt_collector);
cetak("  • Solusi Intervensi   :", krisis_finansial.solusi_intervensi);

jika krisis_finansial.status_kerentanan_finansial == "RENTAN_TERJERAT_PINJOL" dan krisis_finansial.status_teror_debt_collector == "BLOKIR_NOMOR_KONTAK_DARURAT_SEKOLAH" {
    cetak("  ✅ PASS: Sistem Membela Guru! Perlindungan dari Teror Debt Collector & Solusi Koperasi.");
} lainnya {
    cetak("  ❌ FAIL: Evaluasi finansial guru gagal!");
}

// [2] Pembiayaan Guru Pengganti Cuti Melahirkan dari BOS (Anti-Patungan Pribadi)
cetak("\n[2] Uji Pengalihan Biaya Inval Cuti Melahirkan ke Dana BOS (Bebas Biaya Pribadi):");
misal cuti_guru = alokasi_biaya_inval_cuti_melahirkan(
    "CUTI-2026-012",
    "199308102020122018",
    "Dewi Anggraini, S.Pd.",
    90, // 3 Bulan Cuti Melahirkan
    "Farida Ulfah, S.Pd. (Guru Inval Pengganti)",
    3600000 // Total honor inval 3 bulan (Rp 1.2 Jt/bln)
);

cetak("  • Guru Cuti Melahirkan:", cuti_guru.nama_guru, "(Durasi:", cuti_guru.durasi_cuti_hari, "hari)");
cetak("  • Guru Inval Pengganti:", cuti_guru.nama_guru_inval_pengganti);
cetak("  • Total Honor Inval   : Rp", cuti_guru.total_honor_pengganti_rp);
cetak("  • Sumber Pembiayaan   :", cuti_guru.sumber_dana_pembayaran);
cetak("  • Beban Pribadi Guru  :", cuti_guru.status_beban_pribadi_guru);

jika cuti_guru.sumber_dana_pembayaran == "DANA_BOS_REGULER_BELANJA_JASA_INVAL" dan cuti_guru.status_beban_pribadi_guru == "BEBAS_BIAYA_DILARANG_PATUNGAN_PRIBADI" {
    cetak("  ✅ PASS: Praktik Pungutan Pribadi Inval Dihapus! Honor Pengganti Cuti Resmi Dibiayai BOS.");
} lainnya {
    cetak("  ❌ FAIL: Alokasi cuti melahirkan gagal!");
}

// [3] Deteksi Beban Ganda Guru Merangkap Operator Dapodik / Bendahara BOS
cetak("\n[3] Uji Proteksi Guru Merangkap Operator Dapodik (Beban Ganda):");
misal beban_ganda = evaluasi_beban_ganda_guru(
    "198505052010011025",
    "Hendra Kurniawan, S.Pd.",
    24, // 24 Jam Mengajar Penuh
    "OPERATOR_DAPODIK"
);

cetak("  • Nama Guru Terdaftar :", beban_ganda.nama_guru);
cetak("  • Jam Tatap Muka      :", beban_ganda.jam_mengajar_wajib, "jam");
cetak("  • Tugas Non-KBM       :", beban_ganda.jabatan_tambahan_non_kbm);
cetak("  • Status Beban Kerja  :", beban_ganda.status_keseimbangan_beban);
cetak("  • Hak Insentif BOS    :", beban_ganda.insentif_resmi_bos);

jika beban_ganda.status_keseimbangan_beban == "PERINGATAN_OVERLOAD_KOMBINASI" dan beban_ganda.insentif_resmi_bos == "BERHAK_HONOR_TUGAS_TAMBAHAN_BOS" {
    cetak("  ✅ PASS: Sistem Mengakui Beban Ganda Guru! Peringatan Overload & Hak Insentif Terbit.");
} lainnya {
    cetak("  ❌ FAIL: Deteksi beban ganda gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 3/3 KASUS MITIGASI KRISIS GURU LULUS (100%)       ");
cetak("====================================================================");
