// ============================================================================
// compiler_self_hosted/lexer.widya
// Modul Scanner / Lexer Mandiri dalam Bahasa Widya-Lang
// Memindai kode sumber Widya-Lang menjadi aliran token leksikal terstruktur.
// ============================================================================

struktur TokenLeksikal {
    jenis,
    nilai,
    baris,
    kolom,

    fungsi ke_teks() {
        kembalikan "<" + ini.jenis + ", " + ini.nilai + ">";
    }
}

fungsi apakah_spasi(c) {
    kembalikan c == " " || c == "\t" || c == "\n" || c == "\r";
}

fungsi apakah_digit(c) {
    kembalikan c >= "0" && c <= "9";
}

fungsi apakah_huruf_pengenal(c) {
    kembalikan (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_";
}

fungsi cocokkan_kata_kunci(kata) {
    jika kata == "fungsi" || kata == "fn" { kembalikan "KATA_KUNCI_FUNGSI"; }
    jika kata == "misal" || kata == "let" { kembalikan "KATA_KUNCI_MISAL"; }
    jika kata == "tetap" || kata == "const" { kembalikan "KATA_KUNCI_TETAP"; }
    jika kata == "kembalikan" || kata == "return" { kembalikan "KATA_KUNCI_KEMBALIKAN"; }
    jika kata == "jika" || kata == "if" { kembalikan "KATA_KUNCI_JIKA"; }
    jika kata == "lainnya" || kata == "else" || kata == "selain_itu" { kembalikan "KATA_KUNCI_LAINNYA"; }
    jika kata == "selama" || kata == "while" { kembalikan "KATA_KUNCI_SELAMA"; }
    jika kata == "untuk" || kata == "for" { kembalikan "KATA_KUNCI_UNTUK"; }
    jika kata == "struktur" || kata == "struct" { kembalikan "KATA_KUNCI_STRUKTUR"; }
    jika kata == "impor" || kata == "import" { kembalikan "KATA_KUNCI_IMPOR"; }
    jika kata == "ekspor" || kata == "export" { kembalikan "KATA_KUNCI_EKSPOR"; }
    jika kata == "cocokkan" || kata == "match" { kembalikan "KATA_KUNCI_COCOKKAN"; }
    jika kata == "benar" || kata == "true" { kembalikan "LITERAL_BOOL"; }
    jika kata == "salah" || kata == "false" { kembalikan "LITERAL_BOOL"; }
    jika kata == "cetak" || kata == "print" { kembalikan "KATA_KUNCI_CETAK"; }
    kembalikan "IDENTIFIER";
}

struktur LexerMandiri {
    sumber,
    posisi,
    baris,
    kolom,
    total_panjang,

    fungsi karakter_saat_ini() {
        jika ini.posisi >= ini.total_panjang {
            kembalikan "";
        }
        kembalikan potong(ini.sumber, ini.posisi, 1);
    }

    fungsi intip_berikutnya() {
        jika ini.posisi + 1 >= ini.total_panjang {
            kembalikan "";
        }
        kembalikan potong(ini.sumber, ini.posisi + 1, 1);
    }

    fungsi maju() {
        misal c = ini.karakter_saat_ini();
        ini.posisi = ini.posisi + 1;
        jika c == "\n" {
            ini.baris = ini.baris + 1;
            ini.kolom = 1;
        } lainnya {
            ini.kolom = ini.kolom + 1;
        }
        kembalikan c;
    }

    fungsi lewati_spasi_dan_komentar() {
        selama ini.posisi < ini.total_panjang {
            misal c = ini.karakter_saat_ini();
            jika apakah_spasi(c) {
                ini.maju();
            } lainnya jika c == "/" && ini.intip_berikutnya() == "/" {
                // Lewati baris komentar
                selama ini.posisi < ini.total_panjang && ini.karakter_saat_ini() != "\n" {
                    ini.maju();
                }
            } lainnya {
                kembalikan;
            }
        }
    }

    fungsi pindai_kata() {
        misal baris_awal = ini.baris;
        misal kolom_awal = ini.kolom;
        misal kata = "";
        selama ini.posisi < ini.total_panjang {
            misal c = ini.karakter_saat_ini();
            jika apakah_huruf_pengenal(c) || apakah_digit(c) {
                kata = kata + ini.maju();
            } lainnya {
                kembalikan TokenLeksikal(cocokkan_kata_kunci(kata), kata, baris_awal, kolom_awal);
            }
        }
        kembalikan TokenLeksikal(cocokkan_kata_kunci(kata), kata, baris_awal, kolom_awal);
    }

    fungsi pindai_angka() {
        misal baris_awal = ini.baris;
        misal kolom_awal = ini.kolom;
        misal angka_str = "";
        selama ini.posisi < ini.total_panjang {
            misal c = ini.karakter_saat_ini();
            jika apakah_digit(c) || c == "." {
                angka_str = angka_str + ini.maju();
            } lainnya {
                kembalikan TokenLeksikal("LITERAL_ANGKA", angka_str, baris_awal, kolom_awal);
            }
        }
        kembalikan TokenLeksikal("LITERAL_ANGKA", angka_str, baris_awal, kolom_awal);
    }

    fungsi pindai_string() {
        misal baris_awal = ini.baris;
        misal kolom_awal = ini.kolom;
        ini.maju(); // lewati tanda petik pembuka
        misal teks = "";
        selama ini.posisi < ini.total_panjang {
            misal c = ini.karakter_saat_ini();
            jika c == "\"" {
                ini.maju(); // lewati tanda petik penutup
                kembalikan TokenLeksikal("LITERAL_STRING", teks, baris_awal, kolom_awal);
            } lainnya {
                teks = teks + ini.maju();
            }
        }
        kembalikan TokenLeksikal("LITERAL_STRING", teks, baris_awal, kolom_awal);
    }

    fungsi pindai_token_berikutnya() {
        ini.lewati_spasi_dan_komentar();
        jika ini.posisi >= ini.total_panjang {
            kembalikan TokenLeksikal("EOF", "", ini.baris, ini.kolom);
        }

        misal c = ini.karakter_saat_ini();
        misal baris_awal = ini.baris;
        misal kolom_awal = ini.kolom;

        jika apakah_huruf_pengenal(c) {
            kembalikan ini.pindai_kata();
        }
        jika apakah_digit(c) {
            kembalikan ini.pindai_angka();
        }
        jika c == "\"" {
            kembalikan ini.pindai_string();
        }

        // Operator dan simbol
        jika c == "=" && ini.intip_berikutnya() == "=" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_EQ", "==", baris_awal, kolom_awal);
        }
        jika c == "!" && ini.intip_berikutnya() == "=" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_NEQ", "!=", baris_awal, kolom_awal);
        }
        jika c == "<" && ini.intip_berikutnya() == "=" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_LTE", "<=", baris_awal, kolom_awal);
        }
        jika c == ">" && ini.intip_berikutnya() == "=" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_GTE", ">=", baris_awal, kolom_awal);
        }
        jika c == "&" && ini.intip_berikutnya() == "&" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_AND", "&&", baris_awal, kolom_awal);
        }
        jika c == "|" && ini.intip_berikutnya() == "|" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("OPERATOR_OR", "||", baris_awal, kolom_awal);
        }
        jika c == "-" && ini.intip_berikutnya() == ">" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("PANAH_TIPE", "->", baris_awal, kolom_awal);
        }
        jika c == "=" && ini.intip_berikutnya() == ">" {
            ini.maju(); ini.maju();
            kembalikan TokenLeksikal("PANAH_GEMUK", "=>", baris_awal, kolom_awal);
        }

        // Operator karakter tunggal
        ini.maju();
        jika c == "+" { kembalikan TokenLeksikal("OPERATOR_TAMBAH", "+", baris_awal, kolom_awal); }
        jika c == "-" { kembalikan TokenLeksikal("OPERATOR_KURANG", "-", baris_awal, kolom_awal); }
        jika c == "*" { kembalikan TokenLeksikal("OPERATOR_KALI", "*", baris_awal, kolom_awal); }
        jika c == "/" { kembalikan TokenLeksikal("OPERATOR_BAGI", "/", baris_awal, kolom_awal); }
        jika c == "%" { kembalikan TokenLeksikal("OPERATOR_MODULO", "%", baris_awal, kolom_awal); }
        jika c == "=" { kembalikan TokenLeksikal("OPERATOR_PENUGASAN", "=", baris_awal, kolom_awal); }
        jika c == "<" { kembalikan TokenLeksikal("OPERATOR_LT", "<", baris_awal, kolom_awal); }
        jika c == ">" { kembalikan TokenLeksikal("OPERATOR_GT", ">", baris_awal, kolom_awal); }
        jika c == "!" { kembalikan TokenLeksikal("OPERATOR_NOT", "!", baris_awal, kolom_awal); }
        jika c == "(" { kembalikan TokenLeksikal("KURUNG_BUKA", "(", baris_awal, kolom_awal); }
        jika c == ")" { kembalikan TokenLeksikal("KURUNG_TUTUP", ")", baris_awal, kolom_awal); }
        jika c == "{" { kembalikan TokenLeksikal("KURAWAL_BUKA", "{", baris_awal, kolom_awal); }
        jika c == "}" { kembalikan TokenLeksikal("KURAWAL_TUTUP", "}", baris_awal, kolom_awal); }
        jika c == "[" { kembalikan TokenLeksikal("SIKU_BUKA", "[", baris_awal, kolom_awal); }
        jika c == "]" { kembalikan TokenLeksikal("SIKU_TUTUP", "]", baris_awal, kolom_awal); }
        jika c == "," { kembalikan TokenLeksikal("KOMA", ",", baris_awal, kolom_awal); }
        jika c == ":" { kembalikan TokenLeksikal("TITIK_DUA", ":", baris_awal, kolom_awal); }
        jika c == ";" { kembalikan TokenLeksikal("TITIK_KOMA", ";", baris_awal, kolom_awal); }

        kembalikan TokenLeksikal("SIMBOL_TIDAK_DIKENAL", c, baris_awal, kolom_awal);
    }

    fungsi pindai_semua() {
        misal daftar_token = [];
        selama ini.posisi <= ini.total_panjang {
            misal tok = ini.pindai_token_berikutnya();
            tambah(daftar_token, tok);
            jika tok.jenis == "EOF" {
                kembalikan daftar_token;
            }
        }
        kembalikan daftar_token;
    }
}

fungsi buat_lexer(sumber_kode) {
    kembalikan LexerMandiri(sumber_kode, 0, 1, 1, panjang(sumber_kode));
}

fungsi uji_lexer() {
    misal contoh_kode = "fungsi tambah(a, b) { kembalikan a + b; }";
    misal lx = buat_lexer(contoh_kode);
    misal tokens = lx.pindai_semua();
    jika panjang(tokens) >= 10 {
        kembalikan "LEXER_OK";
    }
    kembalikan "LEXER_GALAT";
}

// Jalankan pengujian mandiri
uji_lexer();
