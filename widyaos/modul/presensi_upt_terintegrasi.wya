// =================================================================
// Modul Presensi Terintegrasi UPT Kemendikdasmen (Multi-Jenjang & ASN)
// Menangani Presensi Multi-Jenjang (SD, SMP, SMA/SMK dalam 1 Kompleks)
// dan Presensi ASN/PPPK Vertikal Terhubung ke Biro SDM Kemendikdasmen
// =================================================================

struktur PresensiSiswaKompleks {
    id_presensi,
    nisn,
    nama_siswa,
    jenjang, // SD, SMP, SMA, SMK
    npsn_induk,
    id_rombel,
    tipe_titik_presensi, // GERBANG_KOMPLEKS, KELAS_MAPEL, ASRAMA
    waktu_tap,
    status_kehadiran, // HADIR_TEPAT_WAKTU, TERLAMBAT, IZIN, SAKIT, ALPA
    lokasi_scanner
}

struktur PresensiPTKUPT {
    id_presensi,
    nuptk,
    nip_asn,
    nama_ptk,
    status_kepegawaian, // PNS_KEMENDIKDASMEN, PPPK_PUSAT, NON_ASN
    waktu_datang,
    waktu_pulang,
    jarak_geofence_meter,
    status_liveness_biometrik,
    keterlambatan_menit,
    potongan_tukin_persen,
    status_tpg_harian
}

struktur SesiKBMLintasJenjang {
    id_sesi,
    nuptk,
    nama_guru,
    npsn_sasaran,
    jenjang_sasaran,
    mapel,
    id_rombel,
    jam_pelajaran,
    status_pelaksanaan
}

struktur SistemPresensiUPT {
    id_kompleks_upt,
    nama_satker_upt,
    daftar_npsn, // Dict: { "SD": npsn, "SMP": npsn, "SMA": npsn }
    koordinat_lat_pusat,
    koordinat_long_pusat,
    radius_geofence_meter,
    daftar_presensi_siswa,
    daftar_presensi_ptk,
    jadwal_kbm_lintas
}

// -----------------------------------------------------------------
// [1] Inisialisasi Sistem Presensi UPT Terintegrasi
// -----------------------------------------------------------------
fungsi inisialisasi_presensi_upt(id_kompleks, nama_satker, map_npsn, lat, long, radius) {
    kembalikan SistemPresensiUPT(
        id_kompleks,
        nama_satker,
        map_npsn,
        lat,
        long,
        radius,
        [],
        [],
        []
    );
}

// -----------------------------------------------------------------
// [2] Presensi Siswa Multi-Jenjang di Gerbang Bersama Kompleks UPT
// Satu titik scan gerbang langsung mengenali dan mendistribusikan
// status kehadiran ke database jenjang yang sesuai (SD, SMP, atau SMA)
// -----------------------------------------------------------------
fungsi presensi_gerbang_siswa_upt(sistem, nisn, nama, jenjang, rombel, jam_tap) {
    misal npsn_tujuan = sistem.daftar_npsn[jenjang];
    misal status = "HADIR_TEPAT_WAKTU";
    
    // Batas toleransi masuk gerbang: 07:15 WIB
    // (Dalam simulasi representasi jam)
    jika jam_tap > "07:15:00" {
        status = "TERLAMBAT";
    }
    
    misal id_p = "PRS-SISWA-" + jenjang + "-" + nisn;
    misal record = PresensiSiswaKompleks(
        id_p,
        nisn,
        nama,
        jenjang,
        npsn_tujuan,
        rombel,
        "GERBANG_KOMPLEKS_UTAMA",
        jam_tap,
        status,
        "SCANNER_RFID_FACIAL_GATE_01"
    );
    
    tambah(sistem.daftar_presensi_siswa, record);
    kembalikan record;
}

// -----------------------------------------------------------------
// [3] Presensi PTK (Guru & Tendik) ASN UPT Kemendikdasmen Pusat
// Menegakkan PP 94/2021: Geofencing radius, Biometric Anti-Fake,
// dan pemotongan Tukin otomatis jika datang terlambat
// -----------------------------------------------------------------
fungsi presensi_asn_ptk_upt(sistem, nuptk, nip, nama, status_pegawai, jam_datang, jarak_gps_meter, liveness_ok) {
    jika jarak_gps_meter > sistem.radius_geofence_meter {
        kembalikan {
            "sukses": salah,
            "kode": "DILUAR_RADIUS_KAMPUS_UPT",
            "pesan": "Gagal presensi! Posisi Anda berjarak " + ke_teks(jarak_gps_meter) + "m (Maksimal radius kampus UPT: " + ke_teks(sistem.radius_geofence_meter) + "m)"
        };
    }
    
    jika liveness_ok == salah {
        kembalikan {
            "sukses": salah,
            "kode": "GAGAL_LIVENESS_DETECTION",
            "pesan": "Presensi ditolak! Terdeteksi manipulasi foto statis / anti-spoofing gagal."
        };
    }
    
    // Evaluasi jam kerja ASN UPT (Masuk: 07:30 WIB)
    misal terlambat_menit = 0;
    misal potong_tukin = 0.0;
    
    jika jam_datang > "07:30:00" {
        // Simulasi keterlambatan 15 menit
        terlambat_menit = 15;
        potong_tukin = 0.5; // Potong 0.5% Tunjangan Kinerja per keterlambatan 1-30 menit
    }
    
    misal id_ptk = "PRS-ASN-" + nip;
    misal ptk_record = PresensiPTKUPT(
        id_ptk,
        nuptk,
        nip,
        nama,
        status_pegawai,
        jam_datang,
        "16:00:00", // Estimasi waktu pulang standar ASN
        jarak_gps_meter,
        "TERVERIFIKASI_BIOMETRIK_LIVE",
        terlambat_menit,
        potong_tukin,
        "HADIR_MEMENUHI_SYARAT"
    );
    
    tambah(sistem.daftar_presensi_ptk, ptk_record);
    kembalikan {
        "sukses": benar,
        "data": ptk_record
    };
}

// -----------------------------------------------------------------
// [4] Rekam Presensi KBM Guru Mengajar Lintas Jenjang dalam Kompleks
// Guru mengajar di SMP pada pagi hari dan di SMA pada siang hari
// -----------------------------------------------------------------
fungsi presensi_kbm_lintas_jenjang(sistem, nuptk, nama, jenjang_target, mapel, rombel, jam_pelajaran) {
    misal npsn = sistem.daftar_npsn[jenjang_target];
    misal id_sesi = "KBM-" + jenjang_target + "-" + rombel + "-" + nuptk;
    
    misal sesi = SesiKBMLintasJenjang(
        id_sesi,
        nuptk,
        nama,
        npsn,
        jenjang_target,
        mapel,
        rombel,
        jam_pelajaran,
        "TERLAKSANA_TATAP_MUKA"
    );
    
    tambah(sistem.jadwal_kbm_lintas, sesi);
    kembalikan sesi;
}

// -----------------------------------------------------------------
// [5] Paket Transmisi Presensi Langsung ke Kementerian Pusat (UPT)
// Karena UPT merupakan satuan kerja vertikal Kemendikdasmen,
// paket presensi dikirim langsung via GovCloud Tunnel ke Biro SDM
// -----------------------------------------------------------------
fungsi presensi_upt_paket_pusat(sistem, tanggal) {
    misal total_siswa = panjang(sistem.daftar_presensi_siswa);
    misal total_ptk = panjang(sistem.daftar_presensi_ptk);
    misal total_kbm = panjang(sistem.jadwal_kbm_lintas);
    
    kembalikan {
        "id_satker_upt": sistem.id_kompleks_upt,
        "nama_satker": sistem.nama_satker_upt,
        "tanggal_presensi": tanggal,
        "tujuan_integrasi": "BIRO_SDM_DAN_PUSDATIN_KEMENDIKDASMEN",
        "saluran_transmisi": "SECURE_GOVCLOUD_TUNNEL_VERTIKAL",
        "total_siswa_hadir": total_siswa,
        "total_asn_hadir": total_ptk,
        "total_sesi_kbm": total_kbm,
        "status_sinkronisasi": "BERHASIL_TERKIRIM_KE_PUSAT",
        "hash_integritas": "0x8fa37bc9910d24e6a88b1f5c3e721a93b4f6"
    };
}
