// =================================================================
// Modul Pusat Komando Eksekutif Wilayah & Nasional (Executive GIS Hub)
// (Adopsi MOD-30: Konsolidasi Agregat BOS, Skor Audit, MBG, & IFP)
// =================================================================

struktur AgregatWilayahPendidikan {
    kode_wilayah,
    nama_wilayah, // Tingkat Nasional / Provinsi Jawa Barat / Kab. Bandung
    total_sekolah_terhubung,
    total_pagu_bosp_miliar,
    total_realisasi_bosp_miliar,
    persen_penyerapan_anggaran,
    jumlah_sekolah_risiko_audit, // Sekolah dengan skor audit < 70%
    total_porsi_mbg_harian,
    total_ifp_aktif_mengajar
}

struktur IndikatorPeringatanDini {
    npsn_sekolah,
    nama_sekolah,
    jenis_peringatan, // KAS_MENUMPUK, REALISASI_LAMBAT, RISIKO_TEMUAN_BPK, MBG_BELUM_VERIF
    tingkat_bahaya // KUNING_WASPADA atau MERAH_KRITIS
}

// -------------------------------------------------------------
// [1] Konsolidasi Metrik Eksekutif Satu Layar
// -------------------------------------------------------------
fungsi command_center_hitung_agregat(kode, nama, jml_sekolah, pagu_miliar, realisasi_miliar, sekolah_risiko, mbg_porsi, ifp_aktif) {
    misal persen_serap = (realisasi_miliar * 100.0) / pagu_miliar;
    
    kembalikan AgregatWilayahPendidikan(
        kode,
        nama,
        jml_sekolah,
        pagu_miliar,
        realisasi_miliar,
        persen_serap,
        sekolah_risiko,
        mbg_porsi,
        ifp_aktif
    );
}

// -------------------------------------------------------------
// [2] Peringatan Dini Intervensi Dinas Pendidikan
// -------------------------------------------------------------
fungsi command_center_evaluasi_sekolah(npsn, nama, skor_audit, persen_realisasi_semester) {
    misal jenis = "AMAN";
    misal tingkat = "HIJAU_NORMAL";
    
    jika skor_audit < 70.0 {
        jenis = "RISIKO_TEMUAN_BPK_AUDIT";
        tingkat = "MERAH_KRITIS";
    } kalau persen_realisasi_semester < 40.0 {
        jenis = "REALISASI_ANGGARAN_TERLALU_LAMBAT";
        tingkat = "KUNING_WASPADA";
    }
    
    kembalikan IndikatorPeringatanDini(
        npsn,
        nama,
        jenis,
        tingkat
    );
}
