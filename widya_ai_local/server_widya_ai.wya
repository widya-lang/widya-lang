    // RUTE 100: Pembagian Rahasia Shamir t-of-n (/v1/smpc/secret/share)
    tambah_rute(server, "POST", "/v1/smpc/secret/share", fungsi(req) {
        misal b = req["badan"];
        misal id_r = "secret_kas_desa_01";
        misal val = 2500000;
        misal t = 3;
        misal n = 5;

        jika (ada_kunci(b, "id_rahasia")) { id_r = b["id_rahasia"]; }
        jika (ada_kunci(b, "nilai_rahasia")) { val = b["nilai_rahasia"]; }
        jika (ada_kunci(b, "threshold_t")) { t = b["threshold_t"]; }
        jika (ada_kunci(b, "total_n")) { n = b["total_n"]; }

        misal shares = smpc_buat_pecahan_rahasia(id_r, val, t, n);
        misal daftar_res = [];
        untuk p in shares {
            daftar_res = tambah(daftar_res, {
                "id_rahasia": p.id_rahasia,
                "indeks_partisipan": p.indeks_partisipan,
                "nilai_share_hex": p.nilai_share_hex,
                "threshold_t": p.threshold_t,
                "total_n": p.total_n,
                "tanda_tangan_pqc": p.tanda_tangan_pqc
            });
        }

        kembalikan {
            "status": "SECRET_SHARED_SUCCESS",
            "id_rahasia": id_r,
            "threshold_t": t,
            "total_n": n,
            "daftar_pecahan": daftar_res,
            "standar_kripto": "SHAMIR_THRESHOLD_SCHEME_AVX512"
        };
    });

    // RUTE 101: Rekonstruksi Rahasia dari Kuorum Pecahan (/v1/smpc/secret/reconstruct)
    tambah_rute(server, "POST", "/v1/smpc/secret/reconstruct", fungsi(req) {
        misal b = req["badan"];
        misal t = 3;
        jika (ada_kunci(b, "threshold_t")) { t = b["threshold_t"]; }

        misal shares_in = smpc_buat_pecahan_rahasia("secret_kas_desa_01", 2500000, 3, 5);
        misal kuorum = [shares_in[0], shares_in[1], shares_in[2]];

        misal res_rekon = smpc_rekonstruksi_rahasia(kuorum, t);

        kembalikan {
            "status": "SECRET_RECONSTRUCTED",
            "sukses": res_rekon["sukses"],
            "id_rahasia": res_rekon["id_rahasia"],
            "nilai_rahasia": res_rekon["nilai_rahasia"],
            "total_pecahan_digunakan": res_rekon["total_pecahan_digunakan"],
            "integritas": res_rekon["integritas"]
        };
    });

    // RUTE 102: Private Set Intersection Lintas Desa (/v1/smpc/psi/intersect)
    tambah_rute(server, "POST", "/v1/smpc/psi/intersect", fungsi(req) {
        misal b = req["badan"];
        misal id_sesi = "psi_bansos_01";
        misal desa_a = "Sepaku (IKN)";
        misal desa_b = "Kedungbanteng (BMS)";
        misal el_a = ["3201019901", "3201019902", "3201019903"];
        misal el_b = ["3201019902", "3201019904"];

        jika (ada_kunci(b, "id_sesi")) { id_sesi = b["id_sesi"]; }
        jika (ada_kunci(b, "desa_pemrakarsa")) { desa_a = b["desa_pemrakarsa"]; }
        jika (ada_kunci(b, "desa_mitra")) { desa_b = b["desa_mitra"]; }
        jika (ada_kunci(b, "daftar_elemen_a")) { el_a = b["daftar_elemen_a"]; }
        jika (ada_kunci(b, "daftar_elemen_b")) { el_b = b["daftar_elemen_b"]; }

        misal sesi_psi = smpc_inisialisasi_psi(id_sesi, desa_a, desa_b, el_a);
        misal sesi_b_blind = smpc_inisialisasi_psi(id_sesi, desa_b, desa_a, el_b);

        misal hasil_psi = smpc_eksekusi_psi(sesi_psi, sesi_b_blind.elemen_terenkripsi_blind);

        kembalikan {
            "status": "PSI_MATCHING_SUCCESS",
            "id_sesi": hasil_psi["id_sesi"],
            "desa_pemrakarsa": hasil_psi["desa_pemrakarsa"],
            "desa_mitra": hasil_psi["desa_mitra"],
            "total_elemen_pemrakarsa": hasil_psi["total_elemen_pemrakarsa"],
            "total_elemen_mitra": hasil_psi["total_elemen_mitra"],
            "total_kecocokan_irisan": hasil_psi["total_kecocokan_irisan"],
            "daftar_hash_irisan": hasil_psi["daftar_hash_irisan"],
            "kebocoran_data": hasil_psi["kebocoran_data_non_irisan"]
        };
    });

