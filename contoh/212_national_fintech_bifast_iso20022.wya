// ==============================================================================
// 212_national_fintech_bifast_iso20022.wya
// Demonstrasi Sistem Finansial Nasional BI-FAST, Resolusi Proxy & Pesan ISO 20022
// Standar Perbankan: pacs.008, pacs.002, Splitting Fee Rp 2.500, & Settlement < 2 Detik
// ==============================================================================

cetak("==================================================================");
cetak("🏛️ WIDYA FINTECH: SISTEM PEMBAYARAN NASIONAL BI-FAST & ISO 20022");
cetak("==================================================================");

// 1. Database Resolusi Proxy Pembayaran Terintegrasi Bank Indonesia
struktur AkunProxy {
    tipe_proxy,
    nilai_proxy,
    nama_pemilik,
    kode_bank_bic,
    nama_bank,
    nomor_rekening,
    aktif,

    fungsi ringkasan() {
        kembalikan "[" + ini.tipe_proxy + ": " + ini.nilai_proxy + "] ➔ " + ini.nama_pemilik + " (" + ini.nama_bank + " - " + ini.nomor_rekening + ")";
    }
}

misal daftar_proxy = [
    AkunProxy("NO_HP", "081234567890", "Dr. Budi Santoso", "WIDYIDJA", "Bank Widya Indonesia", "9876543210", benar),
    AkunProxy("EMAIL", "koperasi@merdeka.id", "Koperasi Merdeka Jaya", "BINAIDJA", "Bank Digital Merdeka", "1122334455", benar),
    AkunProxy("NIK", "3171012304950001", "Ahmad Fauzi", "MANDIDJA", "Bank Mandiri", "5544332211", benar)
];

fungsi cari_resolusi_proxy(query) {
    untuk akun dalam daftar_proxy {
        jika akun.nilai_proxy == query dan akun.aktif {
            kembalikan akun;
        }
    }
    kembalikan kosong;
}

cetak("📱 1. Resolusi Proksi Pembayaran Instan (No HP / Email / NIK):");
misal target_transfer = "081234567890";
misal hasil_resolusi = cari_resolusi_proxy(target_transfer);

jika hasil_resolusi != kosong {
    cetak("   🔍 Query Proksi : " + target_transfer);
    cetak("   ✅ Teridentifikasi: " + hasil_resolusi.ringkasan());
} selain_itu {
    cetak("   ❌ Proksi tidak ditemukan.");
}

// 2. Skema Perhitungan Pemecahan Biaya Transaksi (MDR / Fee Split)
// Standar Regulasi BI-FAST: Biaya Transfer Rp 2.500
struktur SkemaBiayaBiFast {
    total_biaya,
    porsi_bank_indonesia,
    porsi_bank_pengirim,
    porsi_bank_penerima,

    fungsi validasi() {
        kembalikan (ini.porsi_bank_indonesia + ini.porsi_bank_pengirim + ini.porsi_bank_penerima) == ini.total_biaya;
    }
}

misal mdr_bifast = SkemaBiayaBiFast(2500, 200, 1000, 1300);
cetak("\n💵 2. Skema Pembagian Biaya Transaksi (Fee Splitting Standard):");
cetak("   • Total Biaya Nasabah: Rp " + ke_teks(mdr_bifast.total_biaya));
cetak("   • Porsi Switching BI : Rp " + ke_teks(mdr_bifast.porsi_bank_indonesia));
cetak("   • Porsi Bank Pengirim: Rp " + ke_teks(mdr_bifast.porsi_bank_pengirim));
misal status_validasi = "GALAT";
jika mdr_bifast.validasi() {
    status_validasi = "LULUS (100% Seimbang)";
}
cetak("   • Validasi Integritas: " + status_validasi);

// 3. Eksekusi Setelmen Transaksi & Pembangkitan Resi
struktur TransaksiBiFast {
    id_transaksi,
    end_to_end_id,
    pengirim,
    penerima,
    nominal,
    status_kode,
    status_deskripsi,

    fungsi cetak_resi() {
        cetak("   ====================================================");
        cetak("   🧾 RESI SETELMEN TRANSAKSI BI-FAST (BANK INDONESIA)");
        cetak("   ====================================================");
        cetak("   ID Transaksi : " + ini.id_transaksi);
        cetak("   End-to-End ID: " + ini.end_to_end_id);
        cetak("   Pengirim     : " + ini.pengirim);
        cetak("   Penerima     : " + ini.penerima);
        cetak("   Nominal      : Rp " + ke_teks(ini.nominal));
        cetak("   Status       : " + ini.status_kode + " (" + ini.status_deskripsi + ")");
        cetak("   Waktu Setelmen: < 1.2 Detik (SLA Real-Time)");
        cetak("   ====================================================");
    }
}

misal tx = TransaksiBiFast(
    "TX-BIFAST-20261008-0001",
    "E2E-WIDYA-PAY-9876",
    "Ahmad Dahlan (Bank Widya)",
    hasil_resolusi.nama_pemilik + " (" + hasil_resolusi.nama_bank + ")",
    15000000,
    "ACTC",
    "Accepted Technical Validation & Settled"
);

cetak("\n⚡ 3. Eksekusi Setelmen Real-Time BI-FAST:");
tx.cetak_resi();

// 4. Emisi Dokumen XML Pesan Standar Global ISO 20022 (pacs.008.001.08)
cetak("\n📨 4. Dokumen Pesan Interoperabilitas Global ISO 20022:");
misal pacs008_snippet = 
"<Document xmlns=\"urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08\">\n"
+ "  <FIToFICstmrCdtTrf>\n"
+ "    <GrpHdr><MsgId>" + tx.id_transaksi + "</MsgId><SttlmMtd>CLRG</SttlmMtd></GrpHdr>\n"
+ "    <CdtTrfTxInf>\n"
+ "      <PmtId><EndToEndId>" + tx.end_to_end_id + "</EndToEndId></PmtId>\n"
+ "      <IntrBkSttlmAmt Ccy=\"IDR\">" + ke_teks(tx.nominal) + ".00</IntrBkSttlmAmt>\n"
+ "      <Dbtr><Nm>" + tx.pengirim + "</Nm></Dbtr>\n"
+ "      <Cdtr><Nm>" + tx.penerima + "</Nm></Cdtr>\n"
+ "    </CdtTrfTxInf>\n"
+ "  </FIToFICstmrCdtTrf>\n"
+ "</Document>";

cetak(pacs008_snippet);

cetak("\n==================================================================");
cetak("✅ Selesai: Sistem Finansial BI-FAST & ISO 20022 Beroperasi Penuh!");
cetak("==================================================================");
