// ==============================================================================
// WIDYAOS: MODUL PROJEK PENGUATAN PROFIL PELAJAR PANCASILA (P5)
// Kurikulum Merdeka & Kokurikuler Kemendikdasmen RI
// ==============================================================================

struktur ProjekP5 {
    kode_projek,
    nama_projek,
    tema, // GAYA_HIDUP_BERKELANJUTAN, KEARIFAN_LOKAL, REKAYASA_TEKNOLOGI, KEWIRAUSAHAAN, BHINNEKA_TUNGGAL_IKA, SUARA_DEMOKRASI
    alokasi_jp,
    nama_fasilitator,
    target_fase // FASE_D (SMP), FASE_E (SMA 10), FASE_F (SMA 11-12)
}

struktur AsesmenDimensiP5 {
    nama_siswa,
    dimensi, // BERIMAN_BERTAKWA, MANDIRI, GOTONG_ROYONG, BERKEBHINEKAAN_GLOBAL, BERNALAR_KRITIS, KREATIF
    predikat, // MB (Mulai Berkembang), SB (Sedang Berkembang), BSH (Berkembang Sesuai Harapan), SAB (Sangat Berkembang)
    deskripsi_proses
}

struktur RaporP5Siswa {
    id_rapor,
    nisn,
    nama_siswa,
    rombel,
    kode_projek,
    tema_projek,
    predikat_dominan,
    catatan_fasilitator
}

// Inisialisasi Projek P5
fungsi rancang_projek_p5(
    kode,
    nama,
    tema,
    jp,
    fasilitator,
    fase
) {
    kembalikan ProjekP5(
        kode,
        nama,
        tema,
        jp,
        fasilitator,
        fase
    );
}

// Menilai Capaian Dimensi Profil
fungsi nilai_dimensi_siswa(
    nama_siswa,
    dimensi,
    predikat,
    deskripsi
) {
    kembalikan AsesmenDimensiP5(
        nama_siswa,
        dimensi,
        predikat,
        deskripsi
    );
}

// Terbitkan Rapor Projek P5
fungsi terbitkan_rapor_p5(
    nisn,
    nama,
    rombel,
    projek,
    predikat_dominan,
    catatan
) {
    misal id_unik = "P5-" + nisn + "-" + projek.kode_projek;
    kembalikan RaporP5Siswa(
        id_unik,
        nisn,
        nama,
        rombel,
        projek.kode_projek,
        projek.tema,
        predikat_dominan,
        catatan
    );
}

// Konversi Kode Predikat ke Deskripsi Narasi Resmi
fungsi deskripsi_predikat_p5(predikat) {
    jika predikat == "SAB" {
        kembalikan "Sangat Berkembang (SAB) - Menunjukkan keteladanan melebihi target fase";
    } kalau predikat == "BSH" {
        kembalikan "Berkembang Sesuai Harapan (BSH) - Telah memenuhi ekspektasi fase pembelajaran";
    } kalau predikat == "SB" {
        kembalikan "Sedang Berkembang (SB) - Mulai terbiasa namun masih memerlukan arahan berkala";
    } lainnya {
        kembalikan "Mulai Berkembang (MB) - Memerlukan bimbingan intensif fasilitator";
    }
}
