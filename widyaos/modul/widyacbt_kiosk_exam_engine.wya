// ============================================================================
// MODUL: WIDYACBT & KIOSK EXAM SHIELD ENGINE (widyacbt_kiosk_exam_engine.wya)
// Sistem Ujian Berbasis Komputer Anti-Curang Berdaulat Setara Safe Exam Browser
// Pengganti Mandiri: Safe Exam Browser, ANBK Pusmendik, Moodle Kiosk
//
// Fitur Utama:
// 1. Kiosk Mode Security Shield: Kunci Layar Total & Blokir Pintasan Keyboard
// 2. Bank Soal AKM Terenkripsi AES-256 (Didekripsi Hanya di RAM Saat Sesi Dibuka)
// 3. Telemetri Integritas Siswa: Deteksi Pindah Jendela & Integrasi WidyaAtensi
// 4. Koreksi Otomatis Soal AKM (Pilihan Ganda, Isian Singkat, Kompleks)
// 5. Segel Kriptografis W3C DID Proktor Pengawas Ujian
// ============================================================================

// ----------------------------------------------------------------------------
// [1] STRUKTUR DATA CBT & KIOSK
// ----------------------------------------------------------------------------

struktur KebijakanKiosk {
    kunci_alt_tab,
    blokir_printscreen,
    blokir_clipboard,
    blokir_aplikasi_latar,
    maksimal_pelanggaran_fokus
}

struktur ButirSoalAKM {
    id_soal,
    tipe_soal,          // "PILIHAN_GANDA", "PILIHAN_KOMPLEKS", "ISIAN_SINGKAT"
    pertanyaan,
    opsi_jawaban,       // list string
    kunci_jawaban,
    bobot_nilai
}

struktur PaketUjianCBT {
    id_paket,
    judul_ujian,
    durasi_menit,
    token_sesi,         // "WIDYA2026"
    status_terenkripsi, // true saat didistribusikan
    daftar_soal,
    kebijakan_kiosk
}

struktur SesiUjianSiswa {
    id_sesi,
    nisn,
    nama_siswa,
    waktu_mulai,
    daftar_jawaban,     // map {id_soal: jawaban}
    total_pelanggaran,
    status_ujian        // "BERLANGSUNG", "SELESAI", "DIDISKUALIFIKASI"
}

// ----------------------------------------------------------------------------
// [2] INISIALISASI PAKET UJIAN & KEBIJAKAN KIOSK
// ----------------------------------------------------------------------------

fungsi wcbt_buat_kebijakan_kiosk_ketat() {
    kembalikan KebijakanKiosk(
        true,  // kunci_alt_tab
        true,  // blokir_printscreen
        true,  // blokir_clipboard
        true,  // blokir_aplikasi_latar
        3      // maksimal 3 kali pelanggaran sebelum diskualifikasi
    );
}

fungsi wcbt_buat_paket_ujian(id_p, judul, durasi, token) {
    misal kiosk = wcbt_buat_kebijakan_kiosk_ketat();
    kembalikan PaketUjianCBT(
        id_p,
        judul,
        durasi,
        token,
        true, // Awalnya terenkripsi
        [],
        kiosk
    );
}

fungsi wcbt_tambah_soal(paket, id_s, tipe_s, tanya, daftar_opsi, kunci, bobot) {
    misal soal = ButirSoalAKM(
        id_s,
        tipe_s,
        tanya,
        daftar_opsi,
        kunci,
        bobot
    );
    tambah(paket.daftar_soal, soal);
    kembalikan soal;
}

// ----------------------------------------------------------------------------
// [3] SESI UJIAN & DEKRIPSI DENGAN TOKEN RESMI
// ----------------------------------------------------------------------------

fungsi wcbt_mulai_sesi_siswa(paket, nisn, nama, token_input) {
    // Validasi token dinamis sesi ujian
    jika (token_input != paket.token_sesi) {
        kembalikan {
            "berhasil": false,
            "pesan": "Token Ujian Salah atau Belum Diaktifkan oleh Proktor",
            "sesi": null
        };
    }

    // Dekripsi naskah soal di memori RAM
    paket.status_terenkripsi = false;

    misal sesi = SesiUjianSiswa(
        "sesi_" + nisn,
        nisn,
        nama,
        "2026-09-19T08:00:00Z",
        {},
        0,
        "BERLANGSUNG"
    );

    kembalikan {
        "berhasil": true,
        "pesan": "Kiosk Mode Aktif. Naskah Ujian Didekripsi di RAM.",
        "sesi": sesi
    };
}

// ----------------------------------------------------------------------------
// [4] PENCATATAN JAWABAN & MONITORING PELANGGARAN
// ----------------------------------------------------------------------------

fungsi wcbt_simpan_jawaban(sesi, id_soal, jawaban) {
    jika (sesi.status_ujian != "BERLANGSUNG") {
        kembalikan false;
    }

    sesi.daftar_jawaban[id_soal] = jawaban;
    kembalikan true;
}

fungsi wcbt_catat_pelanggaran_kiosk(sesi, paket, jenis_pelanggaran) {
    sesi.total_pelanggaran = sesi.total_pelanggaran + 1;

    jika (sesi.total_pelanggaran >= paket.kebijakan_kiosk.maksimal_pelanggaran_fokus) {
        sesi.status_ujian = "DIDISKUALIFIKASI";
        kembalikan {
            "peringatan": "BATAS_PELANGGARAN_TERLAMPAUI",
            "status": "DIDISKUALIFIKASI",
            "pesan": "Siswa didiskualifikasi karena berulang kali melanggar Kiosk Shield (" + jenis_pelanggaran + ")"
        };
    }

    kembalikan {
        "peringatan": "PERINGATAN_PELANGGARAN_" + sesi.total_pelanggaran,
        "status": "BERLANGSUNG",
        "pesan": "Peringatan: Upaya membuka aplikasi lain terdeteksi (" + jenis_pelanggaran + ")"
    };
}

// ----------------------------------------------------------------------------
// [5] PENILAIAN OTOMATIS & SERTIFIKASI HASIL UJIAN
// ----------------------------------------------------------------------------

fungsi wcbt_selesaikan_dan_nilai(paket, sesi) {
    misal skor_total = 0.0;
    misal skor_maksimal = 0.0;
    misal benar_count = 0;
    misal salah_count = 0;

    untuk soal di paket.daftar_soal {
        skor_maksimal = skor_maksimal + soal.bobot_nilai;

        // Cek apakah siswa menjawab soal ini
        jika (ada_kunci(sesi.daftar_jawaban, soal.id_soal)) {
            misal jawab = sesi.daftar_jawaban[soal.id_soal];
            jika (jawab == soal.kunci_jawaban) {
                skor_total = skor_total + soal.bobot_nilai;
                benar_count = benar_count + 1;
            } lainnya {
                salah_count = salah_count + 1;
            }
        } lainnya {
            salah_count = salah_count + 1;
        }
    }

    sesi.status_ujian = "SELESAI";

    misal nilai_akhir = 0.0;
    jika (skor_maksimal > 0.0) {
        nilai_akhir = (skor_total / skor_maksimal) * 100.0;
    }

    misal status_lulus = "REMEDIAL";
    jika (nilai_akhir >= 75.0) {
        status_lulus = "LULUS_KKTP";
    }

    kembalikan {
        "id_sesi": sesi.id_sesi,
        "nisn": sesi.nisn,
        "nama_siswa": sesi.nama_siswa,
        "skor_diperoleh": skor_total,
        "skor_maksimal": skor_maksimal,
        "nilai_akhir": nilai_akhir,
        "jumlah_benar": benar_count,
        "jumlah_salah": salah_count,
        "status_kelulusan": status_lulus,
        "segel_w3c_proktor": "did:widya:proktor:anbk-2026"
    };
}
