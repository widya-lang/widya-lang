// ==============================================================================
// MODUL BD-107: KOMPUTASI BAHASA ACEH, HABA JAMEUN & KALENDER KEUNEUNONG
// Implementasi Kurikulum Pembelajaran Bahasa Daerah Berbasis Widya-Lang
// ==============================================================================

cetak("==================================================================");
cetak("📚 MODUL BD-107: PEMBELAJARAN BAHASA ACEH & ETNOSAINS MARITIM");
cetak("==================================================================");

// 1. SISTEM LOKALISASI I18N BAHASA ACEH
cetak("\n--- [1] Frasa Percakapan & Leksikon Bahasa Aceh ---");

struktur EntriKamusAceh {
    kata_aceh,
    arti_indonesia,
    ragam_santun
}

misal kamus_aceh = [
    EntriKamusAceh("pajoh bu / buet", "makan nasi", "Peumulia / Halos"),
    EntriKamusAceh("eh", "tidur", "Umum"),
    EntriKamusAceh("rumoh", "rumah", "Umum"),
    EntriKamusAceh("jak", "pergi / jalan", "Umum"),
    EntriKamusAceh("teuka / troh", "datang / sampai", "Umum"),
    EntriKamusAceh("meuseuraya", "gotong royong bersama", "Adat / Budaya")
];

untuk item dalam kamus_aceh {
    cetak("  • " + item.kata_aceh + " (" + item.ragam_santun + ") = " + item.arti_indonesia);
}

// 2. KALENDER MARITIM & AGRARIS TRADISIONAL KEUNEUNONG
cetak("\n--- [2] Sistem Penanggalan Maritim Keuneunong Aceh ---");

struktur MusimKeuneunong {
    nomor_keuneunong,
    arah_angin,
    kondisi_laut,
    musim_pertanian
}

misal daftar_keuneunong = [
    MusimKeuneunong(25, "Angin Barat Daya", "Gelombang mulai tenang, awal musim ikan", "Mulai persiapan bibit sawah"),
    MusimKeuneunong(23, "Angin Barat", "Ikan melimpah di pesisir selat", "Menabur benih padi"),
    MusimKeuneunong(21, "Angin Teduh", "Puncak tangkapan nelayan tuna", "Menanam padi serentak"),
    MusimKeuneunong(19, "Angin Timur", "Gelombang meningkat di samudra", "Padi mulai bunting hijau")
];

untuk m dalam daftar_keuneunong {
    cetak("  🌊 Keuneunong " + ke_teks(m.nomor_keuneunong) + ":");
    cetak("     - Angin & Laut  : " + m.arah_angin + " (" + m.kondisi_laut + ")");
    cetak("     - Tani Sawah    : " + m.musim_pertanian);
}

// 3. HABA JAMEUN & HIKAYAT ACEH
cetak("\n--- [3] Haba Jameun (Peribahasa Nasihat Luhur Aceh) ---");

var haba = [
    "Adat bak Po Teumeureuhom, Hukom bak Syiah Kuala (Adat bersandar pada pemimpin kenegaraan, hukum bersandar pada ulama)",
    "Meunyoe hana ta meuduek sajan, peugah haba pih tan meuteumee (Jika tidak bersilaturahmi dan duduk bersama, komunikasi tidak akan terjalin)",
    "Hana guna peugah haba le, meunyo buet hana ta peuget (Tiada guna banyak bicara jika tidak ada aksi nyata yang dikerjakan)"
];

untuk h dalam haba {
    cetak("  🌟 " + h);
}

cetak("\n==================================================================");
cetak("✅ Modul BD-107 Bahasa Aceh selesai dipelajari!");
cetak("==================================================================");
