// ==============================================================================
// 207_widyablok_visual_scratch_engine.wya
// Demonstrasi Logika Pemrograman Visual Berbasis Blok (Scratch untuk Widya-Lang)
// ==============================================================================

cetak("==================================================================");
cetak("🧩 WIDYABLOK: ENGINE PEMROGRAMAN VISUAL BLOK KEDAULATAN NUSANTARA");
cetak("==================================================================");

// Definisi Struktur Sprite dengan Metode Gerakan & Tampilan
struktur Sprite {
    nama,
    posisi_x,
    posisi_y,
    arah,
    ukuran,
    terlihat,
    pena_aktif,

    fungsi gerak_langkah(langkah) {
        ini.posisi_x += langkah;
    }

    fungsi putar_kanan(derajat) {
        ini.arah = (ini.arah + derajat) % 360;
    }

    fungsi katakan(pesan) {
        cetak("💬 Sprite [" + ini.nama + "] berkata: '" + pesan + "'");
    }

    fungsi info() {
        kembalikan "Sprite [" + ini.nama + "] di (" + ke_teks(ini.posisi_x) + ", " + ke_teks(ini.posisi_y) + ") Arah: " + ke_teks(ini.arah) + "°";
    }
}

// Inisialisasi Sprite Maskot
misal maskot = Sprite("GarudaWidya", 0, 0, 90, 100, benar, salah);
misal skor = 0;
misal pesan_siaran = "";

// 1. Blok Kejadian: Ketika Bendera Hijau Diklik
fungsi ketika_bendera_hijau_diklik() {
    cetak("[Kejadian] 🚩 Bendera Hijau Diklik! Memulai skrip...");
    maskot.posisi_x = 0;
    maskot.posisi_y = 0;
    skor = 0;
    
    // Blok Tampilan: Katakan Teks
    maskot.katakan("Halo Nusantara! Selamat datang di WidyaBlok!");
    
    // Blok Gerakan & Kontrol Ulang
    cetak("🔄 Menjalankan blok loop (ulang 5 kali)...");
    untuk _langkah dalam 1..5 {
        // Maju 20 langkah
        maskot.gerak_langkah(20);
        maskot.putar_kanan(15);
        skor += 10;
        cetak("   ➔ " + maskot.info() + " | Skor: " + ke_teks(skor));
    }
}

// 2. Blok Sensor & Percabangan (Jika / Maka)
fungsi periksa_kondisi_sensor() {
    cetak("\n🔍 [Sensor] Memeriksa posisi sprite...");
    jika maskot.posisi_x > 50 {
        cetak("✅ Kondisi Terpenuhi: Sprite berada di sisi kanan panggung!");
        pesan_siaran = "menang";
    } lainnya {
        cetak("ℹ️ Sprite masih di area awal.");
    }
}

// 3. Blok Kejadian: Siaran Pesan
fungsi ketika_menerima_pesan(pesan) {
    jika pesan == "menang" {
        cetak("📢 [Siaran Pesan] Menerima pesan '" + pesan + "'!");
        cetak("🎵 [Audio Synthesizer] Memainkan nada kemenangan (MIDI 72 & 79)...");
        cetak("🎉 SELAMAT! Program WidyaBlok berhasil dieksekusi dengan sempurna.");
    }
}

// Eksekusi Rangkaian Blok
ketika_bendera_hijau_diklik();
periksa_kondisi_sensor();
ketika_menerima_pesan(pesan_siaran);

cetak("==================================================================");
cetak("✅ Selesai: Logika visual Scratch telah sukses diintegrasikan ke Widya-Lang!");
cetak("==================================================================");
