    cetak("    • SINTA 4 : Nilai 50-60  (Jurnal Nasional Terakreditasi Dasar)");
    cetak("    • SINTA 5 : Nilai 40-50  (Jurnal Ilmiah Berkala Rintisan Awal)");
    cetak("    • SINTA 6 : Nilai 30-40  (Jurnal Ilmiah Terindeks Garuda)");

    misal nama_dosen = "Dr. Eng. Hendro Wicaksono (NIDN: 0012058001)";
    misal sinta_score_overall = 515.0;
    misal sinta_score_3yr = 245.0;

    cetak("\n    --- PROFIL KINERJA PENELITI SINTA ---");
    cetak("    - Nama Dosen / Peneliti: " + nama_dosen);
