[Unit]
Description=Widya-Lang Production Application Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/widya-app
ExecStart=/usr/local/bin/widya main.wya
Restart=always
RestartSec=5s
Environment=WIDYA_ENV=production
Environment=PORT=8080

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
