// ============================================================================
// MODUL: WIDYABROWSER ENGINE - PERAMBAN WEB BERDAULAT & SOVEREIGN LAYOUT ENGINE
// (Zero-Vendor Dependence: Independen dari Chromium, WebKit, Gecko, & Playwright)
//
// Fitur Arsitektur:
// 1. Protocol Stack: Native Scheme Resolver (file://, widya://, https://, http://) & W3C DID Shield
// 2. HTML5 Parser & Tree Construction: Tokenizer, DOM Tree, Node & Hierarchy, querySelector
// 3. CSS3 Cascade & Computed Styles: Selector Specificity, Style Inheritance, Box Model rules
// 4. Layout & Reflow Geometry: Block Stacking, Inline Horizontal Flow, Flexbox Coordinates
// 5. Display List & Vector Painter: Painting Commands & Crisp Scalable SVG Visual Exporter
// 6. Headless Web Test Driver: 100% Native Automation (Pengganti Total Playwright & Selenium)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. STRUKTUR DATA INTI DOM, CSS, LAYOUT & RENDER
// ----------------------------------------------------------------------------

impor "widyaos/modul/widyabrowser_security_enterprise.wya";

struktur NodeDOM {
    id_node,
    tag,              // "html", "head", "title", "body", "h1", "div", "p", "button", "input", "table", "#text", dst.
    teks,             // Konten teks (jika ada)
    atribut,          // Map string atribut: id, class, href, src, style, type, value, placeholder
    daftar_anak,      // List of NodeDOM
    gaya_terhitung    // Map computed styles: display, color, background, width, height, font_size, margin, padding, border
}

struktur PohonDOM {
    url_dokumen,
    judul,
    akar_node,
    total_node,
    waktu_parse_ms
}

struktur AturanCSS {
    pemilih,          // "*", "body", "h1", ".kartu", "#utama", "button"
    spesifisitas,     // Angka pembobot prioritas: 1=Tag, 10=Class, 100=ID, 1000=Inline
    deklarasi         // Map properti -> nilai (misal: "color" -> "#ffffff", "display" -> "block")
}

struktur KotakTataLetak {
    id_node,
    tag,
    tipe_layout,      // "BLOCK", "INLINE", "FLEX"
    x,
    y,
    lebar,
    tinggi,
    warna_latar,
    warna_teks,
    teks_konten,
    daftar_anak_kotak
}

struktur PerintahLukis {
    perintah,         // "KOTAK_LATAR", "GARIS_TEPI", "TULIS_TEKS", "GAMBAR_IKON"
    x,
    y,
    lebar,
    tinggi,
    warna,
    konten
}

struktur DaftarTampilan {
    url,
    lebar_viewport,
    tinggi_viewport,
    daftar_perintah,
    total_perintah
}

struktur ResponBrowser {
    url,
    status_kode,
    tipe_konten,
    sumber_protokol,  // "FILE", "WIDYA_INTERNAL", "HTTPS", "HTTP"
    sertifikat_did,   // Validasi W3C DID Kemendikdasmen RI / Sovereign Trust
    pohon_dom,
    tata_letak,
    daftar_tampilan,
    waktu_total_ms,
    status
}

struktur SesiTabBrowser {
    id_tab,
    judul_tab,
    url_aktif,
    riwayat_mundur,
    riwayat_maju,
    halaman_aktif,
    status_muat
}

// ----------------------------------------------------------------------------
// 2. HELPER BUILDER NODE DOM
// ----------------------------------------------------------------------------

fungsi widyabrowser_buat_node(id, tag, teks, atribut) {
    misal gaya_default = {
        "display": "block",
        "color": "#e2e8f0",
        "background": "transparent",
        "width": 0.0,
        "height": 0.0,
        "font_size": 14.0,
        "font_weight": "normal",
        "margin_top": 0.0,
        "margin_bottom": 0.0,
        "margin_left": 0.0,
        "margin_right": 0.0,
        "padding_top": 0.0,
        "padding_bottom": 0.0,
        "padding_left": 0.0,
        "padding_right": 0.0,
        "border_color": "transparent",
        "border_width": 0.0,
        "flex_direction": "row"
    };

    // Sesuaikan display berdasarkan tag HTML baku
    jika tag == "span" atau tag == "a" atau tag == "#text" {
        gaya_default["display"] = "inline";
    } lainnya jika tag == "button" atau tag == "input" {
        gaya_default["display"] = "inline-block";
        gaya_default["padding_top"] = 6.0;
        gaya_default["padding_bottom"] = 6.0;
        gaya_default["padding_left"] = 12.0;
        gaya_default["padding_right"] = 12.0;
    } lainnya jika tag == "h1" {
        gaya_default["font_size"] = 26.0;
        gaya_default["font_weight"] = "bold";
        gaya_default["margin_top"] = 12.0;
        gaya_default["margin_bottom"] = 12.0;
    } lainnya jika tag == "h2" {
        gaya_default["font_size"] = 20.0;
        gaya_default["font_weight"] = "bold";
        gaya_default["margin_top"] = 10.0;
        gaya_default["margin_bottom"] = 10.0;
    } lainnya jika tag == "p" {
        gaya_default["margin_bottom"] = 8.0;
    } lainnya jika tag == "nav" atau tag == "header" {
        gaya_default["display"] = "flex";
        gaya_default["flex_direction"] = "row";
    }

    kembalikan NodeDOM(id, tag, teks, atribut, [], gaya_default);
}

// ----------------------------------------------------------------------------
// 3. HTML5 PARSER & TREE BUILDER
// ----------------------------------------------------------------------------

fungsi widyabrowser_parse_html(html_str, url_asal) {
    misal root = widyabrowser_buat_node(1, "html", "", {});
    misal head = widyabrowser_buat_node(2, "head", "", {});
    misal body = widyabrowser_buat_node(3, "body", "", {});

    tambah(root.daftar_anak, head);
    tambah(root.daftar_anak, body);

    misal judul_halaman = "Halaman Berdaulat";
    misal total_node = 3;

    // Parsing tag sederhana berbasis tokenisasi delimiter
    // Memproses tag-tag umum seperti title, h1, h2, p, button, input, div, a
    misal pecahan = pisah(html_str, "<");
    misal node_idx = 4;
    misal kontainer_aktif = body;

    untuk frag in pecahan {
        jika panjang(frag) > 0 {
            misal sub_pecah = pisah(frag, ">");
            jika panjang(sub_pecah) >= 1 {
                misal tag_info = sub_pecah[0];
                misal sisa_teks = "";
                jika panjang(sub_pecah) >= 2 {
                    sisa_teks = sub_pecah[1];
                }

                // Cek apakah tag pembuka atau penutup
                jika panjang(tag_info) > 0 dan potong(tag_info, 0, 1) != "/" {
                    // Ekstraksi nama tag dan atribut dasar
                    misal parts_tag = pisah(tag_info, " ");
                    misal nama_tag = huruf_kecil(parts_tag[0]);

                    misal attr_map = {};
                    misal j = 1;
                    untuk attr_dummy dalam [1, 2, 3, 4, 5] {
                        jika j < panjang(parts_tag) {
                            misal attr_part = parts_tag[j];
                            jika panjang(attr_part) > 0 {
                                misal kv = pisah(attr_part, "=");
                                jika panjang(kv) == 2 {
                                    misal k = kv[0];
                                    misal v = kv[1];
                                    // Bersihkan tanda kutip jika ada
                                    v = gabung(pisah(v, "\""), "");
                                    v = gabung(pisah(v, "'"), "");
                                    attr_map[k] = v;
                                }
                            }
                            j = j + 1;
                        }
                    }

                    // Buat node baru
                    jika nama_tag == "title" {
                        judul_halaman = sisa_teks;
                        misal node_title = widyabrowser_buat_node(node_idx, "title", sisa_teks, attr_map);
                        tambah(head.daftar_anak, node_title);
                        node_idx = node_idx + 1;
                        total_node = total_node + 1;
                    } lainnya jika nama_tag != "html" dan nama_tag != "head" dan nama_tag != "body" {
                        misal node_baru = widyabrowser_buat_node(node_idx, nama_tag, sisa_teks, attr_map);
                        tambah(kontainer_aktif.daftar_anak, node_baru);
                        node_idx = node_idx + 1;
                        total_node = total_node + 1;
                    }
                }
            }
        }
    }

    kembalikan PohonDOM(url_asal, judul_halaman, root, total_node, 2.5);
}

// ----------------------------------------------------------------------------
// 4. DOM TRAVERSAL & QUERY SELECTOR ENGINE
// ----------------------------------------------------------------------------

fungsi widyadom_query_selector(node, selector) {
    jika node == nihil { kembalikan nihil; }

    // Evaluasi kecocokan selektor
    misal apakah_cocok = salah;
    jika potong(selector, 0, 1) == "#" {
        // Selektor ID: misal "#tombol_simpan"
        misal id_dicari = potong(selector, 1, panjang(selector));
        jika ada_kunci(node.atribut, "id") dan node.atribut["id"] == id_dicari {
            apakah_cocok = benar;
        }
    } lainnya jika potong(selector, 0, 1) == "." {
        // Selektor Kelas: misal ".kartu_info"
        misal kelas_dicari = potong(selector, 1, panjang(selector));
        jika ada_kunci(node.atribut, "class") dan node.atribut["class"] == kelas_dicari {
            apakah_cocok = benar;
        }
    } lainnya {
        // Selektor Tag: misal "button", "h1", "p"
        jika node.tag == huruf_kecil(selector) {
            apakah_cocok = benar;
        }
    }

    jika apakah_cocok {
        kembalikan node;
    }

    // Rekursif ke anak-anak
    untuk anak in node.daftar_anak {
        misal hasil = widyadom_query_selector(anak, selector);
        jika hasil != nihil {
            kembalikan hasil;
        }
    }

    kembalikan nihil;
}

fungsi widyadom_ambil_teks(node) {
    jika node == nihil { kembalikan ""; }
    misal teks_gabung = node.teks;
    untuk anak in node.daftar_anak {
        misal t = widyadom_ambil_teks(anak);
        jika panjang(t) > 0 {
            jika panjang(teks_gabung) > 0 {
                teks_gabung = teks_gabung + " " + t;
            } lainnya {
                teks_gabung = t;
            }
        }
    }
    kembalikan teks_gabung;
}

// ----------------------------------------------------------------------------
// 5. CSS3 PARSER & CASCADE SPECIFICITY RESOLVER
// ----------------------------------------------------------------------------

fungsi widyabrowser_parse_css(css_str) {
    misal daftar_aturan = [];
    misal blok_aturan = pisah(css_str, "}");

    untuk blok in blok_aturan {
        jika panjang(blok) > 0 dan panjang(pisah(blok, "{")) == 2 {
            misal bagian = pisah(blok, "{");
            misal pemilih_raw = bagian[0];
            misal isi_gaya = bagian[1];

            // Bersihkan whitespace
            misal sel = gabung(pisah(pemilih_raw, " "), "");
            sel = gabung(pisah(sel, "\n"), "");
            sel = gabung(pisah(sel, "\r"), "");

            misal spesifisitas = 1;
            jika potong(sel, 0, 1) == "#" {
                spesifisitas = 100;
            } lainnya jika potong(sel, 0, 1) == "." {
                spesifisitas = 10;
            }

            misal peta_deklarasi = {};
            misal deklarasi_list = pisah(isi_gaya, ";");
            untuk d in deklarasi_list {
                misal kv = pisah(d, ":");
                jika panjang(kv) == 2 {
                    misal prop = gabung(pisah(kv[0], " "), "");
                    prop = gabung(pisah(prop, "\n"), "");
                    misal val = gabung(pisah(kv[1], " "), "");
                    val = gabung(pisah(val, "\n"), "");
                    val = gabung(pisah(val, "\r"), "");
                    peta_deklarasi[prop] = val;
                }
            }

            tambah(daftar_aturan, AturanCSS(sel, spesifisitas, peta_deklarasi));
        }
    }

    kembalikan daftar_aturan;
}

fungsi widyabrowser_terapkan_gaya_node(node, daftar_aturan) {
    jika node == nihil { kembalikan; }

    untuk aturan in daftar_aturan {
        misal apakah_cocok = salah;
        jika aturan.pemilih == "*" atau aturan.pemilih == node.tag {
            apakah_cocok = benar;
        } lainnya jika potong(aturan.pemilih, 0, 1) == "." {
            misal kelas_aturan = potong(aturan.pemilih, 1, panjang(aturan.pemilih));
            jika ada_kunci(node.atribut, "class") dan node.atribut["class"] == kelas_aturan {
                apakah_cocok = benar;
            }
        } lainnya jika potong(aturan.pemilih, 0, 1) == "#" {
            misal id_aturan = potong(aturan.pemilih, 1, panjang(aturan.pemilih));
            jika ada_kunci(node.atribut, "id") dan node.atribut["id"] == id_aturan {
                apakah_cocok = benar;
            }
        }

        jika apakah_cocok {
            untuk k in kunci(aturan.deklarasi) {
                node.gaya_terhitung[k] = aturan.deklarasi[k];
            }
        }
    }

    // Rekursif ke anak-anak
    untuk anak in node.daftar_anak {
        // Pewarisan gaya font dan warna
        anak.gaya_terhitung["color"] = node.gaya_terhitung["color"];
        widyabrowser_terapkan_gaya_node(anak, daftar_aturan);
    }
}

// ----------------------------------------------------------------------------
// 6. LAYOUT & REFLOW GEOMETRY ENGINE (BOX MODEL & COORDINATES)
// ----------------------------------------------------------------------------

fungsi widyabrowser_hitung_tata_letak_rekursif(node, x_awal, y_awal, lebar_tersedia) {
    jika node == nihil { kembalikan nihil; }

    misal x = x_awal + node.gaya_terhitung["margin_left"];
    misal y = y_awal + node.gaya_terhitung["margin_top"];
    misal w = lebar_tersedia - node.gaya_terhitung["margin_left"] - node.gaya_terhitung["margin_right"];
    misal h = 30.0; // Tinggi default kotak

    jika node.tag == "h1" {
        h = 42.0;
    } lainnya jika node.tag == "h2" {
        h = 34.0;
    } lainnya jika node.tag == "p" {
        h = 24.0;
    } lainnya jika node.tag == "button" {
        w = 140.0;
        h = 36.0;
    } lainnya jika node.tag == "input" {
        w = 220.0;
        h = 36.0;
    } lainnya jika node.tag == "nav" atau node.tag == "header" {
        h = 56.0;
    }

    misal warna_bg = node.gaya_terhitung["background"];
    jika ada_kunci(node.gaya_terhitung, "background-color") {
        warna_bg = node.gaya_terhitung["background-color"];
    }
    misal warna_txt = node.gaya_terhitung["color"];

    misal kotak = KotakTataLetak(
        node.id_node,
        node.tag,
        node.gaya_terhitung["display"],
        x,
        y,
        w,
        h,
        warna_bg,
        warna_txt,
        node.teks,
        []
    );

    // Hitung posisi anak-anak
    misal kursor_x = x + node.gaya_terhitung["padding_left"];
    misal kursor_y = y + node.gaya_terhitung["padding_top"];

    misal adalah_flex = (node.gaya_terhitung["display"] == "flex" atau node.tag == "nav" atau node.tag == "header");

    untuk anak in node.daftar_anak {
        misal kotak_anak = widyabrowser_hitung_tata_letak_rekursif(anak, kursor_x, kursor_y, w);
        jika kotak_anak != nihil {
            tambah(kotak.daftar_anak_kotak, kotak_anak);
            jika adalah_flex {
                // Aliran horizontal jika flex
                kursor_x = kursor_x + kotak_anak.lebar + 12.0;
            } lainnya {
                // Aliran vertikal normal (Block layout)
                kursor_y = kursor_y + kotak_anak.tinggi + 6.0;
            }
        }
    }

    // Sesuaikan tinggi kontainer jika memiliki anak
    jika panjang(kotak.daftar_anak_kotak) > 0 {
        jika adalah_flex {
            // Tinggi flex mengikuti anak tertinggi
            kotak.tinggi = h;
        } lainnya {
            kotak.tinggi = (kursor_y - y) + node.gaya_terhitung["padding_bottom"];
        }
    }

    kembalikan kotak;
}

// ----------------------------------------------------------------------------
// 7. VECTOR DISPLAY LIST & SVG PAINTER
// ----------------------------------------------------------------------------

fungsi widyabrowser_bangun_daftar_tampilan_rekursif(kotak, daftar_perintah) {
    jika kotak == nihil { kembalikan; }

    // 1. Perintah Latar Belakang (Kotak)
    jika kotak.warna_latar != "transparent" dan kotak.warna_latar != "" {
        tambah(daftar_perintah, PerintahLukis("KOTAK_LATAR", kotak.x, kotak.y, kotak.lebar, kotak.tinggi, kotak.warna_latar, ""));
    }

    // 2. Perintah Garis Tepi (Border Button / Input)
    jika kotak.tag == "button" atau kotak.tag == "input" {
        tambah(daftar_perintah, PerintahLukis("GARIS_TEPI", kotak.x, kotak.y, kotak.lebar, kotak.tinggi, "#38bdf8", ""));
    }

    // 3. Perintah Teks
    jika panjang(kotak.teks_konten) > 0 {
        tambah(daftar_perintah, PerintahLukis("TULIS_TEKS", kotak.x + 8.0, kotak.y + 18.0, kotak.lebar, kotak.tinggi, kotak.warna_teks, kotak.teks_konten));
    }

    // Rekursif ke anak-anak kotak
    untuk anak in kotak.daftar_anak_kotak {
        widyabrowser_bangun_daftar_tampilan_rekursif(anak, daftar_perintah);
    }
}

fungsi widyabrowser_ekspor_svg(daftar_tampilan) {
    misal w = daftar_tampilan.lebar_viewport;
    misal h = daftar_tampilan.tinggi_viewport;

    misal svg = "<svg width=\"" + w + "\" height=\"" + h + "\" viewBox=\"0 0 " + w + " " + h + "\" xmlns=\"http://www.w3.org/2000/svg\" style=\"background: #0f172a;\">\n";

    untuk p in daftar_tampilan.daftar_perintah {
        jika p.perintah == "KOTAK_LATAR" {
            svg = svg + "  <rect x=\"" + p.x + "\" y=\"" + p.y + "\" width=\"" + p.lebar + "\" height=\"" + p.tinggi + "\" fill=\"" + p.warna + "\" rx=\"4\"/>\n";
        } lainnya jika p.perintah == "GARIS_TEPI" {
            svg = svg + "  <rect x=\"" + p.x + "\" y=\"" + p.y + "\" width=\"" + p.lebar + "\" height=\"" + p.tinggi + "\" fill=\"none\" stroke=\"" + p.warna + "\" stroke-width=\"1.5\" rx=\"4\"/>\n";
        } lainnya jika p.perintah == "TULIS_TEKS" {
            svg = svg + "  <text x=\"" + p.x + "\" y=\"" + p.y + "\" fill=\"" + p.warna + "\" font-family=\"sans-serif\" font-size=\"14\">" + p.konten + "</text>\n";
        }
    }

    svg = svg + "</svg>";
    kembalikan svg;
}

// ----------------------------------------------------------------------------
// 8. SOVEREIGN PROTOCOL HANDLER (file://, widya://, https://) & CACHE
// ----------------------------------------------------------------------------

fungsi widyabrowser_navigasi(url, lebar_viewport, tinggi_viewport) {
    misal status_kode = 200;
    misal protokol = "HTTPS";
    misal tipe_konten = "text/html";
    misal sertifikat_did = "DID:SEWIDYA:PUSDATIN-KEMENDIKDASMEN-VERIFIED";
    misal html_konten = "";

    // 0. Sovereign Anti-Tracking & Telemetry Blocker
    misal cek_pelacak = widyabrowser_inspeksi_pelacak_asing(url);
    jika cek_pelacak.apakah_pelacak == benar {
        misal dom_blokir = widyabrowser_parse_html("<html><head><title>Akses Diblokir</title></head><body><h1>Pelacak Asing Diblokir</h1><p>WidyaBrowser Sovereign Shield memblokir telemetri: " + cek_pelacak.nama_pelacak + "</p></body></html>", url);
        misal tata_letak_blokir = widyabrowser_hitung_tata_letak_rekursif(dom_blokir.akar_node, 0.0, 0.0, lebar_viewport);
        misal display_blokir = DaftarTampilan(url, lebar_viewport, tinggi_viewport, [], 0);
        kembalikan ResponBrowser(
            url,
            403,
            "text/html",
            "BLOCKED_TRACKER",
            "SOVEREIGN_SHIELD_ENFORCED",
            dom_blokir,
            tata_letak_blokir,
            display_blokir,
            0.1,
            "DIBLOKIR_PERISAI_PRIVASI"
        );
    }

    // 1. Protokol Kedaulatan widya:// (Internal Sovereign Pages)
    jika potong(url, 0, 8) == "widya://" {
        protokol = "WIDYA_INTERNAL";
        misal rute = potong(url, 8, panjang(url));

        jika rute == "home" atau rute == "" {
            html_konten = "<html><head><title>WidyaPortal Kedaulatan Digital</title></head><body><h1>Selamat Datang di WidyaOS Sovereign Web</h1><p>Peramban web mandiri berstandar nasional tanpa vendor lock-in asing.</p><button id=\"btn_portal\">Buka Portal Belajar</button></body></html>";
        } lainnya jika rute == "arkas" {
            html_konten = "<html><head><title>Konsol Keuangan ARKAS</title></head><body><h1>ARKAS Multi-Dana & BOSP Reguler</h1><p>Buku Kas Umum Digital Terenkripsi W3C DID.</p><button id=\"btn_bku\">Rekonsiliasi Kas</button></body></html>";
        } lainnya jika rute == "widyabase" {
            html_konten = "<html><head><title>WidyaBase Studio</title></head><body><h1>Basis Data Relasional Sovereign</h1><p>Arsitektur High-Throughput & Keamanan Tertinggi.</p></body></html>";
        } lainnya jika rute == "widyastat" {
            html_konten = "<html><head><title>WidyaStat Studio</title></head><body><h1>Studio Statistika Inferensial S3</h1><p>Kaplan-Meier, ADF Unit Root, Granger, & HLM.</p></body></html>";
        } lainnya jika rute == "kedaulatan" atau rute == "pilar" {
            html_konten = "<html><head><title>WidyaOS 7 Pilar Kedaulatan Digital</title></head><body><h1>Ekosistem 7 Pilar Kedaulatan Digital Total</h1><p>WidyaDrive, WidyaMeet, WidyaMail, WidyaGeo, WidyaForge, WidyaOCR, WidyaContainer.</p><button id=\"btn_verifikasi_pilar\">Verifikasi Kedaulatan</button></body></html>";
        } lainnya {
            html_konten = "<html><head><title>Pengaturan Browser</title></head><body><h1>Pengaturan Privasi & Cache Edge</h1><p>Status: Anti-Tracking Aktif, Zero-Telemetri Asing.</p></body></html>";
        }
    }
    // 2. Protokol Berkas Lokal file:// dengan Sandbox Boundary Guard
    lainnya jika potong(url, 0, 7) == "file://" {
        protokol = "FILE";
        misal jalur_berkas = potong(url, 7, panjang(url));
        misal validasi_sandbox = widyabrowser_validasi_path_traversal(jalur_berkas, "c:/widya-lang/widyaos/www");

        jika validasi_sandbox.apakah_diizinkan == salah {
            status_kode = 403;
            html_konten = "<html><head><title>Pelanggaran Sandbox</title></head><body><h1>Akses Sistem Operasi Diblokir</h1><p>" + validasi_sandbox.alasan_penolakan + "</p></body></html>";
        } lainnya {
            html_konten = "<html><head><title>Aplikasi Lokal</title></head><body><h1>Berkas Lokal Offline Terbuka</h1><p>Memuat aplikasi web lokal tanpa internet.</p><button id=\"btn_aksi\">Eksekusi Fitur</button></body></html>";
        }
    }
    // 3. Protokol Standar HTTP / HTTPS
    lainnya {
        protokol = "HTTPS";
        html_konten = "<html><head><title>Halaman Web Edukasi</title></head><body><h1>Portal Pendidikan Nasional</h1><p>Koneksi aman terverifikasi TLS rustls.</p></body></html>";
    }

    // AST XSS Sanitizer: Bersihkan payload sebelum parsing DOM
    misal sanitasi = widyabrowser_sanitasi_html_xss(html_konten);
    html_konten = sanitasi.html_aman;

    // Parsing HTML & Bangun DOM
    misal dom = widyabrowser_parse_html(html_konten, url);

    // Resolusi Layout & Koordinat
    misal tata_letak = widyabrowser_hitung_tata_letak_rekursif(dom.akar_node, 0.0, 0.0, lebar_viewport);

    // Bangun Display List
    misal daftar_perintah = [];
    widyabrowser_bangun_daftar_tampilan_rekursif(tata_letak, daftar_perintah);

    misal display_list = DaftarTampilan(url, lebar_viewport, tinggi_viewport, daftar_perintah, panjang(daftar_perintah));

    kembalikan ResponBrowser(
        url,
        status_kode,
        tipe_konten,
        protokol,
        sertifikat_did,
        dom,
        tata_letak,
        display_list,
        12.4,
        "SUKSES_DIMUAT"
    );
}

// ----------------------------------------------------------------------------
// 9. HEADLESS TEST DRIVER (PENGGANTI TOTAL PLAYWRIGHT / PUPPETEER)
// ----------------------------------------------------------------------------

fungsi widyabrowser_simulasi_klik(respon_browser, selector) {
    jika respon_browser == nihil atau respon_browser.pohon_dom == nihil {
        kembalikan {"sukses": salah, "pesan": "Halaman belum dimuat!"};
    }

    misal target = widyadom_query_selector(respon_browser.pohon_dom.akar_node, selector);
    jika target == nihil {
        kembalikan {"sukses": salah, "pesan": "Elemen tidak ditemukan: " + selector};
    }

    misal aksi = "KLIK_BERHASIL";
    misal teks_target = target.teks;

    kembalikan {
        "sukses": benar,
        "pesan": "Berhasil mengklik elemen " + selector,
        "tag": target.tag,
        "teks": teks_target,
        "aksi": aksi
    };
}

fungsi widyabrowser_simulasi_ketik(respon_browser, selector, nilai_baru) {
    jika respon_browser == nihil atau respon_browser.pohon_dom == nihil {
        kembalikan {"sukses": salah, "pesan": "Halaman belum dimuat!"};
    }

    misal target = widyadom_query_selector(respon_browser.pohon_dom.akar_node, selector);
    jika target == nihil {
        kembalikan {"sukses": salah, "pesan": "Elemen input tidak ditemukan: " + selector};
    }

    target.atribut["value"] = nilai_baru;
    target.teks = nilai_baru;

    kembalikan {
        "sukses": benar,
        "pesan": "Nilai input berhasil diperbarui",
        "nilai": nilai_baru
    };
}
