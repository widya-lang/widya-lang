# ──────────────────────────────────────────────────────────────
# .env.example — Template Environment Variables Kantor Digital
# ──────────────────────────────────────────────────────────────
# SALIN file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke Git (sudah ada di .gitignore)

# ── Telegram Bot Gateway ──
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dapatkan chat_id dari @userinfobot di Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── WhatsApp Gateway (Opsional / Fonnte) ──
WHATSAPP_API_TOKEN=your_fonnte_token_here
WHATSAPP_NOMOR_TUJUAN=6281234567890

# ── Port & Database (Opsional) ──
PORT=8085
HMAC_KEY=your_secure_hmac_secret_salt_here

# ── Cara Mengaktifkan (Linux / Bash) ──
# export TELEGRAM_BOT_TOKEN="token-anda"
# export TELEGRAM_CHAT_ID="id-anda"
# ./target/release/widya jalankan.wya
#
# ── Cara Mengaktifkan (Windows PowerShell) ──
# $env:TELEGRAM_BOT_TOKEN = "token-anda"
# $env:TELEGRAM_CHAT_ID   = "chat-id-anda"
# widya.exe jalankan.wya
