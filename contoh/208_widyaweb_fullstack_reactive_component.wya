// ============================================================================
// CONTOH 208: WIDYAWEB FULLSTACK REACTIVE COMPONENT (SSR + HYDRATION)
// Bahasa Pemrograman Widya (Widya-lang)
//
// Konsep Komponen Reaktif Fullstack terinspirasi dari Phoenix LiveView & SvelteKit:
// 1. Server-Side Rendering (SSR) awal menghasilkan HTML lengkap + Token Anti-Tampering.
// 2. Browser terhidrasi instan melalui koneksi WebSocket RFC 6455 tanpa REST/JSON manual.
// 3. Mutasi state di backend secara real-time merefleksikan perubahan di DOM browser.
// 4. Two-Way Data Binding (w-model) & Event Handlers (w-click, w-input, w-submit).
// 5. Server-Push spontan untuk streaming pembaruan data sensor dan notifikasi.
// ============================================================================

cetak("============================================================================");
cetak("🌐 WIDYAWEB FULLSTACK REACTIVE COMPONENT (SSR + HYDRATION + WS RFC 6455)");
cetak("============================================================================");

// ----------------------------------------------------------------------------
// 1. MEMBUAT KOMPONEN REAKTIF DENGAN STATE AWAL DAN TEMPLAT HTML
// ----------------------------------------------------------------------------
cetak("\n[PILAR 1] INISIALISASI KOMPONEN REAKTIF (BACKEND STATE + TEMPLATE):");

var state_awal = {
    "hitung": 10,
    "pengguna": "Budi Santoso",
    "status_koneksi": "Terhubung via RFC 6455",
    "saldo": 1500000
};

var templat_html = "<div class=\"p-6 bg-slate-900 text-white rounded-xl shadow-lg\">\n" +
"    <h1 class=\"text-2xl font-bold\">Dasbor Reaktif: {{pengguna}}</h1>\n" +
"    <p class=\"text-slate-400\">Status: {{status_koneksi}}</p>\n" +
"    <div class=\"my-4 p-4 bg-slate-800 rounded-lg\">\n" +
"        <span class=\"text-lg\">Counter Real-time: </span>\n" +
"        <span id=\"counter-val\" class=\"text-3xl font-extrabold text-cyan-400\">{{hitung}}</span>\n" +
"    </div>\n" +
"    <div class=\"flex gap-3\">\n" +
"        <button w-click=\"tambah\" class=\"px-4 py-2 bg-blue-600 rounded-lg\">+ Tambah</button>\n" +
"        <button w-click=\"kurang\" class=\"px-4 py-2 bg-red-600 rounded-lg\">- Kurang</button>\n" +
"        <button w-click=\"reset\" class=\"px-4 py-2 bg-gray-600 rounded-lg\">Reset</button>\n" +
"    </div>\n" +
"</div>";

var komponen = web_komponen_reaktif_buat("DasborReaktifUtama", state_awal, templat_html);
cetak("    • Komponen Terdaftar : " + komponen["nama"] + " (CID: " + komponen["cid"] + ")");
cetak("    • Protokol Sinkron   : " + komponen["protokol"]);
cetak("    • Token HMAC Hidrasi : " + komponen["mount_token"]);

// ----------------------------------------------------------------------------
// 2. SERVER-SIDE RENDERING (SSR) & TOKEN HIDRASI
// ----------------------------------------------------------------------------
cetak("\n[PILAR 2] SERVER-SIDE RENDERING (SSR INITIAL PAINT):");

var ssr_res = web_komponen_render_ssr(komponen);
cetak("    • Status Hidrasi     : " + ssr_res["status_hidrasi"]);
cetak("    • Latensi Render SSR : " + ssr_res["latensi_render"]);
cetak("    • Cuplikan HTML SSR  :\n" + ssr_res["html_ssr"]);

// ----------------------------------------------------------------------------
// 3. HIDRASI WEBSOCKET RFC 6455 TANPA BOILERPLATE REST
// ----------------------------------------------------------------------------
cetak("\n[PILAR 3] SIMULASI HANDSHAKE & HIDRASI KLIEN BROWSER (RFC 6455):");

var frame_mount = "{\"tipe\":\"mount\",\"cid\":\"" + komponen["cid"] + "\",\"token\":\"" + komponen["mount_token"] + "\"}";
var reply_mount = web_komponen_proses_ws_frame(komponen, frame_mount);
cetak("    • Frame Mount Klien  : " + frame_mount);
cetak("    • Balasan Server     : " + reply_mount["reply_frame"]);

// ----------------------------------------------------------------------------
// 4. EVENT MUTASI STATE (w-click) & SMART DOM MORPHING
// ----------------------------------------------------------------------------
cetak("\n[PILAR 4] MUTASI STATE VIA EVENT w-click (TANPA REST ENDPOINT):");

var frame_click = "{\"tipe\":\"event\",\"cid\":\"" + komponen["cid"] + "\",\"event\":\"tambah\",\"params\":{\"step\":5}}";
var reply_click = web_komponen_proses_ws_frame(komponen, frame_click);
cetak("    • Event Klien Masuk  : w-click=\"tambah\" (step: 5)");
cetak("    • Balasan Patch DOM  : " + reply_click["reply_frame"]);

// ----------------------------------------------------------------------------
// 5. TWO-WAY DATA BINDING (w-model / w-input)
// ----------------------------------------------------------------------------
cetak("\n[PILAR 5] TWO-WAY DATA BINDING (w-model):");

var frame_input = "{\"tipe\":\"input\",\"cid\":\"" + komponen["cid"] + "\",\"model\":\"pengguna\",\"value\":\"Dewi Sartika\"}";
var reply_input = web_komponen_proses_ws_frame(komponen, frame_input);
cetak("    • Input Browser      : w-model=\"pengguna\" -> \"Dewi Sartika\"");
cetak("    • Hasil Patch DOM    : " + reply_input["reply_frame"]);

// ----------------------------------------------------------------------------
// 6. SERVER-PUSH SPONTAN (REAL-TIME SENSOR / TELEMETRI)
// ----------------------------------------------------------------------------
cetak("\n[PILAR 6] SERVER-PUSH SPONTAN (BACKGROUND TELEMETRY PUSH):");

var push_res = web_komponen_push_state(komponen, {
    "status_koneksi": "Sensor IoT Aktif (99.98% SLA)",
    "hitung": 42
});
cetak("    • Status Push        : " + push_res["status"] + " (Versi: " + ke_teks(push_res["versi"]) + ")");
cetak("    • DOM Ter-update     : Terkirim instan ke browser tanpa permintaan fetch()");

// ----------------------------------------------------------------------------
// 7. RUNTIME CLIENT JAVASCRIPT
// ----------------------------------------------------------------------------
cetak("\n[PILAR 7] RUNTIME CLIENT JAVASCRIPT (< 3 KB ZERO-DEPENDENCY):");
var klien_js = web_komponen_klien_script();
cetak("    • Ukuran Script      : ~" + ke_teks(panjang(klien_js)) + " karakter (Murni Vanilla JS)");
cetak("    • Endpoint LiveView  : /_widya/live (Otomatis Reconnect & Patching)");

cetak("\n============================================================================");
cetak("✨ POLA FULLSTACK REACTIVE COMPONENT WIDYAWEB 100% BERFUNGSI SEMPURNA!");
cetak("============================================================================");
