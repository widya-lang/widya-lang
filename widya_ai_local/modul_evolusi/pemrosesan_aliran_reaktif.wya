// Modul Pemrosesan Aliran Reaktif & Complex Event Processing (CEP) Engine
// Mendukung: Stream Filter, Map, Window Tumbling, Agregasi, dan Pemicu Otonom Real-Time.

struktur AturanCEP {
    id_aturan: teks,
    nama_aturan: teks,
    topik_target: teks,
    kondisi_kunci: teks,
    operator: teks,
    nilai_ambang: sembarang,
    tindakan_otonom: teks,
    tingkat_kritis: teks
}

struktur SinyalPeringatanCEP {
    id_peringatan: teks,
    id_aturan: teks,
    nama_aturan: teks,
    tingkat_kritis: teks,
    pesan: teks,
    tindakan_otonom: teks,
    data_pemicu: map,
    waktu_deteksi: bulat
}

// Inisialisasi Mesin CEP Reaktif
fungsi cep_buat_mesin() {
    kembalikan {
        "daftar_aturan": [],
        "riwayat_peringatan": [],
        "total_event_diproses": 0,
        "total_anomali_terdeteksi": 0
    };
}

// Mendaftarkan Aturan Baru ke Mesin CEP
fungsi cep_tambah_aturan(mesin_cep, aturan) {
    mesin_cep["daftar_aturan"] = tambah(mesin_cep["daftar_aturan"], aturan);
    kembalikan {
        "status": "ATURAN_TERDAFTAR",
        "id_aturan": aturan["id_aturan"],
        "total_aturan": panjang(mesin_cep["daftar_aturan"])
    };
}

// Operator Reaktif: Filter Aliran
fungsi aliran_filter(daftar_records, kunci_payload, operator, nilai_ambang) {
    var hasil = [];
    var i = 0;
    var total = panjang(daftar_records);
    
    selama (i < total) {
        var rec = daftar_records[i];
        var payload = rec["payload"];
        jika (ada_kunci(payload, kunci_payload)) {
            var val = payload[kunci_payload];
            var lolos = salah;
            
            jika (operator == ">") {
                jika (val > nilai_ambang) { lolos = benar; }
            } lainnya jika (operator == ">=") {
                jika (val >= nilai_ambang) { lolos = benar; }
            } lainnya jika (operator == "<") {
                jika (val < nilai_ambang) { lolos = benar; }
            } lainnya jika (operator == "<=") {
                jika (val <= nilai_ambang) { lolos = benar; }
            } lainnya jika (operator == "==") {
                jika (val == nilai_ambang) { lolos = benar; }
            }
            
            jika (lolos) {
                hasil = tambah(hasil, rec);
            }
        }
        i = i + 1;
    }
    
    kembalikan hasil;
}

// Operator Reaktif: Map Aliran (Ekstraksi Bidang)
fungsi aliran_map(daftar_records, kunci_ambil) {
    var hasil = [];
    var i = 0;
    var total = panjang(daftar_records);
    
    selama (i < total) {
        var rec = daftar_records[i];
        var payload = rec["payload"];
        jika (ada_kunci(payload, kunci_ambil)) {
            hasil = tambah(hasil, payload[kunci_ambil]);
        }
        i = i + 1;
    }
    
    kembalikan hasil;
}

// Operator Reaktif: Window Tumbling Berbasis Jumlah Event
fungsi aliran_window_tumbling(daftar_records, ukuran_jendela) {
    jika (ukuran_jendela <= 0) {
        ukuran_jendela = 1;
    }
    
    var daftar_jendela = [];
    var jendela_aktif = [];
    var i = 0;
    var total = panjang(daftar_records);
    
    selama (i < total) {
        jendela_aktif = tambah(jendela_aktif, daftar_records[i]);
        
        jika (panjang(jendela_aktif) == ukuran_jendela) {
            daftar_jendela = tambah(daftar_jendela, jendela_aktif);
            jendela_aktif = [];
        }
        
        i = i + 1;
    }
    
    // Tambahkan jendela sisa jika ada
    jika (panjang(jendela_aktif) > 0) {
        daftar_jendela = tambah(daftar_jendela, jendela_aktif);
    }
    
    kembalikan daftar_jendela;
}

// Operator Reaktif: Agregasi Nilai Numerik dalam Jendela
fungsi aliran_agregasi(jendela_records, kunci_payload, jenis_agregasi) {
    var nilai_list = aliran_map(jendela_records, kunci_payload);
    var count = panjang(nilai_list);
    
    jika (count == 0) {
        kembalikan 0;
    }
    
    var sum = 0;
    var max_val = nilai_list[0];
    var min_val = nilai_list[0];
    var i = 0;
    
    selama (i < count) {
        var v = nilai_list[i];
        sum = sum + v;
        jika (v > max_val) { max_val = v; }
        jika (v < min_val) { min_val = v; }
        i = i + 1;
    }
    
    jika (jenis_agregasi == "SUM") {
        kembalikan sum;
    } lainnya jika (jenis_agregasi == "AVG") {
        kembalikan sum / count;
    } lainnya jika (jenis_agregasi == "MAX") {
        kembalikan max_val;
    } lainnya jika (jenis_agregasi == "MIN") {
        kembalikan min_val;
    } lainnya jika (jenis_agregasi == "COUNT") {
        kembalikan count;
    }
    
    kembalikan sum;
}

// Evaluasi Aliran Event dengan Mesin CEP Terhadap Seluruh Aturan Terdaftar
fungsi cep_proses_stream(mesin_cep, daftar_records) {
    var peringatan_baru = [];
    var total_records = panjang(daftar_records);
    mesin_cep["total_event_diproses"] = mesin_cep["total_event_diproses"] + total_records;
    
    var r_idx = 0;
    var total_aturan = panjang(mesin_cep["daftar_aturan"]);
    
    selama (r_idx < total_aturan) {
        var aturan = mesin_cep["daftar_aturan"][r_idx];
        
        // Filter event berdasarkan topik dan kriteria aturan
        var i = 0;
        selama (i < total_records) {
            var rec = daftar_records[i];
            
            // Periksa apakah topik cocok
            jika (rec["topik"] == aturan["topik_target"]) {
                var payload = rec["payload"];
                var kunci = aturan["kondisi_kunci"];
                
                jika (ada_kunci(payload, kunci)) {
                    var val = payload[kunci];
                    var terpicu = salah;
                    var ambang = aturan["nilai_ambang"];
                    
                    jika (aturan["operator"] == ">" dan val > ambang) {
                        terpicu = benar;
                    } lainnya jika (aturan["operator"] == ">=" dan val >= ambang) {
                        terpicu = benar;
                    } lainnya jika (aturan["operator"] == "<" dan val < ambang) {
                        terpicu = benar;
                    } lainnya jika (aturan["operator"] == "<=" dan val <= ambang) {
                        terpicu = benar;
                    } lainnya jika (aturan["operator"] == "==" dan val == ambang) {
                        terpicu = benar;
                    }
                    
                    jika (terpicu) {
                        var id_warn = "warn_" + aturan["id_aturan"] + "_" + ke_teks(waktu()) + "_" + ke_teks(i);
                        var pesan_teks = "Peringatan CEP: " + aturan["nama_aturan"] + " terdeteksi pada nilai " + ke_teks(val) + " (ambang: " + ke_teks(ambang) + ")";
                        
                        var sinyal = {
                            "id_peringatan": id_warn,
                            "id_aturan": aturan["id_aturan"],
                            "nama_aturan": aturan["nama_aturan"],
                            "tingkat_kritis": aturan["tingkat_kritis"],
                            "pesan": pesan_teks,
                            "tindakan_otonom": aturan["tindakan_otonom"],
                            "data_pemicu": payload,
                            "waktu_deteksi": waktu()
                        };
                        
                        peringatan_baru = tambah(peringatan_baru, sinyal);
                        mesin_cep["riwayat_peringatan"] = tambah(mesin_cep["riwayat_peringatan"], sinyal);
                        mesin_cep["total_anomali_terdeteksi"] = mesin_cep["total_anomali_terdeteksi"] + 1;
                    }
                }
            }
            
            i = i + 1;
        }
        
        r_idx = r_idx + 1;
    }
    
    kembalikan {
        "event_diproses": total_records,
        "peringatan_dihasilkan": panjang(peringatan_baru),
        "daftar_peringatan": peringatan_baru,
        "status": "SELESAI_EVALUASI_CEP"
    };
}
