// =================================================================
// Modul PPDB Online Zonasi Geospasial & Dynamic Quota Tuning
// (Adopsi MOD-09: Seleksi Berbasis GPS Haversine, Spillover & Auto-Dapodik)
// =================================================================

struktur KoordinatGPS {
    lintang,
    bujur
}

struktur CalonSiswaPPDB {
    no_pendaftaran,
    nisn,
    nik,
    nama,
    jalur_pendaftaran, // ZONASI, AFIRMASI, PERPINDAHAN_TUGAS, PRESTASI
    koordinat_rumah,
    jarak_meter,
    nilai_prestasi,
    status_seleksi // MENUNGGU, DITERIMA, TERSINGKIR, CADANGAN
}

struktur KonfigurasiKuotaPPDB {
    total_daya_tampung,
    persen_zonasi,
    persen_afirmasi,
    persen_perpindahan,
    persen_prestasi
}

// -------------------------------------------------------------
// [1] Perhitungan Jarak Geospasial GPS Presisi Meter (Haversine)
// -------------------------------------------------------------
fungsi ppdb_hitung_jarak_haversine(titik_sekolah, titik_rumah) {
    misal rad = PI / 180.0;
    misal r_bumi_meter = 6371000.0;
    
    misal d_lat = (titik_rumah.lintang - titik_sekolah.lintang) * rad;
    misal d_lon = (titik_rumah.bujur - titik_sekolah.bujur) * rad;
    
    misal lat1_rad = titik_sekolah.lintang * rad;
    misal lat2_rad = titik_rumah.lintang * rad;
    
    misal sin_dlat_setengah = sin(d_lat / 2.0);
    misal sin_dlon_setengah = sin(d_lon / 2.0);
    
    misal a = (sin_dlat_setengah * sin_dlat_setengah) +
              (cos(lat1_rad) * cos(lat2_rad) * sin_dlon_setengah * sin_dlon_setengah);
              
    // Aproksimasi sudut untuk jarak radius perkotaan
    misal c = 2.0 * akar(a);
    misal jarak = r_bumi_meter * c;
    
    kembalikan bulat(jarak);
}

// -------------------------------------------------------------
// [2] Pendaftaran & Validasi Calon Siswa
// -------------------------------------------------------------
fungsi ppdb_daftarkan_siswa(no_reg, nisn, nik, nama, jalur, koordinat_sekolah, lat_rumah, lon_rumah, skor_prestasi) {
    misal titik_rumah = KoordinatGPS(lat_rumah, lon_rumah);
    misal jarak_m = ppdb_hitung_jarak_haversine(koordinat_sekolah, titik_rumah);
    
    kembalikan CalonSiswaPPDB(
        no_reg,
        nisn,
        nik,
        nama,
        jalur,
        titik_rumah,
        jarak_m,
        skor_prestasi,
        "MENUNGGU"
    );
}

// -------------------------------------------------------------
// [3] Dynamic Quota Tuning & Pelimpahan Sisa Kuota (Spillover)
// -------------------------------------------------------------
fungsi ppdb_hitung_alokasi_kuota(cfg, pendaftar_perpindahan) {
    misal kuota_zonasi = lantai((cfg.total_daya_tampung * cfg.persen_zonasi) / 100);
    misal kuota_afirmasi = lantai((cfg.total_daya_tampung * cfg.persen_afirmasi) / 100);
    misal kuota_perpindahan = lantai((cfg.total_daya_tampung * cfg.persen_perpindahan) / 100);
    misal kuota_prestasi = cfg.total_daya_tampung - (kuota_zonasi + kuota_afirmasi + kuota_perpindahan);
    
    // Spillover: Jika pendaftar perpindahan tugas lebih sedikit dari kuota,
    // sisa kursi otomatis dilimpahkan ke Jalur Zonasi
    misal sisa_perpindahan = 0;
    jika pendaftar_perpindahan < kuota_perpindahan {
        sisa_perpindahan = kuota_perpindahan - pendaftar_perpindahan;
        kuota_perpindahan = pendaftar_perpindahan;
        kuota_zonasi = kuota_zonasi + sisa_perpindahan;
    }
    
    kembalikan {
        "zonasi": kuota_zonasi,
        "afirmasi": kuota_afirmasi,
        "perpindahan": kuota_perpindahan,
        "prestasi": kuota_prestasi,
        "spillover_ke_zonasi": sisa_perpindahan
    };
}

// -------------------------------------------------------------
// [4] Eksekusi Seleksi Zonasi Berdasarkan Jarak Terdekat
// -------------------------------------------------------------
fungsi ppdb_seleksi_zonasi(daftar_pendaftar, kapasitas_zonasi) {
    // Siswa dengan jarak terkecil dinyatakan diterima
    misal jumlah_diterima = 0;
    
    // Asumsikan daftar_pendaftar telah diurutkan berdasarkan jarak terkecil
    untuk s dalam daftar_pendaftar {
        jika s.jalur_pendaftaran == "ZONASI" {
            jika jumlah_diterima < kapasitas_zonasi {
                s.status_seleksi = "DITERIMA";
                jumlah_diterima = jumlah_diterima + 1;
            } lainnya {
                s.status_seleksi = "TERSINGKIR";
            }
        }
    }
    
    kembalikan jumlah_diterima;
}
