# ==============================================================================
# Konfigurasi Caddy Web Server untuk widya-lang.org
# Caddy secara otomatis mengurus sertifikat SSL Let's Encrypt (Zero-Config HTTPS)
# ==============================================================================

widya-lang.org, www.widya-lang.org {
    root * /var/www/widya-lang.org
    file_server

    # Redirection www to apex
    @www host www.widya-lang.org
    handle @www {
        redir https://widya-lang.org{uri} permanent
    }

    # Kompresi Otomatis (Zstandard & Gzip)
    encode zstd gzip

    # Header Keamanan
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Clean URLs fallback
    try_files {path} {path}.html {path}/ =404

    # Unduhan Rilis
    @downloads path /downloads/*
    header @downloads {
        Cache-Control "public, max-age=604800, immutable"
    }

    # Cache Aset Statis
    @static path *.css *.js *.svg *.ico *.woff2
    header @static {
        Cache-Control "public, max-age=2592000"
    }

    log {
        output file /var/log/caddy/widya-lang.access.log
    }
}
