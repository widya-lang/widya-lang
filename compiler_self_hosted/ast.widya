// ============================================================================
// compiler_self_hosted/ast.widya
// Modul Representasi Pohon Sintaksis Abstrak (Abstract Syntax Tree / AST)
// Mandiri dalam Bahasa Widya-Lang
// ============================================================================

struktur NodeAST {
    jenis,
    nilai,
    anak,

    fungsi tambah_anak(node) {
        tambah(ini.anak, node);
    }

    fungsi jumlah_anak() {
        kembalikan panjang(ini.anak);
    }

    fungsi ke_teks() {
        kembalikan "(" + ini.jenis + ": " + ini.nilai + " [anak: " + ke_teks(panjang(ini.anak)) + "])";
    }
}

fungsi buat_node(jenis, nilai) {
    kembalikan NodeAST(jenis, nilai, []);
}

fungsi buat_node_program() {
    kembalikan buat_node("PROGRAM", "root");
}

fungsi buat_node_fungsi(nama, params_str, tubuh_node) {
    misal fn_node = buat_node("FUNGSI", nama + "(" + params_str + ")");
    fn_node.tambah_anak(tubuh_node);
    kembalikan fn_node;
}

fungsi buat_node_variabel(nama, expr_init) {
    misal var_node = buat_node("VARIABEL", nama);
    var_node.tambah_anak(expr_init);
    kembalikan var_node;
}

fungsi buat_node_jika(kondisi_node, blok_jika, blok_lainnya) {
    misal jika_node = buat_node("JIKA", "cabang");
    jika_node.tambah_anak(kondisi_node);
    jika_node.tambah_anak(blok_jika);
    jika blok_lainnya != kosong {
        jika_node.tambah_anak(blok_lainnya);
    }
    kembalikan jika_node;
}

fungsi buat_node_selama(kondisi_node, tubuh_node) {
    misal loop_node = buat_node("SELAMA", "loop");
    loop_node.tambah_anak(kondisi_node);
    loop_node.tambah_anak(tubuh_node);
    kembalikan loop_node;
}

fungsi buat_node_kembalikan(expr_node) {
    misal ret_node = buat_node("KEMBALIKAN", "return");
    ret_node.tambah_anak(expr_node);
    kembalikan ret_node;
}

fungsi buat_node_biner(operator_str, kiri_node, kanan_node) {
    misal bin_node = buat_node("BINER", operator_str);
    bin_node.tambah_anak(kiri_node);
    bin_node.tambah_anak(kanan_node);
    kembalikan bin_node;
}

fungsi buat_node_literal(jenis_lit, nilai_lit) {
    kembalikan buat_node("LITERAL_" + jenis_lit, nilai_lit);
}

fungsi buat_node_identifier(nama_id) {
    kembalikan buat_node("IDENTIFIER", nama_id);
}

fungsi buat_node_panggilan(nama_fn, daftar_argumen) {
    misal call_node = buat_node("PANGGILAN", nama_fn);
    misal i = 0;
    selama i < panjang(daftar_argumen) {
        call_node.tambah_anak(daftar_argumen[i]);
        i = i + 1;
    }
    kembalikan call_node;
}

fungsi uji_ast() {
    misal prog = buat_node_program();
    misal lit_a = buat_node_literal("ANGKA", "10");
    misal lit_b = buat_node_literal("ANGKA", "20");
    misal bin = buat_node_biner("+", lit_a, lit_b);
    misal ret = buat_node_kembalikan(bin);
    misal fn_tambah = buat_node_fungsi("tambah", "a, b", ret);
    prog.tambah_anak(fn_tambah);

    jika prog.jumlah_anak() == 1 {
        kembalikan "AST_OK";
    }
    kembalikan "AST_GALAT";
}

// Jalankan self-test
uji_ast();
