// ============================================================================
// SIMULASI: WIDYACAD & WIDYA3D STUDIO ENGINE (simulasi_widyacad_3d_engine.wya)
// Uji Komprehensif Gambar Teknik 2D, Pemodelan 3D Solid, & 3D Printing G-code
// ============================================================================

impor "widyaos/modul/widyacad_3d_engine.wya";

fungsi assert_wcad(kondisi, nama_tes) {
    jika (kondisi) {
        cetak("[PASS] " + nama_tes);
    } lainnya {
        cetak("[FAIL] " + nama_tes);
    }
}

fungsi utama() {
    cetak("======================================================================");
    cetak("MEMULAI SIMULASI WIDYACAD & 3D STUDIO ENGINE (SETARA AUTOCAD/SOLIDWORKS)");
    cetak("======================================================================");

    // ------------------------------------------------------------------------
    // TES 1: Inisialisasi Proyek CAD
    // ------------------------------------------------------------------------
    misal proyek = wcad_buat_proyek("cad_smk_01", "Rancangan_Blok_Silinder_Mesin", "1:1", "MM");
    assert_wcad(proyek.id_proyek == "cad_smk_01", "Tes 1.1: ID proyek CAD terdaftar");
    assert_wcad(proyek.satuan == "MM" && proyek.skala == "1:1", "Tes 1.2: Satuan milimeter skala 1:1");

    // ------------------------------------------------------------------------
    // TES 2: Entitas CAD 2D Garis & Lingkaran
    // ------------------------------------------------------------------------
    misal g1 = wcad_tambah_garis(proyek, "g_01", 0.0, 0.0, 100.0, 0.0, "0", "#ffffff", 2.0);
    misal c1 = wcad_tambah_lingkaran(proyek, "c_01", 50.0, 50.0, 25.0, "0", "#38bdf8", 1.5);
    assert_wcad(g1.jenis_entitas == "GARIS" && g1.x2 == 100.0, "Tes 2.1: Garis 2D 100mm terbuat");
    assert_wcad(c1.jenis_entitas == "LINGKARAN" && c1.radius == 25.0, "Tes 2.2: Lingkaran radius 25mm terbuat");

    // ------------------------------------------------------------------------
    // TES 3: Dimensi Ukuran Linear
    // ------------------------------------------------------------------------
    misal dim1 = wcad_tambah_dimensi_linear(proyek, "d_01", 0.0, 0.0, 100.0, 0.0, "100.0 mm");
    assert_wcad(dim1.teks_dimensi == "100.0 mm", "Tes 3: Dimensi linear teknis terpasang");

    // ------------------------------------------------------------------------
    // TES 4: Pemodelan 3D Solid Kubus
    // ------------------------------------------------------------------------
    misal kubus = wcad_buat_kubus_3d(proyek, "k_01", "Blok_Dasar", 0.0, 0.0, 0.0, 100.0, 100.0, 50.0, "#64748b");
    assert_wcad(kubus.tipe_primitif == "KUBUS", "Tes 4.1: Primitif 3D kubus terbentuk");
    assert_wcad(kubus.volume_mm3 == 500000.0, "Tes 4.2: Volume kubus (100*100*50) = 500.000 mm3");

    // ------------------------------------------------------------------------
    // TES 5: Pemodelan 3D Solid Silinder
    // ------------------------------------------------------------------------
    misal silinder = wcad_buat_silinder_3d(proyek, "s_01", "Lubang_Piston", 50.0, 50.0, 0.0, 20.0, 50.0, "#0284c7");
    assert_wcad(silinder.tipe_primitif == "SILINDER", "Tes 5.1: Primitif 3D silinder terbentuk");
    assert_wcad(silinder.volume_mm3 > 62000.0, "Tes 5.2: Volume silinder pi*r^2*t terhitung akurat");

    // ------------------------------------------------------------------------
    // TES 6: Operasi Boolean Solid (UNION)
    // ------------------------------------------------------------------------
    misal bool_union = wcad_operasi_boolean_3d(kubus, silinder, "UNION");
    assert_wcad(bool_union.volume_mm3 > kubus.volume_mm3, "Tes 6: Operasi Boolean UNION menggabungkan volume kedua benda solid");

    // ------------------------------------------------------------------------
    // TES 7: Operasi Boolean Solid (DIFFERENCE - Pemotongan Lubang)
    // ------------------------------------------------------------------------
    misal bool_diff = wcad_operasi_boolean_3d(kubus, silinder, "DIFFERENCE");
    assert_wcad(bool_diff.volume_mm3 < kubus.volume_mm3, "Tes 7: Operasi Boolean DIFFERENCE mengurangi volume untuk membuat rongga");

    // ------------------------------------------------------------------------
    // TES 8: Pembangkitan G-code 3D Printing SMK
    // ------------------------------------------------------------------------
    misal gcode = wcad_bangkitkan_gcode(proyek, 210, 60, 0.2);
    assert_wcad(panjang(gcode) > 100, "Tes 8.1: Sintaks G-code tergenerasi lengkap");
    assert_wcad(proyek.segel_w3c_did == "did:widya:cad:arsitek-smk", "Tes 8.2: Segel W3C DID arsitek SMK tersemat pada header G-code");

    // ------------------------------------------------------------------------
    // TES 9: Ekspor Berkas 3D STL ASCII
    // ------------------------------------------------------------------------
    misal stl = wcad_ekspor_stl_ascii(proyek);
    assert_wcad(panjang(stl) > 50, "Tes 9: Berkas STL ASCII siap manufaktur terbentuk");

    // ------------------------------------------------------------------------
    // TES 10: Validasi Integritas Proyek CAD
    // ------------------------------------------------------------------------
    assert_wcad(panjang(proyek.daftar_entitas_2d) == 3 && panjang(proyek.daftar_objek_3d) == 2, "Tes 10: Konsistensi daftar entitas 2D dan 3D terverifikasi");

    cetak("======================================================================");
    cetak("SELURUH PENGUJIAN WIDYACAD & 3D STUDIO SELESAI (10/10 PASS)");
    cetak("======================================================================");
}

utama();
