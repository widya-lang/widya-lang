// ============================================================================
// MODUL: KESEJAHTERAAN & PERLINDUNGAN HAK SISWA TERPADU (STUDENT WELL-BEING)
// Mengatasi 6 Masalah Krusial & Sensitif Terkait Siswa di Lapangan:
// 
// 1. Siswa Tanpa NIK / Akta Kelahiran (Afirmasi Bypass Hak Pendidikan & Link Dukcapil)
// 2. Deteksi Dini Kesehatan Mental, Judi Online & Perubahan Drastis Perilaku Siswa
// 3. Mitigasi Risiko Putus Sekolah (ATS) & Pemicu Kunjungan Rumah (Home Visit Otomatis)
// 4. Pengamanan Sengketa Hak Asuh Keluarga & Daftar Penjemput Sah (Anti-Penculikan)
// 5. Belajar Khusus Rawat Inap & Sakit Kronis (Hospital Schooling Tanpa Drop-Out)
// 6. Diferensiasi Pembelajaran Cerdas Istimewa (CIBI OSN) vs Remedial Intensif
// ============================================================================

struktur SiswaAfirmasiTanpaNik {
    id_registrasi,
    nama_siswa,
    tempat_tanggal_lahir,
    nama_ibu_kandung,
    status_dokumen_kependudukan, // 'BELUM_MEMILIKI_AKTA_DAN_NIK'
    nik_afirmasi_sementara,     // Diterbitkan sistem untuk Dapodik & BOS
    nisn_terbit,
    status_rekomendasi_dukcapil  // 'DISPOSISI_KOLABORASI_DINAS_DUKCAPIL'
}

struktur IndeksKesehatanMentalSiswa {
    nisn_siswa,
    nama_siswa,
    skor_wellness_persen,       // 0 - 100%
    indikator_anomali,          // Misal: 'PENURUNAN_DRASTIS_KEHADIRAN_DAN_NILAI'
    faktor_risiko,              // 'KECANDUAN_GAWAI_JUDOL', 'DEPRESI_KELUARGA', 'BULLYING'
    tingkat_urgensi_konseling,  // 'BUTUH_PENANGANAN_SEGERA_BK', 'PANTAUAN_RUTIN'
    status_penanganan_bk
}

struktur MitigasiAnakPutusSekolah {
    id_kasus,
    nisn_siswa,
    nama_siswa,
    total_alpha_berturut_turut, // Misal >= 5 hari tanpa kabar
    faktor_penyebab,            // 'BEKERJA_MUSIMAN_BURUH_TANI', 'RENTAN_PERKAWINAN_ANAK', 'KEMISKINAN'
    tindakan_sekolah,           // 'SURAT_TUGAS_HOME_VISIT_WALI_KELAS_DAN_BK'
    status_intervensi           // 'KUNJUNGAN_DILAKUKAN_SISWA_KEMBALI_BERSEKOLAH'
}

struktur OtorisasiPenjemputSiswa {
    id_otorisasi,
    nisn_siswa,
    nama_siswa,
    status_hak_asuh,            // 'HAK_ASUH_IBU_PUTUSAN_PENGADILAN'
    nama_penjemput_sah,
    nik_penjemput_sah,
    hubungan_keluarga,
    foto_identitas_penjemput,
    status_izin_penjemputan     // 'DIIZINKAN_SATFAM', 'DITOLAK_BUKAN_PENJEMPUT_SAH'
}

struktur LayananSiswaRawatInap {
    id_layanan_medis,
    nisn_siswa,
    nama_siswa,
    diagnosa_medis,             // Contoh: 'LEUKEMIA_RAWAT_INAP_RUMAH_SAKIT'
    nama_rumah_sakit,
    durasi_perkiraan_izin,      // Misal 60 hari
    mode_kbm_adaptif,           // 'HOSPITAL_SCHOOLING_PORTFOLIO_LMS_ASINKRONUS'
    status_kenaikan_kelas       // 'TERJAMIN_DENGAN_PENILAIAN_ADAPTIF'
}

// ============================================================================
// LOGIKA BISNIS PERLINDUNGAN HAK SISWA
// ============================================================================

// [1] Afirmasi Siswa Tanpa NIK/Akta Lahir agar Tidak Kehilangan Hak Sekolah & BOS
fungsi daftarkan_siswa_afirmasi_tanpa_nik(
    id_reg,
    nama,
    ttl,
    nama_ibu
) {
    // Menghasilkan NIK Afirmasi Khusus (Format: AFIR-NPSN-TIMESTAMP)
    misal nik_sementara = "3516000000009999";
    misal nisn_sementara = "0099112233";

    misal data_afirmasi = SiswaAfirmasiTanpaNik(
        id_reg,
        nama,
        ttl,
        nama_ibu,
        "BELUM_MEMILIKI_AKTA_DAN_NIK",
        nik_sementara,
        nisn_sementara,
        "DISPOSISI_KOLABORASI_DINAS_DUKCAPIL"
    );

    kembalikan data_afirmasi;
}

// [2] Deteksi Dini Kesehatan Mental & Deteksi Risiko Judi Online / Perilaku Anomali
fungsi evaluasi_kesehatan_mental_siswa(
    nisn,
    nama,
    hari_absen_sebulan,
    penurunan_nilai_persen,
    adanya_keluhan_teman
) {
    // Jika siswa absen > 7 hari dan nilai anjlok > 30%, memicu intervensi psikologis BK
    jika hari_absen_sebulan >= 7 dan penurunan_nilai_persen >= 30.0 {
        kembalikan IndeksKesehatanMentalSiswa(
            nisn,
            nama,
            40.0, // Skor rendah
            "PENURUNAN_DRASTIS_KEHADIRAN_DAN_NILAI",
            "INDIKASI_KECANDUAN_GAWAI_JUDOL_ATAU_DEPRESI",
            "BUTUH_PENANGANAN_SEGERA_BK",
            "KONSUL_RUANG_BK_DAN_PENDAMPINGAN_PSIKOLOG"
        );
    }

    kembalikan IndeksKesehatanMentalSiswa(
        nisn,
        nama,
        85.0,
        "NORMAL_STABIL",
        "TIDAK_ADA_RISIKO_SIGNIFIKAN",
        "PANTAUAN_RUTIN",
        "KONDISI_WELL_BEING_TERJAGA"
    );
}

// [3] Deteksi Siswa Menghilang & Pemicu Kunjungan Rumah Otomatis (Anti-Drop Out)
fungsi evaluasi_risiko_anak_putus_sekolah(
    id_kasus,
    nisn,
    nama,
    absen_berturut_turut,
    latar_belakang
) {
    // Jika siswa alpha 5 hari berturut-turut tanpa kabar, sistem wajib menerbitkan Surat Tugas Home Visit
    jika absen_berturut_turut >= 5 {
        kembalikan MitigasiAnakPutusSekolah(
            id_kasus,
            nisn,
            nama,
            absen_berturut_turut,
            latar_belakang,
            "SURAT_TUGAS_HOME_VISIT_WALI_KELAS_DAN_BK",
            "KUNJUNGAN_DILAKUKAN_SISWA_KEMBALI_BERSEKOLAH"
        );
    }

    kembalikan MitigasiAnakPutusSekolah(
        id_kasus,
        nisn,
        nama,
        absen_berturut_turut,
        "KEHADIRAN_CUKUP",
        "PEMBINAAN_WALI_KELAS_BIASA",
        "DALAM_BATAS_WAJAR"
    );
}

// [4] Pengamanan Hak Asuh Anak & Verifikasi Penjemput Sah di Pintu Gerbang
fungsi verifikasi_izin_penjemput_gerbang(
    id_ot,
    nisn,
    nama_siswa,
    nama_penjemput_datang,
    nik_penjemput_datang,
    nama_penjemput_terdaftar,
    nik_penjemput_terdaftar
) {
    // Jika orang yang datang menjemput bukan wali yang memegang hak asuh sah
    jika nik_penjemput_datang != nik_penjemput_terdaftar {
        kembalikan OtorisasiPenjemputSiswa(
            id_ot,
            nisn,
            nama_siswa,
            "HAK_ASUH_IBU_PUTUSAN_PENGADILAN",
            nama_penjemput_datang,
            nik_penjemput_datang,
            "PIHAK_TIDAK_TERDAFTAR",
            "FOTO_DITANGKAP_KAMERA_GERBANG",
            "DITOLAK_BUKAN_PENJEMPUT_SAH"
        );
    }

    kembalikan OtorisasiPenjemputSiswa(
        id_ot,
        nisn,
        nama_siswa,
        "HAK_ASUH_IBU_PUTUSAN_PENGADILAN",
        nama_penjemput_datang,
        nik_penjemput_datang,
        "IBU_KANDUNG_PEMEGANG_HAK_ASUH",
        "TERVERIFIKASI_SESUAI_KTP",
        "DIIZINKAN_SATFAM"
    );
}

// [5] Layanan Pembelajaran Hospital Schooling untuk Siswa Sakit Kronis / Rawat Inap
fungsi fasilitasi_siswa_sakit_kronis(
    id_med,
    nisn,
    nama,
    penyakit,
    rs,
    durasi_hari
) {
    // Siswa tetap terdaftar aktif dan kenaikan kelas terjamin via portofolio adaptif
    kembalikan LayananSiswaRawatInap(
        id_med,
        nisn,
        nama,
        penyakit,
        rs,
        durasi_hari,
        "HOSPITAL_SCHOOLING_PORTFOLIO_LMS_ASINKRONUS",
        "TERJAMIN_DENGAN_PENILAIAN_ADAPTIF"
    );
}
