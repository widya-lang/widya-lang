        misal res_linter = { "lulus": benar, "skor": 100, "pesan": "Tidak ada kode sumber yang divalidasi." };
        jika (kode_uji != "") {
            res_linter = ai_validasi_sintaks_widya(kode_uji);
        }

        kembalikan {
