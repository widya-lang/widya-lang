// ============================================================================
// MODUL: WIDYAGREEN - KOMPUTASI HEMAT ENERGI & PLTS SEKOLAH 3T
// (widyagreen_energi_sekolah.wya)
//
// 1. Sunlight-Adaptive Computing: Penjadwalan Tugas Berat saat Puncak Terik PLTS
// 2. Battery Deep-Discharge Shield: Perlindungan Baterai Dropping (<20%)
// 3. Green Computing Metric: Pelacakan Penghematan Emisi Karbon (Net Zero 2060)
// ============================================================================

struktur StatusDayaPLTS {
    persentase_baterai,
    daya_panel_surya_watt,
    status_pengisian,
    mode_daya_os,
    apakah_aman_komputasi_berat
}

struktur JadwalKomputasiMatahari {
    nama_tugas,
    jam_eksekusi_rekomendasi,
    alasan_penjadwalan,
    status_penjadwalan
}

struktur MetrikJejakKarbon {
    kwh_energi_surya_terpakai,
    kg_co2_ditekan,
    status_efisiensi_hijau
}

// ----------------------------------------------------------------------------
// [1] EVALUASI DAYA PLTS & BATTERY DEEP-DISCHARGE SHIELD
// ----------------------------------------------------------------------------

fungsi widyagreen_evaluasi_daya_plts(baterai_persen, solar_watt, jam_lokal) {
    misal status_isi = "MENGISI_DAYA";
    misal mode_os = "STANDAR_PERFORMA";
    misal aman_berat = salah;

    jika solar_watt > 300 dan jam_lokal >= 10 dan jam_lokal <= 14 {
        status_isi = "PUNCAK_RADIASI_MATAHARI_SURYA";
        mode_os = "MAX_BURST_PERFORMANCE";
        aman_berat = benar;
    } selain_itu jika baterai_persen < 20 {
        // Perlindungan baterai habis total saat mendung berhari-hari di pulau 3T
        status_isi = "BATERAI_KRITIS_PENYELAMATAN_DATA";
        mode_os = "ULTRA_LOW_POWER_ECO_MODE";
        aman_berat = salah;
    } selain_itu {
        status_isi = "KONSUMSI_BATERAI_NORMAL";
        mode_os = "BALANCED_POWER_SAVING";
        aman_berat = salah;
    }

    kembalikan StatusDayaPLTS(
        baterai_persen,
        solar_watt,
        status_isi,
        mode_os,
        aman_berat
    );
}

// ----------------------------------------------------------------------------
// [2] SUNLIGHT-ADAPTIVE COMPUTING SCHEDULER
// ----------------------------------------------------------------------------

fungsi widyagreen_jadwalkan_tugas_komputasi_berat(nama_tugas, jam_lokal) {
    jika jam_lokal >= 10 dan jam_lokal <= 14 {
        kembalikan JadwalKomputasiMatahari(
            nama_tugas,
            jam_lokal,
            "Puncak radiasi surya (>400W) tersedia. Eksekusi langsung tanpa menguras baterai!",
            "EKSEKUSI_SEKETIKA_ENERGI_GRATIS_MATAHARI"
        );
    }

    kembalikan JadwalKomputasiMatahari(
        nama_tugas,
        11,
        "Di luar jam terik matahari. Ditunda ke jam 11:00 untuk melindungi cadangan baterai malam.",
        "DITUNDA_KE_JAM_TERIK_MATAHARI"
    );
}

// ----------------------------------------------------------------------------
// [3] METRIK PENGHEMATAN JEJAK KARBON SEKOLAH
// ----------------------------------------------------------------------------

fungsi widyagreen_hitung_penghematan_karbon(total_watt_hour) {
    misal kwh = total_watt_hour / 1000.0;
    // Standar rata-rata emisi jaringan listrik PLN Indonesia: ~0.85 kg CO2 per kWh
    misal kg_co2 = (kwh * 85.0) / 100.0;

    kembalikan MetrikJejakKarbon(
        kwh,
        kg_co2,
        "BERKONTRIBUSI_PADA_NET_ZERO_EMISSION_INDONESIA_2060"
    );
}
