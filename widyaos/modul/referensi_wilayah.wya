// ==============================================================================
// WIDYAOS: MODUL MASTER REFERENSI WILAYAH ADMINISTRASI PEMERINTAHAN INDONESIA
// Berdasarkan Keputusan Menteri Dalam Negeri (Kepmen) No. 300.2.2-2138 Tahun 2025
// Referensi Dataset: https://github.com/Bakulcoding/wilayah
// Cakupan: 38 Provinsi, 514 Kabupaten/Kota, 7.285 Kecamatan, 83.762 Desa/Kelurahan
// ==============================================================================

struktur WilayahProvinsi {
    kode_provinsi, // 2 digit (e.g. "32", "31", "95")
    nama_provinsi,
    jumlah_kabupaten,
    jumlah_kota,
    jumlah_kecamatan,
    luas_km2,
    jumlah_penduduk
}

struktur WilayahKabupatenKota {
    kode_kab_kota, // 4 digit (e.g. "32.73", "31.71")
    kode_provinsi, // 2 digit
    nama_kab_kota,
    jenis_wilayah, // "Kabupaten", "Kota"
    ibu_kota,
    luas_km2
}

struktur WilayahKecamatan {
    kode_kecamatan, // 6 digit (e.g. "32.73.01")
    kode_kab_kota,  // 4 digit
    kode_provinsi,  // 2 digit
    nama_kecamatan
}

struktur WilayahDesaKelurahan {
    kode_desa,      // 10 digit (e.g. "32.73.01.1001" atau "32.04.05.2001")
    kode_kecamatan, // 6 digit
    kode_kab_kota,  // 4 digit
    kode_provinsi,  // 2 digit
    nama_desa,
    jenis_desa      // "Kelurahan" (kode 1xxx) atau "Desa" (kode 2xxx)
}

struktur ResolusiAlamatLengkap {
    kode_wilayah_10_digit,
    nama_desa_kelurahan,
    jenis_desa,
    nama_kecamatan,
    nama_kabupaten_kota,
    nama_provinsi,
    string_alamat_resmi,
    status_validasi
}

