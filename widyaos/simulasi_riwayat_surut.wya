// ==============================================================================
// WIDYAOS: SIMULASI MANAJEMEN RIWAYAT SISWA BERLAKU SURUT (RETROAKTIF)
// Menguji:
// 1. Input Nilai Rapor Lampau untuk Siswa Mutasi Masuk
// 2. Koreksi Data Pokok Kependudukan Lampau (> 1 Tahun) & Otoritas Disdik
// 3. Rekonstruksi Riwayat Belajar Siswa Drop Out (ATS) yang Kembali Bersekolah
// 4. Audit Trail Kriptografis & Transparansi Tanggal Input vs Tanggal Efektif
// ==============================================================================

impor "widyaos/modul/riwayat_siswa_retroaktif.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === SIMULASI RIWAYAT SISWA BERLAKU SURUT WIDYAOS v1.0 ===      ║");
cetak("║   Akuntabilitas, Rekonstruksi Historis & Guardrail Integritas    ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

// ==============================================================================
// [TEST 1] SISWA PINDAHAN / MUTASI: INPUT NILAI RAPOR SEMESTER LAMPAU
// ==============================================================================
cetak("================================================================");
cetak("[1] Siswa Pindahan: Input Nilai Rapor Semester Lampau");
cetak("================================================================");

misal entri_mutasi_rapor = ajukan_riwayat_berlaku_surut(
    "SRT-2026-MUT-01",
    "0081122334",
    "Rizky Pratama",
    "NILAI_RAPOR_MUTASI_LAMPAU",
    "2023/2024 Semester Ganjil & Genap",
    "2023-12-20", // Tanggal berlaku surut
    "Input susulan nilai rapor Kelas 10 semester 1 & 2 dari sekolah asal SMA Negeri 5 Padang",
    "Rata-rata Rapor: 88.5 (Fisika: 90, Kimia: 87, MTK: 89)",
    "SURAT-MUTASI-421/045/Disdik-Sumbar/2024",
    1 // Jarak 1 semester lampau
);

cetak("📝 Transaksi Berlaku Surut :");
cetak("   ID Transaksi        :", entri_mutasi_rapor.id_transaksi_surut);
cetak("   Peserta Didik       :", entri_mutasi_rapor.nama_siswa, "(NISN:", entri_mutasi_rapor.nisn + ")");
cetak("   Kategori            :", entri_mutasi_rapor.kategori_surut);
cetak("   Masa Efektif Surut  :", entri_mutasi_rapor.tahun_ajaran_efektif, "(Tgl:", entri_mutasi_rapor.tanggal_efektif_surut + ")");
cetak("   Tingkat Otoritas    :", entri_mutasi_rapor.tingkat_otoritas);
cetak("   Status Awal         :", entri_mutasi_rapor.status_approval);

// Verifikasi dan Pengesahan oleh Kepala Sekolah
misal verif_mutasi = verifikasi_riwayat_surut(
    entri_mutasi_rapor,
    benar,
    "did:sewidya:kepsek:20108888",
    "KEPALA_SEKOLAH",
    "Dokumen buku rapor fisik asli berstempel dinas asal lengkap dan sah"
);

cetak("⚖️ Hasil Otorisasi     :", verif_mutasi.status);
cetak("   Keterangan          :", verif_mutasi.keterangan);
cetak("   Segel Hash Audit    :", verif_mutasi.entri_terupdate.hash_audit_kripto);

TOTAL_TEST = TOTAL_TEST + 1;
jika verif_mutasi.status == "BERHASIL_DIPROSES" dan verif_mutasi.entri_terupdate.status_approval == "DISETUJUI_SAH" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Input Nilai Rapor Lampau untuk Siswa Mutasi: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Input Nilai Rapor Lampau untuk Siswa Mutasi: GAGAL");
}

// ==============================================================================
// [TEST 2] KOREKSI DATA POKOK LAMPAU (> 1 TAHUN) DENGAN GUARDRAIL DINAS
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[2] Koreksi Data Pokok Lampau (> 1 Tahun) & Otoritas Disdik");
cetak("================================================================");

// Pengajuan koreksi nama ibu kandung yang salah ketik sejak masuk sekolah 2 tahun lalu
misal entri_koreksi_ibu = ajukan_riwayat_berlaku_surut(
    "SRT-2026-KOR-02",
    "0087654321",
    "Dewi Lestari",
    "KOREKSI_IDENTITAS_LAMPAU",
    "2022/2023 Semester Ganjil",
    "2022-07-15", // Berlaku surut 4 semester ke belakang
    "Pembetulan nama ibu kandung semula 'Siti' menjadi 'Siti Aminah' sesuai Putusan PN No. 12/Pdt.P/2024",
    "Nama Ibu Sah: Siti Aminah | NIK Ibu: 3201015505750001",
    "PENETAPAN-PN-12/Pdt.P/2024",
    4 // Jarak 4 semester (2 tahun) ke belakang
);

cetak("📝 Pengajuan Koreksi Lampau :");
cetak("   Perubahan Diminta   :", entri_koreksi_ibu.uraian_perubahan);
cetak("   Tingkat Otoritas    :", entri_koreksi_ibu.tingkat_otoritas, "(Karena jarak > 1 tahun ajaran)");

// Skenario A: Kepala sekolah mencoba mengesahkan sendiri perubahan > 1 tahun (Ditolak Sistem)
misal coba_sah_kepsek = verifikasi_riwayat_surut(
    entri_koreksi_ibu,
    benar,
    "did:sewidya:kepsek:20108888",
    "KEPALA_SEKOLAH", // Wewenang tidak cukup
    "Disahkan internal"
);
cetak("⚠️ Percobaan Pengesahan Sepihak :");
cetak("   Hasil               :", coba_sah_kepsek.status);
cetak("   Alasan Penolakan    :", coba_sah_kepsek.keterangan);

// Skenario B: Pengesahan resmi oleh Pejabat Dinas Pendidikan Wilayah (Diterima)
misal sah_dinas = verifikasi_riwayat_surut(
    entri_koreksi_ibu,
    benar,
    "did:sewidya:disdik:kabid:001",
    "DINAS_PENDIDIKAN", // Wewenang resmi
    "SK Penetapan Pengadilan Negeri dan Akta Lahir Dukcapil telah divalidasi sah oleh Bidang Pembinaan SMA Disdik"
);
cetak("🏛️ Pengesahan Resmi Dinas Pendidikan :");
cetak("   Hasil               :", sah_dinas.status);
cetak("   Status Approval     :", sah_dinas.entri_terupdate.status_approval);

TOTAL_TEST = TOTAL_TEST + 1;
jika coba_sah_kepsek.status == "DITOLAK_WEWENANG_TIDAK_CUKUP" dan sah_dinas.status == "BERHASIL_DIPROSES" dan sah_dinas.entri_terupdate.status_approval == "DISETUJUI_SAH" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Guardrail Otoritas Perubahan Surut > 1 Tahun (Disdik): LULUS");
} lainnya {
    cetak("❌ [TEST 2] Guardrail Otoritas Perubahan Surut > 1 Tahun (Disdik): GAGAL");
}

// ==============================================================================
// [TEST 3] ANAK TIDAK SEKOLAH (ATS) KEMBALI BERSEKOLAH & REKONSTRUKSI BUKU INDUK
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[3] Rekonstruksi Riwayat Siswa Drop Out (ATS) Kembali Bersekolah");
cetak("================================================================");

// Siswa drop out selama 1 tahun, lalu kembali bersekolah di Sekolah Rakyat
misal daftar_semester = [
    "Semester 1 (2022/2023): TUNTAS",
    "Semester 2 (2022/2023): TUNTAS",
    "Semester 3 (2023/2024): TUNTAS",
    "Semester 4 (2023/2024): TUNTAS (SEBELUM DROP OUT)",
    "Semester 5 (2025/2026): SEDANG DITEMPUH (REAKTIVASI SEKOLAH RAKYAT)"
];

misal buku_induk = susun_rekonstruksi_buku_induk(
    "0089988112",
    "Markus Wandikbo",
    daftar_semester,
    2 // 2 entri susulan surut
);

cetak("📚 Buku Induk Historis :");
cetak("   Peserta Didik       :", buku_induk.nama_siswa, "(NISN:", buku_induk.nisn + ")");
cetak("   Total Semester      :", panjang(buku_induk.daftar_semester_kronologis), "semester terpetakan");
cetak("   Entri Rekonstruksi  :", buku_induk.total_entri_surut, "transaksi berlaku surut");
cetak("   Status Kesiapan     :", buku_induk.status_kelengkapan_ijazah);

TOTAL_TEST = TOTAL_TEST + 1;
jika buku_induk.status_kelengkapan_ijazah == "LENGKAP_TINGKAT_MENENGAH" dan buku_induk.total_entri_surut == 2 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Rekonstruksi Kronologis Historis Siswa Drop Out (ATS): LULUS");
} lainnya {
    cetak("❌ [TEST 3] Rekonstruksi Kronologis Historis Siswa Drop Out (ATS): GAGAL");
}

// ==============================================================================
// [TEST 4] AUDIT TRAIL KRIPTOGRAFIS: WAKTU INPUT FISIK VS WAKTU EFEKTIF SURUT
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[4] Audit Trail Kriptografis Anti-Pemalsuan Nilai / Siswa Siluman");
cetak("================================================================");

cetak("🔒 Transparansi Rekam Jejak Audit :");
cetak("   Waktu Berlaku Surut :", entri_mutasi_rapor.tanggal_efektif_surut, "(Waktu Yuridis Semester Lampau)");
cetak("   Waktu Nyata Diinput :", entri_mutasi_rapor.tanggal_input_riil, "(Stempel Waktu Nyata Transaksi)");
cetak("   ID Transaksi Unik   :", entri_mutasi_rapor.id_transaksi_surut);
cetak("   Verifikator Digital :", verif_mutasi.entri_terupdate.did_pengesah);
cetak("   Hash Kripto Segel   :", verif_mutasi.entri_terupdate.hash_audit_kripto);

TOTAL_TEST = TOTAL_TEST + 1;
jika entri_mutasi_rapor.tanggal_efektif_surut != entri_mutasi_rapor.tanggal_input_riil dan verif_mutasi.entri_terupdate.did_pengesah == "did:sewidya:kepsek:20108888" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 4] Audit Trail Kriptografi Tanggal Input vs Tanggal Efektif: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Audit Trail Kriptografi Tanggal Input vs Tanggal Efektif: GAGAL");
}

// ==============================================================================
// REKAPITULASI EVALUASI
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("HASIL EVALUASI RIWAYAT SISWA BERLAKU SURUT");
cetak("Total Skenario Diuji :", TOTAL_TEST);
cetak("Lulus Verifikasi     :", LULUS_TEST);
cetak("================================================================");

jika LULUS_TEST == TOTAL_TEST {
    cetak("🎉 SEMPURNA! SISTEM INPUT BERLAKU SURUT 100% AMAN & LULUS AUDIT!");
} lainnya {
    cetak("⚠️ ADA SKENARIO YANG BELUM LULUS, SILAKAN PERIKSA LOG DI ATAS.");
}
cetak("");
