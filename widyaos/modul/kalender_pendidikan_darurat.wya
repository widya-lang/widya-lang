// =================================================================
// Modul Kalender Pendidikan & Manajemen Kedaruratan Sekolah (WidyaOS)
// 1. Kalender Pendidikan Nasional & Hari Efektif Belajar (MEB)
// 2. Libur Nasional (SKB 3 Menteri) & Libur Lokal/Fakultatif Daerah
// 3. Protokol PJJ Darurat Bencana (Karhutla, Banjir, Erupsi) & Adaptasi MBG
// =================================================================

struktur EventHariLibur {
    id_libur,
    tanggal,
    nama_libur,
    kategori, // "LIBUR_NASIONAL_SKB3", "LIBUR_FAKULTATIF_LOKAL", "CUTI_BERSAMA", "LIBUR_SEMESTER"
    dasar_hukum,
    kode_wilayah_berlaku // "NASIONAL" atau kode provinsi tertentu (misal: "51" Bali, "91" Papua)
}

struktur ProtokolKedaruratanBencana {
    id_insiden,
    jenis_bencana, // "KARHUTLA_ASAP_PEKAT", "BANJIR_BANDANG", "ERUPSI_VOLKANO", "GEMPA_BUMI"
    nomor_surat_edaran,
    tingkat_bahaya_ispu, // "BERBAHAYA" (ISPU > 300), "SANGAT_TIDAK_SEHAT", "TANGGAP_DARURAT"
    tanggal_mulai,
    tanggal_selesai,
    mode_kbm, // "PJJ_DARING_PENUH", "HYBRID_TERBATAS"
    kebijakan_presensi, // "DARING_BYPASS_GEOFENCE"
    adaptasi_mbg, // "DISTRIBUSI_PAKET_NUTRISI_KERING_KE_RUMAH"
    proteksi_tukin_dan_tpg // "TIDAK_DIPOTONG_FORCE_MAJEURE"
}

struktur KalenderPendidikanSekolah {
    npsn,
    tahun_ajaran,
    semester_aktif, // 1 (Ganjil) atau 2 (Genap)
    kode_provinsi_sekolah,
    daftar_libur_nasional,
    daftar_libur_lokal,
    status_operasional_hari_ini, // "TATAP_MUKA_REGULER", "LIBUR_NASIONAL", "LIBUR_LOKAL", "PJJ_DARURAT_BENCANA"
    protokol_bencana_aktif
}

// -----------------------------------------------------------------
// [1] Inisialisasi Kalender Pendidikan Satuan Pendidikan
// -----------------------------------------------------------------
fungsi inisialisasi_kalender_pendidikan(npsn, tahun_ajaran, semester, kode_provinsi) {
    kembalikan KalenderPendidikanSekolah(
        npsn,
        tahun_ajaran,
        semester,
        kode_provinsi,
        [],
        [],
        "TATAP_MUKA_REGULER",
        nihil
    );
}

// -----------------------------------------------------------------
// [2] Pendaftaran Hari Libur Nasional (SKB 3 Menteri)
// Berlaku serentak di seluruh 38 provinsi di Indonesia
// -----------------------------------------------------------------
fungsi tambah_libur_nasional(kalender, tanggal, nama, dasar_hukum) {
    misal id_l = "LIB-NAS-" + tanggal;
    misal libur = EventHariLibur(
        id_l,
        tanggal,
        nama,
        "LIBUR_NASIONAL_SKB3",
        dasar_hukum,
        "NASIONAL"
    );
    tambah(kalender.daftar_libur_nasional, libur);
    kembalikan libur;
}

// -----------------------------------------------------------------
// [3] Pendaftaran Hari Libur Lokal / Khas Daerah (Pergub / Surat Edaran Daerah)
// Contoh: Hari Raya Galungan di Bali (Kode 51), HUT Pekabaran Injil di Papua (Kode 91)
// -----------------------------------------------------------------
fungsi tambah_libur_lokal(kalender, tanggal, nama, kode_provinsi_target, dasar_hukum) {
    misal id_l = "LIB-LOKAL-" + kode_provinsi_target + "-" + tanggal;
    misal libur = EventHariLibur(
        id_l,
        tanggal,
        nama,
        "LIBUR_FAKULTATIF_LOKAL",
        dasar_hukum,
        kode_provinsi_target
    );
    tambah(kalender.daftar_libur_lokal, libur);
    kembalikan libur;
}

// -----------------------------------------------------------------
// [4] Evaluasi Otomatis Status Hari Ini Berdasarkan Wilayah
// -----------------------------------------------------------------
fungsi evaluasi_status_hari_kalender(kalender, tanggal_evaluasi) {
    // 1. Cek apakah ada Protokol Bencana Aktif (Kedaruratan Tertinggi)
    jika kalender.protokol_bencana_aktif != nihil {
        misal p = kalender.protokol_bencana_aktif;
        jika tanggal_evaluasi >= p.tanggal_mulai dan tanggal_evaluasi <= p.tanggal_selesai {
            kalender.status_operasional_hari_ini = "PJJ_DARURAT_BENCANA";
            kembalikan {
                "status": "PJJ_DARURAT_BENCANA",
                "keterangan": "PJJ Darurat diaktifkan: " + p.jenis_bencana + " (ISPU: " + p.tingkat_bahaya_ispu + ")",
                "kebijakan_presensi": p.kebijakan_presensi,
                "adaptasi_mbg": p.adaptasi_mbg,
                "tukin_tpg": p.proteksi_tukin_dan_tpg
            };
        }
    }
    
    // 2. Cek apakah tanggal adalah Libur Nasional
    untuk lib_nas dalam kalender.daftar_libur_nasional {
        jika lib_nas.tanggal == tanggal_evaluasi {
            kalender.status_operasional_hari_ini = "LIBUR_NASIONAL";
            kembalikan {
                "status": "LIBUR_NASIONAL",
                "keterangan": "Libur Nasional SKB 3 Menteri: " + lib_nas.nama_libur,
                "kebijakan_presensi": "PRESENSI_OFF_TIDAK_DIHITUNG_ALPA",
                "adaptasi_mbg": "DILIBURKAN",
                "tukin_tpg": "TIDAK_DIPOTONG"
            };
        }
    }
    
    // 3. Cek apakah tanggal adalah Libur Lokal di Provinsi Sekolah
    untuk lib_lok dalam kalender.daftar_libur_lokal {
        jika lib_lok.tanggal == tanggal_evaluasi dan lib_lok.kode_wilayah_berlaku == kalender.kode_provinsi_sekolah {
            kalender.status_operasional_hari_ini = "LIBUR_LOKAL";
            kembalikan {
                "status": "LIBUR_LOKAL",
                "keterangan": "Libur Fakultatif Daerah: " + lib_lok.nama_libur + " (" + lib_lok.dasar_hukum + ")",
                "kebijakan_presensi": "PRESENSI_OFF_TIDAK_DIHITUNG_ALPA",
                "adaptasi_mbg": "DILIBURKAN",
                "tukin_tpg": "TIDAK_DIPOTONG"
            };
        }
    }
    
    // 4. Default: Hari Belajar Biasa
    kalender.status_operasional_hari_ini = "TATAP_MUKA_REGULER";
    kembalikan {
        "status": "TATAP_MUKA_REGULER",
        "keterangan": "Hari Efektif KBM Tatap Muka Reguler",
        "kebijakan_presensi": "WAJIB_PRESENSI_SEKOLAH",
        "adaptasi_mbg": "DISTRIBUSI_PORSI_HANGAT_NORMAL",
        "tukin_tpg": "STANDAR_KEHADIRAN"
    };
}

// -----------------------------------------------------------------
// [5] Protokol Aktivasi PJJ Mendadak (Karhutla / Bencana Alam)
// Menyesuaikan presensi (bypass geofence), LMS Sinau Daring, dan Adaptasi MBG
// -----------------------------------------------------------------
fungsi aktifkan_pjj_darurat_bencana(kalender, id_insiden, jenis_bencana, nomor_se, ispu_level, tgl_mulai, tgl_selesai) {
    misal protokol = ProtokolKedaruratanBencana(
        id_insiden,
        jenis_bencana,
        nomor_se,
        ispu_level,
        tgl_mulai,
        tgl_selesai,
        "PJJ_DARING_PENUH",
        "DARING_BYPASS_GEOFENCE_DARI_RUMAH",
        "DISTRIBUSI_PAKET_NUTRISI_KERING_KE_RUMAH",
        "TIDAK_DIPOTONG_FORCE_MAJEURE"
    );
    
    kalender.protokol_bencana_aktif = protokol;
    kalender.status_operasional_hari_ini = "PJJ_DARURAT_BENCANA";
    kembalikan protokol;
}

// -----------------------------------------------------------------
// [6] Pencabutan PJJ Darurat (Kembali ke Tatap Muka Normal)
// -----------------------------------------------------------------
fungsi akhiri_pjj_darurat_bencana(kalender) {
    kalender.protokol_bencana_aktif = nihil;
    kalender.status_operasional_hari_ini = "TATAP_MUKA_REGULER";
    kembalikan benar;
}

// -----------------------------------------------------------------
// [7] Rekapitulasi Hari Efektif Belajar Semester
// Menghitung hari efektif bersih setelah dipotong libur nasional & daerah
// -----------------------------------------------------------------
fungsi kalkulasi_hari_efektif_semester(kalender, total_hari_kalender_semester, total_minggu_libur_akhir) {
    misal libur_nasional = panjang(kalender.daftar_libur_nasional);
    misal libur_lokal = panjang(kalender.daftar_libur_lokal);
    misal hari_minggu_biasa = 26; // Rata-rata 26 hari minggu dalam 1 semester (6 bulan)
    misal hari_libur_semester = total_minggu_libur_akhir * 6; // Misal 2 minggu = 12 hari efektif
    
    misal total_pengurang = hari_minggu_biasa + libur_nasional + libur_lokal + hari_libur_semester;
    misal hari_efektif_bersih = total_hari_kalender_semester - total_pengurang;
    misal minggu_efektif_belajar = hari_efektif_bersih / 6; // Asumsi 6 hari sekolah per minggu
    
    kembalikan {
        "npsn": kalender.npsn,
        "tahun_ajaran": kalender.tahun_ajaran,
        "total_hari_semester": total_hari_kalender_semester,
        "potongan_libur_nasional": libur_nasional,
        "potongan_libur_lokal": libur_lokal,
        "hari_efektif_kbm_bersih": hari_efektif_bersih,
        "minggu_efektif_belajar": minggu_efektif_belajar,
        "status_kelayakan_kurikulum": "MEMENUHI_STANDAR_MINIMAL_18_MINGGU"
    };
}
