cetak("\n[PILAR 1] TOUCH ENGINE, GESTURES & ADAPTIVE SCREEN LAYOUT:");
var touch_cfg = mobile_gesture_engine_konfigurasi("tap,double_tap,long_press,drag,swipe,pinch_to_zoom", benar);
