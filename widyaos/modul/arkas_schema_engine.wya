// ============================================================================
// MODUL: ARKAS SCHEMA ENGINE - KEMENDIKDASMEN RI
// Diadopsi Langsung dari Basis Data Riil ARKAS (SQLite arkas.db.sql - 55 Tabel)
// Sampel Entitas Riil: SMPN 2 DAWARBLANDONG (NPSN: 20502621)
//
// Pilar Struktur:
// 1. Model Anggaran & Rantai Revisi (is_revisi 0: Murni, 1..99: Pergeseran, 100+: PAK)
// 2. Jurnal Buku Kas Umum (kas_umum & kas_umum_nota dengan flag is_beli_di_siplah)
// 3. Rekam Pajak NTPN 16-Karakter (kas_umum_nota_pajak)
// 4. Aktivasi & Penutupan BKU Bulanan (id_periode 81..92)
// 5. Standar Acuan Barang / SSH (ref_acuan_barang & ref_kode SNP 01..08)
// ============================================================================

struktur AnggaranArkasSql {
    id_anggaran,
    id_ref_sumber_dana, // 1: BOS Reguler, 1075: Banpem TIK, 12: Kinerja, 3: BOSDA
    sekolah_id,
    pagu_jumlah,
    is_revisi,          // 0: Murni, 1..99: Pergeseran, 100+: Perubahan (PAK)
    is_approve,         // 0: Draft, 1: Disetujui Dinas, 2: Ditolak
    tahun_anggaran,
    id_anggaran_sebelumnya // updater_id bertaut ke versi lampau
}

struktur KasUmumTransaksi {
    id_kas_umum,
    id_kas_nota,
    kode_rekening,      // Contoh: '5.1.02.02.01.0013' (Honor/Jasa)
    id_ref_bku,         // 2: Terima BOS, 3: Tarik Tunai, 4: Kas Keluar, 15: Non Tunai
    tanggal_transaksi,
    no_bukti,           // BNU01, BPU01, dsb
    uraian,
    saldo_transaksi,
    is_ppn,
    is_pph_22,
    is_lock             // 1 jika BKU bulan terkait sudah ditutup
}

struktur KasUmumNotaSiplah {
    id_kas_nota,
    no_bukti,
    tanggal_nota,
    nama_toko,
    npwp_toko,
    total_belanja,
    is_badan_usaha,
    is_beli_di_siplah,  // 1: Belanja via SIPLah, 0: Belanja Langsung Offline
    ntpn_pajak          // Kode 16-karakter NTPN dari DJP/Kemenkeu
}

struktur AktivasiBkuBulanan {
    id_anggaran,
    id_periode,         // 81: Jan, 82: Feb, 83: Mar, 84: Apr, 85: Mei, 86: Jun, dst
    saldo_awal_bank,
    saldo_awal_tunai,
    saldo_akhir_bank,
    saldo_akhir_tunai,
    status_pengiriman   // 0: Draft, 1: Proses, 2: Sah Terkirim ke Dinas/Pusat
}

// ============================================================================
// LOGIKA BISNIS RESMI SESUAI SCHEMA ARKAS.DB.SQL
// ============================================================================

// 1. Evaluasi Tipe Revisi Anggaran (Pergeseran vs Perubahan PAK)
fungsi klasifikasi_revisi_arkas(is_revisi) {
    jika is_revisi == 0 {
        kembalikan "ANGGARAN_MURNI_AWAL_TAHUN";
    }
    jika is_revisi >= 1 dan is_revisi < 100 {
        kembalikan "PERGESERAN_ANGGARAN_INTERNAL";
    }
    jika is_revisi >= 100 {
        kembalikan "PERUBAHAN_ANGGARAN_PAK_DINAS";
    }
    kembalikan "TIDAK_DIKENAL";
}

// 2. Ingesti Transaksi Pengadaan SIPLah ke Jurnal Kas Umum BKU
fungsi catat_transaksi_siplah_ke_bku(
    id_nota,
    no_bukti_bnu,
    nama_rekanan,
    npwp_rekanan,
    total_bruto,
    ntpn_ppn,
    bku_terkunci
) {
    // Validasi Lock BKU Bulanan
    jika bku_terkunci == 1 {
        kembalikan "DITOLAK_BKU_SUDAH_DITUTUP_DAN_DIKUNCI";
    }

    // Validasi 16-Karakter NTPN Kas Negara
    jika ntpn_ppn != "" dan panjang(ntpn_ppn) != 16 {
        kembalikan "DITOLAK_FORMAT_NTPN_TIDAK_VALID_HARUS_16_DIGIT";
    }


    misal nota = KasUmumNotaSiplah(
        id_nota,
        no_bukti_bnu,
        "2026-03-14",
        nama_rekanan,
        npwp_rekanan,
        total_bruto,
        1, // Badan Usaha CV/PT
        1, // is_beli_di_siplah = 1 (Resmi SIPLah)
        ntpn_ppn
    );

    kembalikan "BERHASIL_TERCATAT_DI_BKU_ARKAS_DENGAN_NTPN";
}

// 3. Validasi Konsistensi Kas Tutup Buku BKU Bulanan (aktivasi_bku)
fungsi validasi_tutup_bku_bulanan(
    saldo_awal_bank,
    saldo_awal_tunai,
    total_kas_masuk,
    total_kas_keluar,
    saldo_akhir_bank,
    saldo_akhir_tunai
) {
    misal total_awal = saldo_awal_bank + saldo_awal_tunai;
    misal total_akhir_nyata = saldo_akhir_bank + saldo_akhir_tunai;
    misal total_akhir_seharusnya = total_awal + total_kas_masuk - total_kas_keluar;

    jika total_akhir_nyata == total_akhir_seharusnya {
        kembalikan "BKU_SEIMBANG_SIAP_TUTUP_DAN_KIRIM_KE_DINAS";
    } lainnya {
        kembalikan "SELISIH_KAS_BKU_TIDAK_COCOK";
    }
}
