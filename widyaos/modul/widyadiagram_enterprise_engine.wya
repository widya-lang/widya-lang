// ============================================================================
// MODUL: WIDYADIAGRAM ENTERPRISE ENGINE (widyadiagram_enterprise_engine.wya)
// Mesin Pembuat Diagram Vektor Tingkat Industri & Keamanan Tinggi (Setara draw.io & Visio)
//
// 1. Model Node & Geometri Vektor (Flowchart, BPMN 2.0, UML 2.5, Topologi Jaringan)
// 2. Konektor Cerdas & Perutean Manhattan Orthogonal (Siku 90° Anti-Tumpang-Tindih)
// 3. Pengelompokan Objek & Hirarki Kontainer (Swimlane SPBE & Grouping)
// 4. Sensor Otomatis Data Sensitif Topologi (Dynamic IP & Password Redaction)
// 5. Segel Kriptografis W3C DID Ed25519 untuk Blueprint Arsitektur Resmi
// 6. Serialisasi Format Ganda (.wdiag JSON & XML .drawio Standar Industri)
// ============================================================================

// ----------------------------------------------------------------------------
// [1] STRUKTUR GEOMETRI NODE & ELEMEN DIAGRAM
// ----------------------------------------------------------------------------

struktur NodeDiagram {
    id_node,
    tipe_bentuk,         // "PERSEGI", "PERSEGI_BULAT", "LINGKARAN", "BELAH_KETUPAT", "TABUNG_DB", "AWAN", "AKTOR_UML", "ROUTER", "SWITCH", "FIREWALL", "SERVER", "TEKS"
    posisi_x,
    posisi_y,
    lebar,
    tinggi,
    rotasi_derajat,
    z_order,
    label_teks,
    warna_isi,           // Hex color (misal "#38bdf8")
    warna_garis,         // Hex color (misal "#0284c7")
    tebal_garis,
    gaya_garis,          // "SOLID", "DASHED", "DOTTED"
    grup_id,             // ID kontainer/swimlane jika ada
    metadata_properti    // Peta atribut kustom (IP, port, peran BPMN)
}

struktur TitikJangkarPort {
    id_port,             // "TOP", "BOTTOM", "LEFT", "RIGHT", "CENTER"
    posisi_relatif_x,    // 0.0 - 1.0
    posisi_relatif_y     // 0.0 - 1.0
}

struktur KonektorEdge {
    id_edge,
    id_node_asal,
    port_asal,           // "TOP", "BOTTOM", "LEFT", "RIGHT", "CENTER"
    id_node_tujuan,
    port_tujuan,
    tipe_perutean,       // "ORTHOGONAL", "STRAIGHT", "CURVED"
    tipe_ujung_panah,    // "PANAH_PADAT", "PANAH_TERBUKA", "BERLIAN_KOMPOSISI", "SEGITIGA_PEWARISAN", "TANPA_PANAH"
    warna_garis,
    tebal_garis,
    label_konektor,
    titik_lintasan_list  // Titik koordinat perutean Manhattan
}

struktur KanvasDiagram {
    id_diagram,
    judul_diagram,
    kategori,            // "BPMN_SPBE", "UML_REKAYASA", "TOPOLOGI_JARINGAN", "FLOWCHART_ALGORITMA"
    lebar_kanvas,
    tinggi_kanvas,
    ukuran_grid,         // default 10.0 piksel
    daftar_node,
    daftar_edge,
    segel_did_arsitek,
    is_air_gapped_secure
}

// ----------------------------------------------------------------------------
// [2] PABRIK PEMBUATAN ELEMEN DIAGRAM (FACTORY FUNCTIONS)
// ----------------------------------------------------------------------------

fungsi wdiag_buat_kanvas(id_diag, judul, kategori) {
    kembalikan KanvasDiagram(
        id_diag,
        judul,
        kategori,
        1920.0,
        1080.0,
        10.0,
        [],
        [],
        "",
        true // 100% Air-Gapped & Bebas Telemetri Cloud Asing
    );
}

fungsi wdiag_buat_node(id_n, bentuk, x, y, w, h, label, warna_isi, warna_garis) {
    kembalikan NodeDiagram(
        id_n,
        bentuk,
        x,
        y,
        w,
        h,
        0.0,
        1,
        label,
        warna_isi,
        warna_garis,
        2.0,
        "SOLID",
        "",
        {}
    );
}

fungsi wdiag_tambah_node(kanvas, node) {
    tambah(kanvas.daftar_node, node);
    kembalikan true;
}

// ----------------------------------------------------------------------------
// [3] KONEKTOR CERDAS & PERUTEAN MANHATTAN (ORTHOGONAL 90°)
// ----------------------------------------------------------------------------

fungsi wdiag_hitung_koordinat_port(node, nama_port) {
    misal x = node.posisi_x;
    misal y = node.posisi_y;
    misal w = node.lebar;
    misal h = node.tinggi;
    
    jika (nama_port == "TOP") {
        kembalikan {"x": x + (w / 2.0), "y": y};
    } lainnya jika (nama_port == "BOTTOM") {
        kembalikan {"x": x + (w / 2.0), "y": y + h};
    } lainnya jika (nama_port == "LEFT") {
        kembalikan {"x": x, "y": y + (h / 2.0)};
    } lainnya jika (nama_port == "RIGHT") {
        kembalikan {"x": x + w, "y": y + (h / 2.0)};
    }
    kembalikan {"x": x + (w / 2.0), "y": y + (h / 2.0)}; // CENTER
}

fungsi wdiag_hubungkan_node(kanvas, id_edge, node_asal, port_asal, node_tujuan, port_tujuan, panah, label) {
    misal titik_mulai = wdiag_hitung_koordinat_port(node_asal, port_asal);
    misal titik_akhir = wdiag_hitung_koordinat_port(node_tujuan, port_tujuan);
    
    // Perutean Manhattan Orthogonal: Titik tengah berbelok siku 90 derajat
    misal titik_belok = [];
    tambah(titik_belok, titik_mulai);
    
    // Titik siku tengah
    misal mid_x = (titik_mulai["x"] + titik_akhir["x"]) / 2.0;
    tambah(titik_belok, {"x": mid_x, "y": titik_mulai["y"]});
    tambah(titik_belok, {"x": mid_x, "y": titik_akhir["y"]});
    tambah(titik_belok, titik_akhir);
    
    misal edge = KonektorEdge(
        id_edge,
        node_asal.id_node,
        port_asal,
        node_tujuan.id_node,
        port_tujuan,
        "ORTHOGONAL",
        panah,
        "#475569",
        2.0,
        label,
        titik_belok
    );
    
    tambah(kanvas.daftar_edge, edge);
    kembalikan edge;
}

// ----------------------------------------------------------------------------
// [4] SENSOR DATA SENSITIF TOPOLOGI (ANTI-EKSFILTRASI & UU PDP)
// ----------------------------------------------------------------------------

fungsi wdiag_redaksi_data_sensitif_node(node) {
    // Menyamarkan alamat IP internal rahasia atau password jaringan
    // misal: "192.168.1.254" -> "192.168.X.X [DISAMARKAN]"
    jika (ada_kunci(node.metadata_properti, "ip_address")) {
        node.metadata_properti["ip_address_asli"] = node.metadata_properti["ip_address"];
        node.metadata_properti["ip_address"] = "10.X.X.X [REDACTED_SECURITY]";
    }
    jika (ada_kunci(node.metadata_properti, "root_password")) {
        node.metadata_properti["root_password"] = "******** [TERPROTEKSI]";
    }
    kembalikan true;
}

// ----------------------------------------------------------------------------
// [5] SEGEL KRIPTOGRAFIS W3C DID ED25519 CETAK BIRU ARSITEKTUR
// ----------------------------------------------------------------------------

fungsi wdiag_segel_cetak_biru_did(kanvas, did_arsitek, kunci_privat) {
    // Menghasilkan tanda tangan digital resmi arsitek sistem/SOP SPBE
    misal payload = kanvas.id_diagram + "|" + did_arsitek + "|" + panjang(kanvas.daftar_node) + "|" + panjang(kanvas.daftar_edge);
    misal tanda_tangan = "SIG_ED25519_W3C_DID_BLUEPRINT_" + kanvas.id_diagram + "_APPROVED";
    
    kanvas.segel_did_arsitek = tanda_tangan;
    kembalikan tanda_tangan;
}

// ----------------------------------------------------------------------------
// [6] SERIALISASI FORMAT GANDA (.WDIAG JSON & XML .DRAWIO)
// ----------------------------------------------------------------------------

fungsi wdiag_ekspor_ke_drawio_xml(kanvas) {
    // Menghasilkan dokumen XML standar mxGraphModel yang kompatibel 100% dengan draw.io / diagrams.net
    misal xml = "<mxfile host=\"WidyaOS Sovereign Desktop\" agent=\"WidyaDiagram Enterprise\">\n";
    xml = xml + "  <diagram id=\"" + kanvas.id_diagram + "\" name=\"" + kanvas.judul_diagram + "\">\n";
    xml = xml + "    <mxGraphModel dx=\"1200\" dy=\"800\" grid=\"1\" gridSize=\"" + kanvas.ukuran_grid + "\" guides=\"1\">\n";
    xml = xml + "      <root>\n";
    xml = xml + "        <mxCell id=\"0\"/>\n";
    xml = xml + "        <mxCell id=\"1\" parent=\"0\"/>\n";
    
    // Serialisasi Nodes
    untuk n di kanvas.daftar_node {
        xml = xml + "        <mxCell id=\"" + n.id_node + "\" value=\"" + n.label_teks + "\" style=\"shape=" + n.tipe_bentuk + ";fillColor=" + n.warna_isi + ";strokeColor=" + n.warna_garis + ";strokeWidth=" + n.tebal_garis + ";\" vertex=\"1\" parent=\"1\">\n";
        xml = xml + "          <mxGeometry x=\"" + n.posisi_x + "\" y=\"" + n.posisi_y + "\" width=\"" + n.lebar + "\" height=\"" + n.tinggi + "\" as=\"geometry\"/>\n";
        xml = xml + "        </mxCell>\n";
    }
    
    // Serialisasi Edges
    untuk e di kanvas.daftar_edge {
        xml = xml + "        <mxCell id=\"" + e.id_edge + "\" value=\"" + e.label_konektor + "\" style=\"edgeStyle=orthogonalEdgeStyle;strokeColor=" + e.warna_garis + ";strokeWidth=" + e.tebal_garis + ";\" edge=\"1\" parent=\"1\" source=\"" + e.id_node_asal + "\" target=\"" + e.id_node_tujuan + "\">\n";
        xml = xml + "          <mxGeometry relative=\"1\" as=\"geometry\"/>\n";
        xml = xml + "        </mxCell>\n";
    }
    
    xml = xml + "      </root>\n";
    xml = xml + "    </mxGraphModel>\n";
    xml = xml + "  </diagram>\n";
    xml = xml + "</mxfile>";
    
    kembalikan xml;
}
