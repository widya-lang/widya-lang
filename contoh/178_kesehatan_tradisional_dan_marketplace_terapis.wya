// ============================================================================
// CONTOH 178: INDUSTRI KESEHATAN TRADISIONAL, JAMU & MARKETPLACE TERAPIS
// Standar: BPOM TR/HT/FF, Kemenkes STPT, Interaksi Herbal-Obat & Rekam Terapi
// ============================================================================

fungsi utama() {
    cetak("====================================================================");
    cetak("🌿 KESEHATAN TRADISIONAL, JAMU/FITOFARMAKA & MARKETPLACE TERAPIS");
    cetak("====================================================================");

    // ------------------------------------------------------------------------
    // 1. STANDARISASI OBAT BAHAN ALAM & HERBAL INDONESIA (BPOM & FOHI)
    // ------------------------------------------------------------------------
    cetak("\n--- [1. STANDARISASI OBAT BAHAN ALAM (JAMU, OHT, FITOFARMAKA)] ---");

    misal nama_simplisia = "Curcuma xanthorrhiza Rhizoma (Temulawak)";
    misal kadar_kurkuminoid = 4.8; // % HPLC
    misal kadar_air = 8.2;        // Standar Farmakope: <= 10%
    misal kadar_abu = 5.9;        // Standar Farmakope: <= 8%

    cetak("  ✓ Pengujian Simplisia Herbal Terstandar:");
    cetak("    • Simplisia: " + nama_simplisia);
    cetak("    • Senyawa Aktif: Kurkuminoid (" + kadar_kurkuminoid + "% HPLC)");
    cetak("    • Kadar Air: " + kadar_air + "% (Lolos Uji, Standar <= 10.0%)");
    cetak("    • Cemaran Logam & Mikroba: Negatif (Memenuhi Syarat Farmakope)");

    misal produk_nie = "POM HT212345671";
    misal nama_produk = "Kapsul Temulawak Plus Fitofarmaka";
    misal harga_produk = 85000;
    cetak("  ✓ Produk E-Farmasi / Marketplace Herbal:");
    cetak("    • Produk: " + nama_produk + " (" + produk_nie + ")");
    cetak("    • Kategori: Obat Herbal Terstandar (OHT)");
    cetak("    • Indikasi: Memelihara fungsi hati & meningkatkan nafsu makan");
    cetak("    • Sertifikasi Halal BPJPH: Terverifikasi (ID0011000123456)");

    // ------------------------------------------------------------------------
    // 2. MESIN ANALISIS INTERAKSI HERBAL-OBAT KIMIA (HERB-DRUG INTERACTIONS)
    // ------------------------------------------------------------------------
    cetak("\n--- [2. MESIN CEK INTERAKSI HERBAL DENGAN OBAT KIMIA] ---");

    misal herbal_klien = "Kunyit Asam / Curcuma";
    misal obat_resep = "Warfarin (Antikoagulan)";
    cetak("  ✓ Peringatan Keamanan Farmakologi:");
    cetak("    • Herbal: " + herbal_klien + " + Obat: " + obat_resep);
    cetak("    • [PERINGATAN]: Potensi peningkatan efek pengencer darah & risiko pendarahan.");
    cetak("    • Rekomendasi: Konsultasikan dengan apoteker & beri jeda konsumsi 2-3 jam.");

    // ------------------------------------------------------------------------
    // 3. MARKETPLACE & BOOKING PENYEHAT TRADISIONAL (STPT KEMENKES)
    // ------------------------------------------------------------------------
    cetak("\n--- [3. MARKETPLACE LAYANAN TERAPIS & PENYEHAT TRADISIONAL (HATTRA)] ---");

    misal nama_terapis = "H. Ahmad Syafii, S.Kep., C.Tr";
    misal nomor_stpt = "STPT/440/123/DINKES/2025";
    misal asosiasi = "Asosiasi Penyehat Tradisional Indonesia (APSTI)";
    misal tarif_layanan = 150000;
    misal rating = 4.95;

    cetak("  ✓ Profil Terapis Terverifikasi:");
    cetak("    • Nama: " + nama_terapis);
    cetak("    • Izin Praktik: " + nomor_stpt + " (Dinkes)");
    cetak("    • Asosiasi Profesi: " + asosiasi);
    cetak("    • Modalitas Keahlian: Akupresur, Pijat Refleksi, Bekam Steril");
    cetak("    • Rating Kepuasan: " + rating + " / 5.0 (280 Ulasan) | Tarif: Rp " + tarif_layanan + "/sesi");

    // Booking Homecare & Rekam Terapi (SOAP)
    misal id_booking = "BOOK-2026-HATTRA-099";
    misal keluhan = "Kekakuan leher dan bahu kronis akibat kerja depan komputer";
    cetak("\n  ✓ Pemesanan Layanan Homecare: " + id_booking);
    cetak("    • Status Pembayaran: Escrow Terkunci (Dijamin Aman)");
    cetak("    • Rekam Terapi Tradisional (SOAP):");
    cetak("      - Anamnesis: " + keluhan);
    cetak("      - Titik Meridian: GV14 (Dazhui), GB21 (Jianjing), LI4 (Hegu)");
    cetak("      - Rekomendasi Ramuan: Seduhan Jahe Merah + Madu Alami");
    cetak("      - Hasil Evaluasi: Otot rileks, nyeri berkurang signifikan (Skala 7 -> 2)");

    cetak("\n====================================================================");
    cetak("🚀 SELURUH ALUR KESEHATAN TRADISIONAL & MARKETPLACE BERJALAN LANCAR!");
    cetak("====================================================================");
}

utama();
