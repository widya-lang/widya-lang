// ============================================================================
// MODUL PERISAI DOS & RATE LIMITING (perisai_dos.wya)
// Pertahanan Laju Akses: Algoritma Token Bucket Adaptif & Anti-Abuse Shield
// Melindungi Endpoint REST & MCP dari Banjir Permintaan (Request Flooding)
// ============================================================================

struktur EmberToken {
    kapasitas_maksimal,
    jumlah_token,
    laju_isi_per_detik,
    waktu_isi_terakhir
}

struktur PerisaiDoS {
    nama_perisai,
    kapasitas_default,
    laju_default,
    daftar_ember_klien,
    total_diterima,
    total_ditolak,
    daftar_blokir
}

// 1. Inisialisasi Perisai DoS Baru
fungsi inisialisasi_perisai_dos(nama, kapasitas, laju_isi) {
    kembalikan PerisaiDoS(
        nama,
        kapasitas,
        laju_isi,
        {},
        0,
        0,
        {}
    );
}

// 2. Periksa & Konsumsi Token untuk Permintaan Klien
fungsi perisai_konsumsi_token(perisai, id_klien, butuh_token) {
    misal t_sekarang = waktu();
    perisai.total_diterima = perisai.total_diterima + 1;

    // Periksa apakah klien diblokir permanen
    jika (ada_kunci(perisai.daftar_blokir, id_klien)) {
        perisai.total_ditolak = perisai.total_ditolak + 1;
        kembalikan {
            "izinkan": salah,
            "alasan": "Klien diblokir oleh Perisai DoS (Penyalahgunaan Terdeteksi)",
            "kode_status": 403,
            "sisa_token": 0,
            "tunggu_detik": 3600
        };
    }

    // Ambil atau buat ember token baru untuk klien ini
    misal ember = kosong;
    jika (ada_kunci(perisai.daftar_ember_klien, id_klien)) {
        ember = perisai.daftar_ember_klien[id_klien];
        
        // Isi ulang token berdasarkan waktu yang telah berlalu
        misal delta_waktu = t_sekarang - ember.waktu_isi_terakhir;
        jika (delta_waktu > 0) {
            misal tambah_token = delta_waktu * ember.laju_isi_per_detik;
            ember.jumlah_token = ember.jumlah_token + tambah_token;
            jika (ember.jumlah_token > ember.kapasitas_maksimal) {
                ember.jumlah_token = ember.kapasitas_maksimal;
            }
            ember.waktu_isi_terakhir = t_sekarang;
        }
    } lainnya {
        // Klien pertama kali melakukan request
        ember = EmberToken(
            perisai.kapasitas_default,
            perisai.kapasitas_default,
            perisai.laju_default,
            t_sekarang
        );
        perisai.daftar_ember_klien[id_klien] = ember;
    }

    // Evaluasi apakah token mencukupi
    jika (ember.jumlah_token >= butuh_token) {
        ember.jumlah_token = ember.jumlah_token - butuh_token;
        kembalikan {
            "izinkan": benar,
            "alasan": "Permintaan diizinkan oleh Perisai DoS",
            "kode_status": 200,
            "sisa_token": ember.jumlah_token,
            "tunggu_detik": 0
        };
    } lainnya {
        perisai.total_ditolak = perisai.total_ditolak + 1;
        misal kekurangan = butuh_token - ember.jumlah_token;
        misal waktu_tunggu = kekurangan / ember.laju_isi_per_detik;
        jika (waktu_tunggu < 1) { waktu_tunggu = 1; }

        kembalikan {
            "izinkan": salah,
            "alasan": "Laju permintaan melampaui kuota (Rate Limit Exceeded)",
            "kode_status": 429,
            "sisa_token": ember.jumlah_token,
            "tunggu_detik": waktu_tunggu
        };
    }
}

// 3. Blokir Klien yang Melakukan Serangan Berulang
fungsi perisai_blokir_klien(perisai, id_klien, alasan) {
    perisai.daftar_blokir[id_klien] = {
        "alasan": alasan,
        "waktu_blokir": waktu()
    };
}

// 4. Ringkasan Statistik Metrik Perisai DoS
fungsi perisai_dapatkan_statistik(perisai) {
    misal total_klien = panjang(kunci(perisai.daftar_ember_klien));
    misal rasio_lolos = 1.0;
    jika (perisai.total_diterima > 0) {
        rasio_lolos = (perisai.total_diterima - perisai.total_ditolak) * 1.0 / perisai.total_diterima;
    }

    kembalikan {
        "nama_perisai": perisai.nama_perisai,
        "total_permintaan": perisai.total_diterima,
        "permintaan_diloloskan": perisai.total_diterima - perisai.total_ditolak,
        "permintaan_ditolak": perisai.total_ditolak,
        "rasio_kelolosan": rasio_lolos,
        "klien_terpantau": total_klien,
        "klien_terblokir": panjang(kunci(perisai.daftar_blokir))
    };
}
