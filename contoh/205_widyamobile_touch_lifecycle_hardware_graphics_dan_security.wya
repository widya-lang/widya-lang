cetak("    • Motion Physics & Sampling    : Spring Inertia: " + ke_teks(touch_cfg["spring_physics_inertia"]) + " | Touch Sampling: " + ke_teks(touch_cfg["touch_sampling_rate_hz"]) + " Hz");

var safe_area = mobile_safe_area_insets("Dynamic Island / Notch", "Portrait", "UnfoldedHinge");
