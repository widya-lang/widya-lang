// ==============================================================================
// WIDYAOS: MODUL PORTAL KOMUNIKASI ORANG TUA & BUKU PENGHUBUNG REALTIME
// Presensi Tap Gerbang, Monitoring Gizi MBG, & Transparansi Akademik
// ==============================================================================

struktur PresensiGerbang {
    id_presensi,
    nisn,
    nama_siswa,
    waktu_tap,
    jenis_gerbang, // GERBANG_MASUK, GERBANG_PULANG
    status_kehadiran, // TEPAT_WAKTU, TERLAMBAT
    notifikasi_wali_terkirim
}

struktur CatatanPenghubung {
    id_catatan,
    nisn,
    nama_siswa,
    pengirim, // WALI_KELAS, GURU_MAPEL, ORANG_TUA
    jenis_kategori, // TUGAS_PR, PENGUMUMAN_SEKOLAH, KONSULTASI_BK
    isi_pesan,
    tanggal
}

struktur RingkasanHarianSiswa {
    nisn,
    nama_siswa,
    tanggal,
    status_kehadiran,
    menu_mbg_dikonsumsi,
    ringkasan_pembelajaran
}

// Rekam Presensi Tap Gerbang Sekolah (RFID / Barcode / Kamera AI)
fungsi rekam_presensi_gerbang(
    id_presensi,
    nisn,
    nama,
    jam_tap,
    jam_maksimal_masuk,
    jenis
) {
    misal status = "TEPAT_WAKTU";
    jika jenis == "GERBANG_MASUK" dan jam_tap > jam_maksimal_masuk {
        status = "TERLAMBAT";
    }

    // Sistem otomatis mengirimkan Web Push / WhatsApp Gateway ke ponsel orang tua
    misal notif_sukses = true;

    kembalikan PresensiGerbang(
        id_presensi,
        nisn,
        nama,
        jam_tap,
        jenis,
        status,
        notif_sukses
    );
}

// Kirim Pesan Buku Penghubung Digital
fungsi kirim_catatan_penghubung(
    id_catatan,
    nisn,
    nama,
    pengirim,
    kategori,
    pesan,
    tanggal
) {
    kembalikan CatatanPenghubung(
        id_catatan,
        nisn,
        nama,
        pengirim,
        kategori,
        pesan,
        tanggal
    );
}

// Susun Laporan Harian Terpadu untuk Aplikasi Ponsel Orang Tua
fungsi buat_ringkasan_harian(
    nisn,
    nama,
    tanggal,
    presensi,
    menu_mbg,
    catatan_belajar
) {
    kembalikan RingkasanHarianSiswa(
        nisn,
        nama,
        tanggal,
        presensi,
        menu_mbg,
        catatan_belajar
    );
}
