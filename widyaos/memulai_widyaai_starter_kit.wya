// ============================================================================
// WIDYAAI STARTER KIT (memulai_widyaai_starter_kit.wya)
// Contoh Praktis Memulai Proyek AI Lokal Berdaulat untuk Sekolah & Pembelajaran
// ============================================================================

impor "widyaos/modul/widya_ai_edge_llm_engine.wya";

fungsi utama() {
    cetak("======================================================================");
    cetak("SELAMAT DATANG DI PROYEK WIDYAAI (KECERDASAN BUATAN BERDAULAT NASIONAL)");
    cetak("======================================================================\n");

    // ------------------------------------------------------------------------
    // LANGKAH 1: Inisialisasi Model Lokal (Small Language Model Q4_K_M)
    // ------------------------------------------------------------------------
    cetak("[1] MENGINISIALISASI MODEL AI LOKAL...");
    misal model_ai = wai_inisialisasi_model(
        "widya_karsa_3b",
        "WidyaAI Karsa 3B Nusantara",
        "Transformer-Decoder",
        "Q4_K_M",
        8192,
        "NPU_SMART_IFP"
    );
    cetak("    -> ID Model       : " + model_ai.id_model);
    cetak("    -> Nama Model     : " + model_ai.nama_tampilan);
    cetak("    -> Kuantisasi     : " + model_ai.kuantisasi);
    cetak("    -> Alokasi RAM    : " + ke_teks(model_ai.status_memori_ram_mb) + " MB (Sangat ringan untuk PC/IFP)");
    cetak("    -> Target Hardware: " + model_ai.perangkat_eksekusi + "\n");

    // ------------------------------------------------------------------------
    // LANGKAH 2: Ingesti Korpus Buku Teks Resmi ke Memori RAG Lokal
    // ------------------------------------------------------------------------
    cetak("[2] MENGINGESTI DOKUMEN BUKU TEKS KURIKULUM (RAG LOKAL)...");
    misal korpus_rag = [];

    // Fragmen 1: Buku IPA Kelas 5 Bab Fotosintesis
    wai_tambah_dokumen_rag(
        korpus_rag,
        "doc_ipa_01",
        "Buku_Sains_Kelas_5_SD_Kemendikdasmen.pdf",
        "Fotosintesis adalah proses di mana tumbuhan hijau memanfaatkan sinar matahari, air (H2O), dan karbon dioksida (CO2) untuk menghasilkan glukosa dan melepaskan oksigen (O2).",
        [0.85, 0.92, 0.14, 0.78]
    );

    // Fragmen 2: Buku Pendidikan Pancasila & Kewarganegaraan
    wai_tambah_dokumen_rag(
        korpus_rag,
        "doc_ppkn_01",
        "Buku_PPKn_Fase_E_Kurikulum_Merdeka.pdf",
        "Kedaulatan digital mencakup perlindungan data pribadi seluruh warga negara sesuai UU PDP No. 27/2022 dan kemandirian infrastruktur teknologi informasi nasional.",
        [0.12, 0.23, 0.95, 0.88]
    );

    cetak("    -> Total fragmen rujukan terindeks: " + ke_teks(panjang(korpus_rag)) + " dokumen resmi\n");

    // ------------------------------------------------------------------------
    // LANGKAH 3: Penyiapan Guardrail Etika & Keamanan Edukasi
    // ------------------------------------------------------------------------
    cetak("[3] MEMASANG GUARDRAIL KEAMANAN & PRIVASI (UU PDP No. 27/2022)...");
    misal guardrail = wai_buat_guardrail_default();
    cetak("    -> Blokir Judi Online: " + ke_teks(guardrail.blokir_judi_online));
    cetak("    -> Blokir Pornografi : " + ke_teks(guardrail.blokir_pornografi));
    cetak("    -> Proteksi PII Siswa: " + ke_teks(guardrail.cegah_bocoran_pii) + "\n");

    // ------------------------------------------------------------------------
    // LANGKAH 4: Tanya Jawab Interaktif Berbasis RAG (Tanpa Halusinasi)
    // ------------------------------------------------------------------------
    cetak("[4] MENJALANKAN INFERENSI PERTANYAAN SISWA...");
    misal kueri_siswa = "Bagaimana tumbuhan menghasilkan oksigen melalui fotosintesis?";
    misal vektor_tanya = [0.84, 0.90, 0.15, 0.75]; // Vektor representasi semantik pertanyaan

    cetak("    [Pertanyaan Siswa]: \"" + kueri_siswa + "\"");
    misal respon = wai_inferensi_rag(model_ai, kueri_siswa, korpus_rag, vektor_tanya, guardrail);

    cetak("    [Jawaban WidyaAI] : " + respon.teks_jawaban);
    cetak("    [Rujukan Resmi]   : " + respon.daftar_sitasi[0]);
    cetak("    [Kecepatan]       : " + ke_teks(respon.kecepatan_token_per_detik) + " token/detik (Latency: " + ke_teks(respon.waktu_inferensi_ms) + " ms)");
    cetak("    [Segel Kripto]    : " + respon.segel_w3c_did + "\n");

    // ------------------------------------------------------------------------
    // LANGKAH 5: Generator Soal Asesmen Otomatis untuk Guru
    // ------------------------------------------------------------------------
    cetak("[5] MEMBANGKITKAN SOAL ASESMEN OTOMATIS (KKTP)...");
    misal bank_soal = wai_buat_soal_asesmen(model_ai, "Kedaulatan Digital", "Fase E SMA/SMK", 1);
    misal soal_pertama = bank_soal["daftar_soal"][0];
    cetak("    -> Soal Nomor 1: " + soal_pertama["pertanyaan"]);
    cetak("    -> Kunci Jawaban: " + soal_pertama["kunci_jawaban"]);
    cetak("    -> Pembahasan   : " + soal_pertama["pembahasan"] + "\n");

    cetak("======================================================================");
    cetak("PROYEK WIDYAAI BERHASIL DIAKTIFKAN DAN SIAP DIKEMBANGKAN LEBIH LANJUT!");
    cetak("======================================================================");
}

utama();
