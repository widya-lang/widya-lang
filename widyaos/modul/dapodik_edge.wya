// ==============================================================================
// WIDYAOS: MODUL MASTER DAPODIK EDGE (OFFLINE-FIRST LOCAL SCHOOL SYNCHRONIZER)
// Single Source of Truth untuk 8 Pilar Data Pokok Pendidikan Kemendikdasmen RI:
// 1. Satuan Pendidikan & Sanitasi
// 2. Sarana dan Prasarana (Tanah, Bangunan, Ruang & Persentase Kerusakan PUPR)
// 3. Pendidik & Tenaga Kependidikan (GTK, Sertifikasi & TPG 24 JJM)
// 4. Peserta Didik (Identitas, Orang Tua, Antropometri & KIP/PIP)
// 5. Rombongan Belajar (Rombel Reguler/P5 & SK PBM Pembelajaran)
// 6. Jadwal Pelajaran (Anti-Bentrok Ruang & Guru)
// 7. Nilai & Capaian Belajar e-Rapor
// 8. Mesin Validasi Dapodik (Deteksi Invalid/Warning & Sync Pusdatin)
// ==============================================================================

// --- [1] SATUAN PENDIDIKAN & SANITASI ---
struktur DapodikSekolah {
    npsn,
    nama_sekolah,
    bentuk_pendidikan, // SD, SMP, SMA, SMK, SLB
    status_sekolah, // NEGERI, SWASTA
    sk_izin_operasional,
    tanggal_sk_izin,
    alamat_jalan,
    desa_kelurahan,
    kecamatan,
    kab_kota,
    provinsi,
    lintang,
    bujur,
    akreditasi,
    sumber_listrik,
    daya_watt,
    akses_internet
}

struktur DapodikSanitasi {
    npsn,
    sumber_air_bersih,
    ketersediaan_air_minum,
    jamban_laki,
    jamban_perempuan,
    jamban_difabel,
    cuci_tangan_sabun,
    pemilahan_sampah
}

// --- [2] SARANA DAN PRASARANA (SARPRAS) ---
struktur DapodikTanah {
    id_tanah,
    no_sertifikat,
    luas_m2,
    status_kepemilikan // MILIK_SENDIRI, SEWA, PINJAM_PAKAI
}

struktur DapodikBangunan {
    id_bangunan,
    id_tanah,
    nama_bangunan,
    luas_lantai_m2,
    tahun_dibangun,
    persen_rusak_pupr,
    kondisi_kerusakan // BAIK, RUSAK_RINGAN, RUSAK_SEDANG, RUSAK_BERAT
}

struktur DapodikRuang {
    id_ruang,
    id_bangunan,
    nama_ruang,
    jenis_ruang, // KELAS, LAB_KOMPUTER, LAB_IPA, PERPUSTAKAAN, GURU, UKS, TOILET, IBADAH
    kapasitas_siswa,
    panjang_meter,
    lebar_meter
}

// --- [3] GTK (PENDIDIK & TENAGA KEPENDIDIKAN) ---
struktur DapodikGTK {
    nuptk,
    nik,
    nip,
    nama_lengkap,
    gelar_depan,
    gelar_belakang,
    jenis_ptk, // GURU_MAPEL, GURU_KELAS, GURU_BK, KEPALA_SEKOLAH, TENAGA_ADMINISTRASI
    status_kepegawaian, // PNS, PPPK, GTY, GTT, HONOR_SEKOLAH
    jenjang_pendidikan, // S1, S2, S3, D4
    nomor_serdik,
    bidang_sertifikasi,
    total_jjm_mengajar,
    status_tpg, // MEMENUHI_SYARAT_TPG_24_JAM, BELUM_MEMENUHI
    status_linearitas // LINEAR, TIDAK_LINEAR
}

// Kompatibilitas Legacy
struktur GuruDapodik {
    nuptk,
    nama,
    mata_pelajaran,
    jjm_beban_mengajar,
    status_sertifikasi
}

// --- [4] PESERTA DIDIK (SISWA) ---
struktur DapodikPesertaDidik {
    nisn,
    nik,
    no_kk,
    nama_lengkap,
    jenis_kelamin, // L, P
    tanggal_lahir,
    nama_ibu_kandung,
    nama_ayah,
    pekerjaan_ortu,
    penghasilan_ortu,
    penerima_kip, // benar / salah
    nomor_kip,
    status_layak_pip, // LAYAK_PIP_DTKS, TIDAK_LAYAK
    tinggi_cm,
    berat_kg,
    id_rombel,
    status_registrasi // SISWA_BARU, PINDAHAN, AKTIF
}

// Kompatibilitas Legacy
struktur SiswaDapodik {
    nisn,
    nik,
    nama,
    id_rombel,
    status_aktif
}

// --- [5] ROMBEL & PEMBELAJARAN (SK PBM) ---
struktur DapodikRombel {
    id_rombel,
    nama_rombel,
    tingkat_kelas,
    kurikulum,
    id_ruang,
    nuptk_wali_kelas,
    jenis_rombel // REGULER, P5_KOKURIKULER, EKSKUL, BK
}

// Kompatibilitas Legacy
struktur RombelDapodik {
    id_rombel,
    nama_rombel,
    tingkat_kelas,
    kurikulum
}

struktur DapodikPembelajaran {
    id_pembelajaran,
    id_rombel,
    mata_pelajaran,
    nuptk_guru,
    nomor_sk_pbm,
    tanggal_sk_pbm,
    alokasi_jjm,
    status_linearitas
}

// --- [6] JADWAL PELAJARAN ---
struktur DapodikJadwal {
    id_jadwal,
    id_rombel,
    hari, // SENIN, SELASA, RABU, KAMIS, JUMAT, SABTU
    jam_ke, // 1, 2, 3, dst
    id_ruang,
    nuptk_guru,
    mata_pelajaran,
    status_bentrok // AMAN_TERJADWAL, BENTROK_JADWAL
}

// --- [7] MESIN VALIDASI DAPODIK ---
struktur DapodikHasilValidasi {
    total_invalid,
    total_warning,
    daftar_invalid,
    daftar_warning,
    status_izin_sync // SIAP_SINKRON_PUSDATIN, TERKUNCI_KARENA_INVALID
}

// --- NODE DAPODIK EDGE LOCAL ---
struktur NodeDapodikEdge {
    npsn,
    nama_sekolah,
    daftar_siswa,
    daftar_guru,
    daftar_rombel,
    antrian_delta_sync,
    data_sekolah,
    data_sanitasi,
    daftar_tanah,
    daftar_bangunan,
    daftar_ruang,
    daftar_pembelajaran,
    daftar_jadwal
}

// Inisialisasi Node Dapodik
fungsi inisialisasi_dapodik_edge(npsn, nama_sekolah) {
    kembalikan NodeDapodikEdge(
        npsn,
        nama_sekolah,
        {},
        {},
        {},
        [],
        nihil,
        nihil,
        {},
        {},
        {},
        {},
        []
    );
}

// --- FUNGSI ENTITAS SEKOLAH & SANITASI ---
fungsi dapodik_set_identitas_sekolah(
    node,
    bentuk_pendidikan,
    status_sekolah,
    sk_operasional,
    tgl_sk,
    alamat,
    desa,
    kecamatan,
    kab_kota,
    provinsi,
    lat,
    long,
    akreditasi,
    listrik,
    daya,
    internet
) {
    misal sek = DapodikSekolah(
        node.npsn,
        node.nama_sekolah,
        bentuk_pendidikan,
        status_sekolah,
        sk_operasional,
        tgl_sk,
        alamat,
        desa,
        kecamatan,
        kab_kota,
        provinsi,
        lat,
        long,
        akreditasi,
        listrik,
        daya,
        internet
    );
    node.data_sekolah = sek;
    tambah(node.antrian_delta_sync, {
        "entitas": "SEKOLAH",
        "aksi": "UPDATE",
        "id": node.npsn,
        "stempel": waktu()
    });
    kembalikan sek;
}

fungsi dapodik_set_sanitasi(
    node,
    air_bersih,
    air_minum,
    toilet_laki,
    toilet_perempuan,
    toilet_difabel,
    cuci_tangan,
    pemilahan_sampah
) {
    misal san = DapodikSanitasi(
        node.npsn,
        air_bersih,
        air_minum,
        toilet_laki,
        toilet_perempuan,
        toilet_difabel,
        cuci_tangan,
        pemilahan_sampah
    );
    node.data_sanitasi = san;
    tambah(node.antrian_delta_sync, {
        "entitas": "SANITASI",
        "aksi": "UPDATE",
        "id": node.npsn,
        "stempel": waktu()
    });
    kembalikan san;
}

// --- FUNGSI ENTITAS SARPRAS ---
fungsi dapodik_tambah_tanah(node, id_tanah, no_sertifikat, luas, kepemilikan) {
    misal tanah = DapodikTanah(id_tanah, no_sertifikat, luas, kepemilikan);
    node.daftar_tanah[id_tanah] = tanah;
    tambah(node.antrian_delta_sync, {
        "entitas": "TANAH",
        "aksi": "UPSERT",
        "id": id_tanah,
        "stempel": waktu()
    });
    kembalikan tanah;
}

fungsi dapodik_tambah_bangunan(node, id_bangunan, id_tanah, nama, luas, thn, persen_rusak) {
    misal kondisi = "BAIK";
    jika persen_rusak > 65.0 {
        kondisi = "RUSAK_BERAT";
    } kalau persen_rusak > 45.0 {
        kondisi = "RUSAK_SEDANG";
    } kalau persen_rusak > 30.0 {
        kondisi = "RUSAK_RINGAN";
    }

    misal bgn = DapodikBangunan(id_bangunan, id_tanah, nama, luas, thn, persen_rusak, kondisi);
    node.daftar_bangunan[id_bangunan] = bgn;
    tambah(node.antrian_delta_sync, {
        "entitas": "BANGUNAN",
        "aksi": "UPSERT",
        "id": id_bangunan,
        "stempel": waktu()
    });
    kembalikan bgn;
}

fungsi dapodik_tambah_ruang(node, id_ruang, id_bangunan, nama, jenis, kapasitas, p, l) {
    misal ruang = DapodikRuang(id_ruang, id_bangunan, nama, jenis, kapasitas, p, l);
    node.daftar_ruang[id_ruang] = ruang;
    tambah(node.antrian_delta_sync, {
        "entitas": "RUANG",
        "aksi": "UPSERT",
        "id": id_ruang,
        "stempel": waktu()
    });
    kembalikan ruang;
}

// --- FUNGSI ENTITAS GTK ---
fungsi dapodik_tambah_gtk_lengkap(
    node,
    nuptk,
    nik,
    nip,
    nama,
    gelar_depan,
    gelar_blk,
    jenis_ptk,
    status_pegawai,
    jenjang_studi,
    no_serdik,
    bidang_serdik,
    jjm
) {
    misal status_tpg = "BELUM_MEMENUHI";
    jika jjm >= 24 {
        status_tpg = "MEMENUHI_SYARAT_TPG_24_JAM";
    }

    misal linearitas = "TIDAK_LINEAR";
    jika no_serdik != nihil dan no_serdik != "" {
        linearitas = "LINEAR";
    }

    misal gtk = DapodikGTK(
        nuptk,
        nik,
        nip,
        nama,
        gelar_depan,
        gelar_blk,
        jenis_ptk,
        status_pegawai,
        jenjang_studi,
        no_serdik,
        bidang_serdik,
        jjm,
        status_tpg,
        linearitas
    );

    node.daftar_guru[nuptk] = gtk;
    tambah(node.antrian_delta_sync, {
        "entitas": "GTK",
        "aksi": "UPSERT",
        "id": nuptk,
        "stempel": waktu()
    });
    kembalikan gtk;
}

// Kompatibilitas Fungsi Lama
fungsi dapodik_tambah_guru(node, nuptk, nama, mapel, jjm) {
    misal status_sertifikasi = "BELUM_MEMENUHI";
    jika jjm >= 24 {
        status_sertifikasi = "MEMENUHI_SYARAT_TPG_24_JAM";
    }
    
    misal guru = GuruDapodik(nuptk, nama, mapel, jjm, status_sertifikasi);
    node.daftar_guru[nuptk] = guru;
    tambah(node.antrian_delta_sync, {
        "entitas": "GURU",
        "aksi": "UPSERT",
        "id": nuptk,
        "stempel": waktu()
    });
    kembalikan guru;
}

// --- FUNGSI ENTITAS SISWA ---
fungsi dapodik_tambah_siswa_lengkap(
    node,
    nisn,
    nik,
    no_kk,
    nama,
    jk,
    tgl_lahir,
    ibu,
    ayah,
    pekerjaan,
    penghasilan,
    is_kip,
    no_kip,
    layak_pip,
    tb,
    bb,
    id_rombel
) {
    misal siswa = DapodikPesertaDidik(
        nisn,
        nik,
        no_kk,
        nama,
        jk,
        tgl_lahir,
        ibu,
        ayah,
        pekerjaan,
        penghasilan,
        is_kip,
        no_kip,
        layak_pip,
        tb,
        bb,
        id_rombel,
        "AKTIF"
    );

    node.daftar_siswa[nisn] = siswa;
    tambah(node.antrian_delta_sync, {
        "entitas": "SISWA",
        "aksi": "UPSERT",
        "id": nisn,
        "stempel": waktu()
    });
    kembalikan siswa;
}

// Kompatibilitas Fungsi Lama
fungsi dapodik_tambah_siswa(node, nisn, nik, nama, id_rombel) {
    misal siswa = SiswaDapodik(nisn, nik, nama, id_rombel, "AKTIF");
    node.daftar_siswa[nisn] = siswa;
    tambah(node.antrian_delta_sync, {
        "entitas": "SISWA",
        "aksi": "UPSERT",
        "id": nisn,
        "stempel": waktu()
    });
    kembalikan siswa;
}

// --- FUNGSI ENTITAS ROMBEL & PEMBELAJARAN ---
fungsi dapodik_tambah_rombel_lengkap(
    node,
    id_rombel,
    nama_rombel,
    tingkat,
    kurikulum,
    id_ruang,
    wali_nuptk,
    jenis_rombel
) {
    misal rombel = DapodikRombel(
        id_rombel,
        nama_rombel,
        tingkat,
        kurikulum,
        id_ruang,
        wali_nuptk,
        jenis_rombel
    );
    node.daftar_rombel[id_rombel] = rombel;
    tambah(node.antrian_delta_sync, {
        "entitas": "ROMBEL",
        "aksi": "UPSERT",
        "id": id_rombel,
        "stempel": waktu()
    });
    kembalikan rombel;
}

// Kompatibilitas Fungsi Lama
fungsi dapodik_tambah_rombel(node, id_rombel, nama_rombel, tingkat, kurikulum) {
    misal rombel = RombelDapodik(id_rombel, nama_rombel, tingkat, kurikulum);
    node.daftar_rombel[id_rombel] = rombel;
    tambah(node.antrian_delta_sync, {
        "entitas": "ROMBEL",
        "aksi": "UPSERT",
        "id": id_rombel,
        "stempel": waktu()
    });
    kembalikan rombel;
}

fungsi dapodik_tambah_pembelajaran_sk_pbm(
    node,
    id_pembelajaran,
    id_rombel,
    mata_pelajaran,
    nuptk_guru,
    no_sk_pbm,
    tgl_sk,
    jjm
) {
    misal linearitas = "LINEAR";
    misal pem = DapodikPembelajaran(
        id_pembelajaran,
        id_rombel,
        mata_pelajaran,
        nuptk_guru,
        no_sk_pbm,
        tgl_sk,
        jjm,
        linearitas
    );
    node.daftar_pembelajaran[id_pembelajaran] = pem;
    tambah(node.antrian_delta_sync, {
        "entitas": "PEMBELAJARAN",
        "aksi": "UPSERT",
        "id": id_pembelajaran,
        "stempel": waktu()
    });
    kembalikan pem;
}

// --- FUNGSI JADWAL PELAJARAN ---
fungsi dapodik_tambah_jadwal(
    node,
    id_jadwal,
    id_rombel,
    hari,
    jam_ke,
    id_ruang,
    nuptk_guru,
    mapel
) {
    misal bentrok = "AMAN_TERJADWAL";
    
    // Periksa apakah guru atau ruang sudah terisi pada hari dan jam_ke yang sama
    misal i = 0;
    selama i < panjang(node.daftar_jadwal) {
        misal j = node.daftar_jadwal[i];
        jika j.hari == hari dan j.jam_ke == jam_ke {
            jika j.id_ruang == id_ruang {
                bentrok = "BENTROK_RUANG";
            } kalau j.nuptk_guru == nuptk_guru {
                bentrok = "BENTROK_GURU";
            }
        }
        i = i + 1;
    }

    misal jadwal = DapodikJadwal(
        id_jadwal,
        id_rombel,
        hari,
        jam_ke,
        id_ruang,
        nuptk_guru,
        mapel,
        bentrok
    );

    tambah(node.daftar_jadwal, jadwal);
    tambah(node.antrian_delta_sync, {
        "entitas": "JADWAL",
        "aksi": "UPSERT",
        "id": id_jadwal,
        "stempel": waktu()
    });
    kembalikan jadwal;
}

// --- [8] MESIN AUDIT & VALIDASI DAPODIK ---
// Guardrail Utama: Jika total_invalid > 0, tombol sync dikunci!
fungsi dapodik_audit_validasi(node) {
    misal jml_invalid = 0;
    misal jml_warning = 0;
    misal list_invalid = [];
    misal list_warning = [];

    // 1. Validasi Satuan Pendidikan
    jika node.data_sekolah == nihil {
        jml_invalid = jml_invalid + 1;
        tambah(list_invalid, "[Tab Sekolah] Identitas Satuan Pendidikan & Titik Koordinat belum diisi lengkap");
    }

    // 2. Validasi Sanitasi
    jika node.data_sanitasi == nihil {
        jml_invalid = jml_invalid + 1;
        tambah(list_invalid, "[Tab Sanitasi] Data Sanitasi & Toilet Sekolah masih kosong");
    }

    // 3. Validasi Sarpras (Ruang harus punya bangunan)
    // Cek apakah ada ruang kelas
    jika panjang(node.daftar_ruang) == 0 {
        jml_warning = jml_warning + 1;
        tambah(list_warning, "[Tab Sarpras] Belum ada ruang kelas yang didaftarkan di sarpras");
    }

    // 4. Validasi Siswa
    jika panjang(node.daftar_siswa) == 0 {
        jml_warning = jml_warning + 1;
        tambah(list_warning, "[Tab Siswa] Daftar peserta didik masih kosong");
    }

    // 5. Validasi Guru / GTK
    jika panjang(node.daftar_guru) == 0 {
        jml_invalid = jml_invalid + 1;
        tambah(list_invalid, "[Tab GTK] Belum ada Pendidik dan Tenaga Kependidikan (GTK) terdaftar");
    }

    // 6. Validasi Rombel
    jika panjang(node.daftar_rombel) == 0 {
        jml_invalid = jml_invalid + 1;
        tambah(list_invalid, "[Tab Rombel] Belum ada rombongan belajar yang dibentuk");
    }

    misal status_sync = "SIAP_SINKRON_PUSDATIN";
    jika jml_invalid > 0 {
        status_sync = "TERKUNCI_KARENA_INVALID";
    }

    kembalikan DapodikHasilValidasi(
        jml_invalid,
        jml_warning,
        list_invalid,
        list_warning,
        status_sync
    );
}

// --- SINKRONISASI RESMI PUSDATIN KEMENDIKDASMEN ---
fungsi dapodik_sinkronisasi_resmi_pusdatin(node) {
    misal hasil_audit = dapodik_audit_validasi(node);

    // Kunci Sinkronisasi jika ada data invalid
    jika hasil_audit.total_invalid > 0 {
        kembalikan {
            "status": "SINKRONISASI_DIBLOKIR",
            "keterangan": "Gagal sinkron! Terdapat " + ke_teks(hasil_audit.total_invalid) + " data invalid di Dapodik yang wajib diselesaikan terlebih dahulu.",
            "total_invalid": hasil_audit.total_invalid,
            "hash_pusdatin": "NIHIL"
        };
    }

    // Eksekusi pengiriman payload delta sync terenkripsi
    misal total_mutasi = panjang(node.antrian_delta_sync);
    misal hash_payload = "0x" + sha256(node.npsn + ke_teks(waktu()) + ke_teks(total_mutasi));

    // Kosongkan antrean delta sync lokal
    node.antrian_delta_sync = [];

    kembalikan {
        "status": "SINKRONISASI_BERHASIL_PUSDATIN",
        "keterangan": "Seluruh 8 pilar data Dapodik berhasil disinkronkan ke Cloud Pusdatin Kemendikdasmen RI",
        "total_invalid": 0,
        "total_data_terkirim": total_mutasi,
        "hash_pusdatin": hash_payload
    };
}

// Kompatibilitas Fungsi Lama
fungsi dapodik_proses_delta_sync(node) {
    misal jumlah_item = panjang(node.antrian_delta_sync);
    misal ringkasan_sync = {
        "npsn": node.npsn,
        "jumlah_perubahan": jumlah_item,
        "status_pusdatin": "TERHUBUNG_DAN_TERVERIFIKASI",
        "hash_delta": "0x" + sha256(node.npsn + ke_teks(waktu()) + ke_teks(jumlah_item))
    };
    node.antrian_delta_sync = [];
    kembalikan ringkasan_sync;
}
