// ============================================================================
// SIMULASI SUITE: KONFIGURASI KOP SURAT SEKOLAH (WIDYA OFFICE SUITES)
// Menguji Kemampuan Sekolah Mengedit Kop Surat Mandiri:
// 1. Inisialisasi Kop Surat Default
// 2. Kustomisasi Identitas Lembaga (Pemda / Yayasan, Dinas, Sekolah, NSS, Akreditasi)
// 3. Kustomisasi Alamat Lengkap, Kontak Telepon, WhatsApp, Email, & Website
// 4. Kustomisasi Unggah Logo Kiri (Pemda) & Logo Kanan (Sekolah)
// 5. Kustomisasi Tipografi Font, Warna, & Garis Pembatas (Garis Ganda Tebal-Tipis Baku)
// 6. Generasi Kode HTML Kop Surat Siap Cetak Kertas F4 Folio
// 7. Integrasi Langsung ke Dokumen Widya Naskah (Tata Naskah Dinas F4)
// ============================================================================

impor "widyaos/modul/kop_surat_sekolah.wya";
impor "widyaos/modul/widya_office_suites.wya";

cetak("====================================================================");
cetak("🏫  SIMULASI: KUSTOMISASI KOP SURAT RESMI SEKOLAH (WIDYA OFFICE)     ");
cetak("====================================================================");

// [1] Inisialisasi Kop Default
cetak("\n[1] Inisialisasi Konfigurasi Kop Surat:");
misal kop = buat_konfigurasi_kop_default("20502621", "SMP NEGERI 2 DAWARBLANDONG");
cetak("  • NPSN Sekolah       :", kop.npsn_sekolah);
cetak("  • Nama Sekolah Awal  :", kop.nama_sekolah);
cetak("  • Font Default       :", kop.jenis_font);
cetak("  • Garis Pembatas     :", kop.gaya_garis_pembatas);

jika kop.npsn_sekolah == "20502621" {
    cetak("  ✅ PASS: Inisialisasi Konfigurasi Kop Surat Default Berhasil!");
} lainnya {
    cetak("  ❌ FAIL: Inisialisasi gagal!");
}

// [2] Edit Manual Identitas Lembaga & Sekolah
cetak("\n[2] Edit Manual Identitas Lembaga & Satuan Pendidikan:");
kop = perbarui_identitas_lembaga_kop(
    kop,
    "PEMERINTAH KABUPATEN MOJOKERTO",
    "DINAS PENDIDIKAN DAN KEBUDAYAAN",
    "SUB BAGIAN TATA USAHA & KURIKULUM",
    "SMP NEGERI 2 DAWARBLANDONG",
    "TERAKREDITASI A (UNGGUL)",
    "201050201002"
);

cetak("  • Instansi Pembina   :", kop.pemerintah_pembina);
cetak("  • Dinas Terkait      :", kop.dinas_pembina);
cetak("  • Cabang / Sub-Bag   :", kop.cabang_dinas_wilayah);
cetak("  • Nama Sekolah Resmi :", kop.nama_sekolah);
cetak("  • Akreditasi & NSS   :", kop.status_akreditasi, "| NSS:", kop.nomor_nss);

jika kop.pemerintah_pembina == "PEMERINTAH KABUPATEN MOJOKERTO" dan kop.nomor_nss == "201050201002" {
    cetak("  ✅ PASS: Identitas Lembaga & Satuan Pendidikan Berhasil Diperbarui!");
} lainnya {
    cetak("  ❌ FAIL: Update identitas lembaga gagal!");
}

// [3] Edit Manual Alamat & Kontak Resmi Sekolah
cetak("\n[3] Edit Manual Alamat, Titik Lokasi & Kanal Komunikasi:");
kop = perbarui_alamat_kontak_kop(
    kop,
    "Jl. Mayjen Sungkono No. 12, Ds. Dawarblandong",
    "Dawarblandong",
    "Kabupaten Mojokerto",
    "Jawa Timur",
    "61354",
    "(0321) 361234",
    "081234567890",
    "smpn2dawarblandong@mojokertokab.go.id",
    "https://smpn2dawarblandong.sch.id"
);

cetak("  • Alamat Jalan       :", kop.alamat_lengkap);
cetak("  • Kecamatan & Kab/Kota:", kop.kecamatan, "|", kop.kabupaten_kota);
cetak("  • Kode Pos           :", kop.kode_pos);
cetak("  • Telepon & WhatsApp :", kop.nomor_telepon, "| WA:", kop.nomor_whatsapp);
cetak("  • Pos-el & Laman Web :", kop.email_sekolah, "| Web:", kop.website_sekolah);

jika kop.kode_pos == "61354" dan kop.email_sekolah == "smpn2dawarblandong@mojokertokab.go.id" {
    cetak("  ✅ PASS: Alamat dan Kontak Resmi Sekolah Berhasil Diperbarui!");
} lainnya {
    cetak("  ❌ FAIL: Update alamat dan kontak gagal!");
}

// [4] Kustomisasi Logo (Unggah Logo Kiri Pemda & Kanan Sekolah)
cetak("\n[4] Pengaturan Logo Sekolah & Instansi (Dual-Logo):");
// Logo Kiri: Lambang Pemkab Mojokerto
kop = perbarui_logo_kop(
    kop,
    "KIRI",
    "/assets/logo_pemkab_mojokerto.png",
    benar,
    90
);

// Logo Kanan: Lambang Resmi SMPN 2 Dawarblandong
kop = perbarui_logo_kop(
    kop,
    "KANAN",
    "/assets/logo_smpn2_dawarblandong.png",
    benar,
    90
);

cetak("  • Logo Kiri (Pemda)  :", kop.logo_kiri_path, "(Aktif:", kop.tampilkan_logo_kiri, ")");
cetak("  • Logo Kanan (Sekolah):", kop.logo_kanan_path, "(Aktif:", kop.tampilkan_logo_kanan, ")");
cetak("  • Tinggi Logo        :", kop.tinggi_logo_px, "piksel");

jika kop.tampilkan_logo_kiri == benar dan kop.tampilkan_logo_kanan == benar {
    cetak("  ✅ PASS: Pengaturan Dual-Logo Kiri & Kanan Berhasil Dikonfigurasi!");
} lainnya {
    cetak("  ❌ FAIL: Pengaturan logo gagal!");
}

// [5] Kustomisasi Tipografi, Warna & Garis Pembatas Kop Surat
cetak("\n[5] Kustomisasi Tipografi & Garis Pembatas Baku:");
kop = perbarui_tampilan_garis_dan_font_kop(
    kop,
    "Arial",
    "GARIS_GANDA_TEBAL_TIPIS", // Garis ganda standar naskah dinas Permendikbud
    "#000000",
    "TENGAH"
);

cetak("  • Jenis Font         :", kop.jenis_font);
cetak("  • Garis Pembatas     :", kop.gaya_garis_pembatas);
cetak("  • Warna Elemen Teks  :", kop.warna_teks_kop);
cetak("  • Perataan Posisi    :", kop.posisi_perataan);

jika kop.jenis_font == "Arial" dan kop.gaya_garis_pembatas == "GARIS_GANDA_TEBAL_TIPIS" {
    cetak("  ✅ PASS: Tipografi & Garis Ganda Naskah Dinas Berhasil Dikonfigurasi!");
} lainnya {
    cetak("  ❌ FAIL: Pengaturan gaya gagal!");
}

// [6] Render Blok HTML Kop Surat
cetak("\n[6] Render HTML Kop Surat untuk Pencetakan F4/A4:");
misal html_kop = render_kop_surat_ke_html(kop);
misal panjang_html = panjang(html_kop);
cetak("  • Ukuran Karakter HTML:", panjang_html, "karakter ter-generate");

jika panjang_html > 100 {
    cetak("  ✅ PASS: Blok HTML Kop Surat Siap Cetak Berhasil Di-render!");
} lainnya {
    cetak("  ❌ FAIL: Render HTML gagal!");
}

// [7] Integrasi ke Dokumen Naskah Dinas Widya Naskah (F4)
cetak("\n[7] Integrasi Kop Surat Kustom ke Dokumen Naskah Dinas (F4):");
misal surat_undangan = buat_dokumen_widya_naskah(
    "DOC-2026-UND-012",
    "Undangan Rapat Pleno Dewan Guru & Komite Sekolah",
    "SURAT_DINAS_RESMI",
    "F4_FOLIO_INDONESIA",
    "did:sewidya:kepsek:suntoro"
);

misal hasil_integrasi = terapkan_kop_surat_kustom_ke_naskah(surat_undangan, kop);

cetak("  • Judul Surat        :", surat_undangan.judul_dokumen);
cetak("  • Kop Dinas Tertaut  :", surat_undangan.standar_kop_dinas);
cetak("  • Status Integrasi   :", hasil_integrasi.status_integrasi);

jika hasil_integrasi.status_integrasi == "KOP_SURAT_KUSTOM_BERHASIL_DITERAPKAN" {
    cetak("  ✅ PASS: Kop Surat Kustom Resmi Tertaut Sempurna ke Naskah Dinas F4!");
} lainnya {
    cetak("  ❌ FAIL: Integrasi kop surat gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 7/7 PENGUJIAN KONFIGURASI KOP SURAT LULUS (100%)  ");
cetak("====================================================================");
