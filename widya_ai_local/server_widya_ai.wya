        misal rows = [
            { "id_desa": "6409012001", "nama_desa": "Sepaku", "penduduk": 38400, "skor_kemandirian": 92.5 },
            { "id_desa": "3302012001", "nama_desa": "Kedungbanteng", "penduduk": 12500, "skor_kemandirian": 88.0 },
            { "id_desa": "5103012001", "nama_desa": "Kutuh", "penduduk": 8900, "skor_kemandirian": 95.0 }
        ];

        jika (req["badan"] != "" dan req["badan"] != kosong) {
