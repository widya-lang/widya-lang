// ==========================================================
// Modul Sidang Dewan Hakim & Black-Box Forensic Audit Trail
// ArenaSilat.id - Platform Digital Pencak Silat Berdaulat
// ==========================================================

misal NOMINAL_UANG_JAMINAN_BANDING = 3000000; // Rp 3.000.000 (Standar PB IPSI)

struktur SidangBandingDewanHakim {
    id_sidang,
    id_partai,
    nama_pemohon,
    kontingen_pemohon,
    sudut_pemohon,
    alasan_protes,
    status_uang_jaminan, // "DIVERIFIKASI_LUNAS", "BELUM_BAYAR"
    keputusan_akhir,     // "PROTES_DITERIMA", "PROTES_DITOLAK"
    disposisi_dana,      // "DIKEMBALIKAN_KE_KONTINGEN", "DISITA_MASUK_KAS_FEDERASI"

    fungsi daftarkan_protes(nama, kontingen, sudut, alasan) {
        ini.nama_pemohon = nama;
        ini.kontingen_pemohon = kontingen;
        ini.sudut_pemohon = sudut;
        ini.alasan_protes = alasan;
        ini.status_uang_jaminan = "DIVERIFIKASI_LUNAS";
        cetak("⚖️ Pendaftaran Sidang Banding Resmi #" + ini.id_sidang + " untuk Partai " + ini.id_partai);
        cetak("   Pemohon: " + nama + " [" + kontingen + " - Sudut " + sudut + "]");
        cetak("   Uang Jaminan: Rp " + ke_teks(NOMINAL_UANG_JAMINAN_BANDING) + " (LUNAS)");
        cetak("   Alasan: " + alasan);
    }

    fungsi putuskan_sidang(diterima) {
        jika diterima {
            ini.keputusan_akhir = "PROTES_DITERIMA";
            ini.disposisi_dana = "DIKEMBALIKAN_KE_KONTINGEN";
            cetak("✅ SIDANG DEWAN HAKIM: Protes Resmi DITERIMA!");
            cetak("   Keputusan: Hasil pertandingan ditinjau ulang / skor dikoreksi.");
            cetak("   Uang jaminan Rp " + ke_teks(NOMINAL_UANG_JAMINAN_BANDING) + " DIKEMBALIKAN UTUH.");
        } lainnya {
            ini.keputusan_akhir = "PROTES_DITOLAK";
            ini.disposisi_dana = "DISITA_MASUK_KAS_FEDERASI";
            cetak("❌ SIDANG DEWAN HAKIM: Protes Resmi DITOLAK!");
            cetak("   Keputusan: Hasil pertandingan awal tetap berlaku mutlak.");
            cetak("   Uang jaminan Rp " + ke_teks(NOMINAL_UANG_JAMINAN_BANDING) + " HANGUS (Masuk Kas Federasi IPSI).");
        }
    }
}
