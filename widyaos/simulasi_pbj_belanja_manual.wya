// ============================================================================
// SIMULASI SUITE: PBJ BELANJA MANUAL SATUAN PENDIDIKAN (PERMENDIKDASMEN 15/2026)
// Menguji Pembuktian Belanja Riil Toko Fisik (Non-SIPLah) Terekam 100% By-System:
// 1. Dokumen Rencana Belanja (Justifikasi Belanja Offline & Batas SSH)
// 2. Perbandingan Harga Minimal 2 Toko Fisik
// 3. Negosiasi Harga & Rekam Penghematan Kas
// 4. Pelaksanaan Kesepakatan (Surat Pesanan / SPK Digital)
// 5. Serah Terima Riil (BAST + Geotag GPS Toko + Hash Foto Fisik Barang Anti-Fiktif)
// 6. Pembayaran & Bukti Potong/Setor Pajak (NTPN 16-Digit)
// 7. Konsolidasi Berkas Digital (Dossier) Nilai Kepatuhan 100%
// ============================================================================

impor "widyaos/modul/pbj_belanja_manual_permendikdasmen.wya";

cetak("====================================================================");
cetak("🏛️  SIMULASI: AKUNTABILITAS BELANJA MANUAL (PERMENDIKDASMEN 15/2026) ");
cetak("    Pembuktian Belanja Riil Toko Fisik di Luar SIPLah Terekam By-System");
cetak("====================================================================");

// ----------------------------------------------------------------------------
// [TAHAP 1] Rencana Belanja & Verifikasi SSH
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 1] Dokumen Rencana Belanja (Purchase Requisition):");
misal rencana_sah = buat_rencana_belanja_manual(
    "PR-2026-03-001",
    "ANG-BOSP-2026-0042",
    "Pengadaan Bahan Praktik Kertas Gambar & Cat Akrilik",
    50,
    "Paket",
    120000.0, // Batas SSH: Rp 120.000 / paket
    "TOKO_LOKAL_BELUM_TERDAFTAR_SIPLAH_KEBUTUHAN_PRAKTIK_MINGGU_INI",
    benar
);

cetak("  • ID Rencana Belanja    :", rencana_sah.id_rencana);
cetak("  • Uraian Kebutuhan      :", rencana_sah.uraian_kebutuhan);
cetak("  • Justifikasi Belanja   :", rencana_sah.justifikasi_belanja_manual);
cetak("  • Persetujuan Kepala Sek:", rencana_sah.status_persetujuan_ks);

jika rencana_sah.status_persetujuan_ks == "DISETUJUI_KEPALA_SEKOLAH" {
    cetak("  ✅ PASS: Rencana Belanja Manual Sah Terkunci ke Anggaran RKAS & Batas SSH!");
} lainnya {
    cetak("  ❌ FAIL: Rencana belanja ditolak!");
}

// ----------------------------------------------------------------------------
// [TAHAP 2] Matriks Perbandingan Harga Minimal 2 Toko Fisik
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 2] Perbandingan Harga Toko Fisik (Multi-Vendor Comparison):");

misal daftar_penawaran = [];

// Toko A: Toko Buku & Alat Tulis "Sinar Usaha"
misal toko_a = TokoPenawarPembanding(
    "Toko Sinar Usaha",
    "Jl. Raya Dawarblandong No. 12, Mojokerto",
    "081234567890",
    "351601234567000",
    115000.0,
    5750000.0,
    salah
);
tambah(daftar_penawaran, toko_a);

// Toko B: Toko Alat Lukis "Pelangi Seni"
misal toko_b = TokoPenawarPembanding(
    "Toko Pelangi Seni",
    "Jl. Pahlawan No. 45, Mojokerto",
    "081298765432",
    "351609876543000",
    110000.0,
    5500000.0,
    benar
);
tambah(daftar_penawaran, toko_b);

// Evaluasi sistem menentukan toko terbaik
misal toko_pemenang = evaluasi_perbandingan_harga_manual(daftar_penawaran);

cetak("  • Jumlah Toko Disurvei  :", panjang(daftar_penawaran));
cetak("  • Penawaran Toko A      : Rp 5.750.000 (Toko Sinar Usaha)");
cetak("  • Penawaran Toko B      : Rp 5.500.000 (Toko Pelangi Seni)");
cetak("  • Toko Pemenang Pilihan :", toko_pemenang);

jika toko_pemenang == "Toko Pelangi Seni" {
    cetak("  ✅ PASS: Sistem Memilih Penawaran Terbaik Sesuai Prinsip Efisiensi Keuangan Negara!");
} lainnya {
    cetak("  ❌ FAIL: Evaluasi perbandingan harga salah!");
}

// ----------------------------------------------------------------------------
// [TAHAP 3] Negosiasi Harga (Digital Negotiation Log)
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 3] Negosiasi Harga dengan Toko Fisik Terpilih:");
misal log_nego = catat_hasil_negosiasi_manual(
    5500000.0, // Penawaran awal toko
    5000000.0, // Target sekolah
    5200000.0, // Hasil sepakat
    "Diskon pembelian 50 paket + bonus kuas 5 set & gratis antar ke sekolah"
);

cetak("  • Harga Penawaran Awal  : Rp", log_nego.harga_penawaran_awal);
cetak("  • Harga Sepakat Akhir   : Rp", log_nego.harga_final_kesepakatan);
cetak("  • Penghematan Anggaran  : Rp", log_nego.nominal_penghematan);
cetak("  • Catatan Kesepakatan   :", log_nego.catatan_kesepakatan);

jika log_nego.nominal_penghematan == 300000.0 {
    cetak("  ✅ PASS: Negosiasi Terekam Transparan dengan Penghematan Rp 300.000!");
} lainnya {
    cetak("  ❌ FAIL: Rekam negosiasi tidak akurat!");
}

// ----------------------------------------------------------------------------
// [TAHAP 4] Pelaksanaan Kesepakatan (Surat Pesanan / SPK Digital)
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 4] Pelaksanaan Kesepakatan (Surat Pesanan / SPK):");
misal spk_sah = terbitkan_spk_manual(
    "SPK-2026-03-089",
    "Toko Pelangi Seni",
    5200000.0,
    "did:sewidya:pengadaan:budi",
    "did:sewidya:ks:suntoro"
);

cetak("  • Nomor SPK Resmi       :", spk_sah.nomor_spk);
cetak("  • Rekanan Toko Fisik    :", spk_sah.nama_rekanan_toko);
cetak("  • Total Nilai Pesanan   : Rp", spk_sah.total_nilai_pesanan);
cetak("  • Status Dokumen SPK    :", spk_sah.status_spk);

jika spk_sah.status_spk == "SPK_RESMI_TERBIT_DITANDATANGANI_DIGITAL" {
    cetak("  ✅ PASS: Surat Pesanan Sah Diterbitkan dengan TTE Digital Kepala Sekolah!");
} lainnya {
    cetak("  ❌ FAIL: Penerbitan SPK gagal!");
}

// ----------------------------------------------------------------------------
// [TAHAP 5] Serah Terima Riil: BAST + Geotag GPS Toko + Hash Foto Fisik Barang
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 5] Serah Terima Fisik Riil (Anti-Belanja Fiktif):");
// Koordinat GPS toko fisik Dawarblandong Mojokerto (-7.382100, 112.441200)
// Foto fisik barang difoto di lokasi toko / saat diterima di sekolah
misal bast_riil = verifikasi_serah_terima_fisik(
    "BAST-2026-03-094",
    -7.3821,
    112.4412,
    "bukti_fisik_cat_akrilik_50_paket.jpg",
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", // SHA-256 foto
    benar,
    "did:sewidya:penerima:wahyu",
    "Toko Pelangi Seni"
);

cetak("  • Nomor BAST Resmi      :", bast_riil.nomor_bast);
cetak("  • Koordinat Geotag GPS  :", bast_riil.lokasi_geotag_lat, bast_riil.lokasi_geotag_lon);
cetak("  • Berkas Foto Fisik     :", bast_riil.nama_file_foto_barang);
cetak("  • Hash Bukti Fisik      :", bast_riil.hash_foto_kriptografi);
cetak("  • Status BAST           :", bast_riil.status_bast);

jika bast_riil.status_bast == "BAST_SAH_DIVERIFIKASI_FISIK" {
    cetak("  ✅ PASS: Bukti Geospasial GPS & Foto Fisik Barang Membuktikan Belanja Riil (Anti-Fiktif)!");
} lainnya {
    cetak("  ❌ FAIL: Verifikasi fisik BAST gagal!");
}

// ----------------------------------------------------------------------------
// [TAHAP 6] Pembayaran, Kuitansi & Pajak Kas Negara (NTPN)
// ----------------------------------------------------------------------------
cetak("\n[TAHAP 6] Pembayaran Kuitansi & Pemungutan Pajak Kas Negara:");
// Belanja Rp 5.200.000 via Non-Tunai Bank
// PPN 11% = Rp 515.315 (dari DPP 4.684.685) atau sesuai faktur toko
misal kuitansi_sah = proses_pembayaran_manual_bku(
    "KWT-2026-03-014",
    5200000.0,
    515315.0,  // PPN 11%
    0.0,       // PPh (dibawah ambang batas atau rekanan ber-NPWP UMKM)
    "NON_TUNAI_CMS_BANK",
    "6566F67OAL2CGO7O", // NTPN 16-Digit Kas Negara
    "did:sewidya:bendahara:ernawati"
);

cetak("  • Nomor Kuitansi BKU    :", kuitansi_sah.nomor_kuitansi);
cetak("  • Nominal Bruto         : Rp", kuitansi_sah.nominal_bruto);
cetak("  • Potongan PPN          : Rp", kuitansi_sah.potongan_ppn);
cetak("  • Nominal Netto Dibayar : Rp", kuitansi_sah.nominal_netto_dibayar);
cetak("  • Kode NTPN DJP         :", kuitansi_sah.kode_ntpn_pajak);

jika kuitansi_sah.nominal_netto_dibayar == 4684685.0 dan panjang(kuitansi_sah.kode_ntpn_pajak) == 16 {
    cetak("  ✅ PASS: Kuitansi Pembayaran Terbit dengan Pelunasan Pajak Ber-NTPN Sah!");
} lainnya {
    cetak("  ❌ FAIL: Kuitansi pembayaran salah!");
}

// ----------------------------------------------------------------------------
// [KONSOLIDASI DOSSIER] Audit Readiness Permendikdasmen 15/2026
// ----------------------------------------------------------------------------
cetak("\n[KONSOLIDASI DOSSIER] Verifikasi 6 Tahapan By-System untuk Pemeriksaan BPK:");

misal dossier_lengkap = validasi_dossier_pbj_manual_lengkap(
    "PBJ-MANUAL-2026-001",
    "KU-2026-0042",
    "NOTA-2026-0042",
    rencana_sah,
    daftar_penawaran,
    log_nego,
    spk_sah,
    bast_riil,
    kuitansi_sah
);

cetak("  • ID Transaksi PBJ      :", dossier_lengkap.id_transaksi_pbj);
cetak("  • Nilai Flag is_beli_siplah:", dossier_lengkap.is_beli_di_siplah, "(0 = Belanja Manual Toko Fisik)");
cetak("  • Skor Kepatuhan Regulasi :", dossier_lengkap.skor_kepatuhan_regulasi, "%");
cetak("  • Status Keabsahan Audit  :", dossier_lengkap.status_keabsahan_riil);

jika dossier_lengkap.skor_kepatuhan_regulasi == 100.0 dan dossier_lengkap.status_keabsahan_riil == "BELANJA_RIIL_TERBUKTI_VALID_ANTI_FIKTIF" {
    cetak("  ✅ PASS: 100% Seluruh 6 Tahapan Permendikdasmen 15/2026 Terekam By-System!");
    cetak("          Belanja Manual di Luar SIPLah Terbukti Riil, Transparan & Siap Audit BPK WTP!");
} lainnya {
    cetak("  ❌ FAIL: Dossier PBJ manual tidak memenuhi syarat!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 7/7 TAHAPAN PBJ MANUAL PERMENDIKDASMEN LULUS (100%)");
cetak("====================================================================");
