// ============================================================================
// MODUL: WIDYASTAT ANALISIS STATISTIKA INFERENSIAL & EKONOMETRIKA
// (Setara IBM SPSS Statistics, Stata, Minitab, & SAS)
//
// Fitur:
// 1. Dual-View Dataset: Data View & Variable View (Metadata, Scale/Measure)
// 2. Statistika Parametrik: Independent Samples t-Test, Paired Samples t-Test, One-Way ANOVA
// 3. Statistika Non-Parametrik: Chi-Square Test of Independence (Cramér's V)
// 4. Psikometrika & Evaluasi Asesmen: Cronbach's Alpha Reliability Analysis
// 5. Ekonometrika & Regresi Lanjutan: Multiple Regression, VIF Multikolinieritas, Durbin-Watson
// ============================================================================

struktur DefinisiVariabel {
    nama,
    label,
    tipe,             // "NUMERIK" atau "STRING"
    desimal,
    skala_pengukuran, // "SKALA", "ORDINAL", "NOMINAL"
    daftar_nilai_label
}

struktur DatasetWidyaStat {
    nama_dataset,
    daftar_variabel,
    baris_kasus,
    total_kasus
}

struktur HasilUjiT {
    jenis_uji,
    t_hitung,
    df,
    p_value_taksiran,
    beda_rata,
    ci_bawah_95,
    ci_atas_95,
    cohen_d,
    interpretasi
}

struktur HasilANOVA {
    sum_sq_between,
    sum_sq_within,
    sum_sq_total,
    df_between,
    df_within,
    df_total,
    mean_sq_between,
    mean_sq_within,
    f_hitung,
    p_value_taksiran,
    eta_squared,
    interpretasi
}

struktur HasilChiSquare {
    chi_square_hitung,
    df,
    p_value_taksiran,
    cramer_v,
    interpretasi
}

struktur HasilCronbachAlpha {
    jumlah_butir_k,
    varians_total,
    alpha_cronbach,
    kategori_reliabilitas
}

struktur HasilRegresiGanda {
    koefisien_beta_0, // Intercept
    koefisien_beta_1, // Slope X1
    koefisien_beta_2, // Slope X2
    r_squared,
    adj_r_squared,
    f_model,
    durbin_watson,
    vif_x1_x2,
    interpretasi
}

// ----------------------------------------------------------------------------
// STRUKTUR DATA MULTIVARIAT TINGKAT TINGGI (LEVEL DISERTASI / DOKTORAL S3)
// ----------------------------------------------------------------------------

struktur HasilMANOVA {
    wilks_lambda,
    pillai_trace,
    hotelling_trace,
    f_aproksimasi_rao,
    df_hipotesis,
    df_galat,
    p_value,
    partial_eta_squared,
    interpretasi
}

struktur HasilPCAFaktor {
    kmo_sampling_adequacy,
    bartlett_chi_square,
    bartlett_p_value,
    daftar_nilai_eigen,
    varians_kumulatif_persen,
    matriks_loading,
    interpretasi
}

struktur HasilPathAnalysisSEM {
    pengaruh_langsung,
    pengaruh_tidak_langsung,
    pengaruh_total,
    sobel_z_stat,
    sobel_p_value,
    vaf_persen,
    kategori_mediasi,
    interpretasi
}

struktur HasilUjiBreuschPagan {
    lm_statistic,
    df,
    p_value,
    status_asumsi,
    white_robust_se_b1,
    white_robust_se_b2,
    interpretasi
}

// ----------------------------------------------------------------------------
// STRUKTUR DATA ENTERPRISE: BIOSTATISTIKA, DERET WAKTU, HLM, LOGIT, PLS-SEM & LDA
// ----------------------------------------------------------------------------

struktur HasilKaplanMeier {
    waktu_titik,
    prob_survival_s_t,
    median_survival,
    log_rank_chi_sq,
    hazard_ratio,
    interpretasi
}

struktur HasilUjiADF {
    statistik_adf,
    nilai_kritis_1persen,
    nilai_kritis_5persen,
    p_value,
    status_stasioner,
    interpretasi
}

struktur HasilKausalitasGranger {
    lag,
    f_hitung,
    df1,
    df2,
    p_value,
    kesimpulan_kausal
}

struktur HasilMultilevelHLM {
    fixed_intercept,
    fixed_slope,
    tau_00_between,
    sigma_2_within,
    icc_persen,
    interpretasi
}

struktur HasilRegresiLogistik {
    beta_0,
    beta_1,
    beta_2,
    odds_ratio_x1,
    odds_ratio_x2,
    cox_snell_r2,
