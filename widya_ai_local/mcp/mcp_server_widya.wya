                                                                                            misal atr = ["status_warga", "zona_desa"];
                                                                                            misal nnc = "nonce_mcp_test_99";
                                                                                            jika (ada_kunci(args, "id_kredensial")) { id_kr = args["id_kredensial"]; }
                                                                                            jika (ada_kunci(args, "subjek_did")) { sbj = args["subjek_did"]; }
                                                                                            jika (ada_kunci(args, "atribut_diungkap")) { atr = args["atribut_diungkap"]; }
                                                                                            jika (ada_kunci(args, "nonce")) { nnc = args["nonce"]; }

                                                                                            misal vc_mock = id_terbitkan_kredensial(id_kr, "KTP_DIGITAL_DESA", "did:widya:desa:sepaku_resmi", sbj, { "status_warga": "TETAP", "zona_desa": "Sepaku_Hilir", "nik_privat": "6401019901010001" }, 31536000);
                                                                                            misal vp_mock = id_buat_presentasi_selektif_zk(vc_mock, atr, nnc, "salt_mcp");
                                                                                            misal vp_verif = id_verifikasi_presentasi_zk(vp_mock, vc_mock, "pubkey_mock");

                                                                                             hasil_konten = "Verifikasi Kredensial Privasi ZK (UU PDP No. 27/2022):\n" +
                                                                                                           "  - Status Validasi: " + vp_verif["status_privasi"] + "\n" +
                                                                                                           "  - Subjek DID    : " + vp_verif["subjek_did"] + "\n" +
                                                                                                           "  - Bukti ZK      : " + vp_verif["bukti_zk"] + "\n" +
                                                                                                           "  - Keterangan    : " + vp_verif["alasan"] + "\n" +
                                                                                                           "  - Kebocoran Data: 0% (Data Sensitif NIK Tidak Pernah Terbuka)";
                                                                                        } lainnya jika (tool_name == "simulasi_kekacauan_byzantine") {
                                                                                            misal id_sken = "chaos_mcp_01";
                                                                                            misal tip = "LATENSI_JARINGAN";
                                                                                            misal tgt = "simpul_konsensus";
                                                                                            misal intens = 0.8;
                                                                                            misal dur = 250;
                                                                                            jika (ada_kunci(args, "id_skenario")) { id_sken = args["id_skenario"]; }
                                                                                            jika (ada_kunci(args, "tipe_gangguan")) { tip = args["tipe_gangguan"]; }
                                                                                            jika (ada_kunci(args, "target_komponen")) { tgt = args["target_komponen"]; }
                                                                                            jika (ada_kunci(args, "intensitas")) { intens = args["intensitas"]; }
                                                                                            jika (ada_kunci(args, "durasi_ms")) { dur = args["durasi_ms"]; }

                                                                                            misal sken = chaos_buat_skenario(id_sken, tip, tgt, intens, dur);
                                                                                            misal lap_c = chaos_injeksi_gangguan(sken, 20.0);

                                                                                            hasil_konten = "Simulasi Rekayasa Kekacauan & Injeksi Gangguan (Widya-Chaos):\n" +
                                                                                                           "  - ID Skenario     : " + lap_c.id_skenario + "\n" +
                                                                                                           "  - Tipe Gangguan   : " + tip + "\n" +
                                                                                                           "  - Metrik Sebelum  : " + ke_teks(lap_c.metrik_sebelum) + " ms\n" +
                                                                                                           "  - Metrik Sesudah  : " + ke_teks(lap_c.metrik_sesudah) + " ms\n" +
                                                                                                           "  - Anomali Terdeteksi: " + ke_teks(lap_c.anomali_terdeteksi) + "\n" +
                                                                                                           "  - Status Respons  : " + lap_c.pesan_status + "\n" +
                                                                                                           "  - Segel PQC       : " + potong(lap_c.tanda_tangan_pqc, 0, 24) + "...";
                                                                                        } lainnya jika (tool_name == "pemulihan_mandiri_anti_entropi") {
                                                                                            misal tip_h = "REKONSILIASI_GOSSIP";
                                                                                            misal src_h = "simpul_desa_sepaku";
                                                                                            misal tgt_h = "simpul_desa_kedungbanteng";
                                                                                            misal ep_h = 101;
                                                                                            jika (ada_kunci(args, "tipe_pemulihan")) { tip_h = args["tipe_pemulihan"]; }
                                                                                            jika (ada_kunci(args, "simpul_sumber")) { src_h = args["simpul_sumber"]; }
                                                                                            jika (ada_kunci(args, "simpul_target")) { tgt_h = args["simpul_target"]; }
                                                                                            jika (ada_kunci(args, "epoch_id")) { ep_h = args["epoch_id"]; }

                                                                                            misal res_h = heal_rekonsiliasi_anti_entropi_gossip(src_h, tgt_h, { "epoch": ep_h, "version": 2 });

                                                                                            hasil_konten = "Pemulihan Mandiri & Rekonsiliasi Anti-Entropi (Widya-Heal):\n" +
                                                                                                           "  - ID Pemulihan    : " + res_h.id_pemulihan + "\n" +
                                                                                                           "  - Tindakan Remediasi: " + res_h.langkah_remediasi + "\n" +
                                                                                                           "  - RTO Tercapai    : " + ke_teks(res_h.waktu_pemulihan_ms) + " ms (Sub-10ms Zero-Downtime)\n" +
                                                                                                           "  - Keberhasilan    : " + ke_teks(res_h.keberhasilan) + "\n" +
                                                                                                           "  - Merkle Root Baru: " + potong(res_h.state_merkle_root, 0, 24) + "...\n" +
                                                                                                           "  - Integritas Data : 100% Konsisten Bebas Entropi";
                                                                                        } lainnya {
                                                                                            hasil_konten = "Alat '" + tool_name + "' belum terdaftar di MCP Server.";
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        kembalikan ke_json({
            "jsonrpc": "2.0",
            "id": id_req,
            "result": {
                "content": [
                    { "type": "text", "text": hasil_konten }
                ],
                "isError": salah
            }
        });
    }

    // 4. Method: resources/list
    jika (method == "resources/list") {
        misal res_list = [
            {
                "uri": "widya://kemendagri/peta_desa",
                "name": "Dataset Peta Desa Kemendagri 83.762 Desa",
                "mimeType": "application/geopackage+sqlite3"
            },
            {
                "uri": "widya://ai/silsilah_did",
                "name": "Jejak Audit Kriptografis W3C DID Merkle",
                "mimeType": "application/did+json"
            }
        ];
        kembalikan ke_json({
            "jsonrpc": "2.0",
            "id": id_req,
            "result": { "resources": res_list }
        });
    }

    // Fallback: Galat method tidak ditemukan
    kembalikan ke_json({
        "jsonrpc": "2.0",
        "id": id_req,
        "error": { "code": -32601, "message": "Method '" + method + "' tidak didukung oleh MCP Server." }
    });
}
