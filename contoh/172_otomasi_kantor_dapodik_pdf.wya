// ============================================================================
// CONTOH 172: OTOMASI KANTOR, PENGOLAHAN DATA SEKOLAH (DAPODIK) & EXPORT PDF NATIVE
// Widya-Lang Enterprise Productivity Suite (ISO 32000-1 Native %PDF-1.7)
// ============================================================================

cetak("====================================================================")
cetak("  🏢 SISTEM OTOMASI LAPORAN AKREDITASI & DAPODIK SEKOLAH WIDYA")
cetak("====================================================================")

// 1. Data Sekolah & Tenaga Kependidikan
biar profil_sekolah = {
    "npsn": "20109988",
    "nama": "SMA Negeri Unggulan Widya Nusantara",
    "jenjang": "SMA / Sederajat",
    "kabupaten": "Kota Bandung",
    "provinsi": "Jawa Barat",
    "akreditasi": "A (Unggul)"
}

biar rekapitulasi_siswa = [
    {"kelas": "Kelas X", "laki": 180, "perempuan": 195},
    {"kelas": "Kelas XI", "laki": 175, "perempuan": 190},
    {"kelas": "Kelas XII", "laki": 165, "perempuan": 185}
]

// 2. Hitung Agregasi Statistik
biar total_siswa = 0
biar total_laki = 0
biar total_perempuan = 0

untuk data di rekapitulasi_siswa {
    total_laki = total_laki + data["laki"]
    total_perempuan = total_perempuan + data["perempuan"]
    total_siswa = total_siswa + data["laki"] + data["perempuan"]
}

cetak("  NPSN                : " + profil_sekolah["npsn"])
cetak("  Nama Satuan Pendidik: " + profil_sekolah["nama"])
cetak("  Total Siswa Aktif   : " + teks(total_siswa) + " Peserta Didik (L: " + teks(total_laki) + ", P: " + teks(total_perempuan) + ")")
cetak("  Status Akreditasi   : " + profil_sekolah["akreditasi"])

// 3. Bangun Dokumen PDF Native ISO 32000-1
biar pdf = office_pdf_buat("Laporan_Akreditasi_Dapodik")

// Header Laporan
pdf = office_pdf_tambah_teks(pdf, "KEMENTERIAN PENDIDIKAN, KEBUDAYAAN, RISET, DAN TEKNOLOGI", 50.0, 780.0, 10.0)
pdf = office_pdf_tambah_teks(pdf, "DINAS PENDIDIKAN PROVINSI JAWA BARAT", 50.0, 768.0, 10.0)
pdf = office_pdf_tambah_teks(pdf, "LAPORAN AKREDITASI & REKAPITULASI POKOK PENDIDIKAN (DAPODIK)", 50.0, 745.0, 13.0)

// Informasi Profil Sekolah
pdf = office_pdf_tambah_teks(pdf, "NPSN: " + profil_sekolah["npsn"] + " | Nama: " + profil_sekolah["nama"], 50.0, 715.0, 11.0)
pdf = office_pdf_tambah_teks(pdf, "Wilayah: " + profil_sekolah["kabupaten"] + ", " + profil_sekolah["provinsi"], 50.0, 700.0, 10.0)
pdf = office_pdf_tambah_teks(pdf, "Peringkat Akreditasi: " + profil_sekolah["akreditasi"], 50.0, 685.0, 11.0)

// Tabel Ringkasan Siswa
pdf = office_pdf_tambah_teks(pdf, "1. Rekapitulasi Peserta Didik Aktif:", 50.0, 650.0, 11.0)
biar y_pos = 630.0
untuk d di rekapitulasi_siswa {
    biar baris = "- " + d["kelas"] + ": Laki-laki = " + teks(d["laki"]) + ", Perempuan = " + teks(d["perempuan"]) + ", Subtotal = " + teks(d["laki"] + d["perempuan"])
    pdf = office_pdf_tambah_teks(pdf, baris, 65.0, y_pos, 10.0)
    y_pos = y_pos - 18.0
}

pdf = office_pdf_tambah_teks(pdf, "TOTAL KESELURUHAN SISWA: " + teks(total_siswa) + " Orang", 65.0, y_pos - 10.0, 11.0)
pdf = office_pdf_tambah_teks(pdf, "Dokumen ini sah, terenkripsi dan diterbitkan otomatis oleh Mesin Widya-Lang ISO 32000-1.", 50.0, 100.0, 9.0)

cetak("\n✅ Dokumen PDF Laporan Akreditasi Dapodik Berhasil Dihasilkan Secara Native!")
