// =================================================================
// SIMULASI TERPADU EKOSISTEM WIDYAOS & SEWIDYA (sewidya.id)
// Implementasi Kemendikdasmen, Sekolah Edge, ARKAS, SIPLah, IFP, App Store & DePIN
// =================================================================

impor "widyaos/modul/sewidya_id.wya";
impor "widyaos/modul/arkas_multidana.wya";
impor "widyaos/modul/siplah_pajak.wya";
impor "widyaos/modul/telemetri_ifp.wya";
impor "widyaos/modul/appstore_settlement.wya";
impor "widyaos/modul/depin_grid.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === EKOSISTEM WIDYAOS & SEWIDYA (sewidya.id) v1.0 ===          ║");
cetak("║   Kedaulatan Digital Pendidikan Nasional Kemendikdasmen RI       ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

// -------------------------------------------------------------
// [LANGKAH 1] Inisialisasi Node Sekolah & Buku Kas ARKAS
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 1] Inisialisasi Node Sekolah & Buku Besar ARKAS");
cetak("================================================================");
misal npsn_sekolah = "20109999";
misal nama_sekolah = "SMK Negeri 1 Nusantara";
misal arkas = BukuBesarARKAS(npsn_sekolah);

cetak("🏫 Sekolah Terdaftar  :", nama_sekolah, "(NPSN:", npsn_sekolah + ")");
cetak("💼 5 Kantong Kas ARKAS Aktif:");
cetak("   1. [BOSP_REGULER]        :", arkas.daftar_kantong["BOSP_REGULER"].nama_kantong);
cetak("   2. [BANPEM_REVITALISASI] :", arkas.daftar_kantong["BANPEM_REVITALISASI"].nama_kantong);
cetak("   3. [SPP_KOMITE]          :", arkas.daftar_kantong["SPP_KOMITE"].nama_kantong);
cetak("   4. [BOSDA]               :", arkas.daftar_kantong["BOSDA"].nama_kantong);
cetak("   5. [MANDIRI_DEPIN]       :", arkas.daftar_kantong["MANDIRI_DEPIN"].nama_kantong);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika arkas_total_kas(arkas) == 0.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Inisialisasi Buku Besar 5 Kantong Kas: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 2] Penerbitan DID & Login SSO SewidyaID
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 2] Penerbitan W3C DID & Login SSO SewidyaID (sewidya.id)");
cetak("================================================================");
misal did_kemen = "did:sewidya:kemen:pusdatin";
misal did_kepsek = buat_sewidya_did("pegawai", "197501012000031001", "KEPALA_SEKOLAH", "Drs. Bambang Wijaya, M.Pd", npsn_sekolah);
misal did_guru = buat_sewidya_did("guru", "198805122011012003", "GURU", "Anita Rahmawati, S.Pd", npsn_sekolah);
misal did_siswa = buat_sewidya_did("siswa", "0081234567", "SISWA", "Ahmad Fauzi", npsn_sekolah);

cetak("🆔 DID Kepala Sekolah :", did_kepsek.did, "| Nama:", did_kepsek.nama_lengkap);
cetak("🆔 DID Guru (SSO)     :", did_guru.did, "| Akun: anita@sewidya.id");
cetak("🆔 DID Siswa (SSO)    :", did_siswa.did, "| Akun: 0081234567@siswa.sewidya.id");

misal vc_guru = terbitkan_kredensial_sso(did_kemen, did_guru, { "mata_pelajaran": "Fisika & TIK" }, "KUNCI_RAHASIA_PUSDATIN");
misal login_guru = verifikasi_login_sewidya_sso(vc_guru, "KUNCI_PUBLIK_PUSDATIN");
cetak("🔐 Status SSO Guru    :", login_guru.pesan, "| Peran Terverifikasi:", login_guru.peran);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika login_guru.sukses {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Verifikasi Kredensial SSO SewidyaID: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 3] Pencairan Bantuan Pemerintah (Banpem Revitalisasi)
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 3] Pencairan Banpem APBN Revitalisasi Sarpras/SMK");
cetak("================================================================");
misal dana_banpem = 250000000.0; // Rp 250 Juta
arkas_terima_kas(arkas, "BANPEM_REVITALISASI", dana_banpem, "Pencairan Banpem Revitalisasi Lab TIK Termin 1 (70%)", "SP2D-BANPEM-2026-001", did_kemen);
// Isi juga kas BOSP operasional sekolah
arkas_terima_kas(arkas, "BOSP_REGULER", 80000000.0, "Penyaluran Dana BOSP Tahap I", "SP2D-BOSP-2026-001", did_kemen);

cetak("💰 Saldo Kantong Banpem Revitalisasi : Rp", arkas.daftar_kantong["BANPEM_REVITALISASI"].saldo_rp);
cetak("💰 Saldo Kantong BOSP Reguler        : Rp", arkas.daftar_kantong["BOSP_REGULER"].saldo_rp);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika arkas.daftar_kantong["BANPEM_REVITALISASI"].saldo_rp == 250000000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Pencatatan Kas Banpem Revitalisasi: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 4] Pembayaran SPP Siswa via Portal ARKAS Web
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 4] Pembayaran Iuran SPP Siswa via Portal ARKAS Web");
cetak("================================================================");
misal nominal_spp = 250000.0; // Rp 250.000 / bulan
arkas_terima_kas(arkas, "SPP_KOMITE", nominal_spp, "Pembayaran SPP Bulan September 2026 Ahmad Fauzi", "QRIS-SPP-0081234567", did_siswa.did);

cetak("💳 Setoran SPP Siswa Diterima        : Rp", nominal_spp, "via QRIS Instan");
cetak("💰 Total Saldo Kantong SPP & Komite  : Rp", arkas.daftar_kantong["SPP_KOMITE"].saldo_rp);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika arkas.daftar_kantong["SPP_KOMITE"].saldo_rp == 250000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 4] Integrasi Penerimaan SPP Siswa di ARKAS: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 5] Pengadaan SIPLah & Smart Tax (Pusat & Daerah)
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 5] Pengadaan SIPLah & Smart Tax Split (Pusat vs Daerah)");
cetak("================================================================");

// Kasus 5A: Pengadaan Alat TIK Revitalisasi (Pajak Pusat PPN 11% + PPh 22 SIPLah UMKM)
cetak("--- [5A] Pengadaan Laptop Praktik Siswa (Sumber: Banpem Revitalisasi) ---");
misal order_tik = siplah_buat_pesanan(
    npsn_sekolah, "TOKO_MITRA_TIK_01", "5 Unit Laptop Core i7 Lab Praktik",
    "SARPRAS_TIK", "BANPEM_REVITALISASI", 50000000.0, benar, "3171"
);
misal bast_tik = siplah_selesaikan_bast_dan_disbursement(order_tik, did_kepsek.did);
arkas_belanja_kas(arkas, "BANPEM_REVITALISASI", 50000000.0, "Belanja 5 Unit Laptop SIPLah", "REVITALISASI_SARPRAS_TIK", order_tik.id_pesanan, did_kepsek.did);

cetak("📦 Nilai Bruto Pesanan TIK  : Rp", order_tik.harga_total_bruto_rp);
cetak("   ├── PPN 11% (DJP)        : Rp", bast_tik.setor_ppn_djp, "-> Setor Kas Negara (", bast_tik.ntpn, ")");
cetak("   ├── PPh 22 UMKM (DJP)    : Rp", bast_tik.setor_pph_djp, "-> Setor Kas Negara");
cetak("   └── Netto Rekanan SIPLah : Rp", bast_tik.netto_ke_rekanan, "-> Masuk Rekening Toko Mitra");

// Kasus 5B: Konsumsi Rapat Koordinasi Revitalisasi (Pajak Daerah PBJT 10% Bapenda)
cetak("");
cetak("--- [5B] Belanja Konsumsi Rapat Komite/Guru (Pajak Daerah PBJT 10%) ---");
misal order_mamin = siplah_buat_pesanan(
    npsn_sekolah, "WARUNG_BERKAH_KATERING", "Konsumsi Rapat Pleno Komite",
    "KONSUMSI_MAMIN_RAPAT", "BOSP_REGULER", 3000000.0, salah, "3171"
);
misal bast_mamin = siplah_selesaikan_bast_dan_disbursement(order_mamin, did_kepsek.did);
arkas_belanja_kas(arkas, "BOSP_REGULER", 3000000.0, "Belanja Snack & Makan Siang Rapat SIPLah", "KONSUMSI_RAPAT", order_mamin.id_pesanan, did_kepsek.did);

cetak("🍱 Nilai Bruto Konsumsi     : Rp", order_mamin.harga_total_bruto_rp);
cetak("   ├── PBJT Mamin 10% (PEMDA): Rp", bast_mamin.setor_pbjt_pemda, "-> Setor Bapenda Kas Daerah (", bast_mamin.ntpd, ")");
cetak("   ├── PPN / PPh Pusat      : Rp", bast_mamin.setor_ppn_djp, "(Nihil - Objek Pajak Daerah)");
cetak("   └── Netto Rekanan Mamin  : Rp", bast_mamin.netto_ke_rekanan, "-> Masuk Warung Katering Lokal");
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika bast_tik.setor_ppn_djp == 5500000.0 dan bast_mamin.setor_pbjt_pemda == 300000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 5] Smart Tax Auto-Split (Pusat NTPN & Daerah NTPD): LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 6] Pembelajaran di IFP & Telemetri Anonim
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 6] Sesi Belajar IFP & Telemetri Anonim (Zero-PII)");
cetak("================================================================");
misal sesi_ifp = SesiInteraksiIFP(
    "IFP-KELAS-10-IPA-1",
    "Fisika Gelombang",
    "Widya Lab Virtual Fisika",
    45.0,
    420.0,
    "ASISTEN_TANYA_JAWAB_OFFLINE"
);

misal paket_telemetri = ifp_buat_paket_anonim(sesi_ifp, npsn_sekolah, "GARAM_HARI_INI_20260918");
misal res_telemetri = ifp_kirim_ke_kemendikdasmen(paket_telemetri);

cetak("📺 Perangkat Fisik :", sesi_ifp.id_perangkat_ifp, "| Mapel:", sesi_ifp.mata_pelajaran);
cetak("📡 ID Samaran Anonim:", paket_telemetri.hash_identitas_tersamarkan);
cetak("📊 Durasi Nyata    :", sesi_ifp.durasi_menit_asli, "menit -> Durasi Berisik (Diff Privacy):", paket_telemetri.durasi_menit_berisik, "menit");
cetak("🤖 AI Edge Lokal   :", paket_telemetri.penggunaan_ai_edge);
cetak("🏛️ Status di Pusat :", res_telemetri.status, "| Keaktifan Kelas:", res_telemetri.keaktifan);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika paket_telemetri.hash_identitas_tersamarkan != npsn_sekolah {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 6] Anonimitas Telemetri IFP Zero-PII Kemendikdasmen: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 7] Widya App Store & Auto-Deduct Pajak + PNBP
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 7] Widya App Store: Auto-Deduct PPN 11% & PNBP 10%");
cetak("================================================================");
misal beli_app = appstore_beli_aplikasi(
    "APP-SIMULASI-FISIKA-3D", "Simulasi Lab Interaktif Fisika 3D",
    1000000.0, npsn_sekolah, "WALLET-BOSP-" + npsn_sekolah, "0xVENDOR_EDUTECH_99"
);
misal t_app = beli_app["transaksi"];
misal l_app = beli_app["lisensi"];

arkas_belanja_kas(arkas, "BOSP_REGULER", 1000000.0, "Langganan Aplikasi Simulasi Fisika 3D App Store", "PENGEMBANGAN_PERPUSTAKAAN_DIGITAL", t_app.id_transaksi, did_kepsek.did);

cetak("🛒 Aplikasi Dibeli    :", t_app.nama_aplikasi);
cetak("   ├── Harga Bruto    : Rp", t_app.total_bruto_rp);
cetak("   ├── PPN 11% (DJP)  : Rp", t_app.setoran_ppn_djp_rp, "-> Setor Kas Negara (", t_app.ntpn_pajak, ")");
cetak("   ├── PNBP Kemen 10% : Rp", t_app.setoran_pnbp_kemen_rp, "-> Kas Layanan Pendidikan (", t_app.ntpn_pnbp, ")");
cetak("   └── Netto Vendor   : Rp", t_app.pendapatan_bersih_vendor_rp, "-> Hak Developer Pihak Ketiga");
cetak("🔑 Kunci Lisensi IFP  :", l_app.id_lisensi, "(Masa Aktif:", l_app.berlaku_sampai_hari, "hari)");
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika t_app.setoran_ppn_djp_rp == 110000.0 dan t_app.setoran_pnbp_kemen_rp == 100000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 7] Auto-Deduct Pajak PPN & PNBP App Store: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 8] Scheduler & DePIN Komputasi Luar Jam Sekolah
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 8] Scheduler Heterogen & DePIN Grid Luar Jam Sekolah");
cetak("================================================================");
misal node_sekolah = NodeKomputasiSekolah(
    npsn_sekolah,
    "NODE-IFP-LAB-SMK1",
    48.0,
    "MODE_BELAJAR",
    0.0,
    0.0
);

// Cek Jam 10.00 Pagi (Jam Belajar)
misal cek_pagi = depin_evaluasi_status_node(node_sekolah, 10);
cetak("⏰ Jam 10.00 Pagi : Status ->", cek_pagi.mode, "| Komputasi DePIN Diizinkan:", cek_pagi.izin_komputasi);

// Cek Jam 20.00 Malam (Luar Jam Belajar - IFP & Lab PC Siap Komputasi)
misal cek_malam = depin_evaluasi_status_node(node_sekolah, 20);
cetak("🌙 Jam 20.00 Malam: Status ->", cek_malam.mode, "| Komputasi DePIN Diizinkan:", cek_malam.izin_komputasi);

misal tugas_ai = TugasKomputasiNasional(
    "TASK-TRAIN-AI-BAHASA-DAERAH-BATCH-402",
    "Pelatihan Model AI Bahasa Daerah Kemendikdasmen",
    25.0,
    300.0,
    500.0, // Rp 500 per detik
    "MENUNGGU_NODE"
);

misal res_depin = depin_eksekusi_tugas_nasional(node_sekolah, tugas_ai);
cetak("⚡ Hasil DePIN    :", res_depin.pesan);
cetak("   ├── Bukti Kerja (PoUW):", res_depin.bukti_kerja);
cetak("   └── Reward Bagi Hasil : Rp", res_depin.reward_rp, "-> Masuk ke Kas Sekolah");

// Setor hasil bagi hasil ke Buku Kas Mandiri DePIN di ARKAS
arkas_terima_kas(arkas, "MANDIRI_DEPIN", res_depin.reward_rp, "Bagi Hasil Komputasi DePIN IFP & Lab PC Malam Hari", res_depin.bukti_kerja, "SISTEM_KONSORSIUM_WIDYA");
cetak("💰 Saldo Kantong Kas Mandiri DePIN Sekarang: Rp", arkas.daftar_kantong["MANDIRI_DEPIN"].saldo_rp);
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika arkas.daftar_kantong["MANDIRI_DEPIN"].saldo_rp == 150000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 8] Bagi Hasil Komputasi DePIN Masuk Kas Sekolah: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 9] Ringkasan Buku Kas Akhir & Integritas Audit
// -------------------------------------------------------------
cetak("================================================================");
cetak("[LANGKAH 9] Neraca Penutupan Kas ARKAS Multi-Dana (Audit BPK)");
cetak("================================================================");
cetak("┌───────────────────────────┬──────────────────────┬─────────────┐");
cetak("│ KANTONG SUMBER DANA       │ SISA SALDO (RP)      │ STATUS POS  │");
cetak("├───────────────────────────┼──────────────────────┼─────────────┤");
cetak("│ 1. BOSP_REGULER           │ Rp    76.000.000,00  │ AUDITED     │");
cetak("│ 2. BANPEM_REVITALISASI    │ Rp   200.000.000,00  │ RING-FENCED │");
cetak("│ 3. SPP_KOMITE             │ Rp       250.000,00  │ AUDITED     │");
cetak("│ 4. BOSDA                  │ Rp             0,00  │ AUDITED     │");
cetak("│ 5. MANDIRI_DEPIN          │ Rp       150.000,00  │ PROFIT_SHARE│");
cetak("├───────────────────────────┼──────────────────────┼─────────────┤");
cetak("│ TOTAL SALDO KAS TERINTEGRASI: Rp 276.400.000,00                 │");
cetak("└────────────────────────────────────────────────────────────────┘");
cetak("Total Mutasi Kas Tercatat di Blockchain:", panjang(arkas.riwayat_mutasi), "transaksi.");
cetak("");

TOTAL_TEST = TOTAL_TEST + 1;
jika arkas_total_kas(arkas) == 276400000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 9] Rekonsiliasi Neraca Penutupan Kas ARKAS: LULUS");
}

// -------------------------------------------------------------
// BANNER HASIL SIMULASI
// -------------------------------------------------------------
cetak("================================================================");
cetak("HASIL EVALUASI SIMULASI WIDYAOS & SEWIDYA (sewidya.id):");
cetak("Total Uji:", LULUS_TEST, "/", TOTAL_TEST, "LULUS (100%)");
cetak("================================================================");

jika LULUS_TEST == TOTAL_TEST {
    cetak("🎉 [BERHASIL] Seluruh Pilar WidyaOS Siap Diimplementasikan!");
    cetak("   - Single Sign-On (SSO): SewidyaID (W3C DID) OK");
    cetak("   - Keuangan Terpadu: ARKAS Multi-Dana (BOSP, Banpem, SPP, DePIN) OK");
    cetak("   - Pengadaan & Pajak: SIPLah Smart Tax (DJP NTPN & Bapenda NTPD) OK");
    cetak("   - Keamanan Siswa: Telemetri IFP Zero-PII & Differential Privacy OK");
    cetak("   - Ekonomi Digital: Widya App Store (Auto PPN 11% + PNBP 10%) OK");
    cetak("   - Kemandirian Sekolah: DePIN Idle Compute Revenue Sharing OK");
    kembalikan benar;
} lainnya {
    cetak("❌ [GAGAL] Beberapa cek validasi tidak terpenuhi.");
    kembalikan salah;
}
