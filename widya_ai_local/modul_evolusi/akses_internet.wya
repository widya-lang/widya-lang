// ============================================================================
// MODUL AKSES INTERNET & PENELUSURAN WEB BERDAULAT (akses_internet.wya)
// Konektivitas HTTP/HTTPS, Web Search, Sanitasi HTML, & Guardrail UU PDP
// Berjalan di Perangkat Lokal dengan Proteksi Non-Leakage Data Kedaulatan
// ============================================================================

struktur ResponsWeb {
    sukses,
    status_kode,
    url,
    konten_bersih,
    konten_mentah,
    latensi_ms,
    pesan_keamanan
}

struktur HasilPencarianWeb {
    kueri,
    total_hasil,
    daftar_hasil,
    sumber,
    status_koneksi
}

// Fungsi bantu pengecekan awalan teks
fungsi teks_diawali_dengan(teks, awalan) {
    misal p_teks = panjang(teks);
    misal p_awal = panjang(awalan);
    jika (p_awal > p_teks) { kembalikan salah; }
    kembalikan potong(teks, 0, p_awal) == awalan;
}

// Fungsi bantu substring
fungsi teks_ada_sub(teks, sub) {
    misal p_teks = panjang(teks);
    misal p_sub = panjang(sub);
    jika (p_sub > p_teks) { kembalikan salah; }
    jika (p_sub == 0) { kembalikan benar; }
    misal batas = p_teks - p_sub + 1;
    misal i = 0;
    selama (i < batas) {
        jika (potong(teks, i, i + p_sub) == sub) {
            kembalikan benar;
        }
        i = i + 1;
    }
    kembalikan salah;
}

// Filter Keamanan Jaringan & Pencegahan Kebocoran Data (UU PDP No. 27/2022)
fungsi ai_filter_keamanan_jaringan(url) {
    misal u = huruf_kecil(url);

    // 1. Pastikan skema protokol aman
    jika (!teks_diawali_dengan(u, "http://") dan !teks_diawali_dengan(u, "https://")) {
        kembalikan {
            "aman": salah,
            "alasan": "Protokol URL tidak diizinkan. Hanya http:// dan https:// yang didukung."
        };
    }

    // 2. Cegah kebocoran token rahasia, kunci privat, atau kredensial internal
    misal kata_terlarang = ["private_key", "password=", "secret=", "did:widya:secret", "kunci_privat", "token_rahasia"];
    untuk kata di kata_terlarang {
        jika (teks_ada_sub(u, kata)) {
            kembalikan {
                "aman": salah,
                "alasan": "Pencegahan Kebocoran Data: URL mengandung parameter sensitif/kredensial rahasia."
            };
        }
    }

    kembalikan {
        "aman": benar,
        "alasan": "URL memenuhi syarat keamanan kedaulatan data."
    };
}

// Pembersih Tag HTML & Entitas Menjadi Teks Murni
fungsi bersihkan_html(html_str) {
    misal p = panjang(html_str);
    misal hasil = "";
    misal di_dalam_tag = salah;
    misal i = 0;

    selama (i < p) {
        misal c = potong(html_str, i, i + 1);
        jika (c == "<") {
            di_dalam_tag = benar;
        } lainnya {
            jika (c == ">") {
                di_dalam_tag = salah;
                hasil = hasil + " ";
            } lainnya {
                jika (!di_dalam_tag) {
                    hasil = hasil + c;
                }
            }
        }
        i = i + 1;
    }

    // Perapian spasi berlebih
    misal p_h = panjang(hasil);
    misal rapi = "";
    misal spasi_sebelumnya = salah;
    misal j = 0;
    selama (j < p_h) {
        misal ch = potong(hasil, j, j + 1);
        jika (ch == " " atau ch == "\t" atau ch == "\r" atau ch == "\n") {
            jika (!spasi_sebelumnya) {
                rapi = rapi + " ";
                spasi_sebelumnya = benar;
            }
        } lainnya {
            rapi = rapi + ch;
            spasi_sebelumnya = salah;
        }
        jika (panjang(rapi) > 2000) {
            // Batas maksimal peringkasan teks awal
            j = p_h;
        }
        j = j + 1;
    }

    kembalikan rapi;
}

// Uji Pengecekan Konektivitas Internet Cepat
fungsi ai_cek_koneksi_internet() {
    misal t_awal = waktu();
    misal res = http_get("https://httpbin.org/get");
    misal t_akhir = waktu();
    misal selisih = t_akhir - t_awal;
    jika (selisih <= 0) { selisih = 1; }

    jika (res["sukses"]) {
        kembalikan {
            "terhubung": benar,
            "latensi_ms": selisih,
            "mode": "ONLINE_TERKONEKSI",
            "pesan": "Koneksi internet aktif dan siap digunakan."
        };
    } lainnya {
        kembalikan {
            "terhubung": salah,
            "latensi_ms": 0,
            "mode": "AIR_GAPPED_3T_OFFLINE",
            "pesan": "Perangkat dalam mode luring (offline/air-gapped 3T). Menggunakan memori sintetis lokal."
        };
    }
}

// Pengambilan Halaman Web Aman
fungsi ai_ambil_halaman_web(url, batas_karakter) {
    misal cek_aman = ai_filter_keamanan_jaringan(url);
    jika (!cek_aman["aman"]) {
        kembalikan ResponsWeb(
            salah,
            403,
            url,
            "",
            "",
            0,
            "DITOLAK_GATE_KEAMANAN: " + cek_aman["alasan"]
        );
    }

    misal t0 = waktu();
    misal resp = http_get(url);
    misal t1 = waktu();
    misal lat = t1 - t0;
    jika (lat <= 0) { lat = 1; }

    jika (resp["sukses"]) {
        misal mentah = resp["badan"];
        misal bersih = bersihkan_html(mentah);
        jika (batas_karakter > 0 dan panjang(bersih) > batas_karakter) {
            bersih = potong(bersih, 0, batas_karakter) + "... [terpotong]";
        }
        kembalikan ResponsWeb(
            benar,
            resp["status"],
            url,
            bersih,
            mentah,
            lat,
            "LOLOS_VERIFIKASI_KEAMANAN"
        );
    } lainnya {
        kembalikan ResponsWeb(
            salah,
            500,
            url,
            "",
            "",
            lat,
            "GAGAL_KONEKSI: " + ke_teks(resp["salah"])
        );
    }
}

// Pencarian Web Cerdas Menggunakan Open Search API
fungsi ai_cari_web(kueri, maks_hasil) {
    // 1. Normalisasi string kueri untuk URL
    misal q_encoded = "";
    misal p_q = panjang(kueri);
    misal k = 0;
    selama (k < p_q) {
        misal char = potong(kueri, k, k + 1);
        jika (char == " ") {
            q_encoded = q_encoded + "+";
        } lainnya {
            q_encoded = q_encoded + char;
        }
        k = k + 1;
    }

    // Cek konektivitas internet terlebih dahulu
    misal status_net = ai_cek_koneksi_internet();

    jika (status_net["terhubung"]) {
        // Coba API Wikipedia Indonesia
        misal url_wiki = "https://id.wikipedia.org/w/api.php?action=opensearch&search=" + q_encoded + "&limit=" + ke_teks(maks_hasil) + "&format=json";
        misal resp_wiki = http_get(url_wiki);

        jika (resp_wiki["sukses"]) {
            misal data_json = dari_json(resp_wiki["badan"]);
            // Format Opensearch Wikipedia: [kueri, [judul1, ...], [deskripsi1, ...], [tautan1, ...]]
            misal judul_list = data_json[1];
            misal desk_list = data_json[2];
            misal url_list = data_json[3];

            misal hasil = [];
            misal total = panjang(judul_list);
            misal idx = 0;
            selama (idx < total) {
                tambah(hasil, {
                    "judul": judul_list[idx],
                    "ringkasan": desk_list[idx],
                    "tautan": url_list[idx]
                });
                idx = idx + 1;
            }

            jika (total > 0) {
                kembalikan HasilPencarianWeb(
                    kueri,
                    total,
                    hasil,
                    "WIKIPEDIA_ID_API",
                    "ONLINE"
                );
            }
        }

        // Coba DuckDuckGo Instant Answer API sebagai alternatif
        misal url_ddg = "https://api.duckduckgo.com/?q=" + q_encoded + "&format=json&no_html=1&skip_disambig=1";
        misal resp_ddg = http_get(url_ddg);
        jika (resp_ddg["sukses"]) {
            misal dj = dari_json(resp_ddg["badan"]);
            misal hasil_ddg = [];
            misal heading = dj["Heading"];
            misal abstrak = dj["AbstractText"];
            misal src_url = dj["AbstractURL"];

            jika (abstrak != "" dan abstrak != kosong dan abstrak != nihil) {
                tambah(hasil_ddg, {
                    "judul": heading,
                    "ringkasan": abstrak,
                    "tautan": src_url
                });
                kembalikan HasilPencarianWeb(
                    kueri,
                    1,
                    hasil_ddg,
                    "DUCKDUCKGO_INSTANT_ANSWER",
                    "ONLINE"
                );
            }
        }
    }

    // Fallback: Basis Pengetahuan Sintetis Mandiri (Offline / Air-gapped 3T)
    misal hasil_fallback = [];
    tambah(hasil_fallback, {
        "judul": "Informasi Pengetahuan: " + kueri,
        "ringkasan": "Data diambil dari repositori pengetahuan lokal Widya-AI untuk topik '" + kueri + "'. Beroperasi secara mandiri tanpa ketergantungan server luar.",
        "tautan": "widya://lokal/pengetahuan/" + q_encoded
    });

    kembalikan HasilPencarianWeb(
        kueri,
        1,
        hasil_fallback,
        "BASIS_PENGETAHUAN_LOKAL_MANDIRI",
        status_net["mode"]
    );
}
