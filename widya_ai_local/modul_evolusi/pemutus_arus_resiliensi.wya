// ============================================================================
// MODUL PEMUTUS ARUS RESILIENSI / CIRCUIT BREAKER (pemutus_arus_resiliensi.wya)
// Pola Ketahanan Industri: Mencegah Kegagalan Berantai (Cascading Failure)
// Status: TERTUTUP (Normal), TERBUKA (Isolasi & Fallback), SETENGAH_TERBUKA (Probe)
// ============================================================================

struktur PemutusArus {
    nama_layanan,
    status,
    ambang_kegagalan,
    jumlah_gagal_beruntun,
    waktu_terbuka_terakhir,
    durasi_jeda_detik,
    jumlah_sukses_pemulihan,
    cache_fallback
}

// 1. Inisialisasi Pemutus Arus Baru
fungsi inisialisasi_pemutus_arus(nama, ambang_gagal, durasi_jeda, data_fallback) {
    kembalikan PemutusArus(
        nama,
        "TERTUTUP",
        ambang_gagal,
        0,
        0,
        durasi_jeda,
        0,
        data_fallback
    );
}

// 2. Evaluasi Izin Eksekusi Permintaan
fungsi pemutus_arus_izinkan_eksekusi(breaker) {
    misal t_sekarang = waktu();

    // Jika sedang TERBUKA, periksa apakah masa jeda pemulihan sudah terpenuhi
    jika (breaker.status == "TERBUKA") {
        misal selisih = t_sekarang - breaker.waktu_terbuka_terakhir;
        jika (selisih >= breaker.durasi_jeda_detik) {
            // Masuk ke fase uji pemulihan (SETENGAH_TERBUKA)
            breaker.status = "SETENGAH_TERBUKA";
            breaker.jumlah_sukses_pemulihan = 0;
            kembalikan benar;
        } lainnya {
            // Masih dalam masa isolasi (Fail Fast ke Fallback)
            kembalikan salah;
        }
    }

    // Jika TERTUTUP atau SETENGAH_TERBUKA, izinkan eksekusi
    kembalikan benar;
}

// 3. Catat Keberhasilan Eksekusi
fungsi pemutus_arus_catat_sukses(breaker) {
    jika (breaker.status == "SETENGAH_TERBUKA") {
        breaker.jumlah_sukses_pemulihan = breaker.jumlah_sukses_pemulihan + 1;
        jika (breaker.jumlah_sukses_pemulihan >= 2) {
            // Pemulihan penuh tercapai, kembalikan ke status normal TERTUTUP
            breaker.status = "TERTUTUP";
            breaker.jumlah_gagal_beruntun = 0;
            breaker.jumlah_sukses_pemulihan = 0;
        }
    } lainnya {
        jika (breaker.status == "TERTUTUP") {
            breaker.jumlah_gagal_beruntun = 0;
        }
    }
}

// 4. Catat Kegagalan Eksekusi (Memicu Tripping ke TERBUKA)
fungsi pemutus_arus_catat_gagal(breaker) {
    misal t_sekarang = waktu();
    breaker.jumlah_gagal_beruntun = breaker.jumlah_gagal_beruntun + 1;

    jika (breaker.status == "SETENGAH_TERBUKA" atau breaker.jumlah_gagal_beruntun >= breaker.ambang_kegagalan) {
        breaker.status = "TERBUKA";
        breaker.waktu_terbuka_terakhir = t_sekarang;
    }
}

// 5. Dapatkan Respon Fallback Cepat (Sub-Milidetik)
fungsi pemutus_arus_dapatkan_fallback(breaker) {
    kembalikan {
        "status_breaker": breaker.status,
        "layanan": breaker.nama_layanan,
        "is_fallback": benar,
        "konten": breaker.cache_fallback,
        "keterangan": "Layanan utama sedang dalam masa pemulihan pemutus arus. Respon dialihkan ke cadangan lokal berdaulat."
    };
}
