// ============================================================================
// MODUL: WIDYA APP STORE & SUBSCRIPTION SETTLEMENT (appstore_langganan_pihak_ketiga.wya)
// Platform Pengadaan & Berlangganan Aplikasi Pihak Ketiga untuk Sekolah
//
// 1. Registrasi Paket Vendor (Per-Siswa Bulanan, Per-Sekolah Tahunan, Per-Device IFP)
// 2. Split Settlement Otomatis: PPN 11% (DJP), PNBP 10% (Kemendikdasmen), 79% Vendor
// 3. Lifecycle Guardrail: Notifikasi H-30, Grace Period 14 Hari (Pencairan BOSP)
// 4. Auto-Posting Buku Kas Umum (BKU) Rekening Belanja ARKAS 5.1.02.02.01.0063
// ============================================================================

struktur PaketLanggananVendor {
    id_paket,
    id_vendor,
    nama_vendor,
    nama_aplikasi,
    model_tagihan,
    harga_bruto_rp,
    periode_hari,
    kode_rekening_arkas,
    status_kurasi,
    did_pengembang
}

struktur KontrakLanggananSekolah {
    id_kontrak,
    npsn_sekolah,
    id_paket,
    nama_aplikasi,
    tanggal_mulai_iso,
    tanggal_berakhir_iso,
    hari_aktif_tersisa,
    status_layanan,
    kunci_lisensi_did
}

struktur SettlementBagiHasil {
    id_settlement,
    id_transaksi,
    id_paket,
    total_bruto_rp,
    setoran_ppn_11_rp,
    setoran_pnbp_10_rp,
    hak_bersih_vendor_79_rp,
    ntpn_pajak_djp,
    ntpn_pnbp_kemendikdasmen,
    metode_pencairan,
    status
}

struktur JurnalBKUARKAS {
    id_bku,
    tanggal_iso,
    kode_rekening,
    uraian_belanja,
    nominal_debet_rp,
    nomor_bukti,
    ntpn,
    status_bku
}

// ----------------------------------------------------------------------------
// [1] REGISTRASI PAKET LANGGANAN VENDOR
// ----------------------------------------------------------------------------

fungsi appstore_daftarkan_paket(id_pkt, id_vnd, nama_vnd, nama_app, model, harga, hari, did_vnd) {
    kembalikan PaketLanggananVendor(
        id_pkt,
        id_vnd,
        nama_vnd,
        nama_app,
        model,
        harga,
        hari,
        "5.1.02.02.01.0063",
        "LOLOS_KURASI_PUSKURBUK_KEMENDIKDASMEN",
        did_vnd
    );
}

// ----------------------------------------------------------------------------
// [2] PEMBELIAN LANGGANAN & SPLIT SETTLEMENT OTOMATIS
// ----------------------------------------------------------------------------

fungsi appstore_beli_langganan_sekolah(paket, npsn, saldo_kas_sekolah, tanggal_mulai_iso, tgl_selesai_iso) {
    misal harga = paket.harga_bruto_rp;

    // Guardrail saldo kas sekolah
    jika saldo_kas_sekolah < harga {
        kembalikan {
            "sukses": salah,
            "pesan": "SALDO_KAS_BOSP_TIDAK_MENCUKUPI",
            "kontrak": kosong,
            "settlement": kosong
        };
    }

    // Perhitungan Split Settlement: 11% PPN, 10% PNBP, 79% Hak Vendor
    misal ppn_11 = (harga * 11) / 100;
    misal pnbp_10 = (harga * 10) / 100;
    misal hak_vendor = harga - (ppn_11 + pnbp_10);

    misal id_trx = "TRX-APP-" + potong(sha256(paket.id_paket + npsn + tanggal_mulai_iso), 0, 10);
    misal ntpn_djp = "NTPN-DJP-" + potong(sha256(id_trx + "PAJAK_PPN_11"), 0, 12);
    misal ntpn_pnbp = "PNBP-KEMEN-" + potong(sha256(id_trx + "PNBP_DIKBUD_10"), 0, 12);

    misal settlement = SettlementBagiHasil(
        "SETTLE-" + id_trx,
        id_trx,
        paket.id_paket,
        harga,
        ppn_11,
        pnbp_10,
        hak_vendor,
        ntpn_djp,
        ntpn_pnbp,
        "BI_FAST_SETTLEMENT_LANGSUNG",
        "LUNAS_TERBAGI_OTOMATIS"
    );

    misal id_kontrak = "SUB-" + npsn + "-" + potong(sha256(id_trx), 0, 8);
    misal lisensi_did = "did:widya:license:" + potong(sha256(id_kontrak + paket.did_pengembang), 0, 16);

    misal kontrak = KontrakLanggananSekolah(
        id_kontrak,
        npsn,
        paket.id_paket,
        paket.nama_aplikasi,
        tanggal_mulai_iso,
        tgl_selesai_iso,
        paket.periode_hari,
        "AKTIF",
        lisensi_did
    );

    kembalikan {
        "sukses": benar,
        "pesan": "PEMBELIAN_LANGGANAN_BERHASIL",
        "kontrak": kontrak,
        "settlement": settlement
    };
}

// ----------------------------------------------------------------------------
// [3] EVALUASI SIKLUS LANGGANAN & GRACE PERIOD 14 HARI
// ----------------------------------------------------------------------------

fungsi appstore_evaluasi_siklus_langganan(kontrak, hari_berjalan) {
    misal sisa_hari = kontrak.hari_aktif_tersisa - hari_berjalan;
    misal status = "AKTIF";

    jika sisa_hari > 30 {
        status = "AKTIF";
    } selain_itu jika sisa_hari > 0 dan sisa_hari <= 30 {
        status = "MENDEKATI_KADALUWARSA";
    } selain_itu jika sisa_hari <= 0 dan sisa_hari >= -14 {
        // Masa tenggang 14 hari toleransi proses pencairan dana BOSP
        status = "GRACE_PERIOD_14_HARI";
    } selain_itu {
        status = "NONAKTIF_KADALUWARSA";
    }

    kontrak.hari_aktif_tersisa = sisa_hari;
    kontrak.status_layanan = status;
    kembalikan kontrak;
}

// ----------------------------------------------------------------------------
// [4] PERPANJANGAN LANGGANAN (RENEWAL)
// ----------------------------------------------------------------------------

fungsi appstore_perpanjang_langganan(kontrak_lama, paket, hari_tambahan, tanggal_baru_iso) {
    misal sisa = 0;
    jika kontrak_lama.hari_aktif_tersisa > 0 {
        sisa = kontrak_lama.hari_aktif_tersisa;
    }
    kontrak_lama.hari_aktif_tersisa = sisa + hari_tambahan;
    kontrak_lama.tanggal_berakhir_iso = tanggal_baru_iso;
    kontrak_lama.status_layanan = "AKTIF";
    kembalikan kontrak_lama;
}

// ----------------------------------------------------------------------------
// [5] AUTO-POSTING BUKU KAS UMUM (BKU) ARKAS
// ----------------------------------------------------------------------------

fungsi appstore_buat_jurnal_bku_arkas(kontrak, settlement, tanggal_bku) {
    misal id_bku = "BKU-BOSP-" + potong(sha256(kontrak.id_kontrak + settlement.id_transaksi), 0, 10);
    misal uraian = "Pembayaran Langganan Aplikasi " + kontrak.nama_aplikasi + " (NTPN: " + settlement.ntpn_pajak_djp + ")";

    kembalikan JurnalBKUARKAS(
        id_bku,
        tanggal_bku,
        "5.1.02.02.01.0063",
        uraian,
        settlement.total_bruto_rp,
        settlement.id_transaksi,
        settlement.ntpn_pajak_djp,
        "TERPOSTING_BKU_BOSP"
    );
}
