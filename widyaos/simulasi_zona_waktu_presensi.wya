// =================================================================
// SIMULASI SUITE: PRESENSI LINTAS 3 ZONA WAKTU (WIB, WITA, WIT)
// Menjamin Presensi di Wilayah Timur (Papua & Maluku) Bebas Diskriminasi Waktu
// =================================================================

impor "widyaos/modul/zona_waktu_indonesia.wya";

cetak("==================================================================");
cetak("     UJI PRESENSI NASIONAL TIGA ZONA WAKTU (WIB, WITA, WIT)       ");
cetak("==================================================================");

// [TEST 1] Presensi Wilayah Timur (WIT - Papua) Tepat Waktu
// Guru di SMA Negeri 1 Jayapura presensi jam 07:15 WIT
cetak("\n[1] Uji Presensi Wilayah Timur (WIT - Jayapura, Papua [Kode 91])");
misal res_wit = evaluasi_presensi_berkeadilan_wilayah(
    "198203152008011005",
    "Yohanes Mandowen, S.Pd",
    "91", // Kode Provinsi Papua (WIT, UTC+9)
    "07:15:00",
    "07:30:00"
);

cetak("👨‍🏫 Pegawai              :", res_wit.nama);
cetak("🌏 Zona Waktu           :", res_wit.zona_waktu, "(UTC+9)");
cetak("⏰ Jam Presensi Lokal   :", res_wit.jam_lokal);
cetak("🏢 Jam Ekuivalen Pusat  :", res_wit.jam_server_jakarta_ekuivalen);
cetak("🟢 Status Kehadiran     :", res_wit.status_kehadiran);
cetak("📋 Keterangan Sistem    :", res_wit.keterangan_audit);

jika res_wit.zona_waktu == "WIT" dan res_wit.status_kehadiran == "HADIR_TEPAT_WAKTU" {
    cetak("✅ [TEST 1] Presensi Wilayah Timur (WIT) Bebas Diskriminasi Waktu Server: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Presensi Wilayah Timur (WIT) Bebas Diskriminasi Waktu Server: GAGAL");
}

// [TEST 2] Presensi Wilayah Tengah (WITA - Bali & Sulawesi) Tepat Waktu
// Guru di SMP Negeri 2 Denpasar presensi jam 07:20 WITA
cetak("\n[2] Uji Presensi Wilayah Tengah (WITA - Denpasar, Bali [Kode 51])");
misal res_wita = evaluasi_presensi_berkeadilan_wilayah(
    "198604122010012011",
    "Ni Made Ayu Pratiwi, M.Pd",
    "51", // Kode Provinsi Bali (WITA, UTC+8)
    "07:20:00",
    "07:30:00"
);

cetak("👩‍🏫 Pegawai              :", res_wita.nama);
cetak("🌏 Zona Waktu           :", res_wita.zona_waktu, "(UTC+8)");
cetak("⏰ Jam Presensi Lokal   :", res_wita.jam_lokal);
cetak("🏢 Jam Ekuivalen Pusat  :", res_wita.jam_server_jakarta_ekuivalen);
cetak("🟢 Status Kehadiran     :", res_wita.status_kehadiran);

jika res_wita.zona_waktu == "WITA" dan res_wita.status_kehadiran == "HADIR_TEPAT_WAKTU" {
    cetak("✅ [TEST 2] Presensi Wilayah Tengah (WITA) Tepat Waktu Lokal: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Presensi Wilayah Tengah (WITA) Tepat Waktu Lokal: GAGAL");
}

// [TEST 3] Presensi Wilayah Barat (WIB - Jawa Barat) Tepat Waktu
// Guru di SMK Negeri 1 Bandung presensi jam 07:25 WIB
cetak("\n[3] Uji Presensi Wilayah Barat (WIB - Bandung, Jawa Barat [Kode 32])");
misal res_wib = evaluasi_presensi_berkeadilan_wilayah(
    "197809202002121003",
    "Asep Hidayat, S.T",
    "32", // Kode Provinsi Jawa Barat (WIB, UTC+7)
    "07:25:00",
    "07:30:00"
);

cetak("👨‍🏫 Pegawai              :", res_wib.nama);
cetak("🌏 Zona Waktu           :", res_wib.zona_waktu, "(UTC+7)");
cetak("⏰ Jam Presensi Lokal   :", res_wib.jam_lokal);
cetak("🏢 Jam Ekuivalen Pusat  :", res_wib.jam_server_jakarta_ekuivalen);
cetak("🟢 Status Kehadiran     :", res_wib.status_kehadiran);

jika res_wib.zona_waktu == "WIB" dan res_wib.status_kehadiran == "HADIR_TEPAT_WAKTU" {
    cetak("✅ [TEST 3] Presensi Wilayah Barat (WIB) Tepat Waktu Lokal: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Presensi Wilayah Barat (WIB) Tepat Waktu Lokal: GAGAL");
}

// [TEST 4] Deteksi Keterlambatan Murni di Wilayah Timur (Bukan Efek Konversi)
// Guru di Merauke presensi jam 07:45 WIT (melewati batas 07:30 WIT)
cetak("\n[4] Uji Keterlambatan Murni di Wilayah Timur (Merauke [Kode 93])");
misal res_telat_wit = evaluasi_presensi_berkeadilan_wilayah(
    "199011112015031002",
    "Markus Wanma, S.Pd",
    "93", // Papua Selatan (WIT)
    "07:45:00",
    "07:30:00"
);

cetak("👨‍🏫 Pegawai              :", res_telat_wit.nama);
cetak("⏰ Jam Presensi Lokal   :", res_telat_wit.jam_lokal);
cetak("🚨 Status Kehadiran     :", res_telat_wit.status_kehadiran);
cetak("⏳ Keterlambatan        :", res_telat_wit.keterlambatan_menit, "menit (Dihitung adil berdasarkan jam setempat)");

jika res_telat_wit.status_kehadiran == "TERLAMBAT" dan res_telat_wit.keterlambatan_menit == 15 {
    cetak("✅ [TEST 4] Deteksi Keterlambatan Murni Berdasarkan Waktu Setempat: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Deteksi Keterlambatan Murni Berdasarkan Waktu Setempat: GAGAL");
}

// [TEST 5] Validasi Pemetaan 38 Provinsi ke Tiga Zona Waktu Tanpa Cacat
cetak("\n[5] Uji Konsistensi Pemetaan 38 Provinsi ke Tiga Zona Waktu");
misal master_zona = get_definisi_zona_waktu();
misal total_prov_wib = panjang(master_zona["WIB"].daftar_kode_provinsi);
misal total_prov_wita = panjang(master_zona["WITA"].daftar_kode_provinsi);
misal total_prov_wit = panjang(master_zona["WIT"].daftar_kode_provinsi);
misal total_semua = total_prov_wib + total_prov_wita + total_prov_wit;

cetak("🗺️ Provinsi Zona WIB   :", total_prov_wib, "Provinsi (Sumatera, Jawa, Kalbar, Kalteng)");
cetak("🗺️ Provinsi Zona WITA  :", total_prov_wita, "Provinsi (Bali, Nusa Tenggara, Kalsel, Kaltim, Kaltara, Sulawesi)");
cetak("🗺️ Provinsi Zona WIT   :", total_prov_wit, "Provinsi (Maluku, Maluku Utara, 6 Provinsi Papua)");
cetak("🇮🇩 Total Cakupan       :", total_semua, "Provinsi (100% Seluruh Indonesia)");

jika total_semua == 38 {
    cetak("✅ [TEST 5] Pemetaan 38 Provinsi NKRI ke WIB, WITA, WIT: LULUS 100%");
} lainnya {
    cetak("❌ [TEST 5] Pemetaan 38 Provinsi NKRI ke WIB, WITA, WIT: GAGAL");
}

cetak("\n==================================================================");
cetak("     SEMUA PENGUJIAN TIGA ZONA WAKTU INDONESIA LULUS 100%!        ");
cetak("==================================================================");
