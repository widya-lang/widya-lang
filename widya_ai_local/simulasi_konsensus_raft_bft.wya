// ============================================================================
// SUITE PENGUJIAN OTOMATIS FASE 22: SOVEREIGN WIDYA-CONSENSUS (RAFT-BFT)
// (simulasi_konsensus_raft_bft.wya)
// Byzantine-Resistant Raft Consensus, Distributed WAL on VFS, Dynamic Leader
// Election & Term Governance, Verifiable ZK-Merkle Snapshots, Autonomous Quorum
// Reconfiguration, & Cross-Village Disaster Recovery
// Perangkat Target: AMD Ryzen 7 8840HS (Zen 4 8C/16T, Radeon 780M, NPU 16 TOPS)
// ============================================================================

impor "widya_ai_local/modul_evolusi/konsensus_raft_bft.wya";
impor "widya_ai_local/mcp/mcp_server_widya.wya";

fungsi asserts(kondisi, pesan) {
    jika (!kondisi) {
        cetak("  [GAGAL]: " + pesan);
    } lainnya {
        cetak("  [PASS] " + pesan);
    }
}

fungsi jalankan_pengujian_konsensus_raft_bft() {
    cetak("======================================================================");
    cetak("SUITE UJI FASE 22: SOVEREIGN WIDYA-CONSENSUS (RAFT-BFT & WAL)");
    cetak("Protokol         : Byzantine-Resistant Raft Consensus on VFS");
    cetak("Kriptografi      : NIST FIPS 204 ML-DSA-65 Post-Quantum Digital Signatures");
    cetak("Persistensi      : Distributed Write-Ahead Logging (WAL) Sub-0.5ms Fsync");
    cetak("Pemulihan        : Verifiable Compact ZK-Merkle Snapshots (Fast-Sync)");
    cetak("Ketahanan Swarm  : Solar-Drained Adaptive Quorum Reconfiguration (2f+1)");
    cetak("Kedaulatan Data  : Deterministic Split-Brain Shield & Zero Data Loss");
    cetak("======================================================================");

    misal rekan_sepaku = ["did:widya:node:kb_02", "did:widya:node:kutuh_03", "did:widya:node:bakongan_04"];

    // 1. Inisialisasi Simpul Raft & State Awal
    cetak("\n[UJI 1] Inisialisasi Simpul Raft & State Awal...");
    misal node_sepaku = raft_inisialisasi_simpul("did:widya:node:sepaku_01", rekan_sepaku);
    asserts(node_sepaku.did_simpul == "did:widya:node:sepaku_01", "DID simpul sesuai");
    asserts(node_sepaku.peran == "PENGIKUT", "Peran awal simpul adalah PENGIKUT");
    asserts(node_sepaku.istilah_saat_ini == 0, "Istilah (term) awal adalah 0");
    asserts(node_sepaku.indeks_komit == 0, "Indeks komit awal adalah 0");
    asserts(node_sepaku.parameter_konsensus["total_anggota"] == 4, "Total 4 simpul dalam kuorum konsensus");
    asserts(node_sepaku.parameter_konsensus["ukuran_quorum"] == 2, "Ukuran kuorum awal mayoritas 2");

    // 2. Transisi State ke CALON & Kenaikan Istilah saat Election Timeout
    cetak("\n[UJI 2] Transisi State ke CALON & Kenaikan Istilah saat Election Timeout...");
    misal hasil_mulai = raft_mulai_pemilihan_pemimpin(node_sepaku);
    asserts(hasil_mulai["sukses"] == benar, "Inisiasi pemilihan pemimpin sukses");
    asserts(node_sepaku.peran == "CALON", "Transisi sukses ke peran CALON");
    asserts(node_sepaku.istilah_saat_ini == 1, "Istilah dinaikkan menjadi 1");
    asserts(node_sepaku.did_memilih == "did:widya:node:sepaku_01", "Simpul memilih dirinya sendiri");

    // 3. Pembuatan & Validasi Pesan RequestVote dengan Segel ML-DSA-65
    cetak("\n[UJI 3] Pembuatan & Validasi Pesan RequestVote dengan Segel ML-DSA-65...");
    misal req_vote_sepaku = hasil_mulai["permintaan_suara"];
    asserts(req_vote_sepaku.istilah_calon == 1, "Istilah calon valid 1");
    asserts(req_vote_sepaku.did_calon == "did:widya:node:sepaku_01", "DID calon valid did:widya:node:sepaku_01");
    asserts(potong(req_vote_sepaku.tanda_tangan_calon, 0, 20) == "sig_mldsa65_vote_req", "Segel tanda tangan ML-DSA-65 valid");

    // 4. Penanganan RequestVote oleh Follower (Vote Granted jika Term > currentTerm)
    cetak("\n[UJI 4] Penanganan RequestVote oleh Follower (Vote Granted)...");
    misal rekan_kb = ["did:widya:node:sepaku_01", "did:widya:node:kutuh_03", "did:widya:node:bakongan_04"];
    misal node_kb = raft_inisialisasi_simpul("did:widya:node:kb_02", rekan_kb);
    misal hasil_vote_kb = raft_tangani_permintaan_suara(node_kb, req_vote_sepaku);
    misal resp_vote_kb = hasil_vote_kb["respons"];
    asserts(resp_vote_kb.suara_diberikan == benar, "Node KB memberikan suara SETUJU");
    asserts(node_kb.istilah_saat_ini == 1, "Istilah Node KB dimutakhirkan ke 1");
    asserts(node_kb.did_memilih == "did:widya:node:sepaku_01", "Node KB mencatat memilih Sepaku");

    // 5. Penolakan RequestVote jika Term Kandidat Lebih Rendah (Stale Term Rejection)
    cetak("\n[UJI 5] Penolakan RequestVote jika Term Kandidat Lebih Rendah (Stale Term)...");
    misal req_vote_stale = PesanPermintaanSuaraBFT(
        0,
        "did:widya:node:stale_99",
        0,
        0,
        "sig_mldsa65_stale"
    );
    misal hasil_vote_stale = raft_tangani_permintaan_suara(node_kb, req_vote_stale);
    misal resp_stale = hasil_vote_stale["respons"];
    asserts(resp_stale.suara_diberikan == salah, "Permintaan suara dari istilah usang DITOLAK");
    asserts(resp_stale.istilah_pemilih == 1, "Istilah pemilih tetap 1 (lebih tinggi)");

    // 6. Penghitungan Suara & Promosi Otonom ke LEADER saat Kuorum Tercapai
    cetak("\n[UJI 6] Penghitungan Suara & Promosi Otonom ke LEADER saat Kuorum Tercapai...");
    // Node Kutuh juga memberikan suara setuju
    misal resp_vote_kutuh = PesanResponsSuaraBFT(
        1,
        benar,
        "did:widya:node:kutuh_03",
        "sig_mldsa65_vote_kutuh"
    );
    misal daftar_suara = [resp_vote_kb, resp_vote_kutuh];
    misal hasil_promosi = raft_hitung_suara_dan_promosi(node_sepaku, daftar_suara);
    asserts(hasil_promosi["sukses"] == benar, "Kandidat berhasil memenangkan pemilihan");
    asserts(node_sepaku.peran == "PEMIMPIN", "Status simpul dipromosikan menjadi PEMIMPIN");
    asserts(hasil_promosi["total_suara"] == 3, "Total 3 suara setuju (1 sendiri + 2 rekan)");

    // 7. Pengajuan Perintah Baru pada Pemimpin & Penulisan WAL Terdistribusi
    cetak("\n[UJI 7] Pengajuan Perintah Baru pada Pemimpin & Penulisan WAL Terdistribusi...");
    misal data_perintah_1 = { "desa": "Sepaku", "nominal_idr": 1500000000, "kategori": "Infrastruktur_Smart_Village" };
    misal hasil_wal_1 = raft_tambah_perintah_pemimpin(node_sepaku, "ALOKASI_DANA_DESA", data_perintah_1);
    asserts(hasil_wal_1["sukses"] == benar, "Penambahan entri ke WAL pemimpin sukses");
    asserts(hasil_wal_1["indeks_log"] == 1, "Indeks entri WAL pertama adalah 1");
    asserts(hasil_wal_1["istilah"] == 1, "Istilah entri WAL sesuai istilah pemimpin (1)");
    asserts(panjang(node_sepaku.log_wal) == 1, "Panjang log WAL pemimpin kini 1");
    asserts(potong(node_sepaku.log_wal[0].segel_pqc_pemimpin, 0, 16) == "sig_mldsa65_wal_", "Hash entri WAL terdistribusi valid");

    // 8. Replikasi Log ke Pengikut via AppendEntries & Verifikasi Hash Log Berantai
    cetak("\n[UJI 8] Replikasi Log ke Pengikut via AppendEntries & Verifikasi Hash Berantai...");
    misal data_perintah_2 = { "versi_model": "v1.2.0", "bobot": "INT8", "target_npu": "Ryzen AI XDNA" };
    misal hasil_wal_2 = raft_tambah_perintah_pemimpin(node_sepaku, "PEMBARUAN_MODEL_SLM", data_perintah_2);
    asserts(hasil_wal_2["indeks_log"] == 2, "Indeks entri WAL kedua adalah 2");
    asserts(panjang(node_sepaku.log_wal) == 2, "Total 2 entri tercatat di WAL pemimpin");
    asserts(hasil_wal_2["pesan_append"].indeks_sebelumnya == 1, "Indeks sebelumnya pada pesan replikasi adalah 1");

    // 9. Penanganan AppendEntries oleh Pengikut & Penyesuaian Commit Index
    cetak("\n[UJI 9] Penanganan AppendEntries oleh Pengikut & Penyesuaian Commit Index...");
    misal pesan_ae = PesanTambahEntriBFT(
        1,
        "did:widya:node:sepaku_01",
        0,
        0,
        node_sepaku.log_wal,
        1,
        "sig_mldsa65_ae_batch_9f1e"
    );
    misal resp_ae_kb = raft_tangani_tambah_entri(node_kb, pesan_ae);
    asserts(resp_ae_kb["sukses"] == benar, "Pengikut berhasil mereplikasi entri AppendEntries");
    asserts(resp_ae_kb["indeks_terakhir"] == 2, "Log terakhir pengikut sinkron ke indeks 2");
    asserts(node_kb.indeks_komit == 1, "Indeks komit pengikut termutakhirkan ke 1");

    // 10. Linearizable State Machine Commit (Aplikasi ke State Machine Lokal)
    cetak("\n[UJI 10] Linearizable State Machine Commit (Aplikasi ke State Machine)...");
    misal ack_kb = { "indeks_terakhir": 2 };
    misal ack_kutuh = { "indeks_terakhir": 2 };
    misal daftar_ack = [ack_kb, ack_kutuh];
    misal hasil_komit = raft_komit_dan_terapkan_keadaan(node_sepaku, daftar_ack);
    asserts(hasil_komit["sukses"] == benar, "Komit linearizable pada pemimpin sukses");
    asserts(hasil_komit["indeks_komit"] == 2, "Indeks komit pemimpin menjadi 2");
    asserts(node_sepaku.indeks_diterapkan == 2, "Perintah 1..2 berhasil diaplikasikan ke state machine");
    asserts(node_sepaku.keadaan_mesin["ALOKASI_DANA_DESA"] != kosong, "State aplikasi berisi ALOKASI_DANA_DESA");
    asserts(node_sepaku.keadaan_mesin["PEMBARUAN_MODEL_SLM"] != kosong, "State aplikasi berisi PEMBARUAN_MODEL_SLM");

    // 11. Pemadatan Log melalui Snapshot ZK-Merkle Kompak & Log Truncation
    cetak("\n[UJI 11] Pemadatan Log melalui Snapshot ZK-Merkle Kompak & Log Truncation...");
    misal snap_sepaku = raft_buat_snapshot_keadaan(node_sepaku);
    asserts(snap_sepaku["sukses"] == benar, "Pembuatan snapshot ZK-Merkle sukses");
    asserts(snap_sepaku["snapshot"].indeks_terakhir_disertakan == 2, "Indeks termasuk snapshot adalah 2");
    asserts(snap_sepaku["snapshot"].istilah_terakhir == 1, "Istilah termasuk snapshot adalah 1");
    asserts(potong(snap_sepaku["snapshot"].akar_merkle_keadaan, 0, 13) == "merkle_state_", "Akar Merkle snapshot valid");
    asserts(node_sepaku.snapshot_terakhir.indeks_terakhir_disertakan == 2, "Snapshot aktif tersimpan di simpul pemimpin");
    asserts(snap_sepaku["sisa_log"] == 0, "Log WAL berhasil dipadatkan (0 entri tersisa pasca-snapshot)");

    // 12. Fast-Sync State Recovery dari Snapshot untuk Simpul Baru/Tertinggal
    cetak("\n[UJI 12] Fast-Sync State Recovery dari Snapshot untuk Simpul Tertinggal...");
    // Buat simpul tertinggal (Node Bakongan pasca mati listrik / cold boot)
    misal rekan_bakongan = ["did:widya:node:sepaku_01", "did:widya:node:kb_02", "did:widya:node:kutuh_03"];
    misal node_bakongan = raft_inisialisasi_simpul("did:widya:node:bakongan_04", rekan_bakongan);
    asserts(node_bakongan.indeks_komit == 0, "Simpul Bakongan awalnya pada indeks komit 0");
    misal hasil_fast_sync = raft_pulihkan_dari_snapshot(node_bakongan, node_sepaku.snapshot_terakhir, node_sepaku.keadaan_mesin);
    asserts(hasil_fast_sync["sukses"] == benar, "Fast-sync recovery berhasil dilakukan");
    asserts(node_bakongan.indeks_komit == 2, "Indeks komit simpul Bakongan langsung pulih ke 2");
    asserts(node_bakongan.indeks_diterapkan == 2, "Indeks terapkan simpul Bakongan langsung pulih ke 2");
    asserts(node_bakongan.keadaan_mesin["ALOKASI_DANA_DESA"] != kosong, "Keadaan mesin simpul Bakongan identik dengan pemimpin");

    // 13. Rekonfigurasi Kuorum Otonom 2f+1 saat Simpul Mengalami Solar-Drain/Mati Daya
    cetak("\n[UJI 13] Rekonfigurasi Kuorum Otonom 2f+1 saat Solar-Drain/Mati Daya...");
    // Simpul Bakongan drop daya surya (< 10%), ditandai OFFLINE pada tabel status pemimpin
    node_sepaku.tabel_status_anggota["did:widya:node:bakongan_04"]["status"] = "OFFLINE";
    misal hasil_rekonf = raft_rekonfigurasi_kuorum_otonom(node_sepaku);
    asserts(hasil_rekonf["total_aktif"] == 3, "Total anggota kuorum aktif menjadi 3");
    asserts(hasil_rekonf["kuorum_baru"] == 2, "Ambang batas kuorum adaptif menjadi 2 (Mayoritas dari 3)");
    asserts(panjang(hasil_rekonf["rekan_offline"]) == 1, "1 simpul offline terdeteksi");
    asserts(hasil_rekonf["rekan_offline"][0] == "did:widya:node:bakongan_04", "Simpul offline adalah Bakongan");

    // 14. Deteksi & Resolusi Split-Brain
    cetak("\n[UJI 14] Deteksi & Resolusi Split-Brain...");
    // Buat simpul terisolasi di pulau lain dengan istilah lama (Term 0)
    misal node_terisolasi = raft_inisialisasi_simpul("did:widya:node:terisolasi_99", []);
    node_terisolasi.peran = "PEMIMPIN"; // Mengaku pemimpin secara cacat (split-brain)
    node_terisolasi.istilah_saat_ini = 0;

    misal hasil_resolusi = raft_resolusi_split_brain(node_sepaku, node_terisolasi);
    asserts(hasil_resolusi["sukses"] == benar, "Resolusi split-brain berhasil ditangani");
    asserts(hasil_resolusi["did_pemenang"] == "did:widya:node:sepaku_01", "Pemimpin sah dengan istilah lebih tinggi memenangkan resolusi");
    asserts(node_terisolasi.istilah_saat_ini == node_sepaku.istilah_saat_ini, "Istilah simpul terisolasi diselaraskan");
    asserts(node_terisolasi.peran == "PENGIKUT", "Simpul terisolasi turun pangkat menjadi PENGIKUT");

    cetak("\n======================================================================");
    cetak("HASIL AKHIR: 14/14 PENGUJIAN WIDYA-CONSENSUS RAFT-BFT LULUS 100%!");
    cetak("======================================================================");
}

// Jalankan suite pengujian konsensus raft bft
jalankan_pengujian_konsensus_raft_bft();
