// ============================================================================
// CONTOH 173: GENERATOR DOKUMEN ILMIAH LATEX / TEX DENGAN PERSAMAAN MATEMATIKA
// Widya-Lang Enterprise Scientific Suite (LaTeX & KaTeX Previewer)
// ============================================================================

cetak("====================================================================")
cetak("  📐 SISTEM GENERATOR MAKALAH & JURNAL ILMIAH LATEX WIDYA")
cetak("====================================================================")

// 1. Inisialisasi Dokumen Ilmiah LaTeX
biar judul = "Simulasi Dinamika Fluida Komputasional dan Termodinamika Kuantum"
biar penulis = "Prof. Dr. Widya Hartono & Tim Riset Nusantara"
biar tex = office_latex_buat(judul, penulis)

cetak("  Judul Makalah : " + judul)
cetak("  Penulis Utama : " + penulis)

// 2. Tambah Persamaan Matematika TeX
// Persamaan 1: Persamaan Navier-Stokes
biar eq_navier = "\\rho \\left( \\frac{\\partial \\mathbf{u}}{\\partial t} + \\mathbf{u} \\cdot \\nabla \\mathbf{u} \\right) = -\\nabla p + \\mu \\nabla^2 \\mathbf{u} + \\mathbf{f}"
tex = office_latex_tambah_persamaan(tex, eq_navier)
cetak("  [+] Persamaan Ditambahkan: Navier-Stokes Fluid Dynamics")

// Persamaan 2: Persamaan Gelombang Schrödinger
biar eq_schrodinger = "i \\hbar \\frac{\\partial}{\\partial t} \\Psi(\\mathbf{r}, t) = \\left[ -\\frac{\\hbar^2}{2m} \\nabla^2 + V(\\mathbf{r}, t) \\right] \\Psi(\\mathbf{r}, t)"
tex = office_latex_tambah_persamaan(tex, eq_schrodinger)
cetak("  [+] Persamaan Ditambahkan: Time-Dependent Schrödinger Wave Equation")

// Persamaan 3: Transformasi Fourier Diskrit
biar eq_fourier = "X_k = \\sum_{n=0}^{N-1} x_n \\cdot e^{-\\frac{i 2 \\pi}{N} k n}"
tex = office_latex_tambah_persamaan(tex, eq_fourier)
cetak("  [+] Persamaan Ditambahkan: Discrete Fourier Transform (DFT)")

cetak("\n✅ Seluruh Persamaan Matematika & Naskah TeX Berhasil Disusun!")
cetak("💡 Siap dikompilasi ke biner PDF / KaTeX Web Previewer.")
