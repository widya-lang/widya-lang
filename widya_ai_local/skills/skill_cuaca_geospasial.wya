// Skill Mandiri: Pemantau Cuaca & Iklim Wilayah
fungsi eksekusi_skill_cuaca(nama_wilayah) {
    misal data_cuaca = {
        'wilayah': nama_wilayah,
        'kondisi': 'Cerah Berawan',
        'suhu_celsius': 28.5,
        'kelembaban_persen': 76,
        'kecepatan_angin_kmh': 12.0,
        'sumber': 'Sensor Stasiun Cuaca BMKG / AI Telemetri'
    };
    misal teks = 'Prakiraan Cuaca ' + nama_wilayah + ':\n' +
                 '  Kondisi   : ' + data_cuaca['kondisi'] + '\n' +
                 '  Suhu      : ' + ke_teks(data_cuaca['suhu_celsius']) + ' °C\n' +
                 '  Kelembaban: ' + ke_teks(data_cuaca['kelembaban_persen']) + ' %\n' +
                 '  Angin     : ' + ke_teks(data_cuaca['kecepatan_angin_kmh']) + ' km/jam';
    kembalikan { 'sukses': benar, 'data': data_cuaca, 'tampilan': teks };
}