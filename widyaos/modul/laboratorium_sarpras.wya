// =================================================================
// Modul Manajemen Laboratorium, Bengkel Vokasi SMK & Sarpras Aset
// (Adopsi MOD-06: KIR, QR Code Aset, Depresiasi SAP & Bahan Habis Pakai)
// =================================================================

struktur RuangLaboratorium {
    id_ruang,
    nama_lab,
    jenis_lab, // LAB_KOMPUTER_AI, LAB_IPA_FISIKA, LAB_KIMIA_B3, BENGKEL_MESIN_SMK
    kapasitas_siswa,
    pj_kepala_lab,
    jadwal_terisi
}

struktur AsetInventarisKIR {
    kode_aset_qr,
    id_ruang,
    nama_aset,
    kategori,
    harga_perolehan,
    tahun_perolehan,
    masa_manfaat_tahun,
    kondisi // BAIK, RUSAK_RINGAN, RUSAK_BERAT
}

struktur NilaiDepresiasiSAP {
    kode_aset,
    harga_perolehan,
    umur_ekonomis_terpakai_tahun,
    akumulasi_penyusutan,
    nilai_buku_saat_ini
}

struktur ReservasiLab {
    id_reservasi,
    id_ruang,
    id_rombel,
    mapel,
    guru_pengampu,
    jam_slot,
    status_booking // DIKONFIRMASI atau BENTROK_JADWAL
}

struktur BahanHabisPakaiBHP {
    id_bahan,
    id_ruang,
    nama_bahan,
    stok_saat_ini,
    satuan,
    ambang_batas_minimum,
    status_kebutuhan_restock // AMAN atau PERLU_PENGADAAN_SIPLAH
}

// -------------------------------------------------------------
// [1] Pendaftaran Fasilitas Ruang Lab & Bengkel Kejuruan
// -------------------------------------------------------------
fungsi lab_daftarkan_ruang(id, nama, jenis, kapasitas, pj_guru) {
    kembalikan RuangLaboratorium(
        id,
        nama,
        jenis,
        kapasitas,
        pj_guru,
        []
    );
}

// -------------------------------------------------------------
// [2] Registrasi Aset ke Kartu Inventaris Ruangan (KIR)
// -------------------------------------------------------------
fungsi lab_tambah_aset_kir(id_ruang, nama_alat, kategori, harga, thn_beli, manfaat_thn) {
    misal kode_qr = "AST-" + id_ruang + "-" + potong(sha256(nama_alat + ke_teks(thn_beli)), 0, 8);
    kembalikan AsetInventarisKIR(
        kode_qr,
        id_ruang,
        nama_alat,
        kategori,
        harga,
        thn_beli,
        manfaat_thn,
        "BAIK"
    );
}

// -------------------------------------------------------------
// [3] Perhitungan Penyusutan Aset Garis Lurus (Standar Akuntansi SAP)
// -------------------------------------------------------------
fungsi lab_hitung_penyusutan_sap(aset, tahun_evaluasi) {
    misal umur_terpakai = tahun_evaluasi - aset.tahun_perolehan;
    jika umur_terpakai < 0 {
        umur_terpakai = 0;
    }
    
    // Penyusutan per tahun = Harga Perolehan / Masa Manfaat
    misal depresiasi_tahunan = aset.harga_perolehan / aset.masa_manfaat_tahun;
    misal akumulasi = depresiasi_tahunan * umur_terpakai;
    
    // Nilai buku tidak boleh di bawah 0 (atau nilai residu)
    jika akumulasi > aset.harga_perolehan {
        akumulasi = aset.harga_perolehan;
    }
    
    misal nilai_buku = aset.harga_perolehan - akumulasi;
    
    kembalikan NilaiDepresiasiSAP(
        aset.kode_aset_qr,
        aset.harga_perolehan,
        umur_terpakai,
        akumulasi,
        nilai_buku
    );
}

// -------------------------------------------------------------
// [4] Reservasi Jadwal Praktikum & Pencegahan Bentrok
// -------------------------------------------------------------
fungsi lab_booking_jadwal(ruang, id_booking, rombel, mapel, guru, slot_jam) {
    // Cek apakah slot jam sudah terisi
    untuk b dalam ruang.jadwal_terisi {
        jika b == slot_jam {
            kembalikan ReservasiLab(
                id_booking,
                ruang.id_ruang,
                rombel,
                mapel,
                guru,
                slot_jam,
                "BENTROK_JADWAL"
            );
        }
    }
    
    tambah(ruang.jadwal_terisi, slot_jam);
    kembalikan ReservasiLab(
        id_booking,
        ruang.id_ruang,
        rombel,
        mapel,
        guru,
        slot_jam,
        "DIKONFIRMASI"
    );
}

// -------------------------------------------------------------
// [5] Penggunaan Bahan Habis Pakai (BHP) & Sinyal Restock SIPLah
// -------------------------------------------------------------
fungsi lab_pakai_reagen_bhp(bhp, jumlah_terpakai) {
    bhp.stok_saat_ini = bhp.stok_saat_ini - jumlah_terpakai;
    jika bhp.stok_saat_ini < 0 {
        bhp.stok_saat_ini = 0;
    }
    
    jika bhp.stok_saat_ini <= bhp.ambang_batas_minimum {
        bhp.status_kebutuhan_restock = "PERLU_PENGADAAN_SIPLAH";
    } lainnya {
        bhp.status_kebutuhan_restock = "AMAN";
    }
    
    kembalikan {
        "nama_bahan": bhp.nama_bahan,
        "sisa_stok": bhp.stok_saat_ini,
        "satuan": bhp.satuan,
        "status": bhp.status_kebutuhan_restock
    };
}
