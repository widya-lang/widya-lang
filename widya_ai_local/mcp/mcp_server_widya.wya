// ============================================================================
// MODUL MODEL CONTEXT PROTOCOL (MCP) SERVER (mcp_server_widya.wya)
// Antarmuka Standar Industri JSON-RPC 2.0 untuk Integrasi IDE & Agen Eksternal
// Mendukung: tools/list, tools/call, resources/list, initialize
// ============================================================================

impor "widya_ai_local/modul_evolusi/manajer_skill.wya";
impor "widya_ai_local/modul_evolusi/vektor_rag.wya";
impor "widya_ai_local/modul_evolusi/sintesis_skill_mandiri.wya";
impor "widya_ai_local/modul_evolusi/inferensi_slm_npu.wya";
impor "widya_ai_local/modul_evolusi/hnsw_vektor_desa.wya";
impor "widya_ai_local/modul_evolusi/swarm_orkestrator.wya";
impor "widya_ai_local/modul_evolusi/kripto_ed25519.wya";
impor "widya_ai_local/modul_evolusi/pemutus_arus_resiliensi.wya";
impor "widya_ai_local/modul_evolusi/penyelia_otonom.wya";
impor "widya_ai_local/modul_evolusi/perisai_dos.wya";
impor "widya_ai_local/modul_evolusi/mesh_kedaulatan.wya";
impor "widya_ai_local/modul_evolusi/persepsi_multimodal.wya";
impor "widya_ai_local/modul_evolusi/agen_tujuan_otonom.wya";
impor "widya_ai_local/modul_evolusi/penyimpanan_hibrida_desa.wya";
impor "widya_ai_local/modul_evolusi/rekayasa_bahasa_widya.wya";
impor "modul/sains_tensor_numpy.wya";
impor "modul/dataframe_analitika.wya";
