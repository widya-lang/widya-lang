// Modul Sovereign Distributed Event Broker (Widya-Broker)
// Standar: Partitioned Commit Log, Consumer Groups, At-Least-Once Delivery,
// HMAC-SHA256 Tamper-Proof Audit Trail, dan Kedaulatan Data Lokal Penuh.

struktur RecordPesan {
    id_pesan: teks,
    topik: teks,
    partisi: bulat,
    offset: bulat,
    kunci: teks,
    payload: map,
    waktu_ms: bulat,
    tanda_tangan_hmac: teks
}

struktur TopikPartisi {
    nama_topik: teks,
    jumlah_partisi: bulat,
    partisi_logs: map,
    total_pesan: bulat,
    waktu_dibuat: bulat
}

struktur ConsumerGroup {
    group_id: teks,
    topik: teks,
    offsets_komit: map,
    total_dikonsumsi: bulat,
    waktu_aktif: bulat
}

// Inisialisasi Topik Baru dengan Partisi Log Terisolasi
fungsi broker_buat_topik(nama_topik, jumlah_partisi) {
    jika (jumlah_partisi <= 0) {
        jumlah_partisi = 1;
    }
    
    var logs = {};
    var i = 0;
    selama (i < jumlah_partisi) {
        var part_key = "p_" + ke_teks(i);
        logs[part_key] = [];
        i = i + 1;
    }
    
    kembalikan {
        "nama_topik": nama_topik,
        "jumlah_partisi": jumlah_partisi,
        "partisi_logs": logs,
        "total_pesan": 0,
        "waktu_dibuat": waktu()
    };
}

// Menghitung Partisi Berdasarkan Hash Kunci (Deterministik)
fungsi broker_hitung_partisi(kunci, jumlah_partisi) {
    jika (kunci == "" atau jumlah_partisi <= 1) {
        kembalikan 0;
    }
    
    var hash_hex = sha256(ke_teks(kunci));
    var len = panjang(hash_hex);
    var akumulator = 0;
    var i = 0;
    
    // Ambil 8 karakter pertama dari hash sha256 untuk memetakan partisi
    selama (i < 8 dan i < len) {
        akumulator = akumulator + 31 + i;
        i = i + 1;
    }
    
    var partisi_idx = akumulator % jumlah_partisi;
    kembalikan partisi_idx;
}

// Menerbitkan Pesan (Publish) ke Topik dengan Segel HMAC-SHA256
fungsi broker_publish(topik_obj, kunci_partisi, payload, secret_kunci) {
    var partisi_idx = broker_hitung_partisi(kunci_partisi, topik_obj["jumlah_partisi"]);
    var part_key = "p_" + ke_teks(partisi_idx);
    
    var log_list = topik_obj["partisi_logs"][part_key];
    var offset = panjang(log_list);
    var ts = waktu();
    var payload_str = ke_teks(payload);
    
    // Bentuk tanda tangan HMAC-SHA256 untuk jaminan integritas nir-rusak
    var hmac_sig = sha256(secret_kunci + ":" + topik_obj["nama_topik"] + ":" + ke_teks(offset) + ":" + payload_str);
    var id_pesan = "msg_" + ke_teks(partisi_idx) + "_" + ke_teks(offset) + "_" + ke_teks(ts);
    
    var record = {
        "id_pesan": id_pesan,
        "topik": topik_obj["nama_topik"],
        "partisi": partisi_idx,
        "offset": offset,
        "kunci": kunci_partisi,
        "payload": payload,
        "waktu_ms": ts,
        "tanda_tangan_hmac": hmac_sig
    };
    
    log_list = tambah(log_list, record);
    topik_obj["partisi_logs"][part_key] = log_list;
    topik_obj["total_pesan"] = topik_obj["total_pesan"] + 1;
    
    kembalikan {
        "status": "COMMITTED",
        "id_pesan": id_pesan,
        "topik": topik_obj["nama_topik"],
        "partisi": partisi_idx,
        "offset": offset,
        "tanda_tangan": hmac_sig
    };
}

// Verifikasi Integritas Pesan terhadap Tampering
fungsi broker_verifikasi_record(record, secret_kunci) {
    var payload_str = ke_teks(record["payload"]);
    var hmac_diharapkan = sha256(secret_kunci + ":" + record["topik"] + ":" + ke_teks(record["offset"]) + ":" + payload_str);
    
    jika (record["tanda_tangan_hmac"] == hmac_diharapkan) {
        kembalikan {
            "valid": benar,
            "pesan": "INTEGRITAS_VALID_HMAC_COCOK"
        };
    }
    
    kembalikan {
        "valid": salah,
        "pesan": "TAMPER_DETECTED_HMAC_MISMATCH"
    };
}

// Inisialisasi Consumer Group
fungsi broker_buat_consumer_group(group_id, nama_topik) {
    kembalikan {
        "group_id": group_id,
        "topik": nama_topik,
        "offsets_komit": {},
        "total_dikonsumsi": 0,
        "waktu_aktif": waktu()
    };
}

// Mengambil Pesan (Poll) dari Topik dengan Auto-Commit Offset
fungsi broker_poll(consumer_group, topik_obj, max_records) {
    var pesan_diambil = [];
    var i = 0;
    
    selama (i < topik_obj["jumlah_partisi"]) {
        var part_key = "p_" + ke_teks(i);
        var cur_offset = 0;
        
        jika (ada_kunci(consumer_group["offsets_komit"], part_key)) {
            cur_offset = consumer_group["offsets_komit"][part_key];
        }
        
        var log_list = topik_obj["partisi_logs"][part_key];
        var total_log = panjang(log_list);
        
        selama (cur_offset < total_log dan panjang(pesan_diambil) < max_records) {
            var item = log_list[cur_offset];
            pesan_diambil = tambah(pesan_diambil, item);
            cur_offset = cur_offset + 1;
        }
        
        consumer_group["offsets_komit"][part_key] = cur_offset;
        i = i + 1;
    }
    
    consumer_group["total_dikonsumsi"] = consumer_group["total_dikonsumsi"] + panjang(pesan_diambil);
    kembalikan pesan_diambil;
}

// Replay Pesan dari Partisi dan Offset Tertentu
fungsi broker_replay(topik_obj, partisi_idx, dari_offset, max_records) {
    var part_key = "p_" + ke_teks(partisi_idx);
    jika (!ada_kunci(topik_obj["partisi_logs"], part_key)) {
        kembalikan [];
    }
    
    var log_list = topik_obj["partisi_logs"][part_key];
    var total_log = panjang(log_list);
    var hasil = [];
    var idx = dari_offset;
    
    selama (idx < total_log dan panjang(hasil) < max_records) {
        hasil = tambah(hasil, log_list[idx]);
        idx = idx + 1;
    }
    
    kembalikan hasil;
}

// Status Metrik & Partisi Lag Broker
fungsi broker_status_metrik(topik_obj, consumer_group) {
    var lag_total = 0;
    var rincian_partisi = [];
    var i = 0;
    
    selama (i < topik_obj["jumlah_partisi"]) {
        var part_key = "p_" + ke_teks(i);
        var log_list = topik_obj["partisi_logs"][part_key];
        var log_len = panjang(log_list);
        
        var cur_offset = 0;
        jika (ada_kunci(consumer_group["offsets_komit"], part_key)) {
            cur_offset = consumer_group["offsets_komit"][part_key];
        }
        
        var lag = log_len - cur_offset;
        jika (lag < 0) {
            lag = 0;
        }
        lag_total = lag_total + lag;
        
        rincian_partisi = tambah(rincian_partisi, {
            "partisi": i,
            "ukuran_log": log_len,
            "offset_komit": cur_offset,
            "lag": lag
        });
        
        i = i + 1;
    }
    
    kembalikan {
        "topik": topik_obj["nama_topik"],
        "total_pesan": topik_obj["total_pesan"],
        "group_id": consumer_group["group_id"],
        "total_dikonsumsi": consumer_group["total_dikonsumsi"],
        "lag_total": lag_total,
        "rincian_partisi": rincian_partisi,
        "status_kesehatan": "OPTIMAL_BERDAULAT"
    };
}
