// ============================================================================
// SIMULASI SUITE: TATA KELOLA ASET BMD, FASILITAS & SARANA PRASARANA SEKOLAH
// Menguji 4 Skenario Pengelolaan Aset & Fasilitas Satuan Pendidikan:
// 1. Registrasi Belanja Modal ke KIB B (Peralatan & Mesin) & Penempatan KIR
// 2. Peminjaman Fasilitas Internal Bebas Bentrok (Aula Sekolah untuk KBM/Ekskul)
// 3. Pemanfaatan Sewa Fasilitas oleh Pihak Eksternal Terhubung Kas Daerah
// 4. Usulan Penghapusan Aset Rusak Berat (Disposal) Pemutihan Neraca BPKAD
// ============================================================================

impor "widyaos/modul/aset_dan_fasilitas_sekolah.wya";

cetak("====================================================================");
cetak("🏢  SIMULASI: TATA KELOLA ASET BMD & PENGGUNAAN FASILITAS SEKOLAH   ");
cetak("====================================================================");

// [1] Registrasi Aset Baru ke KIB B & Penempatan KIR Ruangan
cetak("\n[1] Uji Registrasi Belanja Modal ke KIB B (Chromebook TIK) & KIR:");
misal aset_kib = registrasi_aset_ke_kib(
    "BMD-2026-KIB-B-0042",
    "Chromebook Acer Spin 511 TIK",
    "KIB_B_PERALATAN_MESIN",
    "LAB_KOMPUTER_1",
    2026,
    7500000,
    "BAIK",
    "Bambang Sutrisno, S.Kom. (Kepala Lab TIK)"
);

cetak("  • Kode Barang BMD    :", aset_kib.kode_barang_bmd);
cetak("  • Nama Aset          :", aset_kib.nama_aset);
cetak("  • Kategori KIB       :", aset_kib.kategori_kib);
cetak("  • Lokasi KIR Ruangan :", aset_kib.lokasi_ruangan_kir);
cetak("  • Nilai Perolehan    : Rp", aset_kib.harga_perolehan_rp);
cetak("  • Penanggung Jawab   :", aset_kib.penanggung_jawab_ruang);
cetak("  • Status SIMDA       :", aset_kib.status_registrasi_simda);

jika aset_kib.kategori_kib == "KIB_B_PERALATAN_MESIN" dan aset_kib.status_registrasi_simda == "TERREGISTER_KIB_BPKAD" {
    cetak("  ✅ PASS: Belanja Modal Tertib Terkapitalisasi di KIB B & Siap Ditempel Label QR KIR!");
} lainnya {
    cetak("  ❌ FAIL: Registrasi KIB gagal!");
}

// [2] Peminjaman Fasilitas Internal Bebas Bentrok
cetak("\n[2] Uji Peminjaman Fasilitas Internal Sekolah (Anti-Jadwal Bentrok):");
// Skenario A: Booking Aula oleh Panitia Gelar Karya P5 (Jadwal Kosong)
misal booking_internal = booking_fasilitas_sekolah(
    "BK-2026-001",
    "AULA_GRAHA_WIYATA",
    "Panitia Gelar Karya P5",
    "INTERNAL_KBM_DAN_EKSKUL",
    "24 Oktober 2026",
    "08:00",
    "12:00",
    salah, // Tidak ada bentrok
    0
);

// Skenario B: Ada guru lain mau booking Aula di jam yang sama persis
misal booking_bentrok = booking_fasilitas_sekolah(
    "BK-2026-002",
    "AULA_GRAHA_WIYATA",
    "Ekskul Teater Siswa",
    "INTERNAL_KBM_DAN_EKSKUL",
    "24 Oktober 2026",
    "08:00",
    "12:00",
    benar, // Bentrok terdeteksi sistem
    0
);

cetak("  • Booking P5 (Jadwal Bersih)  : Status =", booking_internal.status_booking);
cetak("  • Booking Teater (Jadwal Tabrakan): Status =", booking_bentrok.status_booking);

jika booking_internal.status_booking == "DISETUJUI_WAKASEK_SARPRAS" dan booking_bentrok.status_booking == "DITOLAK_BENTROK_JADWAL" {
    cetak("  ✅ PASS: Mesin Booking Anti-Bentrok Berhasil Mencegah Rebutan Fasilitas Antar-Guru!");
} lainnya {
    cetak("  ❌ FAIL: Booking fasilitas gagal!");
}

// [3] Pemanfaatan Sewa Fasilitas oleh Pihak Luar (Retribusi BMD Kas Daerah)
cetak("\n[3] Uji Pemanfaatan Sewa Fasilitas oleh Pihak Eksternal (Sewa Lapangan):");
misal sewa_eksternal = booking_fasilitas_sekolah(
    "BK-SEWA-2026-015",
    "LAPANGAN_FUTSAL_INDOOR",
    "Klub Futsal Pemuda Mandiri (Warga)",
    "EKSTERNAL_SEWA_KOMERSIAL",
    "15 November 2026",
    "19:00",
    "21:00",
    salah,
    300000 // Rp 300.000 sewa 2 jam
);

cetak("  • Fasilitas Disewa    :", sewa_eksternal.nama_fasilitas);
cetak("  • Peminjam Eksternal  :", sewa_eksternal.peminjam);
cetak("  • Biaya Sewa Retribusi: Rp", sewa_eksternal.biaya_retribusi_sewa_rp);
cetak("  • Rekening Penyetoran :", sewa_eksternal.rekening_tujuan_kas);
cetak("  • Status Persetujuan  :", sewa_eksternal.status_booking);

jika sewa_eksternal.rekening_tujuan_kas == "KASDA_BAPENDA_PEMDA" dan sewa_eksternal.biaya_retribusi_sewa_rp == 300000 {
    cetak("  ✅ PASS: Pendapatan Sewa BMD Otomatis Mengalir ke Rekening Kasda, Anti-Pungli Pribadi!");
} lainnya {
    cetak("  ❌ FAIL: Pemanfaatan sewa BMD gagal!");
}

// [4] Usulan Penghapusan Aset Rusak Berat (Disposal) Pemutihan Neraca BPKAD
cetak("\n[4] Uji Usulan Penghapusan Aset Rusak Berat (Stock Opname Gudang):");
misal usulan_disposal = usulkan_penghapusan_aset_rusak(
    "DISP-2026-003",
    "BMD-2015-KIB-B-0911",
    "PC Rakitan Pentium Dual Core (50 Unit Rusak Berat)",
    2015,
    150000000,
    "LELANG_TERBUKA_KPKNL"
);

cetak("  • Kode Aset Diusulkan :", usulan_disposal.kode_barang_bmd);
cetak("  • Nama Barang Rusak   :", usulan_disposal.nama_aset);
cetak("  • Kondisi Fisik       :", usulan_disposal.kondisi_terakhir);
cetak("  • Alasan Penghapusan  :", usulan_disposal.alasan_teknis);
cetak("  • Persetujuan Resmi   :", usulan_disposal.status_persetujuan_bpkad);
cetak("  • Status di Neraca    :", usulan_disposal.status_neraca);

jika usulan_disposal.status_neraca == "DIHAPUS_DARI_BUKU_ASET_BMD" {
    cetak("  ✅ PASS: Gudang Sekolah Bersih Secara Legal! Neraca Bebas dari Temuan Barang Rongsokan BPK.");
} lainnya {
    cetak("  ❌ FAIL: Usulan penghapusan aset gagal!");
}

cetak("\n====================================================================");
cetak("🏆 HASIL SIMULASI: 4/4 KASUS ASET & FASILITAS SEKOLAH LULUS (100%)  ");
cetak("====================================================================");
