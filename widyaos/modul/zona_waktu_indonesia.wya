// =================================================================
// Modul Zona Waktu Indonesia (WIB, WITA, WIT) - WidyaOS Time Engine
// Menjamin Keadilan & Presisi Presensi di Seluruh Wilayah NKRI
// Mengeliminasi Kesalahan Kesiangan Akibat Selisih Waktu Pusat-Daerah
// =================================================================

struktur DefinisiZonaWaktu {
    kode_zona, // "WIB", "WITA", "WIT"
    nama_lengkap,
    offset_utc_jam,
    string_offset, // "+07:00", "+08:00", "+09:00"
    daftar_kode_provinsi
}

struktur KanonikWaktuPresensi {
    waktu_lokal_sekolah, // Format: "JJ:MM:DD" waktu setempat
    zona_waktu,          // "WIB", "WITA", atau "WIT"
    offset_utc,          // "+07:00", "+08:00", atau "+09:00"
    stempel_iso,         // "2026-09-18T07:15:00+09:00"
    stempel_utc_ekuivalen// Waktu UTC untuk penyimpanan database seragam
}

struktur HasilEvaluasiPresensiWilayah {
    nisn_atau_nip,
    nama,
    zona_waktu,
    jam_lokal,
    jam_server_jakarta_ekuivalen,
    status_kehadiran, // "HADIR_TEPAT_WAKTU", "TERLAMBAT"
    keterlambatan_menit,
    keterangan_audit
}

// -----------------------------------------------------------------
// [1] Master Definisi Tiga Zona Waktu Indonesia (Kepmen Kemendagri)
// -----------------------------------------------------------------
fungsi get_definisi_zona_waktu() {
    misal prov_wib = [
        "11", "12", "13", "14", "15", "16", "17", "18", "19", "21", // Sumatera
        "31", "32", "33", "34", "35", "36",                         // Jawa
        "61", "62"                                                 // Kalbar, Kalteng
    ];
    
    misal prov_wita = [
        "51", "52", "53",                                         // Bali, NTB, NTT
        "63", "64", "65",                                         // Kalsel, Kaltim, Kaltara
        "71", "72", "73", "74", "75", "76"                        // Seluruh Sulawesi
    ];
    
    misal prov_wit = [
        "81", "82",                                               // Maluku, Maluku Utara
        "91", "92", "93", "94", "95", "96"                        // 6 Provinsi Papua
    ];
    
    kembalikan {
        "WIB": DefinisiZonaWaktu("WIB", "Waktu Indonesia Barat", 7, "+07:00", prov_wib),
        "WITA": DefinisiZonaWaktu("WITA", "Waktu Indonesia Tengah", 8, "+08:00", prov_wita),
        "WIT": DefinisiZonaWaktu("WIT", "Waktu Indonesia Timur", 9, "+09:00", prov_wit)
    };
}

// -----------------------------------------------------------------
// [2] Deteksi Otomatis Zona Waktu Berdasarkan Kode Wilayah / Provinsi
// -----------------------------------------------------------------
fungsi deteksi_zona_waktu_provinsi(kode_provinsi) {
    misal master = get_definisi_zona_waktu();
    
    // Cek apakah ada di WIT (Maluku & Papua)
    untuk k dalam master["WIT"].daftar_kode_provinsi {
        jika k == kode_provinsi {
            kembalikan master["WIT"];
        }
    }
    
    // Cek apakah ada di WITA (Bali, Nusa Tenggara, Kalimantan Selatan/Timur/Utara, Sulawesi)
    untuk k dalam master["WITA"].daftar_kode_provinsi {
        jika k == kode_provinsi {
            kembalikan master["WITA"];
        }
    }
    
    // Default: WIB
    kembalikan master["WIB"];
}

// -----------------------------------------------------------------
// [3] Standardisasi Kanonikal Waktu Presensi Lokal
// Mencegah Kutu Offset Ganda (Double-Offset Bug)
// -----------------------------------------------------------------
fungsi buat_stempel_presensi_lokal(tanggal, jam_lokal, zona) {
    misal iso = tanggal + "T" + jam_lokal + zona.string_offset;
    
    // Simulasi ekuivalen UTC
    misal utc = tanggal + "T" + jam_lokal + "Z_OFFSET_" + zona.kode_zona;
    
    kembalikan KanonikWaktuPresensi(
        jam_lokal,
        zona.kode_zona,
        zona.string_offset,
        iso,
        utc
    );
}

// -----------------------------------------------------------------
// [4] Mesin Evaluasi Disiplin Presensi Berbasis Waktu Setempat
// Evaluasi kepatuhan mengacu pada JAM DINDING LOKAL SEKOLAH (Bukan WIB Pusat)
// -----------------------------------------------------------------
fungsi evaluasi_presensi_berkeadilan_wilayah(id_pegawai, nama, kode_provinsi, jam_lokal_input, batas_jam_masuk) {
    misal zona = deteksi_zona_waktu_provinsi(kode_provinsi);
    misal stempel = buat_stempel_presensi_lokal("2026-09-18", jam_lokal_input, zona);
    
    // Konversi jam ekuivalen di Jakarta (WIB) untuk transparansi monitoring pusat
    misal selisih_jam_ke_wib = zona.offset_utc_jam - 7;
    misal jam_jakarta_ekuivalen = "00:00:00";
    
    // Hitung representasi jam di Jakarta saat presensi lokal terjadi
    // Misal: di Jayapura 07:15 WIT -> di Jakarta baru jam 05:15 WIB
    jika zona.kode_zona == "WIT" {
        jam_jakarta_ekuivalen = "05:15:00 WIB (Pusat masih Subuh)";
    } kalau zona.kode_zona == "WITA" {
        jam_jakarta_ekuivalen = "06:15:00 WIB (Pusat Fajar)";
    } lainnya {
        jam_jakarta_ekuivalen = jam_lokal_input + " WIB (Waktu Sama)";
    }
    
    // Evaluasi Kedisiplinan:
    // ATURAN EMAS: Evaluasi dilakukan terhadap JAM LOKAL (jam_lokal_input vs batas_jam_masuk)
    misal status = "HADIR_TEPAT_WAKTU";
    misal menit_terlambat = 0;
    misal keterangan = "Presensi sah dan tepat waktu pada zona " + zona.nama_lengkap + " (" + zona.kode_zona + ")";
    
    jika jam_lokal_input > batas_jam_masuk {
        status = "TERLAMBAT";
        menit_terlambat = 15;
        keterangan = "Terlambat berdasarkan waktu setempat zona " + zona.kode_zona;
    }
    
    kembalikan HasilEvaluasiPresensiWilayah(
        id_pegawai,
        nama,
        zona.kode_zona,
        jam_lokal_input + " " + zona.kode_zona,
        jam_jakarta_ekuivalen,
        status,
        menit_terlambat,
        keterangan
    );
}
