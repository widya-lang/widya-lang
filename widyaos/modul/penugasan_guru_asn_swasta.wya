// ============================================================================
// MODUL: TATA KELOLA PENUGASAN GURU ASN DI SATUAN PENDIDIKAN SWASTA (YAYASAN)
// Mengatur Penempatan Guru PNS DPK & Guru PPPK di Sekolah Swasta (Masyarakat)
// 
// Rujukan Regulasi:
// 1. Permendikbud No. 1 Tahun 2018 (Petunjuk Teknis Penugasan Guru PNS di Sekolah Swasta)
// 2. PP No. 94 Tahun 2021 & PP No. 49 Tahun 2018 tentang Manajemen Pegawai ASN
// 3. Kebijakan Kemendikdasmen RI tentang Redistribusi & Penugasan Guru PPPK ke Swasta
// 4. UU No. 14 Tahun 2005 (Keterjaminan Gaji Pokok APBD & TPG APBN Tanpa Bebani Yayasan)
// ============================================================================

struktur PenugasanGuruAsnDiSwasta {
    id_penugasan,
    nip_guru,
    nama_guru,
    status_asn,                 // 'PNS_DPK', 'PPPK_PENUGASAN_SWASTA'
    npsn_swasta_tujuan,
    nama_sekolah_swasta,
    nama_yayasan,
    nomor_sk_kepala_daerah,     // SK Bupati / Walikota / Gubernur
    tmt_mulai,
    tmt_selesai,                // Masa tugas (misal 3 tahun)
    mapel_tugas,
    total_jam_tatap_muka,
    sumber_gaji_pokok,          // 'DIBAYAR_PEMDA_APBD_100_PERSEN'
    status_tpg_sertifikasi,     // 'TETAP_CAIR_APBN_PUSAT'
    beban_finansial_yayasan,    // 'YAYASAN_DILARANG_DIBEBANI_GAJI_POKOK'
    status_satminkal_dapodik    // 'INDUK_RESMI_DI_SEKOLAH_SWASTA'
}

struktur EvaluasiKinerjaAsnDiSwasta {
    id_evaluasi,
    nip_guru,
    nama_guru,
    npsn_sekolah,
    nama_kepala_sekolah_swasta,
    predikat_skp_tahunan,       // 'SANGAT_BAIK', 'BAIK'
    pengesahan_pejabat_dinas,   // 'DISAHKAN_KEPALA_DINAS_PENDIDIKAN'
    rekomendasi_penugasan       // 'DIREKOMENDASIKAN_PERPANJANG_TUGAS', 'TARIK_KEMBALI_KE_NEGERI'
}

// ============================================================================
// LOGIKA BISNIS PENUGASAN GURU ASN DI SEKOLAH SWASTA
// ============================================================================

// [1] Penetapan Penugasan Resmi Guru ASN (PNS DPK / PPPK) ke Sekolah Swasta
fungsi tetapkan_penugasan_asn_ke_swasta(
    id_penugasan,
    nip,
    nama,
    status_asn,
    npsn_swasta,
    nama_swasta,
    yayasan,
    nomor_sk,
    tmt_mulai,
    tmt_selesai,
    mapel,
    jam_kbm
) {
    misal status_tpg = "TIDAK_VALID_KURANG_JAM";
    jika jam_kbm >= 24 {
        status_tpg = "TETAP_CAIR_APBN_PUSAT";
    }

    kembalikan PenugasanGuruAsnDiSwasta(
        id_penugasan,
        nip,
        nama,
        status_asn,
        npsn_swasta,
        nama_swasta,
        yayasan,
        nomor_sk,
        tmt_mulai,
        tmt_selesai,
        mapel,
        jam_kbm,
        "DIBAYAR_PEMDA_APBD_100_PERSEN",
        status_tpg,
        "YAYASAN_DILARANG_DIBEBANI_GAJI_POKOK",
        "INDUK_RESMI_DI_SEKOLAH_SWASTA"
    );
}

// [2] Evaluasi Kinerja (SKP) Berjenjang: Kepsek Swasta -> Pengesahan Kepala Dinas
fungsi evaluasi_skp_asn_swasta(
    id_ev,
    nip,
    nama,
    npsn,
    nama_kepsek_swasta,
    predikat
) {
    misal rekomendasi = "DIREKOMENDASIKAN_PERPANJANG_TUGAS";
    jika predikat == "KURANG" atau predikat == "SANGAT_KURANG" {
        rekomendasi = "TARIK_KEMBALI_KE_NEGERI";
    }

    kembalikan EvaluasiKinerjaAsnDiSwasta(
        id_ev,
        nip,
        nama,
        npsn,
        nama_kepsek_swasta,
        predikat,
        "DISAHKAN_KEPALA_DINAS_PENDIDIKAN",
        rekomendasi
    );
}
