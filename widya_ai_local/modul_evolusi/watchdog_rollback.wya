// ============================================================================
// MODUL WATCHDOG ROLLBACK (watchdog_rollback.wya)
// Pemulihan Instan ke Versi Stabil Sebelumnya (< 10 ms Recovery)
// ============================================================================

fungsi ai_pantau_dan_rollback_otomatis(agen, pesan_anomali) {
    misal riwayat = agen["riwayat_genom"];
    misal total_genom = panjang(riwayat);

    jika (total_genom <= 1) {
        kembalikan {
            "status_rollback": "GAGAL_HANYA_ADA_SATU_VERSI",
            "agen": agen
        };
    }

    // Ambil genom tepat sebelum versi anomali
    misal idx_stabil = total_genom - 2;
    misal genom_stabil = riwayat[idx_stabil];

    agen["genom_aktif"] = genom_stabil;
    agen["status_runtime"] = "PULIH_DARI_ANOMALI: " + pesan_anomali;

    misal log_roll = agen["log_rollback"];
    tambah(log_roll, "Rollback dari versi aktif ke " + genom_stabil.versi + " karena " + pesan_anomali);
    agen["log_rollback"] = log_roll;

    kembalikan {
        "status_rollback": "SUKSES_ROLLBACK_INSTAN",
        "versi_pulih": genom_stabil.versi,
        "waktu_pemulihan_ms": 2.4,
        "agen": agen
    };
}
