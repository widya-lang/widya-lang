// ============================================================================
// CONTOH 195: LIMA PILAR REKAYASA SISTEM MODERN (CORE SYSTEM ENGINEERING)
// Bahasa Pemrograman Widya (Widya-lang)
//
// 1. Unicode & UTF-8 Encoding (Byte vs Karakter, Normalisasi NFC/NFD)
// 2. Precision Decimal Math & Currency (Solusi Floating-Point IEEE 754 & Format IDR/USD/EUR/JPY)
// 3. Serialization & Schema Evolution (CBOR Binary & Backward Compatibility)
// 4. Security & Cryptography (Argon2id, AES-256-GCM, Constant-Time Comparison)
// 5. Error Handling & Resiliency (Hasil<T, E>, Retry Backoff Jitter, Circuit Breaker, Rate Limiter)
// ============================================================================

cetak("============================================================================");
cetak("🛡️ 5 PILAR REKAYASA PERANGKAT LUNAK & ARSITEKTUR RUNTIME DI WIDYA-LANG");
cetak("============================================================================");

// ----------------------------------------------------------------------------
// PILAR 1: UNICODE & UTF-8 (BYTE VS KARAKTER & NORMALISASI)
// ----------------------------------------------------------------------------
cetak("\n[PILAR 1] CHARACTER ENCODING & UNICODE (UTF-8 BINARY MANIPULATION):");
var teks_emoji = "Widya 🇮🇩 🚀 繁体字";
cetak("    • Teks Visual           : " + teks_emoji);
cetak("    • Jumlah Karakter Grapheme: " + ke_teks(panjang_karakter(teks_emoji)) + " karakter");
cetak("    • Jumlah Byte UTF-8     : " + ke_teks(panjang_byte(teks_emoji)) + " bytes (Variabel 1-4 byte/karakter)");

var teks_diakritik = "Café";
var norm_nfc = normalisasi_unicode(teks_diakritik, "NFC");
var norm_nfd = normalisasi_unicode(teks_diakritik, "NFD");
cetak("    • Normalisasi NFC (Komposisi)   : " + norm_nfc["teks_normalisasi"] + " (" + ke_teks(norm_nfc["jumlah_byte_normalisasi"]) + " bytes)");
cetak("    • Normalisasi NFD (Dekomposisi) : " + norm_nfd["teks_normalisasi"] + " (" + ke_teks(norm_nfd["jumlah_byte_normalisasi"]) + " bytes)");

// ----------------------------------------------------------------------------
// PILAR 2: PRECISION DECIMAL MATH & CURRENCY FORMATTING (IEEE 754 MITIGATION)
// ----------------------------------------------------------------------------
cetak("\n[PILAR 2] CURRENCY & PRECISION MATH (FIXED-POINT DESIMAL TANPA ROUNDING ERROR):");
// Bukti masalah floating point IEEE 754 klasik: 0.1 + 0.2
var d1 = desimal_buat(0.1);
var d2 = desimal_buat(0.2);
var d_tambah = desimal_tambah(d1, d2);
cetak("    • Kalkulasi Desimal 0.1 + 0.2 : " + d_tambah["teks"] + " (Bukan 0.30000000000000004)");

var uang_pokok = desimal_buat(1500000.75);
var pajak_ppn  = desimal_buat(0.11);
var nilai_ppn  = desimal_kali(uang_pokok, pajak_ppn);
var total_uang = desimal_tambah(uang_pokok, nilai_ppn);

cetak("    • Format Rupiah (IDR)   : " + format_mata_uang(total_uang, "IDR"));
cetak("    • Format Dolar (USD)    : " + format_mata_uang(total_uang, "USD"));
cetak("    • Format Euro (EUR)     : " + format_mata_uang(total_uang, "EUR"));
cetak("    • Format Yen (JPY)      : " + format_mata_uang(total_uang, "JPY"));

// ----------------------------------------------------------------------------
// PILAR 3: SERIALIZATION (CBOR BINARY) & SCHEMA EVOLUTION
// ----------------------------------------------------------------------------
cetak("\n[PILAR 3] SERIALIZATION & SCHEMA EVOLUTION (DATA INTERCHANGE):");
var payload_transaksi = {
    "id_transaksi": "TX-2026-9901",
    "pengirim": "Budi",
    "nominal": 750000,
    "status": "SELESAI"
};

var biner_cbor = ke_biner_cbor(payload_transaksi);
cetak("    • CBOR Binary Hex       : " + biner_cbor);
var payload_pulih = dari_biner_cbor(biner_cbor);
cetak("    • Deserialisasi Sukses  : " + payload_pulih["id_transaksi"] + " | Pengirim: " + payload_pulih["pengirim"]);

// Validasi Evolusi Skema Microservices (Backward / Forward Compatibility)
var skema_v1 = ["id", "nama", "email"];
var skema_v2 = ["id", "nama", "email", "nomor_telepon_opsional"];
var evolusi  = validasi_evolusi_skema(skema_v1, skema_v2, {});
cetak("    • Analisis Evolusi Skema: " + evolusi["status_evolusi"]);
cetak("    • Kompatibel Mundur?    : " + ke_teks(evolusi["kompatibel_mundur_backward"]));

// ----------------------------------------------------------------------------
// PILAR 4: SECURITY & CRYPTOGRAPHY (ARGON2ID, AES-256-GCM, CONSTANT-TIME)
// ----------------------------------------------------------------------------
cetak("\n[PILAR 4] SECURITY & KRIPTOGRAFI STANDAR INDUSTRI:");
// 1. Memory-hard Password Hashing (Argon2id)
var hash_pwd = argon2id_hash("KatasandiRahasia2026!", "garam_kripto_unik");
cetak("    • Argon2id Password Hash: " + hash_pwd);
var verif_pwd = argon2id_verifikasi("KatasandiRahasia2026!", hash_pwd);
cetak("    • Verifikasi Password   : " + ke_teks(verif_pwd));

// 2. Authenticated Encryption AES-256-GCM
var kunci_aes_hex = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"; // 32 byte
var iv_aes_hex    = "abcdef0123456789abcdef01"; // 12 byte
var rahasia_teks  = "Data Finansial Sangat Rahasia";

var enkripsi_res = aes_gcm_enkripsi(rahasia_teks, kunci_aes_hex, iv_aes_hex);
cetak("    • AES-GCM Ciphertext    : " + enkripsi_res["ciphertext_hex"]);
cetak("    • Auth Tag (128-bit)    : " + enkripsi_res["tag_autentikasi_hex"]);

var dekripsi_res = aes_gcm_dekripsi(enkripsi_res["ciphertext_hex"], enkripsi_res["tag_autentikasi_hex"], kunci_aes_hex, iv_aes_hex);
cetak("    • Hasil Dekripsi Asli   : " + dekripsi_res);

// 3. Constant-Time String Comparison (Anti Timing Attack)
var token_asli  = "token_keamanan_bernilai_rahasia_a8b9c1";
var token_input = "token_keamanan_bernilai_rahasia_a8b9c1";
var timing_safe = bandingkan_konstan(token_asli, token_input);
cetak("    • Constant-Time Compare : " + ke_teks(timing_safe) + " (Aman dari serangan Side-Channel)");

// ----------------------------------------------------------------------------
// PILAR 5: ERROR HANDLING & RESILIENCY PATTERNS
// ----------------------------------------------------------------------------
cetak("\n[PILAR 5] ERROR HANDLING & RESILIENCY PATTERNS (FAULT TOLERANCE):");
// 1. Result<T, E> Pattern (Tanpa Exception Crash Tak Terduga)
var hasil_ok  = HasilSukses("Data berhasil diproses");
var hasil_err = HasilGagal("Koneksi database timeout");

cetak("    • Result Status Sukses  : " + ke_teks(adalah_sukses(hasil_ok))  + " -> Nilai: " + ambil_nilai(hasil_ok));
cetak("    • Result Status Gagal   : " + ke_teks(adalah_sukses(hasil_err)) + " -> Pesan Galat: " + ambil_galat(hasil_err));

// 2. Circuit Breaker Pattern (Closed -> Open -> Half-Open)
var cb = circuit_breaker_buat("Gateway-Pembayaran-QRIS", 3, 5000);
var status_cb = circuit_breaker_eksekusi(cb, nil);
cetak("    • Circuit Breaker State : " + cb["status"] + " | Ambang Batas: " + ke_teks(cb["ambang_gagal"]) + " kegagalan");

// 3. Token Bucket Rate Limiter (Anti DDOS & API Throttling)
var rl = rate_limiter_buat(5, 2); // Kapasitas 5 token, refill 2 token/detik
var req1 = rate_limiter_ambil(rl);
var req2 = rate_limiter_ambil(rl);
cetak("    • Rate Limiter Request 1: " + req1["pesan"] + " (Sisa Token: " + ke_teks(req1["sisa_token"]) + ")");
cetak("    • Rate Limiter Request 2: " + req2["pesan"] + " (Sisa Token: " + ke_teks(req2["sisa_token"]) + ")");

cetak("\n============================================================================");
cetak("✨ KELIMA PILAR REKAYASA SISTEM MODERN 100% TERCOVER LENGKAP DI WIDYA-LANG!");
cetak("============================================================================");
