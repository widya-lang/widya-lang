// =================================================================
// SIMULASI TATA KELOLA TIPOLOGI SEKOLAH KHUSUS WIDYAOS
// 1. Sekolah Nasional Terintegrasi (1 Kepala Sekolah Multi-Jenjang)
// 2. Sekolah Rakyat (Afirmasi Gratis Berasrama Kemiskinan Ekstrem)
// 3. Sekolah Garuda (Sekolah Kedinasan / Unggulan Nasional K/L Pusat)
// =================================================================

impor "widyaos/modul/tipologi_sekolah_khusus.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === SIMULASI TIPOLOGI SEKOLAH KHUSUS WIDYAOS v1.0 ===          ║");
cetak("║   Terintegrasi Satu Atap, Sekolah Rakyat & Sekolah Garuda K/L    ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

// -------------------------------------------------------------
// [TEST 1] SEKOLAH NASIONAL TERINTEGRASI (SATU ATAP / KOMPLEKS)
// -------------------------------------------------------------
cetak("================================================================");
cetak("[1] Sekolah Terintegrasi: 1 Kepala Sekolah Multi-Jenjang");
cetak("================================================================");
misal kompleks_nusantara = KompleksTerintegrasi(
    "KMP-001",
    "Kompleks Pendidikan Terpadu Garuda Nusantara",
    "Drs. H. Mulyadi, M.Pd",
    "did:sewidya:kepsek:kompleks:001",
    ["20101111_SD", "20102222_SMP", "20103333_SMA"],
    "Gedung Olahraga, Aula Pertemuan, Lab Komputer AI & Perpustakaan Terpadu"
);

cetak("🏫 Kompleks Sekolah   :", kompleks_nusantara.nama_kompleks);
cetak("👨‍💼 Kepala Sekolah Satu:", kompleks_nusantara.nama_kepala_sekolah, "(Master DID:", kompleks_nusantara.did_kepala_sekolah + ")");
cetak("🏢 3 Jenjang Dibawahi : SD (NPSN: 20101111), SMP (NPSN: 20102222), SMA (NPSN: 20103333)");

// Agregasi JJM Guru Lintas Jenjang (Guru Bahasa Inggris)
// Mengajar 12 jam di SD dan 12 jam di SMP
misal guru_bhs_inggris = terintegrasi_agregasi_jjm_guru(
    "199003032015012001",
    "Anita Rahmawati, S.Pd",
    "Bahasa Inggris Terapan",
    12, // 12 jam di SD
    "20101111",
    12, // 12 jam di SMP
    "20102222"
);

cetak("👩‍🏫 Beban Guru Lintas  :", guru_bhs_inggris.nama_guru);
cetak("   Mengajar di SD      :", guru_bhs_inggris.jam_unit_1, "JJM | di SMP:", guru_bhs_inggris.jam_unit_2, "JJM");
cetak("   Total JJM Agregasi  :", guru_bhs_inggris.total_jjm_teragregasi, "JJM/minggu -> Status TPG:", guru_bhs_inggris.status_sertifikasi_tpg);

// Pembagian Beban Biaya Sarpras Bersama (Perbaikan Atap Aula Rp 10.000.000)
// Rasio murid: SD 30%, SMP 30%, SMA 40%
misal alokasi_sarpras = terintegrasi_alokasi_biaya_sarpras(
    "SARPRAS-AULA-01",
    "Perbaikan Atap Aula Pertemuan Terpadu",
    10000000.0,
    30, // 30%
    30, // 30%
    40  // 40%
);

cetak("🏛️ Biaya Sarpras Bersama : Rp", alokasi_sarpras.total_biaya_rp, "(Uraian:", alokasi_sarpras.uraian_sarpras + ")");
cetak("   Beban BOS SD (30%)   : Rp", alokasi_sarpras.beban_sd_rp);
cetak("   Beban BOS SMP (30%)  : Rp", alokasi_sarpras.beban_smp_rp);
cetak("   Beban BOS SMA (40%)  : Rp", alokasi_sarpras.beban_sma_rp);

TOTAL_TEST = TOTAL_TEST + 1;
jika guru_bhs_inggris.status_sertifikasi_tpg == "MEMENUHI_SYARAT_TPG_24_JAM" dan alokasi_sarpras.beban_sma_rp == 4000000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Sekolah Terintegrasi Multi-Jenjang & Agregasi JJM: LULUS");
}

// -------------------------------------------------------------
// [TEST 2] SEKOLAH RAKYAT (AFIRMASI GRATIS BERASRAMA 100%)
// -------------------------------------------------------------
cetak("");
cetak("================================================================");
cetak("[2] Sekolah Rakyat: Afirmasi Penuh Masyarakat Miskin Ekstrem");
cetak("================================================================");
misal sekolah_rakyat_papua = ProfilSekolahRakyat(
    "60109999",
    "Sekolah Rakyat Vokasi Berasrama Papua Pegunungan",
    "SK-KEMENSOS-KEMENDIKDASMEN-2026-001",
    120, // 120 Siswa Asrama
    3600000000.0, // Dibiayai APBN Bansos Rp 3,6 Miliar
    "3x Makan Gizi Seimbang + 2x Snack",
    benar,
    "DILARANG_PUNGUTAN_SPP_APAPUN"
);

cetak("🏫 Sekolah Rakyat     :", sekolah_rakyat_papua.nama_sekolah);
cetak("🍚 Standar Nutrisi    :", sekolah_rakyat_papua.standar_makan_harian, "(Sinkron MBG BGN)");
cetak("🚫 Regulasi Finansial :", sekolah_rakyat_papua.status_komersial);

// Pendaftar 1: NIK anak dari keluarga DTKS Desil 1 (Kemiskinan Ekstrem)
misal siswa_rakyat_1 = sekolah_rakyat_verifikasi_siswa("9101012345670001", "Yohanes Kogoya", 1);
// Pendaftar 2: NIK anak keluarga mampu (Desil 6)
misal siswa_rakyat_2 = sekolah_rakyat_verifikasi_siswa("9101017654320002", "Markus (Keluarga Mampu)", 6);

cetak("👦 Calon Siswa 1      :", siswa_rakyat_1.nama, "(DTKS Desil", ke_teks(siswa_rakyat_1.desil_kemiskinan_dtks) + ")");
cetak("   Hasil Seleksi      :", siswa_rakyat_1.status_kelayakan_afirmasi);
cetak("   Fasilitas Diterima :", siswa_rakyat_1.fasilitas_diterima);
cetak("👦 Calon Siswa 2      :", siswa_rakyat_2.nama, "(DTKS Desil", ke_teks(siswa_rakyat_2.desil_kemiskinan_dtks) + ")");
cetak("   Hasil Seleksi      :", siswa_rakyat_2.status_kelayakan_afirmasi);

TOTAL_TEST = TOTAL_TEST + 1;
jika siswa_rakyat_1.status_kelayakan_afirmasi == "DITERIMA_BEASISWA_PENUH_ASRAMA" dan siswa_rakyat_2.status_kelayakan_afirmasi == "DITOLAK_TIDAK_MEMENUHI_KRITERIA_MISKIN" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Sekolah Rakyat: Seleksi Afirmasi Kemiskinan Ekstrem: LULUS");
}

// -------------------------------------------------------------
// [TEST 3] SEKOLAH GARUDA (SEKOLAH KEDINASAN / UNGGULAN K/L PUSAT)
// -------------------------------------------------------------
cetak("");
cetak("================================================================");
cetak("[3] Sekolah Garuda: Sekolah Unggulan Berasrama Milik K/L Pusat");
cetak("================================================================");
misal sma_garuda_pertahanan = ProfilSekolahGaruda(
    "012", // Kode K/L Kementerian Pertahanan
    "Kementerian Pertahanan Republik Indonesia",
    "SMA Taruna Garuda Nusantara Magelang",
    "DIPA-012.01.1.678900/2026",
    25000000000.0, // Pagu DIPA Rp 25 Miliar
    25000000000.0, // Sisa Pagu Awal
    360,           // 360 Siswa Taruna
    38,            // Mewakili seluruh 38 Provinsi Indonesia
    "Kepemimpinan Nasional, Bela Negara, Dirgantara & Ketahanan Siber",
    benar          // 100% Beasiswa Ikatan Dinas
);

cetak("🦅 Satuan Pendidikan  :", sma_garuda_pertahanan.nama_kampus_garuda);
cetak("🏛️ Kementerian Induk  :", sma_garuda_pertahanan.kementerian_induk);
cetak("📜 Nomor DIPA APBN    :", sma_garuda_pertahanan.nomor_dipa_apbn);
cetak("💰 Pagu Anggaran DIPA : Rp", sma_garuda_pertahanan.pagu_anggaran_dipa);
cetak("🌐 Sebaran Siswa      :", sma_garuda_pertahanan.sebaran_provinsi_terpenuhi, "Provinsi Se-Indonesia");
cetak("🛡️ Kurikulum Khusus   :", sma_garuda_pertahanan.kurikulum_kekhususan);

// Realisasi Belanja Barang Operasional Asrama Taruna (MAK 521111) Rp 2,5 Miliar
misal realisasi_dipa = sekolah_garuda_realisasi_dipa(
    sma_garuda_pertahanan,
    "MAK-521111",
    2500000000.0,
    "Pengadaan Perlengkapan Pakaian Dinas Harian (PDH) & Latihan Bela Negara 360 Taruna"
);

cetak("💼 Realisasi DIPA Pusat :");
cetak("   Kode MAK Akun      :", realisasi_dipa.kode_mak);
cetak("   Uraian Belanja     :", realisasi_dipa.uraian);
cetak("   Nominal Dicairkan  : Rp", realisasi_dipa.nominal_cair);
cetak("   Sisa Pagu DIPA     : Rp", realisasi_dipa.sisa_dipa);

TOTAL_TEST = TOTAL_TEST + 1;
jika realisasi_dipa.sukses == benar dan realisasi_dipa.sisa_dipa == 22500000000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Sekolah Garuda: Tata Kelola DIPA APBN K/L Pusat: LULUS");
}

cetak("");
cetak("================================================================");
cetak("HASIL EVALUASI TIPOLOGI SEKOLAH KHUSUS");
cetak("Total Tipologi Diuji :", TOTAL_TEST);
cetak("Lulus Verifikasi     :", LULUS_TEST);
cetak("================================================================");
jika TOTAL_TEST == LULUS_TEST {
    cetak("🎉 SEMPURNA! TATA KELOLA SELURUH TIPOLOGI SEKOLAH KHUSUS 100% LULUS!");
}
