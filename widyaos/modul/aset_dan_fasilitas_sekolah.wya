// ============================================================================
// MODUL: TATA KELOLA ASET BMD, FASILITAS & SARANA PRASARANA SEKOLAH TERPADU
// Mengelola Siklus Hidup Aset Sekolah (PP No. 27/2014 jo. PP No. 28/2020, Permendagri 19/2016)
// 
// 1. Klasifikasi & Kodifikasi KIB (KIB A Tanah s.d. KIB E Aset Tetap Lainnya)
// 2. Kartu Inventaris Ruangan (KIR) Digital Ber-QR Code & Sensus Aset Berkala
// 3. Peminjaman & Penyewaan Fasilitas (Aula, Lab, Lapangan) Anti-Jadwal Bentrok
// 4. Retribusi Sewa BMD / BLUD Terhubung ke Rekening Kasda / Kas BLUD
// 5. Usulan Penghapusan Aset Rusak Berat (Disposal) Bebas Temuan Gudang BPK
// ============================================================================

struktur AsetSekolahKIB {
    kode_barang_bmd,
    nama_aset,
    kategori_kib,             // 'KIB_A_TANAH', 'KIB_B_PERALATAN_MESIN', 'KIB_C_GEDUNG', 'KIB_D_JARINGAN', 'KIB_E_ASET_TETAP_LAIN'
    lokasi_ruangan_kir,       // Contoh: 'LAB_MULTIMEDIA_1'
    tahun_perolehan,
    harga_perolehan_rp,
    kondisi_fisik,            // 'BAIK', 'RUSAK_RINGAN', 'RUSAK_BERAT'
    penanggung_jawab_ruang,
    status_registrasi_simda   // 'TERREGISTER_KIB_BPKAD', 'BELUM_KAPITALISASI'
}

struktur BookingFasilitasSekolah {
    id_booking,
    nama_fasilitas,           // 'AULA_GRAHA_WIYATA', 'LAB_KOMPUTER_1', 'LAPANGAN_FUTSAL', 'BUS_SEKOLAH'
    peminjam,
    kategori_peminjam,        // 'INTERNAL_KBM_DAN_EKSKUL', 'EKSTERNAL_SEWA_KOMERSIAL'
    tanggal_pinjam,
    jam_mulai,                // Format "08:00"
    jam_selesai,              // Format "12:00"
    biaya_retribusi_sewa_rp,
    rekening_tujuan_kas,      // 'KASDA_BAPENDA_PEMDA', 'KAS_BLUD_SMK', 'BEBAS_TARIF_INTERNAL'
    status_booking            // 'DISETUJUI_WAKASEK_SARPRAS', 'DITOLAK_BENTROK_JADWAL'
}

struktur UsulanPenghapusanAsetBMD {
    id_disposal,
    kode_barang_bmd,
    nama_aset,
    tahun_perolehan,
    harga_perolehan_rp,
    kondisi_terakhir,         // 'RUSAK_BERAT_TOTAL'
    alasan_teknis,            // 'BIAYA_PERBAIKAN_MELEBIHI_NILAI_BARU'
    status_persetujuan_bpkad, // 'DISETUJUI_SK_BUPATI_WALIKOTA_GUBERNUR'
    metode_eksekusi,          // 'LELANG_TERBUKA_KPKNL', 'PEMUSNAHAN_FISIK_BA_SAKSI'
    status_neraca             // 'DIHAPUS_DARI_BUKU_ASET_BMD'
}

// ============================================================================
// LOGIKA BISNIS MANAJEMEN ASET & FASILITAS
// ============================================================================

// [1] Pendaftaran Aset Baru ke Kartu Inventaris Barang (KIB & KIR)
fungsi registrasi_aset_ke_kib(
    kode_bmd,
    nama_barang,
    kategori,
    ruangan,
    tahun,
    harga,
    kondisi,
    pj_ruang
) {
    kembalikan AsetSekolahKIB(
        kode_bmd,
        nama_barang,
        kategori,
        ruangan,
        tahun,
        harga,
        kondisi,
        pj_ruang,
        "TERREGISTER_KIB_BPKAD"
    );
}

// [2] Peminjaman Fasilitas Sekolah dengan Deteksi Anti-Jadwal Bentrok
fungsi booking_fasilitas_sekolah(
    id_bk,
    fasilitas,
    peminjam,
    kategori,
    tgl,
    mulai,
    selesai,
    ada_bentrok_jadwal,
    tarif_sewa
) {
    jika ada_bentrok_jadwal {
        kembalikan BookingFasilitasSekolah(
            id_bk,
            fasilitas,
            peminjam,
            kategori,
            tgl,
            mulai,
            selesai,
            0,
            "TIDAK_ADA",
            "DITOLAK_BENTROK_JADWAL"
        );
    }

    misal rekening = "BEBAS_TARIF_INTERNAL";
    jika kategori == "EKSTERNAL_SEWA_KOMERSIAL" {
        rekening = "KASDA_BAPENDA_PEMDA";
    }

    kembalikan BookingFasilitasSekolah(
        id_bk,
        fasilitas,
        peminjam,
        kategori,
        tgl,
        mulai,
        selesai,
        tarif_sewa,
        rekening,
        "DISETUJUI_WAKASEK_SARPRAS"
    );
}

// [3] Usulan Penghapusan Aset Rusak Berat (Stock Opname / Disposal BPKAD)
fungsi usulkan_penghapusan_aset_rusak(
    id_disp,
    kode_bmd,
    nama_barang,
    tahun,
    harga,
    metode
) {
    kembalikan UsulanPenghapusanAsetBMD(
        id_disp,
        kode_bmd,
        nama_barang,
        tahun,
        harga,
        "RUSAK_BERAT_TOTAL",
        "BIAYA_PERBAIKAN_MELEBIHI_NILAI_BARU",
        "DISETUJUI_SK_BUPATI_WALIKOTA_GUBERNUR",
        metode,
        "DIHAPUS_DARI_BUKU_ASET_BMD"
    );
}
