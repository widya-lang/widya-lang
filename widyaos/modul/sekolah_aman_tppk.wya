// =================================================================
// Modul Sekolah Ramah Anak, Anti-Perundungan & Satgas TPPK
// (Adopsi MOD-12 & Permendikbudristek No. 46/2023: PPKSP)
// =================================================================

struktur TiketPengaduanTPPK {
    kode_tiket,
    kategori_kasus, // PERUNDUNGAN_BULLYING, KEKERASAN_FISIK, KEKERASAN_SEKSUAL, DISKRIMINASI_INTOLERANSI
    urgensi, // RENDAH, SEDANG, DARURAT_KRITIS
    ringkasan_kejadian,
    stempel_lapor,
    status_penanganan, // TIKET_DIBUAT, INVESTIGASI_KLARIFIKASI, MEDIASI_KONSELING, RUJUKAN_UPTD_PPA, KASUS_SELESAI
    catatan_tindakan,
    hash_rahasia_pelapor // Zero-Knowledge Hash agar identitas korban aman
}

struktur SesiKonselingBK {
    id_sesi,
    kode_tiket,
    nisn_konseli,
    guru_bk_did,
    tanggal,
    hasil_konseling,
    rekomendasi_psikologis
}

// -------------------------------------------------------------
// [1] Pembuatan Laporan Pengaduan Rahasia (Anonymous Whistleblower)
// -------------------------------------------------------------
fungsi tppk_buat_pengaduan(kategori, urgensi, uraian, identitas_opsional) {
    misal waktu_skrg = waktu();
    misal hash_pelapor = "ANON_" + potong(sha256(identitas_opsional + ke_teks(waktu_skrg)), 0, 16);
    misal kode = "TPPK-" + potong(sha256(kategori + ke_teks(waktu_skrg)), 0, 8);
    
    kembalikan TiketPengaduanTPPK(
        kode,
        kategori,
        urgensi,
        uraian,
        waktu_skrg,
        "TIKET_DIBUAT",
        "Laporan diterima sistem dalam antrean Satgas TPPK",
        hash_pelapor
    );
}

// -------------------------------------------------------------
// [2] Eskalasi Penanganan Kasus oleh Satgas TPPK & Konseling BK
// -------------------------------------------------------------
fungsi tppk_proses_kasus(tiket, status_baru, tindakan) {
    tiket.status_penanganan = status_baru;
    tiket.catatan_tindakan = tindakan;
    
    kembalikan {
        "kode_tiket": tiket.kode_tiket,
        "status_baru": tiket.status_penanganan,
        "catatan": tiket.catatan_tindakan,
        "stempel_update": waktu()
    };
}

// -------------------------------------------------------------
// [3] Rekam Sesi Konseling Psikologis BK
// -------------------------------------------------------------
fungsi tppk_catat_konseling_bk(kode_tiket, nisn, guru_bk, hasil, rekomendasi) {
    misal id_sesi = "BK-" + ke_teks(waktu());
    kembalikan SesiKonselingBK(
        id_sesi,
        kode_tiket,
        nisn,
        guru_bk,
        waktu(),
        hasil,
        rekomendasi
    );
}
