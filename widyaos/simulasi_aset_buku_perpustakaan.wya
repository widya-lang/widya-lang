// =================================================================
// SIMULASI PENCATATAN ASET BUKU PERPUSTAKAAN & MULTI-SUMBER PEMBIAYAAN
// Menguji KIB E (Buku & Perpustakaan), Dual-Ownership, BAST SIPLah,
// dan Rekapitulasi Neraca Aset untuk Audit BPK / Inspektorat
// =================================================================

impor "widyaos/modul/perpustakaan_smart.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === SIMULASI PENCATATAN ASET BUKU PERPUSTAKAAN (KIB E) ===     ║");
cetak("║   Standar Permendagri 19/2016, BAST SIPLah & Audit BPK RI        ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

misal npsn_sekolah = "20109999";
misal nama_sekolah = "SMK Negeri 1 Nusantara";

// -------------------------------------------------------------
// [LANGKAH 1] Pendaftaran Katalog Judul Buku
// -------------------------------------------------------------
cetak("================================================================");
cetak("[1] Pendaftaran Judul Buku pada Katalog Induk Perpustakaan");
cetak("================================================================");
misal buku_rpl = pustaka_daftarkan_buku(
    "BUKU-RPL-01",
    "978-623-123-456-7",
    "Rekayasa Perangkat Lunak Modern Berbasis Kedaulatan Digital",
    "Tim Penulis Widya Kemendikdasmen",
    "005.1", // DDC Ilmu Komputer / Pemrograman
    4
);

cetak("📚 Judul Katalog      :", buku_rpl.judul);
cetak("🏷️ ISBN               :", buku_rpl.isbn);
cetak("📑 Nomor Klasifikasi  : DDC", buku_rpl.ddc_klasifikasi);

// -------------------------------------------------------------
// [LANGKAH 2] Registrasi Eksemplar Fisik Berdasarkan Sumber Dana
// -------------------------------------------------------------
cetak("");
cetak("================================================================");
cetak("[2] Registrasi Eksemplar Fisik & Label Aset KIB E Multi-Dana");
cetak("================================================================");

// Eksemplar 1: Dibeli pakai BOSP Reguler via SIPLah
misal e1 = pustaka_daftarkan_eksemplar_lengkap(
    "BAR-LIB-001",
    buku_rpl.id_buku,
    "001/INV/BOSP-REG/2026",
    "RAK-TIK-01",
    npsn_sekolah,
    "BOSP_REGULER",
    "BAST-SIPLAH-2026-0881",
    85000.0,
    2026,
    "BAIK"
);

// Eksemplar 2: Bantuan Pemerintah Revitalisasi DAK APBN
misal e2 = pustaka_daftarkan_eksemplar_lengkap(
    "BAR-LIB-002",
    buku_rpl.id_buku,
    "002/INV/BANPEM-APBN/2026",
    "RAK-TIK-01",
    npsn_sekolah,
    "BANPEM_APBN",
    "BAST-KEMENDIKDASMEN-DAK-04",
    120000.0,
    2026,
    "BAIK"
);

// Eksemplar 3: Bantuan Operasional Sekolah Daerah (BOSDA Pemda)
misal e3 = pustaka_daftarkan_eksemplar_lengkap(
    "BAR-LIB-003",
    buku_rpl.id_buku,
    "003/INV/BOSDA/2026",
    "RAK-TIK-01",
    npsn_sekolah,
    "BOSDA",
    "BAST-DISDIK-KASDA-11",
    95000.0,
    2026,
    "BAIK"
);

// Eksemplar 4: Hibah / Sumbangan Alumni
misal e4 = pustaka_daftarkan_eksemplar_lengkap(
    "BAR-LIB-004",
    buku_rpl.id_buku,
    "004/INV/HIBAH/2026",
    "RAK-TIK-01",
    npsn_sekolah,
    "HIBAH_WAKAF",
    "AKTA-HIBAH-ALUMNI-2026",
    0.0,
    2026,
    "BAIK"
);

cetak("📖 Eksemplar 1 :", e1.nomor_inventaris, "| Sumber:", e1.sumber_pembiayaan, "| Harga: Rp", e1.harga_perolehan_rp);
cetak("   No BAST SIPLah :", e1.nomor_bast_siplah);
cetak("📖 Eksemplar 2 :", e2.nomor_inventaris, "| Sumber:", e2.sumber_pembiayaan, "| Harga: Rp", e2.harga_perolehan_rp);
cetak("   No BAST APBN   :", e2.nomor_bast_siplah);
cetak("📖 Eksemplar 3 :", e3.nomor_inventaris, "| Sumber:", e3.sumber_pembiayaan, "| Harga: Rp", e3.harga_perolehan_rp);
cetak("   No BAST BOSDA  :", e3.nomor_bast_siplah);
cetak("📖 Eksemplar 4 :", e4.nomor_inventaris, "| Sumber:", e4.sumber_pembiayaan, "| Harga: Rp", e4.harga_perolehan_rp, "(Sumbangan)");

TOTAL_TEST = TOTAL_TEST + 1;
jika e1.sumber_pembiayaan == "BOSP_REGULER" dan e2.sumber_pembiayaan == "BANPEM_APBN" dan e3.sumber_pembiayaan == "BOSDA" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Pelabelan Eksemplar & Nomor BAST Sumber Pembiayaan: LULUS");
}

// -------------------------------------------------------------
// [LANGKAH 3] Rekapitulasi Neraca KIB E untuk Audit BPK
// -------------------------------------------------------------
cetak("");
cetak("================================================================");
cetak("[3] Rekapitulasi Neraca Aset KIB E Buku Perpustakaan (Audit Trail)");
cetak("================================================================");
misal koleksi_perpustakaan = [e1, e2, e3, e4];
misal rekap_kib = pustaka_rekapitulasi_kib_e(npsn_sekolah, koleksi_perpustakaan);

cetak("🏛️ NPSN Pemilik Aset   :", rekap_kib.npsn_sekolah);
cetak("📚 Total Eksemplar Buku :", rekap_kib.total_eksemplar_buku, "buku");
cetak("💰 Total Nilai Aset KIBE: Rp", rekap_kib.total_nilai_aset_rp);
cetak("----------------------------------------------------------------");
cetak("RINCIAN REKONSILIASI PER SUMBER PEMBIAYAAN:");
cetak("1. Belanja Modal BOSP Reguler     : Rp", rekap_kib.alokasi_bosp_reguler_rp);
cetak("2. Belanja Banpem Revitalisasi    : Rp", rekap_kib.alokasi_banpem_apbn_rp);
cetak("3. Belanja BOSDA Provinsi/Daerah  : Rp", rekap_kib.alokasi_bosda_rp);
cetak("4. Penerimaan Hibah / Wakaf       : Rp", rekap_kib.alokasi_hibah_wakaf_rp, "(Tercatat tertib tanpa belanja kas)");
cetak("----------------------------------------------------------------");

TOTAL_TEST = TOTAL_TEST + 1;
jika rekap_kib.total_eksemplar_buku == 4 dan rekap_kib.total_nilai_aset_rp == 300000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Total Nilai Kapitalisasi Aset KIB E Sesuai: LULUS");
}

TOTAL_TEST = TOTAL_TEST + 1;
jika rekap_kib.alokasi_bosp_reguler_rp == 85000.0 dan rekap_kib.alokasi_banpem_apbn_rp == 120000.0 dan rekap_kib.alokasi_bosda_rp == 95000.0 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Pemisahan Rekonsiliasi Kas BOSP, APBN, BOSDA & Hibah: LULUS");
}

cetak("");
cetak("================================================================");
cetak("HASIL EVALUASI PENCATATAN ASET BUKU PERPUSTAKAAN (KIB E)");
cetak("Total Skenario Diuji :", TOTAL_TEST);
cetak("Lulus Verifikasi     :", LULUS_TEST);
cetak("================================================================");
jika TOTAL_TEST == LULUS_TEST {
    cetak("🎉 SEMPURNA! SELURUH PENCATATAN ASET BUKU & SUMBER DANA 100% LULUS!");
}
