// Modul Kuantisasi Tensor INT8 Adaptif Disintesis Mandiri oleh AI
// ============================================================================

fungsi kuantisasi_vektor_desa(vektor_fp32, skala) {
    misal kuantisasi = [];
    untuk val di vektor_fp32 {
        tambah(kuantisasi, val * skala);
    }
    kembalikan kuantisasi;
}

fungsi dekuantisasi_vektor_desa(vektor_int8, skala) {
    misal dekuantisasi = [];
    untuk val di vektor_int8 {
        tambah(dekuantisasi, val / skala);
    }
    kembalikan dekuantisasi;
}
