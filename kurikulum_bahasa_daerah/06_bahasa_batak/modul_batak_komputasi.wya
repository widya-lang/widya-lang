// ==============================================================================
// MODUL BD-106: KOMPUTASI BAHASA BATAK, SURAT BATAK & STRUKTUR TAROMBO
// Implementasi Kurikulum Pembelajaran Bahasa Daerah Berbasis Widya-Lang
// ==============================================================================

cetak("==================================================================");
cetak("📚 MODUL BD-106: PEMBELAJARAN BAHASA BATAK & AKSARA TRADISIONAL");
cetak("==================================================================");

// 1. TRANSLITERASI TEKS KE SURAT BATAK
cetak("\n--- [1] Transliterasi Latin ke Surat Batak (Unicode Compliant) ---");

var frasa_batak = [
    "horas ma di hita saluhutna",
    "mejuah juah",
    "njuah njuah",
    "widya nusantara"
];

untuk f dalam frasa_batak {
    var aksara = latin_ke_aksara_batak(f);
    cetak("  • Latin  : " + f);
    cetak("    Batak  : " + aksara);
}

// 2. KAMUS LEKSIKOGRAFI KOMPARATIF RUMPUN BATAK
cetak("\n--- [2] Kamus Komparatif Rumpun Bahasa Batak ---");

struktur EntriBatak {
    toba,
    karo,
    mandailing,
    arti_indonesia
}

misal kamus_batak = [
    EntriBatak("mangan", "man", "mangan", "makan"),
    EntriBatak("modom", "medem", "modom", "tidur"),
    EntriBatak("bagas / jabu", "rumah", "bagas", "rumah"),
    EntriBatak("ro", "reh", "ro", "datang"),
    EntriBatak("borua", "diberu", "borua", "perempuan / wanita"),
    EntriBatak("doli / baoa", "dilaki", "bayo", "laki-laki / pria")
];

untuk item dalam kamus_batak {
    cetak("  • Indonesia   : " + item.arti_indonesia);
    cetak("    - Toba       : " + item.toba);
    cetak("    - Karo       : " + item.karo);
    cetak("    - Mandailing : " + item.mandailing);
}

// 3. FALSAFAH DALIHAN NA TOLU & SISTEM TAROMBO
cetak("\n--- [3] Pemodelan Sistem Kekerabatan Dalihan Na Tolu ---");

struktur PeranDalihan {
    pilar,
    makna_adat,
    prinsip_perilaku
}

misal dalihan = [
    PeranDalihan("Hula-hula", "Pihak keluarga pemberi mempelai wanita", "Somba marhula-hula (Hormat dan takzim kepada hula-hula)"),
    PeranDalihan("Dongan Tubu", "Teman semarga sekelahiran patrilineal", "Manat mardongan tubu (Hati-hati, kompak, dan saling jaga martabat)"),
    PeranDalihan("Boru", "Pihak keluarga penerima wanita", "Elek marboru (Mengayomi, membimbing, dan mengasihi boru)")
];

untuk d dalam dalihan {
    cetak("  • Pilar Adat : " + d.pilar);
    cetak("    - Makna    : " + d.makna_adat);
    cetak("    - Prinsip  : " + d.prinsip_perilaku);
}

// 4. UMPASA ADAT BATAK
cetak("\n--- [4] Umpasa Luhung & Doa Adat Batak ---");
var umpasa = [
    "Aek godang tu aek laut, Dos ni roha sibahen na saut (Musyawarah mufakat dan kesepakatan hati mendatangkan keberhasilan)",
    "Bintang na rumiris, ombun na sumorop; Anak pe riris, boru pe torop (Doa keberkahan keturunan putra dan putri yang berbudi luhur)",
    "Pantun do hangoluan, tois hamagoan (Kesopanan dan budi pekerti menjamin keselamatan hidup, keangkuhan membawa celaka)"
];

untuk u dalam umpasa {
    cetak("  🌟 " + u);
}

cetak("\n==================================================================");
cetak("✅ Modul BD-106 Bahasa Batak selesai dipelajari!");
cetak("==================================================================");
