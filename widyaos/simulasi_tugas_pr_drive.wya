// =================================================================
// SIMULASI SUITE: PENGUMPULAN TUGAS PR DARI CLOUD DRIVE KE LMS SINAU
// Pengujian Integrasi Google Drive, OneDrive, Anti-Plagiasi, & e-Rapor
// =================================================================

impor "widyaos/modul/tugas_pr_drive_lms.wya";

cetak("==================================================================");
cetak(" UJI INTEGRASI PENGUMPULAN TUGAS PR DARI CLOUD DRIVE KE LMS SINAU ");
cetak("==================================================================");

// [TEST 1] Guru Menerbitkan Tugas PR Baru di LMS Sinau
cetak("\n[1] Penerbitan Tugas PR Baru oleh Guru di LMS Sinau");
misal pr_fisika = buat_tugas_pr_lms(
    "PR-2026-OPT-01",
    "ROMBEL-10-A",
    "IPA-FIS-10",
    "Fisika Terapan",
    "Laporan Praktikum Pembiasan Cahaya & Lensa Cembung",
    "Unggah dokumen laporan eksperimen format PDF/Docs dari Google Drive atau Cloud Penyimpanan Anda",
    "2026-09-20T23:59:00"
);

cetak("📖 Mata Pelajaran      :", pr_fisika.nama_mapel);
cetak("📋 Judul Tugas PR      :", pr_fisika.judul_tugas);
cetak("⏰ Batas Tenggat Waktu :", pr_fisika.tenggat_waktu_deadline);
cetak("💯 Bobot Maksimal      :", pr_fisika.skor_maksimal, "poin");

jika pr_fisika.id_tugas == "PR-2026-OPT-01" {
    cetak("✅ [TEST 1] Penerbitan Tugas PR Baru di LMS Sinau: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Penerbitan Tugas PR Baru di LMS Sinau: GAGAL");
}

// [TEST 2] Siswa 1 Mengumpulkan Tugas dari Google Drive Tepat Waktu
cetak("\n[2] Siswa 1 Mengunggah Tugas dari Google Drive (Tepat Waktu)");
misal sub_fauzi = kumpulkan_pr_dari_drive(
    pr_fisika,
    "0081234567",
    "Ahmad Fauzi",
    "GOOGLE_DRIVE",
    "https://drive.google.com/file/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/view",
    "Laporan_Eksperimen_Lensa_Fauzi.pdf",
    2.4, // 2.4 MB
    "0xa89fbc014389234892cfa78923412aefbc901289", // Hash file SHA-256
    "2026-09-19T14:30:00" // Sebelum deadline
);

cetak("👦 Nama Siswa          :", sub_fauzi.nama_siswa);
cetak("☁️ Sumber Cloud Drive  :", sub_fauzi.penyedia_drive);
cetak("📎 Nama Berkas         :", sub_fauzi.nama_berkas, "(Ukuran:", sub_fauzi.ukuran_mb, "MB)");
cetak("⚡ Status Ketepatan    :", sub_fauzi.status_ketepatan);
cetak("🛡️ Status Orisinalitas :", sub_fauzi.status_orisinalitas);
cetak("📲 Notifikasi Wali     :", sub_fauzi.notifikasi_ke_wali);

jika sub_fauzi.status_ketepatan == "TEPAT_WAKTU" dan sub_fauzi.penyedia_drive == "GOOGLE_DRIVE" {
    cetak("✅ [TEST 2] Pengumpulan Tugas dari Google Drive Tepat Waktu: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Pengumpulan Tugas dari Google Drive Tepat Waktu: GAGAL");
}

// [TEST 3] Siswa 2 Mengumpulkan Tugas dari Nextcloud Lokal (Terlambat)
cetak("\n[3] Siswa 2 Mengunggah Tugas dari Nextcloud Lokal Sekolah (Terlambat)");
misal sub_budi = kumpulkan_pr_dari_drive(
    pr_fisika,
    "0087766554",
    "Budi Pratama",
    "NEXTCLOUD_LOKAL",
    "https://cloud.sekolah.local/s/89dFkm294Jka/download",
    "Laporan_Optik_Budi.pdf",
    1.8,
    "0xb789123049182390148912aefbc0912489124891",
    "2026-09-21T07:15:00" // Melewati batas deadline (2026-09-20T23:59:00)
);

cetak("👦 Nama Siswa          :", sub_budi.nama_siswa);
cetak("☁️ Sumber Cloud Drive  :", sub_budi.penyedia_drive);
cetak("⏰ Waktu Mengumpulkan  :", sub_budi.waktu_pengumpulan);
cetak("🚨 Status Ketepatan    :", sub_budi.status_ketepatan);

jika sub_budi.status_ketepatan == "TERLAMBAT" {
    cetak("✅ [TEST 3] Deteksi Keterlambatan Pengumpulan Tugas PR: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Deteksi Keterlambatan Pengumpulan Tugas PR: GAGAL");
}

// [TEST 4] Deteksi Anti-Plagiasi Berkas Duplikat (Copas Berkas Teman)
cetak("\n[4] Uji Deteksi Anti-Plagiasi Berkas Duplikat (Copas File)");
// Siswa 3 mengunggah file yang sama persis dengan milik Siswa 1 (Hash identik)
misal sub_doni = kumpulkan_pr_dari_drive(
    pr_fisika,
    "0089991122",
    "Doni Kurniawan",
    "GOOGLE_DRIVE",
    "https://drive.google.com/file/d/copy_file_fauzi",
    "Laporan_Optik_Doni.pdf", // Nama file beda, tapi isi hash sama
    2.4,
    "0xa89fbc014389234892cfa78923412aefbc901289", // Hash SAMA dengan milik Fauzi
    "2026-09-19T18:00:00"
);

cetak("👦 Nama Siswa          :", sub_doni.nama_siswa);
cetak("⚠️ Status Orisinalitas :", sub_doni.status_orisinalitas);
cetak("🔒 Indikasi Sistem     : Terdeteksi hash berkas identik dengan kiriman Ahmad Fauzi");

jika sub_doni.status_orisinalitas == "PERINGATAN_DUPLIKASI_PERSIS" {
    cetak("✅ [TEST 4] Guardrail Anti-Plagiasi Berkas Duplikat SHA-256: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Guardrail Anti-Plagiasi Berkas Duplikat SHA-256: GAGAL");
}

// [TEST 5] Guru Memberikan Penilaian & Integrasi Formatif e-Rapor
cetak("\n[5] Penilaian Tugas PR oleh Guru & Integrasi Formatif e-Rapor");
misal res_nilai = beri_nilai_tugas_pr(
    sub_fauzi,
    95.0,
    "Analisis data hasil percobaan pembiasan lensa sangat akurat dan pembahasan grafiknya lengkap!"
);

cetak("🎯 Nilai Diberikan     :", res_nilai.nilai_diberikan);
cetak("✍️ Catatan Umpan Balik :", res_nilai.umpan_balik);
cetak("📊 Status Sinkronisasi :", res_nilai.status_sinkronisasi_erapor);

jika sub_fauzi.nilai_guru == 95.0 dan res_nilai.status_sinkronisasi_erapor == "TERINTEGRASI_KE_NILAI_FORMATIF_ERAPOR" {
    cetak("✅ [TEST 5] Penilaian Guru di LMS & Integrasi ke Asesmen Formatif: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Penilaian Guru di LMS & Integrasi ke Asesmen Formatif: GAGAL");
}

cetak("\n==================================================================");
cetak(" SEMUA PENGUJIAN INTEGRASI TUGAS PR DARI DRIVE KE LMS LULUS 100%! ");
cetak("==================================================================");
