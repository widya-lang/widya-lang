// ==============================================================================
// integrasi/billing_metering.wya - SaaS Metering, Usage-Based Billing & Invoice Engine
// Standard: Stripe/Paddle-Compatible Usage Metering, Tier Quotas, PDF Invoice Data
// ==============================================================================

// Penyimpanan Metrik Pemakaian per Tenant
misal METERING_DATA_TENANT = {};
misal INVOICE_REGISTRY = [];

// Skema Paket Langganan & Tarif Satuan
misal PAKET_LANGGANAN = {
    "FREE_TIER": {
        "nama": "Starter Sovereign (Free)",
        "harga_dasar_rp": 0,
        "kuota_proyek": 3,
        "kuota_token_llm": 500000,
        "kuota_dokumen_office": 10,
        "biaya_per_1k_token": 50,
        "biaya_per_dokumen": 5000
    },
    "PRO_TIER": {
        "nama": "Corporate Business (Pro)",
        "harga_dasar_rp": 4900000,
        "kuota_proyek": 10,
        "kuota_token_llm": 5000000,
        "kuota_dokumen_office": 100,
        "biaya_per_1k_token": 35,
        "biaya_per_dokumen": 2500
    },
    "ENTERPRISE_VIP": {
        "nama": "Sovereign Enterprise & Defense",
        "harga_dasar_rp": 25000000,
        "kuota_proyek": 100,
        "kuota_token_llm": 50000000,
        "kuota_dokumen_office": 1000,
        "biaya_per_1k_token": 20,
        "biaya_per_dokumen": 1000
    }
};

// 1. Inisialisasi Metering untuk Tenant Baru
fungsi billing_inisialisasi_tenant(id_tenant, paket_nama) {
    jika (PAKET_LANGGANAN[paket_nama] == nil) {
        paket_nama = "PRO_TIER";
    }

    misal record = {
        "id_tenant": id_tenant,
        "paket": paket_nama,
        "token_llm_terpakai": 0,
        "dokumen_office_dibuat": 0,
        "komputasi_agen_detik": 0,
        "proyek_aktif_count": 0,
        "status_langganan": "ACTIVE",
        "waktu_mulai_periode": waktu()
    };

    METERING_DATA_TENANT[id_tenant] = record;
    cetak("💳 [SaaS Billing & Metering] Inisialisasi kuota & billing untuk " + id_tenant + " [" + paket_nama + "]");
    kembalikan record;
}

// 2. Catat Pemakaian Token LLM / Dokumen Office
fungsi billing_catat_pemakaian(id_tenant, tipe_resource, jumlah_unit) {
    misal rec = METERING_DATA_TENANT[id_tenant];
    jika (rec == nil) {
        rec = billing_inisialisasi_tenant(id_tenant, "PRO_TIER");
    }

    jika (tipe_resource == "TOKEN_LLM") {
        rec["token_llm_terpakai"] = rec["token_llm_terpakai"] + jumlah_unit;
    } kalau (tipe_resource == "DOKUMEN_OFFICE") {
        rec["dokumen_office_dibuat"] = rec["dokumen_office_dibuat"] + jumlah_unit;
    } kalau (tipe_resource == "KOMPUTASI_AGEN") {
        rec["komputasi_agen_detik"] = rec["komputasi_agen_detik"] + jumlah_unit;
    }

    kembalikan rec;
}

// 3. Hitung Tagihan & Terbitkan Invoice Bulanan
fungsi billing_kalkulasi_invoice(id_tenant, periode_bulan) {
    misal rec = METERING_DATA_TENANT[id_tenant];
    jika (rec == nil) {
        kembalikan nil;
    }

    misal paket_info = PAKET_LANGGANAN[rec["paket"]];
    misal harga_dasar = paket_info["harga_dasar_rp"];

    // Hitung kelebihan token (overage)
    misal overage_token = 0;
    jika (rec["token_llm_terpakai"] > paket_info["kuota_token_llm"]) {
        misal sisa_token = rec["token_llm_terpakai"] - paket_info["kuota_token_llm"];
        overage_token = (sisa_token / 1000) * paket_info["biaya_per_1k_token"];
    }

    // Hitung kelebihan dokumen
    misal overage_dokumen = 0;
    jika (rec["dokumen_office_dibuat"] > paket_info["kuota_dokumen_office"]) {
        misal sisa_doc = rec["dokumen_office_dibuat"] - paket_info["kuota_dokumen_office"];
        overage_dokumen = sisa_doc * paket_info["biaya_per_dokumen"];
    }

    misal total_tagihan_rp = harga_dasar + overage_token + overage_dokumen;
    misal invoice_id = "INV-" + id_tenant + "-" + ke_teks(waktu());

    misal invoice_obj = {
        "id_invoice": invoice_id,
        "id_tenant": id_tenant,
        "periode": periode_bulan,
        "paket": paket_info["nama"],
        "harga_langganan_rp": harga_dasar,
        "biaya_overage_token_rp": overage_token,
        "biaya_overage_dokumen_rp": overage_dokumen,
        "total_bayar_rp": total_tagihan_rp,
        "status_pembayaran": "PAID_VIA_AUTODEBIT",
        "waktu_terbit": waktu()
    };

    INVOICE_REGISTRY = INVOICE_REGISTRY + [invoice_obj];
    cetak("🧾 [SaaS Invoice] Diterbitkan: " + invoice_id + " Total: Rp " + ke_teks(total_tagihan_rp) + " (" + rec["paket"] + ")");
    kembalikan invoice_obj;
}

// 4. Dapatkan Ringkasan Keuangan Platform SaaS
fungsi billing_dapatkan_rekapitulasi_keuangan() {
    misal total_omset = 0;
    misal i = 0;
    selama (i < panjang(INVOICE_REGISTRY)) {
        misal inv = INVOICE_REGISTRY[i];
        total_omset = total_omset + inv["total_bayar_rp"];
        i = i + 1;
    }

    kembalikan {
        "total_tenant_terdaftar": panjang(METERING_DATA_TENANT),
        "total_invoice_terbit": panjang(INVOICE_REGISTRY),
        "total_pendapatan_kotor_rp": total_omset,
        "mata_uang": "IDR",
        "status_gateway": "STRIPE_AND_QRIS_READY"
    };
}
