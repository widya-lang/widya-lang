    // RUTE 93: Penerbitan W3C Verifiable Credential Bersegel PQC (/v1/id/vc/issue)
    tambah_rute(server, "POST", "/v1/id/vc/issue", fungsi(req) {
        misal b = req["badan"];
        misal id_kred = "VC-DESA-001";
        misal tipe = "KTP_DIGITAL_DESA";
        misal did_penerbit = "did:widya:desa:sepaku_resmi";
        misal did_subjek = "did:widya:warga:budi_sepaku_01";
        misal klaim = { "status_warga": "TETAP", "zona_desa": "Sepaku_Hilir", "hak_akses": "PENUH" };
        misal masa_berlaku = 31536000;
        jika (ada_kunci(b, "id_kredensial")) { id_kred = b["id_kredensial"]; }
        jika (ada_kunci(b, "tipe_kredensial")) { tipe = b["tipe_kredensial"]; }
        jika (ada_kunci(b, "penerbit_did")) { did_penerbit = b["penerbit_did"]; }
        jika (ada_kunci(b, "subjek_did")) { did_subjek = b["subjek_did"]; }
        jika (ada_kunci(b, "klaim_data")) { klaim = b["klaim_data"]; }
        jika (ada_kunci(b, "masa_berlaku_detik")) { masa_berlaku = b["masa_berlaku_detik"]; }

        misal vc = id_terbitkan_kredensial(id_kred, tipe, did_penerbit, did_subjek, klaim, masa_berlaku);
        kembalikan {
            "status": "VC_ISSUED",
            "id_kredensial": vc.id_kredensial,
            "tipe_kredensial": vc.tipe_kredensial,
            "penerbit_did": vc.penerbit_did,
            "subjek_did": vc.subjek_did,
            "klaim_data": vc.klaim_data,
            "stempel_terbit": vc.stempel_terbit,
