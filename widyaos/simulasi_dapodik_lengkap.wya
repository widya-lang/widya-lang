// ==============================================================================
// WIDYAOS: SIMULASI MASTER 8 PILAR DAPODIK LENGKAP KEMENDIKDASMEN RI
// Menguji:
// 1. Satuan Pendidikan, Titik Koordinat Geospasial & Audit Sanitasi Sekolah
// 2. Sarana dan Prasarana (Tanah, Bangunan, Ruang & Tingkat Kerusakan PUPR)
// 3. Pendidik & Tenaga Kependidikan (GTK, Sertifikasi Serdik & TPG 24 JJM)
// 4. Peserta Didik (Identitas Kependudukan, Antropometri & KIP/PIP)
// 5. Rombongan Belajar (Rombel Reguler/P5 & SK PBM Beban Mengajar)
// 6. Penjadwalan Pelajaran & Proteksi Anti-Bentrok Ruang/Guru
// 7. Mesin Validasi Dapodik: Deteksi Data Invalid & Penguncian Sinkronisasi
// 8. Kepatuhan Penuh (Invalid = 0) & Sukses Sinkronisasi ke Pusdatin
// ==============================================================================

impor "widyaos/modul/dapodik_edge.wya";

cetak("");
cetak("╔══════════════════════════════════════════════════════════════════╗");
cetak("║   === SIMULASI 8 PILAR MASTER DAPODIK WIDYAOS v1.0 ===           ║");
cetak("║   Integrasi Penuh Data Pokok Pendidikan Kemendikdasmen RI        ║");
cetak("╚══════════════════════════════════════════════════════════════════╝");
cetak("");

misal TOTAL_TEST = 0;
misal LULUS_TEST = 0;

misal npsn = "20108888";
misal nama_sekolah = "SMA Negeri 1 Garudaprana Nusantara";
misal dapodik = inisialisasi_dapodik_edge(npsn, nama_sekolah);

// ==============================================================================
// [TEST 1] SATUAN PENDIDIKAN & SANITASI SEKOLAH
// ==============================================================================
cetak("================================================================");
cetak("[1] Pilar Satuan Pendidikan, Titik Geospasial & Sanitasi");
cetak("================================================================");

misal identitas_sekolah = dapodik_set_identitas_sekolah(
    dapodik,
    "SMA",
    "NEGERI",
    "SK-OP-421/001/Disdik/2015",
    "2015-05-02",
    "Jl. Merdeka Pendidikan No. 45",
    "Garudamekar",
    "Coblong",
    "Kota Bandung",
    "Jawa Barat",
    -6.8912,
    107.6105,
    "A",
    "PLN",
    13200,
    "FIBER_OPTIK_100_MBPS"
);

misal sanitasi_sekolah = dapodik_set_sanitasi(
    dapodik,
    "SUMUR_BOR_DAN_PDAM",
    "TERSEDIA_AIR_MATANG_HIGIENIS",
    6, // 6 toilet laki
    8, // 8 toilet perempuan
    2, // 2 toilet inklusi difabel
    15, // 15 wastafel sabun
    "3_TEMPAT_SAMPAH_ORGANIK_ANORGANIK_B3"
);

cetak("🏫 Satuan Pendidikan :", dapodik.data_sekolah.nama_sekolah, "(NPSN:", dapodik.data_sekolah.npsn + ")");
cetak("   Bentuk / Status   :", dapodik.data_sekolah.bentuk_pendidikan, "|", dapodik.data_sekolah.status_sekolah, "| Akreditasi:", dapodik.data_sekolah.akreditasi);
cetak("   Lokasi Geospasial : Koordinat (" + ke_teks(dapodik.data_sekolah.lintang) + ", " + ke_teks(dapodik.data_sekolah.bujur) + ")");
cetak("🚿 Audit Sanitasi    : Air Bersih =", dapodik.data_sanitasi.sumber_air_bersih);
cetak("   Jamban / Toilet   : Laki-laki:", dapodik.data_sanitasi.jamban_laki, "| Perempuan:", dapodik.data_sanitasi.jamban_perempuan, "| Difabel:", dapodik.data_sanitasi.jamban_difabel);

TOTAL_TEST = TOTAL_TEST + 1;
jika dapodik.data_sekolah.akreditasi == "A" dan dapodik.data_sanitasi.jamban_difabel == 2 {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 1] Satuan Pendidikan, Titik Geospasial & Sanitasi: LULUS");
} lainnya {
    cetak("❌ [TEST 1] Satuan Pendidikan, Titik Geospasial & Sanitasi: GAGAL");
}

// ==============================================================================
// [TEST 2] SARANA DAN PRASARANA (TANAH, BANGUNAN & RUANG TINGKAT KERUSAKAN PUPR)
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[2] Pilar Sarana & Prasarana (Standar Penilaian Kerusakan PUPR)");
cetak("================================================================");

misal tanah = dapodik_tambah_tanah(dapodik, "TNH-01", "HP-No.45/Pemda/2012", 12500, "MILIK_SENDIRI");
misal bgn1 = dapodik_tambah_bangunan(dapodik, "BGN-01", "TNH-01", "Gedung Pembelajaran Teori 2 Lantai", 3200, 2018, 12.5);
misal bgn2 = dapodik_tambah_bangunan(dapodik, "BGN-02", "TNH-01", "Gedung Laboratorium & Sains", 1400, 2012, 38.0);

misal r_kelas = dapodik_tambah_ruang(dapodik, "RNG-X-A", "BGN-01", "Ruang Kelas X-A", "KELAS", 36, 9.0, 8.0);
misal r_lab = dapodik_tambah_ruang(dapodik, "RNG-LAB-AI", "BGN-02", "Laboratorium Komputer & IFP", "LAB_KOMPUTER", 40, 12.0, 9.0);

cetak("🏞️ Tanah Sekolah      : Luas", tanah.luas_m2, "m² | No Sertifikat:", tanah.no_sertifikat);
cetak("🏢 Bangunan 1         :", bgn1.nama_bangunan, "(Tingkat Kerusakan PUPR:", ke_teks(bgn1.persen_rusak_pupr) + "% -> Kondisi:", bgn1.kondisi_kerusakan + ")");
cetak("🏢 Bangunan 2         :", bgn2.nama_bangunan, "(Tingkat Kerusakan PUPR:", ke_teks(bgn2.persen_rusak_pupr) + "% -> Kondisi:", bgn2.kondisi_kerusakan + ")");
cetak("🚪 Ruang Kelas        :", r_kelas.nama_ruang, "(Kapasitas:", r_kelas.kapasitas_siswa, "siswa)");
cetak("🚪 Ruang Laboratorium :", r_lab.nama_ruang, "(Kapasitas:", r_lab.kapasitas_siswa, "siswa)");

TOTAL_TEST = TOTAL_TEST + 1;
jika bgn1.kondisi_kerusakan == "BAIK" dan bgn2.kondisi_kerusakan == "RUSAK_RINGAN" dan r_lab.jenis_ruang == "LAB_KOMPUTER" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 2] Sarpras Tanah, Bangunan & Ruang Standar PUPR: LULUS");
} lainnya {
    cetak("❌ [TEST 2] Sarpras Tanah, Bangunan & Ruang Standar PUPR: GAGAL");
}

// ==============================================================================
// [TEST 3] GTK, SERTIFIKASI SERDIK & PERSYARATAN TPG 24 JAM
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[3] Pilar Pendidik & Tenaga Kependidikan (GTK & TPG 24 JJM)");
cetak("================================================================");

misal guru_bambang = dapodik_tambah_gtk_lengkap(
    dapodik,
    "19750812001",
    "3201017508120001",
    "197508122000031002",
    "Drs. Bambang Irawan",
    "Drs.",
    "M.Pd",
    "GURU_MAPEL",
    "PNS",
    "S2",
    "2026/SERDIK/FISIKA/001",
    "Fisika Terapan",
    26 // 26 JJM
);

misal guru_rina = dapodik_tambah_gtk_lengkap(
    dapodik,
    "19920405002",
    "3201019204050002",
    "", // Non-PNS
    "Rina Marlina",
    "",
    "S.Pd",
    "GURU_MAPEL",
    "HONOR_SEKOLAH",
    "S1",
    "",
    "Kimia",
    18 // 18 JJM
);

cetak("👨‍🏫 PTK 1 :", guru_bambang.nama_lengkap + ",", guru_bambang.gelar_belakang);
cetak("   Status Kepegawaian :", guru_bambang.status_kepegawaian, "| NIP:", guru_bambang.nip);
cetak("   Nomor Sertifikat   :", guru_bambang.nomor_serdik, "(Bidang:", guru_bambang.bidang_sertifikasi + ")");
cetak("   Total Jam Mengajar :", guru_bambang.total_jjm_mengajar, "JJM/minggu -> Status TPG:", guru_bambang.status_tpg);

cetak("👩‍🏫 PTK 2 :", guru_rina.nama_lengkap + ",", guru_rina.gelar_belakang);
cetak("   Total Jam Mengajar :", guru_rina.total_jjm_mengajar, "JJM/minggu -> Status TPG:", guru_rina.status_tpg);

TOTAL_TEST = TOTAL_TEST + 1;
jika guru_bambang.status_tpg == "MEMENUHI_SYARAT_TPG_24_JAM" dan guru_rina.status_tpg == "BELUM_MEMENUHI" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 3] Profil GTK, Sertifikasi & Pemenuhan Syarat TPG 24 Jam: LULUS");
} lainnya {
    cetak("❌ [TEST 3] Profil GTK, Sertifikasi & Pemenuhan Syarat TPG 24 Jam: GAGAL");
}

// ==============================================================================
// [TEST 4] PESERTA DIDIK, DATA KEPENDUDUKAN & KELAYAKAN PIP / KIP
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[4] Pilar Peserta Didik, NIK/NISN & Bantuan Kesejahteraan PIP");
cetak("================================================================");

misal siswa_ahmad = dapodik_tambah_siswa_lengkap(
    dapodik,
    "0081234567",
    "3201012345670001",
    "3201010000000001",
    "Ahmad Fauzi",
    "L",
    "2008-05-14",
    "Siti Aminah",
    "Rahmat Hidayat",
    "Buruh Harian Lepas",
    850000,
    benar, // Penerima KIP
    "KIP-2026-9901-FAUZI",
    "LAYAK_PIP_DTKS",
    168.0,
    56.0,
    "ROMBEL-X-MIPA-1"
);

misal siswi_nadia = dapodik_tambah_siswa_lengkap(
    dapodik,
    "0087654321",
    "3201017654320002",
    "3201010000000002",
    "Nadia Syifa",
    "P",
    "2008-09-22",
    "Nurhayati",
    "H. Suryana, S.E",
    "Karyawan BUMN",
    12000000,
    salah,
    "",
    "TIDAK_LAYAK",
    158.0,
    48.0,
    "ROMBEL-X-MIPA-1"
);

cetak("👦 Siswa 1 :", siswa_ahmad.nama_lengkap, "(NISN:", siswa_ahmad.nisn, "| NIK:", siswa_ahmad.nik + ")");
cetak("   Nama Ibu Kandung   :", siswa_ahmad.nama_ibu_kandung);
cetak("   Status Bansos      : KIP =", siswa_ahmad.penerima_kip, "| No KIP:", siswa_ahmad.nomor_kip, "-> Status:", siswa_ahmad.status_layak_pip);

cetak("👧 Siswa 2 :", siswi_nadia.nama_lengkap, "(NISN:", siswi_nadia.nisn, "| NIK:", siswi_nadia.nik + ")");
cetak("   Status Bansos      : KIP =", siswi_nadia.penerima_kip, "-> Status:", siswi_nadia.status_layak_pip);

TOTAL_TEST = TOTAL_TEST + 1;
jika siswa_ahmad.status_layak_pip == "LAYAK_PIP_DTKS" dan siswi_nadia.status_layak_pip == "TIDAK_LAYAK" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 4] Peserta Didik, Kependudukan & Validasi KIP/PIP: LULUS");
} lainnya {
    cetak("❌ [TEST 4] Peserta Didik, Kependudukan & Validasi KIP/PIP: GAGAL");
}

// ==============================================================================
// [TEST 5] ROMBEL & PEMBELAJARAN (SK PBM BEBAN MENGAJAR)
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[5] Pilar Rombongan Belajar & SK Pembagian Tugas Mengajar (PBM)");
cetak("================================================================");

misal rombel_10 = dapodik_tambah_rombel_lengkap(
    dapodik,
    "ROMBEL-X-MIPA-1",
    "Kelas X MIPA 1",
    10,
    "Kurikulum Merdeka 2024",
    "RNG-X-A",
    "19750812001", // Wali kelas: Drs. Bambang
    "REGULER"
);

misal pbm_fisika = dapodik_tambah_pembelajaran_sk_pbm(
    dapodik,
    "PBM-FIS-001",
    "ROMBEL-X-MIPA-1",
    "Fisika Dasar",
    "19750812001",
    "SK-PBM-800/01/2026",
    "2026-07-15",
    4 // 4 jam per minggu
);

cetak("👥 Rombel Terdaftar   :", rombel_10.nama_rombel, "| Kurikulum:", rombel_10.kurikulum);
cetak("   Ruang Kelas Induk  :", rombel_10.id_ruang, "| Wali Kelas NUPTK:", rombel_10.nuptk_wali_kelas);
cetak("📖 SK PBM Pembelajaran:", pbm_fisika.mata_pelajaran);
cetak("   Nomor SK PBM       :", pbm_fisika.nomor_sk_pbm, "| Alokasi:", pbm_fisika.alokasi_jjm, "JJM/minggu");
cetak("   Status Linearitas  :", pbm_fisika.status_linearitas);

TOTAL_TEST = TOTAL_TEST + 1;
jika rombel_10.tingkat_kelas == 10 dan pbm_fisika.status_linearitas == "LINEAR" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 5] Rombongan Belajar & SK PBM Pembelajaran: LULUS");
} lainnya {
    cetak("❌ [TEST 5] Rombongan Belajar & SK PBM Pembelajaran: GAGAL");
}

// ==============================================================================
// [TEST 6] JADWAL PELAJARAN & DETEKSI ANTI-BENTROK RUANG/GURU
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[6] Pilar Jadwal Pelajaran & Proteksi Anti-Bentrok Ruang/Guru");
cetak("================================================================");

// Jadwal 1: Senin Jam ke-1 di Lab Komputer
misal j1 = dapodik_tambah_jadwal(
    dapodik,
    "JDW-01",
    "ROMBEL-X-MIPA-1",
    "SENIN",
    1,
    "RNG-LAB-AI",
    "19750812001",
    "Fisika Dasar & Komputasi"
);

// Jadwal 2: Mencoba menempatkan kelas lain pada Senin Jam ke-1 di Ruang Lab yang sama
misal j2 = dapodik_tambah_jadwal(
    dapodik,
    "JDW-02",
    "ROMBEL-X-MIPA-2",
    "SENIN",
    1,
    "RNG-LAB-AI", // Ruang sama pada jam sama
    "19920405002",
    "Kimia Komputasi"
);

cetak("📅 Slot Jadwal 1      : Hari", j1.hari, "Jam Ke-", j1.jam_ke, "| Ruang:", j1.id_ruang, "-> Status:", j1.status_bentrok);
cetak("📅 Slot Jadwal 2      : Hari", j2.hari, "Jam Ke-", j2.jam_ke, "| Ruang:", j2.id_ruang, "-> Status:", j2.status_bentrok);

TOTAL_TEST = TOTAL_TEST + 1;
jika j1.status_bentrok == "AMAN_TERJADWAL" dan j2.status_bentrok == "BENTROK_RUANG" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 6] Penjadwalan Pelajaran & Deteksi Anti-Bentrok: LULUS");
} lainnya {
    cetak("❌ [TEST 6] Penjadwalan Pelajaran & Deteksi Anti-Bentrok: GAGAL");
}

// ==============================================================================
// [TEST 7] MESIN VALIDASI DAPODIK: PENGUNCIAN SINKRONISASI KARENA INVALID
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[7] Mesin Validasi Dapodik: Deteksi Invalid & Kunci Sinkronisasi");
cetak("================================================================");

// Buat node sekolah baru yang belum isi sanitasi dan belum ada GTK
misal dapodik_baru_kosong = inisialisasi_dapodik_edge("20107777", "SMA Negeri 2 Pedalaman");
misal audit_kosong = dapodik_audit_validasi(dapodik_baru_kosong);

cetak("🔍 Audit Sekolah Kosong: Total Invalid =", audit_kosong.total_invalid, "| Total Warning =", audit_kosong.total_warning);
cetak("🔒 Status Kunci Sync   :", audit_kosong.status_izin_sync);

misal coba_sinkron_invalid = dapodik_sinkronisasi_resmi_pusdatin(dapodik_baru_kosong);
cetak("🚫 Percobaan Sinkronisasi :");
cetak("   Hasil Eksekusi      :", coba_sinkron_invalid.status);
cetak("   Keterangan Sistem   :", coba_sinkron_invalid.keterangan);

TOTAL_TEST = TOTAL_TEST + 1;
jika audit_kosong.total_invalid > 0 dan coba_sinkron_invalid.status == "SINKRONISASI_DIBLOKIR" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 7] Penguncian Sinkronisasi saat Ditemukan Data Invalid: LULUS");
} lainnya {
    cetak("❌ [TEST 7] Penguncian Sinkronisasi saat Ditemukan Data Invalid: GAGAL");
}

// ==============================================================================
// [TEST 8] KEPATUHAN PENUH (INVALID = 0) & SUKSES SINKRONISASI KE PUSDATIN
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("[8] Kepatuhan Validasi (Invalid = 0) & Sinkronisasi Pusdatin");
cetak("================================================================");

// Node dapodik utama kita telah lengkap terisi seluruh pilarnya
misal audit_lengkap = dapodik_audit_validasi(dapodik);

cetak("🔍 Audit Sekolah Lengkap: Total Invalid =", audit_lengkap.total_invalid, "| Total Warning =", audit_lengkap.total_warning);
cetak("🟢 Status Izin Sync     :", audit_lengkap.status_izin_sync);

misal hasil_sinkron_resmi = dapodik_sinkronisasi_resmi_pusdatin(dapodik);
cetak("🚀 Eksekusi Sinkronisasi Pusdatin :");
cetak("   Status              :", hasil_sinkron_resmi.status);
cetak("   Keterangan          :", hasil_sinkron_resmi.keterangan);
cetak("   Total Entitas Kirim :", hasil_sinkron_resmi.total_data_terkirim, "mutasi data terverifikasi");
cetak("   Hash Payload Cloud  :", hasil_sinkron_resmi.hash_pusdatin);

TOTAL_TEST = TOTAL_TEST + 1;
jika audit_lengkap.total_invalid == 0 dan hasil_sinkron_resmi.status == "SINKRONISASI_BERHASIL_PUSDATIN" {
    LULUS_TEST = LULUS_TEST + 1;
    cetak("✅ [TEST 8] Kepatuhan Validasi & Keberhasilan Sinkronisasi Pusdatin: LULUS");
} lainnya {
    cetak("❌ [TEST 8] Kepatuhan Validasi & Keberhasilan Sinkronisasi Pusdatin: GAGAL");
}

// ==============================================================================
// REKAPITULASI EVALUASI
// ==============================================================================
cetak("");
cetak("================================================================");
cetak("HASIL EVALUASI 8 PILAR DAPODIK LENGKAP WIDYAOS");
cetak("Total Skenario Diuji :", TOTAL_TEST);
cetak("Lulus Verifikasi     :", LULUS_TEST);
cetak("================================================================");

jika LULUS_TEST == TOTAL_TEST {
    cetak("🎉 SEMPURNA! SELURUH MODUL DAPODIK KEMENDIKDASMEN TERCOVER 100%!");
} lainnya {
    cetak("⚠️ ADA SKENARIO YANG BELUM LULUS, SILAKAN PERIKSA LOG DI ATAS.");
}
cetak("");
